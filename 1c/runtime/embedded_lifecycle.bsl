// Исходный фрагмент общего владельца lifecycle embedded runtime. Не содержит API тест-клиента.
// Append-only журнал: при повреждении/неполной записи исполнение запрещено.
&НаКлиенте
Процедура НастроитьОбщийLifecycle(КаталогЖурнала, ПодготовкаЗаписей = Неопределено, ФоноваяОчистка = Ложь) Экспорт
	Если ОбщийLifecycle <> Неопределено Тогда ВызватьИсключение "lifecycle_already_configured"; КонецЕсли;
	СоздатьКаталог(КаталогЖурнала);
	Замок = Новый ФайловыйПоток(КаталогЖурнала + "/owner.lock", РежимОткрытияФайла.ОткрытьИлиСоздать);
	ОбщийLifecycle = Новый Структура("path,lock,records,keys,queue,healthy,bytes", КаталогЖурнала + "/operations.jsonl",
		Замок, Новый Соответствие, Новый Соответствие, Новый Массив, Ложь, 0);
    ОбщийLifecycle.Вставить("compacted_bytes", 0);
    ОбщийLifecycle.Вставить("cleanup_needed", Ложь);
    ОбщийLifecycle.Вставить("adapter_prepared", Ложь);
    ОбщийLifecycle.Вставить("compaction", Неопределено);
    ОбщийLifecycle.Вставить("initializing", Истина);
    Попытка
        LifecycleВосстановитьКомпактацию();
        СнимокЖурнала = LifecycleПрочитатьЖурнал(ОбщийLifecycle.path);
        ОбщийLifecycle.records = СнимокЖурнала.records;
        ОбщийLifecycle.keys = СнимокЖурнала.keys;
        ОбщийLifecycle.bytes = СнимокЖурнала.bytes;
        Если ПодготовкаЗаписей <> Неопределено Тогда
            ВыполнитьОбработкуОповещения(ПодготовкаЗаписей, ОбщийLifecycle.records);
            ОбщийLifecycle.adapter_prepared = Истина;
        КонецЕсли;
        ОбщийLifecycle.healthy = Истина;
        // Доступ открывается после проверки журнала и фиксации unknown.
        // Сроки выдачи проверяются при каждом чтении; физическая очистка может идти отдельно.
        Если ФоноваяОчистка И ОбщийLifecycle.bytes <= 58720256 Тогда
            LifecycleЗавершитьИнициализацию();
        КонецЕсли;
        LifecycleКомпактировать(Истина, Не ФоноваяОчистка);
        ПодключитьОбработчикОжидания("LifecycleОбслуживание", 60, Ложь);
    Исключение
        LifecycleОсвободитьХранилище();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура LifecycleОсвободитьХранилище()
    Если ОбщийLifecycle = Неопределено Тогда Возврат; КонецЕсли;
    ОтключитьОбработчикОжидания("LifecycleОбслуживание");
    ОтключитьОбработчикОжидания("LifecycleШагКомпактации");
    ОбщийLifecycle.healthy = Ложь;
    Если ОбщийLifecycle.compaction <> Неопределено Тогда
        LifecycleЗакрытьПотокиКомпактации(ОбщийLifecycle.compaction);
        ОбщийLifecycle.compaction = Неопределено;
    КонецЕсли;
    ОбщийLifecycle.lock.Закрыть();
    ОбщийLifecycle = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура LifecycleЗавершитьИнициализацию()
	Для Каждого Пара Из ОбщийLifecycle.records Цикл
		Если LifecycleАктивна(Пара.Значение.state) Тогда
			ЗаписьОперации = LifecycleКопия(Пара.Значение);
			ЗаписьОперации.state = "unknown";
			ЗаписьОперации.error = "executor_restarted";
			LifecycleСохранить(ЗаписьОперации);
		КонецЕсли;
	КонецЦикла;
    ОбщийLifecycle.initializing = Ложь;
КонецПроцедуры

&НаКлиенте
Функция LifecycleКопия(Значение)
	Возврат ПрочитатьJSON2(ЗаписатьJSON2(Значение));
КонецФункции

&НаСервереБезКонтекста
Функция LifecycleХеш(Текст)
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Текст);
	Возврат Base64Строка(Хеш.ХешСумма);
КонецФункции

&НаСервереБезКонтекста
Функция LifecycleХеши(Тексты)
    Хеши = Новый Массив;
    Для Каждого Текст Из Тексты Цикл Хеши.Добавить(LifecycleХеш(Текст)); КонецЦикла;
    Возврат Хеши;
КонецФункции

&НаКлиенте
Функция LifecycleКаноническийJSON(Значение)
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Ключи = Новый СписокЗначений;
		Для Каждого Пара Из Значение Цикл Ключи.Добавить(Пара.Ключ); КонецЦикла;
		Ключи.СортироватьПоЗначению();
		Части = Новый Массив;
		Для Каждого Ключ Из Ключи Цикл
			Части.Добавить(ЗаписатьJSON2(Ключ.Значение) + ":" + LifecycleКаноническийJSON(Значение[Ключ.Значение]));
		КонецЦикла;
		Возврат "{" + СтрСоединить(Части, ",") + "}";
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Части = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл Части.Добавить(LifecycleКаноническийJSON(ЭлементМассива)); КонецЦикла;
		Возврат "[" + СтрСоединить(Части, ",") + "]";
	КонецЕсли;
	Возврат ЗаписатьJSON2(Значение);
КонецФункции

&НаКлиенте
Функция LifecycleАктивна(Состояние)
	Возврат Состояние = "queued" Или Состояние = "running" Или Состояние = "awaiting_approval";
КонецФункции

&НаКлиенте
Процедура LifecycleСохранить(ЗаписьОперации)
	Если ОбщийLifecycle = Неопределено Или Не ОбщийLifecycle.healthy Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
    ВозобновитьОчистку = ОбщийLifecycle.compaction <> Неопределено;
    LifecycleОтменитьПодготовку();
    Прежняя = ОбщийLifecycle.records.Получить(ЗаписьОперации.id);
    ЗаписьОперации.revision = ?(Прежняя = Неопределено, 1, Прежняя.revision + 1);
	Текст = ЗаписатьJSON2(ЗаписьОперации);
	Пакет = ЗаписатьJSON2(Новый Структура("payload,hash", Текст, LifecycleХеш(Текст)));
	Пакет = СтрЗаменить(СтрЗаменить(Пакет, Символы.ПС, ""), Символы.ВК, "");
	Если СтрДлина(Пакет) * 4 + ОбщийLifecycle.bytes > 67108864 Тогда ВызватьИсключение "operation_quota_exceeded"; КонецЕсли;
	Попытка
		Запись = Новый ЗаписьТекста(ОбщийLifecycle.path, КодировкаТекста.UTF8, Символы.ПС, Истина);
		Запись.ЗаписатьСтроку(Пакет);
		Запись.Закрыть(); // Закрытие буфера ДО публикации/вызова. Не обещает защиту от потери питания ОС.
		ФайлЖурнала = Новый Файл(ОбщийLifecycle.path);
		ОбщийLifecycle.bytes = ФайлЖурнала.Размер();
		ОбщийLifecycle.records.Вставить(ЗаписьОперации.id, ЗаписьОперации);
		ОбщийLifecycle.keys.Вставить(ЗаписьОперации.key, ЗаписьОперации.id);
        Если ВозобновитьОчистку Или ОбщийLifecycle.bytes > 62914560 Тогда LifecycleКомпактировать(); КонецЕсли;
	Исключение
		ОбщийLifecycle.healthy = Ложь;
		ВызватьИсключение "operation_store_unavailable";
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция LifecycleПринять(Канал, КлючЗапроса, Инструмент, Аргументы, Контекст, Новая)
	Если ОбщийLifecycle = Неопределено Или Не ОбщийLifecycle.healthy Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
    Если ОбщийLifecycle.initializing Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
	Ключ = LifecycleХеш(ЗаписатьJSON2(Новый Структура("channel,request_id", Канал, КлючЗапроса)));
	Отпечаток = LifecycleХеш(LifecycleКаноническийJSON(Новый Структура("tool,params", Инструмент, Аргументы)));
	Ид = ОбщийLifecycle.keys.Получить(Ключ);
	Новая = Ид = Неопределено;
	Если Не Новая Тогда
		ЗаписьОперации = ОбщийLifecycle.records[Ид];
		Если Не LifecycleТочноРавны(ЗаписьОперации.fingerprint, Отпечаток) Тогда ВызватьИсключение "request_conflict"; КонецЕсли;
		Возврат Ид;
	КонецЕсли;
	Активные = 0;
	Для Каждого Пара Из ОбщийLifecycle.records Цикл Если LifecycleАктивна(Пара.Значение.state) Тогда Активные = Активные + 1; КонецЕсли; КонецЦикла;
	Если ОбщийLifecycle.bytes > 62914560 Тогда LifecycleКомпактировать(ОбщийLifecycle.bytes > ОбщийLifecycle.compacted_bytes); КонецЕсли;
	Если ОбщийLifecycle.records.Количество() >= 10000 Или Активные >= 100 Или ОбщийLifecycle.bytes > 62914560 Тогда
		ВызватьИсключение "operation_quota_exceeded";
	КонецЕсли;
	Ид = Строка(Новый УникальныйИдентификатор);
	ЗаписьОперации = Новый Структура("id,key,channel,request_id,tool,fingerprint,state,revision,event_seq,context,result,expires,error",
		Ид, Ключ, Канал, КлючЗапроса, Инструмент, Отпечаток, "queued", 0, 0, Контекст, Неопределено, 0, Неопределено);
	LifecycleСохранить(ЗаписьОперации);
	Возврат Ид;
КонецФункции

&НаКлиенте
Функция LifecycleПолучить(Канал, Ид)
	Если ОбщийLifecycle = Неопределено Или Не ОбщийLifecycle.healthy Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
    Если ОбщийLifecycle.initializing Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
	ЗаписьОперации = ОбщийLifecycle.records.Получить(Ид);
	Если ЗаписьОперации = Неопределено Или Не LifecycleТочноРавны(ЗаписьОперации.channel, Канал) Тогда ВызватьИсключение "permission_denied"; КонецЕсли;
	Если ЗаписьОперации.expires > 0 И ТекущаяУниверсальнаяДатаВМиллисекундах() >= ЗаписьОперации.expires
		И Не LifecycleАктивна(ЗаписьОперации.state) И ЗаписьОперации.state <> "unknown" И ЗаписьОперации.state <> "result_expired" Тогда
		ЗаписьОперации = LifecycleКопия(ЗаписьОперации);
		ЗаписьОперации.state = "result_expired"; ЗаписьОперации.result = Неопределено; ЗаписьОперации.Удалить("progress");
		ОбщийLifecycle.cleanup_needed = Истина;
        // Чтение TTL не требует места для append. Физическую очистку выполнит обслуживание.
	КонецЕсли;
	Возврат LifecycleКопия(ЗаписьОперации);
КонецФункции

&НаКлиенте
Процедура LifecycleСобытие(Канал, Ид, Состояние, Номер, Прогресс = Неопределено)
	ЗаписьОперации = LifecycleПолучить(Канал, Ид);
	Если Не LifecycleАктивна(ЗаписьОперации.state) Или Номер <= ЗаписьОперации.event_seq Тогда Возврат; КонецЕсли;
	Если Состояние = "progress" Тогда
		Если ТипЗнч(Номер) <> Тип("Число") Или Номер <> Цел(Номер) Или Номер < 3 Или Номер > 100000 Тогда Возврат; КонецЕсли;
		Если Не LifecycleДопустимПрогресс(Прогресс) Тогда Возврат; КонецЕсли;
		Предыдущий = Неопределено;
		Если ЗаписьОперации.Свойство("progress", Предыдущий) Тогда
			Если Прогресс.completed_count < Предыдущий.completed_count Или Прогресс.elapsed_ms < Предыдущий.elapsed_ms Тогда Возврат; КонецЕсли;
		КонецЕсли;
		Если ОбщийLifecycle.bytes + СтрДлина(ЗаписатьJSON2(ЗаписьОперации)) * 4 + 4096 > 58720256 Тогда Возврат; КонецЕсли;
		ЗаписьОперации.Вставить("progress", LifecycleКопия(Прогресс));
		Состояние = "running";
	ИначеЕсли Прогресс <> Неопределено Или Не ((Состояние = "awaiting_approval" И Номер = 1) Или (Состояние = "running" И Номер = 2)) Тогда
		Возврат;
	КонецЕсли;
	ЗаписьОперации.state = Состояние; ЗаписьОперации.event_seq = Номер;
	LifecycleСохранить(ЗаписьОперации);
КонецПроцедуры

&НаКлиенте
Процедура LifecycleЗавершить(Канал, Ид, Результат)
	ЗаписьОперации = LifecycleПолучить(Канал, Ид);
	Если Не LifecycleАктивна(ЗаписьОперации.state) Тогда Возврат; КонецЕсли;
	ЗаписьОперации.state = ?(Результат.success, "succeeded", "failed");
	Если Результат.Свойство("lifecycle_outcome") Тогда ЗаписьОперации.state = Результат.lifecycle_outcome; КонецЕсли;
	ЗаписьОперации.result = Результат;
	ЗаписьОперации.Удалить("progress");
	Если СтрДлина(ЗаписатьJSON2(Результат)) * 4 > 4194304 Или ОбщийLifecycle.bytes > 62914560 Тогда
		ЗаписьОперации.result = Неопределено; ЗаписьОперации.state = "unknown"; ЗаписьОперации.error = "result_storage_quota";
	КонецЕсли;
	ЗаписьОперации.expires = ТекущаяУниверсальнаяДатаВМиллисекундах() + 86400000;
	LifecycleСохранить(ЗаписьОперации);
КонецПроцедуры

&НаКлиенте
Функция LifecycleТочноРавны(Левая, Правая)
    Если СтрДлина(Левая) <> СтрДлина(Правая) Тогда Возврат Ложь; КонецЕсли;
    Для Индекс = 1 По СтрДлина(Левая) Цикл
        Если КодСимвола(Левая, Индекс) <> КодСимвола(Правая, Индекс) Тогда Возврат Ложь; КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

&НаКлиенте
Функция LifecycleДопустимПрогресс(Прогресс)
	Если ТипЗнч(Прогресс) <> Тип("Структура") Или Прогресс.Количество() <> 4 Тогда Возврат Ложь; КонецЕсли;
	Для Каждого Имя Из СтрРазделить("phase,completed_count,elapsed_ms,last_confirmed_step", ",") Цикл
		Если Не Прогресс.Свойство(Имя) Тогда Возврат Ложь; КонецЕсли;
	КонецЦикла;
	Если ТипЗнч(Прогресс.phase) <> Тип("Строка") Тогда Возврат Ложь; КонецЕсли;
	Если Не LifecycleТочноРавны(Прогресс.phase, "executing") И Не LifecycleТочноРавны(Прогресс.phase, "waiting") И Не LifecycleТочноРавны(Прогресс.phase, "observing") Тогда Возврат Ложь; КонецЕсли;
	Для Каждого Имя Из СтрРазделить("completed_count,elapsed_ms", ",") Цикл
		Значение = Прогресс[Имя];
		Если ТипЗнч(Значение) <> Тип("Число") Или Значение <> Цел(Значение) Или Значение < 0 Тогда Возврат Ложь; КонецЕсли;
	КонецЦикла;
	Если Прогресс.completed_count > 1000000 Или Прогресс.elapsed_ms > 86400000 Тогда Возврат Ложь; КонецЕсли;
	Если Прогресс.last_confirmed_step = Неопределено Или Прогресс.last_confirmed_step = Null Тогда Возврат Прогресс.completed_count = 0; КонецЕсли;
	Если Прогресс.completed_count = 0 Или ТипЗнч(Прогресс.last_confirmed_step) <> Тип("Строка") Тогда Возврат Ложь; КонецЕсли;
	Для Каждого Шаг Из СтрРазделить("activate,open_choice_list,select_choice,toggle_check,clear,input_text,finish_edit,action,add,open", ",") Цикл
		Если LifecycleТочноРавны(Шаг, Прогресс.last_confirmed_step) Тогда Возврат Истина; КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции
