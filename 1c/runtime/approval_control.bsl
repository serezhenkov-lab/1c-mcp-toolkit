&НаКлиенте
Функция УстановитьРежимПодтвержденияMCP(Аргументы)
	Если Не СоответствуетСхемеLifecycle(Аргументы, СхемаУправленияРазрешениямиMCP().inputSchema) Тогда
		Возврат Новый Структура("success,error,error_code", Ложь,
			"Expected exactly one parameter: mode = deny | ask | session_allow", "invalid_params");
	КонецЕсли;
	ПрежнийРежим = РежимПодтвержденияОпасныхОпераций;
	Если Не LifecycleТочноРавны(ПрежнийРежим, Аргументы.mode) Тогда
		РежимПодтвержденияОпасныхОпераций = Аргументы.mode;
		// Тот же переход и отзыв прежних разрешений, что при изменении поля формы.
		РежимПодтвержденияПриИзменении(Неопределено);
	КонецЕсли;
	Данные = Новый Структура("mode,previous_mode,scope", РежимПодтвержденияОпасныхОпераций,
		ПрежнийРежим, "toolkit_session");
	Возврат Новый Структура("success,data", Истина, Данные);
КонецФункции
