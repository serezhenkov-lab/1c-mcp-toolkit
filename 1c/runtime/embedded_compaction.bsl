// Общий владелец: checkpoint с маркером commit, без запасной копии старых payload.
&НаКлиенте
Функция LifecycleПрочитатьЖурнал(Путь, КонтрольнаяТочка = Ложь)
    Снимок = Новый Структура("records,keys,bytes,count,digest", Новый Соответствие, Новый Соответствие, 0, 0, "");
    Файл = Новый Файл(Путь);
    Хеши = Новый Массив;
    ТекстыПакета = Новый Массив; ХешиПакета = Новый Массив; РазмерПакета = 0;
    Если Файл.Существует() Тогда
        Если Файл.Размер() > 67108864 Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
        Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
        Попытка
            СтрокаЗаписи = Чтение.ПрочитатьСтроку();
            Пока СтрокаЗаписи <> Неопределено Цикл
                Пакет = ПрочитатьJSON2(СтрокаЗаписи);
                ТекстыПакета.Добавить(Пакет.payload); ХешиПакета.Добавить(Пакет.hash);
                РазмерПакета = РазмерПакета + СтрДлина(Пакет.payload);
                Если ТекстыПакета.Количество() >= 256 Или РазмерПакета >= 1048576 Тогда
                    LifecycleПроверитьПакет(ТекстыПакета, ХешиПакета); РазмерПакета = 0;
                КонецЕсли;
                ЗаписьОперации = ПрочитатьJSON2(Пакет.payload);
                Прежняя = Снимок.records.Получить(ЗаписьОперации.id);
                Если (Прежняя = Неопределено И ЗаписьОперации.revision <> 1)
                    Или (Прежняя <> Неопределено И (КонтрольнаяТочка Или ЗаписьОперации.revision <> Прежняя.revision + 1)) Тогда
                    ВызватьИсключение "operation_store_corrupt";
                КонецЕсли;
                Если Прежняя <> Неопределено Тогда
                    Если Не LifecycleТочноРавны(Прежняя.key, ЗаписьОперации.key)
                        Или Не LifecycleТочноРавны(Прежняя.fingerprint, ЗаписьОперации.fingerprint) Тогда ВызватьИсключение "operation_store_corrupt"; КонецЕсли;
                КонецЕсли;
                ИдПоКлючу = Снимок.keys.Получить(ЗаписьОперации.key);
                Если ИдПоКлючу <> Неопределено И ИдПоКлючу <> ЗаписьОперации.id Тогда ВызватьИсключение "operation_store_corrupt"; КонецЕсли;
                Снимок.records.Вставить(ЗаписьОперации.id, ЗаписьОперации);
                Снимок.keys.Вставить(ЗаписьОперации.key, ЗаписьОперации.id);
                Хеши.Добавить(Пакет.hash);
                Снимок.count = Снимок.count + 1;
                СтрокаЗаписи = Чтение.ПрочитатьСтроку();
            КонецЦикла;
            LifecycleПроверитьПакет(ТекстыПакета, ХешиПакета);
            Чтение.Закрыть();
        Исключение
            Чтение.Закрыть(); ВызватьИсключение "operation_store_unavailable";
        КонецПопытки;
        Снимок.bytes = Файл.Размер();
    КонецЕсли;
    Снимок.digest = LifecycleХеш(СтрСоединить(Хеши, Символы.ПС));
    Возврат Снимок;
КонецФункции

&НаКлиенте
Процедура LifecycleКомпактировать(Принудительно = Ложь, ОжидатьЗавершения = Ложь)
    Если ОбщийLifecycle = Неопределено Или Не ОбщийLifecycle.healthy Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
    Если ОбщийLifecycle.compaction <> Неопределено Тогда
        Если Принудительно Тогда ОбщийLifecycle.compaction.required = Истина; КонецЕсли;
        Если Не ОжидатьЗавершения Тогда Возврат; КонецЕсли;
    КонецЕсли;
    Если ОбщийLifecycle.compaction = Неопределено Тогда
        Работа = Новый Структура;
        Работа.Вставить("phase", "expire"); Работа.Вставить("index", 0);
        Работа.Вставить("now", ТекущаяУниверсальнаяДатаВМиллисекундах());
        Работа.Вставить("rows", Новый Массив); Работа.Вставить("expired", Новый Соответствие);
        Для Каждого Пара Из ОбщийLifecycle.records Цикл Работа.rows.Добавить(Пара.Значение); КонецЦикла;
        Работа.Вставить("required", Принудительно Или ОбщийLifecycle.cleanup_needed Или ОбщийLifecycle.bytes - ОбщийLifecycle.compacted_bytes > 8388608);
        Работа.Вставить("changed", Ложь); Работа.Вставить("writer", Неопределено);
        Работа.Вставить("reader", Неопределено); Работа.Вставить("snapshot", Неопределено);
        Работа.Вставить("checked", Неопределено); Работа.Вставить("hashes", Новый Массив);
        Работа.Вставить("synchronous", ОжидатьЗавершения);
        ОбщийLifecycle.compaction = Работа;
    КонецЕсли;
    Если ОжидатьЗавершения Тогда
        ОбщийLifecycle.compaction.synchronous = Истина;
        Пока ОбщийLifecycle.compaction <> Неопределено Цикл LifecycleШагКомпактации(); КонецЦикла;
    Иначе
        ПодключитьОбработчикОжидания("LifecycleШагКомпактации", 0.05, Истина);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура LifecycleЗакрытьПотокиКомпактации(Работа)
    Если Работа.reader <> Неопределено Тогда Работа.reader.Закрыть(); Работа.reader = Неопределено; КонецЕсли;
    Если Работа.writer <> Неопределено Тогда Работа.writer.Закрыть(); Работа.writer = Неопределено; КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура LifecycleОтменитьПодготовку()
    Если ОбщийLifecycle.compaction = Неопределено Тогда Возврат; КонецЕсли;
    // Между шагами commit ещё не существует. Новая запись остаётся в старом журнале.
    Попытка
        LifecycleЗакрытьПотокиКомпактации(ОбщийLifecycle.compaction);
        Файл = Новый Файл(ОбщийLifecycle.path + ".next");
        Если Файл.Существует() Тогда УдалитьФайлы(Файл.ПолноеИмя); КонецЕсли;
        ОбщийLifecycle.compaction = Неопределено;
        ОбщийLifecycle.cleanup_needed = Истина;
    Исключение
        ОбщийLifecycle.healthy = Ложь; ВызватьИсключение "operation_store_unavailable";
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура LifecycleШагКомпактации() Экспорт
    Если ОбщийLifecycle = Неопределено Или ОбщийLifecycle.compaction = Неопределено Или Не ОбщийLifecycle.healthy Тогда Возврат; КонецЕсли;
    Работа = ОбщийLifecycle.compaction;
    Попытка
        Если Работа.phase = "expire" Или Работа.phase = "dependencies" Тогда
            LifecycleШагИстечения(Работа);
        ИначеЕсли Работа.phase = "write" Тогда
            LifecycleШагЗаписи(Работа);
        ИначеЕсли Работа.phase = "verify" Или Работа.phase = "verify_again" Тогда
            LifecycleШагПроверки(Работа);
        ИначеЕсли Работа.phase = "commit" Тогда
            LifecycleЗавершитьКомпактацию(Работа);
        КонецЕсли;
    Исключение
        Попытка LifecycleЗакрытьПотокиКомпактации(Работа); Исключение ОбщийLifecycle.cleanup_needed = Истина; КонецПопытки;
        ОбщийLifecycle.compaction = Неопределено; ОбщийLifecycle.healthy = Ложь;
        Если Работа.synchronous Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
        Возврат;
    КонецПопытки;
    Если ОбщийLifecycle.compaction <> Неопределено И Не Работа.synchronous Тогда
        ПодключитьОбработчикОжидания("LifecycleШагКомпактации", 0.05, Истина);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура LifecycleШагИстечения(Работа)
    Предел = Мин(Работа.index + 128, Работа.rows.Количество());
    Пока Работа.index < Предел Цикл
        СтрокаОперации = Работа.rows[Работа.index]; Работа.index = Работа.index + 1;
        Истекла = LifecycleИстекла(СтрокаОперации, Работа.now);
        Если Работа.phase = "dependencies" И Не LifecycleАктивна(СтрокаОперации.state) И СтрокаОперации.state <> "unknown"
            И СтрокаОперации.context.Свойство("result_dependencies") Тогда
            Для Каждого Ид Из СтрокаОперации.context.result_dependencies Цикл
                Если Работа.expired.Получить(Ид) <> Неопределено Тогда Истекла = Истина; Прервать; КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если Истекла И Работа.expired.Получить(СтрокаОперации.id) = Неопределено Тогда
            Работа.expired.Вставить(СтрокаОперации.id, Истина); Работа.changed = Истина;
            Если СтрокаОперации.state <> "result_expired" Тогда Работа.required = Истина; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если Работа.index < Работа.rows.Количество() Тогда Возврат; КонецЕсли;
    Работа.index = 0;
    Если Работа.phase = "expire" Или Работа.changed Тогда
        Работа.phase = "dependencies"; Работа.changed = Ложь; Возврат;
    КонецЕсли;
    Если Не Работа.required Тогда ОбщийLifecycle.compaction = Неопределено; Возврат; КонецЕсли;
    Работа.writer = Новый ЗаписьТекста(ОбщийLifecycle.path + ".next", КодировкаТекста.UTF8, Символы.ПС, Ложь);
    Работа.phase = "write";
КонецПроцедуры

&НаКлиенте
Процедура LifecycleШагЗаписи(Работа)
    Тексты = Новый Массив; Размер = 0;
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Пока Работа.index < Работа.rows.Количество() Цикл
        СтрокаОперации = LifecycleКопия(Работа.rows[Работа.index]); Работа.index = Работа.index + 1;
        Если Работа.expired.Получить(СтрокаОперации.id) <> Неопределено Тогда
            СтрокаОперации.state = "result_expired"; СтрокаОперации.result = Неопределено; СтрокаОперации.Удалить("progress");
        КонецЕсли;
        СтрокаОперации.revision = 1;
        Текст = ЗаписатьJSON2(СтрокаОперации); Тексты.Добавить(Текст); Размер = Размер + СтрДлина(Текст);
        Если Тексты.Количество() >= 64 Или Размер >= 262144 Или ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало >= 50 Тогда Прервать; КонецЕсли;
    КонецЦикла;
    LifecycleЗаписатьПакет(Работа.writer, Тексты);
    Если Работа.index < Работа.rows.Количество() Тогда Возврат; КонецЕсли;
    Работа.writer.Закрыть(); Работа.writer = Неопределено;
    // Барьер: prepared. Пока commit отсутствует, старый журнал авторитетен.
    Работа.phase = "verify";
КонецПроцедуры

&НаКлиенте
Процедура LifecycleШагПроверки(Работа)
    Путь = ОбщийLifecycle.path + ".next";
    Если Работа.reader = Неопределено Тогда
        Файл = Новый Файл(Путь);
        Если Файл.Размер() > 67108864 Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
        Работа.checked = Новый Структура("records,keys,bytes,count,digest", Новый Соответствие, Новый Соответствие, Файл.Размер(), 0, "");
        Работа.hashes = Новый Массив;
        Работа.reader = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
    КонецЕсли;
    Тексты = Новый Массив; Хеши = Новый Массив; Размер = 0; КонецФайла = Ложь;
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Пока Истина Цикл
        Строка = Работа.reader.ПрочитатьСтроку();
        Если Строка = Неопределено Тогда КонецФайла = Истина; Прервать; КонецЕсли;
        Пакет = ПрочитатьJSON2(Строка);
        Тексты.Добавить(Пакет.payload); Хеши.Добавить(Пакет.hash); Размер = Размер + СтрДлина(Пакет.payload);
        СтрокаОперации = ПрочитатьJSON2(Пакет.payload);
        Если СтрокаОперации.revision <> 1 Или Работа.checked.records.Получить(СтрокаОперации.id) <> Неопределено
            Или Работа.checked.keys.Получить(СтрокаОперации.key) <> Неопределено Тогда ВызватьИсключение "operation_store_corrupt"; КонецЕсли;
        Работа.checked.records.Вставить(СтрокаОперации.id, СтрокаОперации);
        Работа.checked.keys.Вставить(СтрокаОперации.key, СтрокаОперации.id);
        Работа.checked.count = Работа.checked.count + 1; Работа.hashes.Добавить(Пакет.hash);
        Если Тексты.Количество() >= 64 Или Размер >= 262144 Или ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало >= 50 Тогда Прервать; КонецЕсли;
    КонецЦикла;
    LifecycleПроверитьПакет(Тексты, Хеши);
    Если Не КонецФайла Тогда Возврат; КонецЕсли;
    Работа.reader.Закрыть(); Работа.reader = Неопределено;
    Работа.checked.digest = LifecycleХеш(СтрСоединить(Работа.hashes, Символы.ПС));
    Если Работа.checked.count <> Работа.rows.Количество() Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
    Если Работа.phase = "verify" Тогда
        Работа.snapshot = Работа.checked; Работа.checked = Неопределено; Работа.phase = "verify_again";
    Иначе
        Если Не LifecycleТочноРавны(Работа.snapshot.digest, Работа.checked.digest) Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
        Работа.phase = "commit";
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура LifecycleЗавершитьКомпактацию(Работа)
    // Commit и замена не уступают управление. До этого шага любая запись отменяет подготовку.
    Путь = ОбщийLifecycle.path;
    Работа.writer = Новый ЗаписьТекста(Путь + ".commit", КодировкаТекста.UTF8);
    Работа.writer.Записать(ЗаписатьJSON2(Новый Структура("version,count,digest", 1, Работа.snapshot.count, Работа.snapshot.digest)));
    Работа.writer.Закрыть(); Работа.writer = Неопределено;
    // Барьер: committed. Возврат к старому журналу теперь запрещён.
    Файл = Новый Файл(Путь);
    Если Файл.Существует() Тогда УдалитьФайлы(Путь); КонецЕсли;
    // Барьер: old_removed. При сбое commit + next остаются источником истины.
    ПереместитьФайл(Путь + ".next", Путь);
    // Барьер: installed. При сбое commit проверяется по уже установленному файлу.
    УдалитьФайлы(Путь + ".commit");
    ОбщийLifecycle.records = Работа.snapshot.records; ОбщийLifecycle.keys = Работа.snapshot.keys;
    ОбщийLifecycle.bytes = Работа.snapshot.bytes; ОбщийLifecycle.compacted_bytes = Работа.snapshot.bytes;
    ОбщийLifecycle.cleanup_needed = Ложь; ОбщийLifecycle.compaction = Неопределено;
    Если ОбщийLifecycle.initializing Тогда LifecycleЗавершитьИнициализацию(); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура LifecycleОбслуживание() Экспорт
    Если ОбщийLifecycle = Неопределено Или Не ОбщийLifecycle.healthy Тогда Возврат; КонецЕсли;
    Попытка LifecycleКомпактировать(); Исключение ОбщийLifecycle.healthy = Ложь; КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура LifecycleПроверитьПакет(Тексты, Ожидаемые)
    Если Тексты.Количество() = 0 Тогда Возврат; КонецЕсли;
    Хеши = LifecycleХеши(Тексты);
    Для Индекс = 0 По Тексты.Количество() - 1 Цикл
        Если Не LifecycleТочноРавны(Хеши[Индекс], Ожидаемые[Индекс]) Тогда ВызватьИсключение "operation_store_corrupt"; КонецЕсли;
    КонецЦикла;
    Тексты.Очистить(); Ожидаемые.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура LifecycleЗаписатьПакет(Запись, Тексты)
    Если Тексты.Количество() = 0 Тогда Возврат; КонецЕсли;
    Хеши = LifecycleХеши(Тексты);
    Для Индекс = 0 По Тексты.Количество() - 1 Цикл
        Пакет = ЗаписатьJSON2(Новый Структура("payload,hash", Тексты[Индекс], Хеши[Индекс]));
        Запись.ЗаписатьСтроку(СтрЗаменить(СтрЗаменить(Пакет, Символы.ПС, ""), Символы.ВК, ""));
    КонецЦикла;
    Тексты.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура LifecycleВосстановитьКомпактацию()
    Путь = ОбщийLifecycle.path;
    НовыйФайл = Новый Файл(Путь + ".next");
    Маркер = Новый Файл(Путь + ".commit");
    Если Не Маркер.Существует() Тогда
        // Незавершённая подготовка не меняла действующий журнал.
        Если НовыйФайл.Существует() Тогда УдалитьФайлы(НовыйФайл.ПолноеИмя); КонецЕсли;
        Возврат;
    КонецЕсли;
    Если Маркер.Размер() > 4096 Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
    Чтение = Новый ЧтениеТекста(Маркер.ПолноеИмя, КодировкаТекста.UTF8);
    Попытка
        Описание = ПрочитатьJSON2(Чтение.Прочитать()); Чтение.Закрыть();
    Исключение
        Чтение.Закрыть(); ВызватьИсключение "operation_store_unavailable";
    КонецПопытки;
    Если ТипЗнч(Описание) <> Тип("Структура") Или Не Описание.Свойство("version")
        Или Не Описание.Свойство("count") Или Не Описание.Свойство("digest") Тогда
        ВызватьИсключение "operation_store_unavailable";
    КонецЕсли;
    Источник = ?(НовыйФайл.Существует(), НовыйФайл.ПолноеИмя, Путь);
    ФайлИсточника = Новый Файл(Источник);
    Если Не ФайлИсточника.Существует() Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
    Проверка = LifecycleПрочитатьЖурнал(Источник, Истина);
    Если Описание.version <> 1 Или Проверка.count <> Описание.count
        Или Не LifecycleТочноРавны(Проверка.digest, Описание.digest) Тогда ВызватьИсключение "operation_store_unavailable"; КонецЕсли;
    Если НовыйФайл.Существует() Тогда
        СтарыйФайл = Новый Файл(Путь);
        Если СтарыйФайл.Существует() Тогда УдалитьФайлы(Путь); КонецЕсли;
        // Барьер: old_removed. При сбое commit + next остаются источником истины.
        ПереместитьФайл(НовыйФайл.ПолноеИмя, Путь);
        // Барьер: installed. При сбое commit проверяется по уже установленному файлу.
    КонецЕсли;
    УдалитьФайлы(Маркер.ПолноеИмя);
КонецПроцедуры

&НаКлиенте
Функция LifecycleИстекла(ЗаписьОперации, Сейчас)
    Возврат Не LifecycleАктивна(ЗаписьОперации.state) И ЗаписьОперации.state <> "unknown"
        И (ЗаписьОперации.state = "result_expired" Или (ЗаписьОперации.expires > 0 И Сейчас >= ЗаписьОперации.expires));
КонецФункции

