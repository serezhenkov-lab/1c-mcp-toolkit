// Локальная настройка пользователя текущей базы. Секреты не сохраняются.
&НаСервере
Процедура ЗагрузитьПрофильТестирования()
    ТестПрофильID = "local";
    ТестПрофильПользователь = ИмяПользователя();
    ТестПрофильПорт = 1538;
    ТестПрофильСтатус = "Профиль не настроен";
    Попытка
        Данные = ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "TestClientProfileV1");
        Если Данные = Неопределено Тогда Возврат; КонецЕсли;
        ПроверитьНастройкуПрофиляТестирования(Данные);
        ТестПрофильID = Данные.id;
        ТестПрофильПользователь = Данные.user;
        ТестПрофильПорт = Данные.port;
        ТестПрофильСтатус = "Настройки загружены";
    Исключение
            ТестПрофильСтатус = "Не удалось загрузить профиль; проверьте настройки и сохраните заново";
    КонецПопытки;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьНастройкуПрофиляТестирования(Данные)
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда ВызватьИсключение "invalid_profile"; КонецЕсли;
    Для Каждого Имя Из СтрРазделить("version,id,user,port,enabled,password_required", ",") Цикл
        Если Не Данные.Свойство(Имя) Тогда ВызватьИсключение "invalid_profile"; КонецЕсли;
    КонецЦикла;
    Если Данные.version <> 1 Или ТипЗнч(Данные.id) <> Тип("Строка")
        Или ТипЗнч(Данные.user) <> Тип("Строка") Или ТипЗнч(Данные.port) <> Тип("Число")
        Или ТипЗнч(Данные.enabled) <> Тип("Булево") Или ТипЗнч(Данные.password_required) <> Тип("Булево") Тогда
        ВызватьИсключение "invalid_profile";
    КонецЕсли;
    Если СтрДлина(Данные.id) < 1 Или СтрДлина(Данные.id) > 64
        Или ПустаяСтрока(Данные.user) Или СтрДлина(Данные.user) > 128
        Или Данные.port <> Цел(Данные.port) Или Данные.port < 1024 Или Данные.port > 65535 Тогда
        ВызватьИсключение "invalid_profile";
    КонецЕсли;
    Для Индекс = 1 По СтрДлина(Данные.id) Цикл
        Если СтрНайти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-", Сред(Данные.id, Индекс, 1)) = 0 Тогда
            ВызватьИсключение "invalid_profile";
        КонецЕсли;
    КонецЦикла;
    Для Индекс = 1 По СтрДлина(Данные.user) Цикл
        Если КодСимвола(Данные.user, Индекс) < 32 Тогда ВызватьИсключение "invalid_profile"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция НастройкаПрофиляТестирования()
    Возврат Новый Структура("version,id,user,port,enabled,password_required", 1,
        ТестПрофильID, СокрЛП(ТестПрофильПользователь), ТестПрофильПорт,
        Истина, Ложь);
КонецФункции

&НаСервере
Процедура ЗаписатьПрофильТестирования(Данные)
    ПроверитьНастройкуПрофиляТестирования(Данные);
    Если Не ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
        ВызватьИсключение "profile_settings_access_denied";
    КонецЕсли;
    // Только перечисленные поля: без пароля, подключения, аргументов запуска и разрешений.
    Запись = Новый Структура("version,id,user,port,enabled,password_required", 1,
        Данные.id, Данные.user, Данные.port, Данные.enabled, Данные.password_required);
    ХранилищеОбщихНастроек.Сохранить("MCPToolkit", "TestClientProfileV1", Запись);
КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючReceiptПрофиляТестирования(Подключение, Пользователь)
    Возврат СтрЗаменить(СтрЗаменить(LifecycleХеш(Подключение + "|" + Пользователь), "/", "_"), "+", "-");
КонецФункции

&НаКлиенте
Функция СобратьЛокальныйПрофильТестирования(Данные)
    ПроверитьНастройкуПрофиляТестирования(Данные);
    Каталог = РабочийКаталогДанныхПользователя() + "MCPToolkit/test-client/";
    СоздатьКаталог(Каталог);
    // Receipt общий для профилей этой базы/пользователя: смена ID не прячет живой процесс.
    Ключ = КлючReceiptПрофиляТестирования(СтрокаСоединенияИнформационнойБазы(), ИмяПользователя());
    Возврат Новый Структура("id,exe,connection,user,port,receipt_path,password,password_required",
        Данные.id, КаталогПрограммы() + "1cv8c.exe", СтрокаСоединенияИнформационнойБазы(),
        Данные.user, Данные.port, Каталог + Ключ + ".json", ТестПрофильПароль, Данные.password_required);
КонецФункции

&НаКлиенте
Процедура ВосстановитьЛокальныйПрофильТестирования()
    Попытка
        ПрименитьНастройкиТестКлиента();
    Исключение
        ТестПрофильСтатус = "Не удалось применить настройки тест-клиента";
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура НастройкаТестКлиентаПриИзменении(Элемент)
    Попытка
        ЗаписатьПрофильТестирования(НастройкаПрофиляТестирования());
        ПрименитьНастройкиТестКлиента();
    Исключение
        ТестПрофильСтатус = "Не удалось сохранить или применить настройки тест-клиента";
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПарольТестКлиентаПриИзменении(Элемент)
    ВосстановитьЛокальныйПрофильТестирования();
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьНастройкиТестКлиента()
    Настройка = НастройкаПрофиляТестирования();
    Если ФормаМенеджераТестирования <> Неопределено Тогда
        Если Не ФормаМенеджераТестирования.МожноИзменитьПрофиль(Настройка) Тогда
            НастройкиТестКлиентаОтложены = Истина;
            ТестПрофильСтатус = "Настройки будут применены после завершения тест-клиента";
            Возврат;
        КонецЕсли;
        ФормаМенеджераТестирования.ИзменитьПрофиль(СобратьЛокальныйПрофильТестирования(Настройка));
    Иначе
        ПолучитьМенеджерТестирования(СобратьЛокальныйПрофильТестирования(Настройка));
    КонецЕсли;
    НастройкиТестКлиентаОтложены = Ложь;
    ТестПрофильСтатус = "Настройки применены";
КонецПроцедуры
