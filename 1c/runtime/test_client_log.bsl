&НаКлиенте
Процедура ЖурналТестирования(Команда, Этап, Ответ = Неопределено)
	// Диагностика использует штатное поле Лог и не управляет исполнением/lifecycle.
	Попытка
		Метка = "";
		Если Этап = "command" Тогда Метка = "_test_log_command";
		ИначеЕсли Этап = "completed" Тогда Метка = "_test_log_completed";
		КонецЕсли;
		Если Не ПустаяСтрока(Метка) И Команда.Свойство(Метка) Тогда Возврат; КонецЕсли;
		Если Этап = "state" Тогда
			ПредыдущееСостояние = "";
			Команда.Свойство("_test_log_state", ПредыдущееСостояние);
			Если ПредыдущееСостояние = Ответ.status Тогда Возврат; КонецЕсли;
		КонецЕсли;

		Если Этап = "command" Тогда
			Заголовок = "Получена команда: ";
			Данные = Команда.params;
		Иначе
			Заголовок = ?(Этап = "completed", "Завершена команда: ",
				?(Этап = "state", "Состояние команды: ", "Результат запроса: "));
			Данные = Ответ;
		КонецЕсли;
		Заголовок = Заголовок + Команда.tool;
		Если Команда.Свойство("id") И ЗначениеЗаполнено(Команда.id) Тогда
			Заголовок = Заголовок + " [operation_id=" + Строка(Команда.id) + "]";
		КонецЕсли;
		Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("status") Тогда
			Заголовок = Заголовок + " [" + Данные.status + "]";
		КонецЕсли;
		Текст = ЗаписатьJSON2(Данные);
		// Большой inspect не вытесняет всю предшествующую историю (общий предел - 70000).
		Если СтрДлина(Текст) > 16000 Тогда
			Текст = Лев(Текст, 16000) + Символы.ПС + "[Запись журнала усечена; полный результат доступен через MCP]";
		КонецЕсли;
		ДобавитьВЛог(Заголовок + Символы.ПС + Текст);
		Если Не ПустаяСтрока(Метка) Тогда Команда.Вставить(Метка, Истина); КонецЕсли;
		Если Этап = "state" Тогда Команда.Вставить("_test_log_state", Ответ.status); КонецЕсли;
	Исключение
		// Недоступность журнала не подменяет результат и не запускает действие повторно.
		Возврат;
	КонецПопытки;
КонецПроцедуры
