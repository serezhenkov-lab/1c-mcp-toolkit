&НаКлиенте
Функция СхемыСоВстроеннымLifecycle()
	Схемы = LifecycleКопия(ПолучитьСхемыИнструментов());
	УправлениеРазрешениями = СхемаУправленияРазрешениямиMCP();
	Схемы.tools.Добавить(СоздатьСхемуИнструмента(УправлениеРазрешениями.name,
		УправлениеРазрешениями.description, УправлениеРазрешениями.inputSchema));
	Для Каждого Пара Из СхемыТестированияLifecycle() Цикл
		Схемы.tools.Добавить(СоздатьСхемуИнструмента(Пара.Ключ, "Test-client v1. Durable request_id; status in data.operation.", Пара.Значение));
	КонецЦикла;
	Возврат Схемы;
КонецФункции

&НаКлиенте
Функция СоответствуетСхемеLifecycle(Значение, Схема)
	Если Схема.Свойство("oneOf") Тогда
		Совпадений = 0;
		Для Каждого Вариант Из Схема.oneOf Цикл Если СоответствуетСхемеLifecycle(Значение, Вариант) Тогда Совпадений = Совпадений + 1; КонецЕсли; КонецЦикла;
		Возврат Совпадений = 1;
	КонецЕсли;
	Если Схема.Свойство("const") И Не LifecycleТочноРавны(LifecycleКаноническийJSON(Схема.const), LifecycleКаноническийJSON(Значение)) Тогда Возврат Ложь; КонецЕсли;
	Если Схема.Свойство("enum") Тогда
		Найдено = Ложь;
		Для Каждого Вариант Из Схема.enum Цикл Если LifecycleТочноРавны(LifecycleКаноническийJSON(Вариант), LifecycleКаноническийJSON(Значение)) Тогда Найдено = Истина; КонецЕсли; КонецЦикла;
		Если Не Найдено Тогда Возврат Ложь; КонецЕсли;
	КонецЕсли;
	Если Не Схема.Свойство("type") Тогда Возврат Истина; КонецЕсли;
	ТипJSON = Схема.type;
	Если ТипJSON = "object" Тогда
		Если ТипЗнч(Значение) <> Тип("Структура") Тогда Возврат Ложь; КонецЕсли;
		Если Схема.Свойство("minProperties") И Значение.Количество() < Схема.minProperties Тогда Возврат Ложь; КонецЕсли;
		Если Схема.Свойство("required") Тогда
			Для Каждого Имя Из Схема.required Цикл Если Не Значение.Свойство(Имя) Тогда Возврат Ложь; КонецЕсли; КонецЦикла;
		КонецЕсли;
		Для Каждого Пара Из Значение Цикл
			ТочныйКлюч = Ложь;
            Для Каждого СвойствоСхемы Из Схема.properties Цикл
                Если LifecycleТочноРавны(Пара.Ключ, СвойствоСхемы.Ключ) Тогда ТочныйКлюч = Истина; КонецЕсли;
            КонецЦикла;
            Если Не ТочныйКлюч Тогда Возврат Ложь; КонецЕсли;
			Если Не СоответствуетСхемеLifecycle(Пара.Значение, Схема.properties[Пара.Ключ]) Тогда Возврат Ложь; КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипJSON = "array" Тогда
		Если ТипЗнч(Значение) <> Тип("Массив") Тогда Возврат Ложь; КонецЕсли;
		Если Схема.Свойство("minItems") И Значение.Количество() < Схема.minItems Тогда Возврат Ложь; КонецЕсли;
		Если Схема.Свойство("maxItems") И Значение.Количество() > Схема.maxItems Тогда Возврат Ложь; КонецЕсли;
		Уникальные = Новый Соответствие; Колонки = Новый Соответствие;
		Для Каждого ЭлементМассива Из Значение Цикл
			Если Не СоответствуетСхемеLifecycle(ЭлементМассива, Схема.items) Тогда Возврат Ложь; КонецЕсли;
			Ключ = LifecycleКаноническийJSON(ЭлементМассива);
			Если Схема.Свойство("uniqueItems") И Схема.uniqueItems И Уникальные.Получить(Ключ) <> Неопределено Тогда Возврат Ложь; КонецЕсли;
			Уникальные.Вставить(Ключ, Истина);
			Если ТипЗнч(ЭлементМассива) = Тип("Структура") И ЭлементМассива.Свойство("column") Тогда
				Если Колонки.Получить(ЭлементМассива.column) <> Неопределено Тогда Возврат Ложь; КонецЕсли;
				Колонки.Вставить(ЭлементМассива.column, Истина);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипJSON = "string" Тогда
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда Возврат Ложь; КонецЕсли;
		Если Схема.Свойство("minLength") И СтрДлина(Значение) < Схема.minLength Тогда Возврат Ложь; КонецЕсли;
		Если Схема.Свойство("maxLength") И СтрДлина(Значение) > Схема.maxLength Тогда Возврат Ложь; КонецЕсли;
		Если Схема.Свойство("pattern") Тогда
			Если Схема.pattern = "^e1cib/" Тогда
				Если Не LifecycleТочноРавны(Лев(Значение, 6), "e1cib/") Тогда Возврат Ложь; КонецЕсли;
			ИначеЕсли Схема.pattern = "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2})?$" Тогда
				Если Не LifecycleДатаISO(Значение) Тогда Возврат Ложь; КонецЕсли;
			Иначе
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипJSON = "integer" Или ТипJSON = "number" Тогда
		Если ТипЗнч(Значение) <> Тип("Число") Тогда Возврат Ложь; КонецЕсли;
		Если ТипJSON = "integer" И Значение <> Цел(Значение) Тогда Возврат Ложь; КонецЕсли;
		Если Схема.Свойство("minimum") И Значение < Схема.minimum Тогда Возврат Ложь; КонецЕсли;
		Если Схема.Свойство("maximum") И Значение > Схема.maximum Тогда Возврат Ложь; КонецЕсли;
	ИначеЕсли ТипJSON = "boolean" Тогда
		Если ТипЗнч(Значение) <> Тип("Булево") Тогда Возврат Ложь; КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция LifecycleДатаISO(Значение)
	Если СтрДлина(Значение) <> 10 И СтрДлина(Значение) <> 19 Тогда Возврат Ложь; КонецЕсли;
	Для ИндексСимвола = 1 По СтрДлина(Значение) Цикл
		Допустимые = "0123456789";
		Если ИндексСимвола = 5 Или ИндексСимвола = 8 Тогда Допустимые = "-"; КонецЕсли;
		Если ИндексСимвола = 11 Тогда Допустимые = "T"; КонецЕсли;
		Если ИндексСимвола = 14 Или ИндексСимвола = 17 Тогда Допустимые = ":"; КонецЕсли;
		Если СтрНайти(Допустимые, Сред(Значение, ИндексСимвола, 1)) = 0 Тогда Возврат Ложь; КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ВстроенныйКонвертLifecycle(Аргументы, Ид = Неопределено, Код = "")
	Команда = Новый Структура("id,params", Ид, Аргументы);
	Возврат КонвертТестирования(Команда, Код);
КонецФункции

&НаКлиенте
Функция ВстроенныйСнимокLifecycle(Канал, Ид, Глубина = 0)
	Если Глубина > 8 Тогда ВызватьИсключение "operation_result_unavailable"; КонецЕсли;
	ЗаписьОперации = LifecycleПолучить(Канал, Ид);
	Если ТипЗнч(ЗаписьОперации.result) = Тип("Структура") Тогда
        Ответ = ЗаписьОперации.result.data;
        Ответ.operation_id = Ид; Ответ.request_id = ЗаписьОперации.request_id;
		ВстроенныйСрокСнимковLifecycle(Канал, Ответ, Глубина);
        Если Ответ.session_id = "" Тогда Ответ.session_id = Неопределено; КонецЕсли;
        Если ТипЗнч(Ответ.data) <> Тип("Структура") И Ответ.observed_at = Неопределено Тогда
            Ответ.data = Новый Структура("observation_unavailable_reason", "executor_returned_no_observation");
        КонецЕсли;
        Возврат Ответ;
    КонецЕсли;
	Аргументы = Новый Структура("request_id,session_id", ЗаписьОперации.request_id, ЗаписьОперации.context.session_id);
	Код = "";
	Если ЗаписьОперации.state = "unknown" Тогда Код = "connection_lost"; КонецЕсли;
	Если ЗаписьОперации.state = "result_expired" Тогда Код = "result_expired"; КонецЕсли;
	Ответ = ВстроенныйКонвертLifecycle(Аргументы, Ид, Код);
	Ответ.status = ?(ЗаписьОперации.state = "result_expired", "failed", ЗаписьОперации.state);
	Если Ответ.status = "unknown" Тогда Ответ.execution = "unknown"; Ответ.verification = "not_confirmed"; КонецЕсли;
	Прогресс = Неопределено;
	Если ЗаписьОперации.Свойство("progress", Прогресс) Тогда
		Прогресс.Вставить("operation_id", Ид); Прогресс.Вставить("sequence", ЗаписьОперации.event_seq);
		Прогресс.Вставить("scope", "intermediate_snapshot");
		Если ТипЗнч(Ответ.data) <> Тип("Структура") Тогда Ответ.data = Новый Структура; КонецЕсли;
		Ответ.data.Вставить("progress", Прогресс);
		Если Ответ.status <> "unknown" И Прогресс.completed_count > 0 Тогда Ответ.execution = "invoked"; КонецЕсли;
	КонецЕсли;
	Возврат Ответ;
КонецФункции

&НаКлиенте
Функция ВстроенныйВызовТестирования(ДанныеЗапроса, Инструмент, Аргументы)
	КонтекстЖурнала = Новый Структура("tool,params", Инструмент, Аргументы);
	ЖурналТестирования(КонтекстЖурнала, "command");
	Ответ = ВыполнитьВстроенныйВызовТестирования(ДанныеЗапроса, Инструмент, Аргументы);
	ЖурналТестирования(КонтекстЖурнала, "response", Ответ);
	Возврат Ответ;
КонецФункции

&НаКлиенте
Функция ВыполнитьВстроенныйВызовТестирования(ДанныеЗапроса, Инструмент, Аргументы)
	Попытка
		Схемы = СхемыТестированияLifecycle();
		Если Не Схемы.Свойство(Инструмент) Или Не СоответствуетСхемеLifecycle(Аргументы, Схемы[Инструмент]) Тогда
			Возврат ВстроенныйКонвертLifecycle(Новый Структура, , "invalid_params");
		КонецЕсли;
		Если ИспользоватьТочнуюАнонимизацию Тогда Возврат ВстроенныйКонвертLifecycle(Аргументы, , "operation_result_policy_not_ready"); КонецЕсли;
        Если ПерезапускАктивенИлиЗавершается() Или ЗакрытиеСессииВПроцессе Тогда
            Возврат ВстроенныйКонвертLifecycle(Аргументы, , "operation_store_unavailable");
        КонецЕсли;
		Если ОбщийLifecycle = Неопределено Тогда
			НастроитьОбщийLifecycle(РабочийКаталогДанныхПользователя() + "MCPToolkit/lifecycle", Новый ОписаниеОповещения("ВстроенныйЗависимостиLifecycle", ЭтаФорма), Истина);
		КонецЕсли;
        Если ОбщийLifecycle.initializing Тогда Возврат ВстроенныйКонвертLifecycle(Аргументы, , "operation_store_unavailable"); КонецЕсли;
        Если Не ОбщийLifecycle.adapter_prepared Тогда
            ВстроенныйЗависимостиLifecycle(ОбщийLifecycle.records);
            LifecycleКомпактировать(Истина);
            ОбщийLifecycle.adapter_prepared = Истина;
        КонецЕсли;
		Канал = "default";
		Если ДанныеЗапроса.query.Свойство("channel") Тогда
			ЗначенияКанала = ДанныеЗапроса.query.channel;
			Если ЗначенияКанала.Количество() <> 1 Тогда Возврат ВстроенныйКонвертLifecycle(Аргументы, , "invalid_params"); КонецЕсли;
			Канал = ЗначенияКанала[0];
			Если ПустаяСтрока(Канал) Или СтрДлина(Канал) > 64 Тогда Возврат ВстроенныйКонвертLifecycle(Аргументы, , "invalid_params"); КонецЕсли;
		КонецЕсли;
		Аргументы = LifecycleКопия(Аргументы);
		Действие = ""; Аргументы.Свойство("action", Действие);
		Если Не Аргументы.Свойство("timeout_ms") Тогда
			Аргументы.Вставить("timeout_ms", ?(Инструмент = "test_session", ?(Действие = "status", 0, ?(Действие = "start" Или Действие = "attach", 120000, 30000)), 30000));
		КонецЕсли;
		Если Инструмент = "test_inspect" И (Действие = "tree" Или Действие = "command_interface" Или Действие = "command_bars") Тогда
			Если Не Аргументы.params.Свойство("depth") Тогда Аргументы.params.Вставить("depth", 8); КонецЕсли;
			Если Не Аргументы.params.Свойство("max_nodes") Тогда Аргументы.params.Вставить("max_nodes", 1000); КонецЕсли;
		КонецЕсли;
		Если Инструмент = "test_table" Тогда
			Если Действие = "read" И Не Аргументы.params.Свойство("limit") Тогда Аргументы.params.Вставить("limit", 100); КонецЕсли;
			Если (Действие = "read" Или Действие = "find") И Не Аргументы.params.Свойство("allow_navigation") Тогда Аргументы.params.Вставить("allow_navigation", Ложь); КонецЕсли;
			Если Действие = "add" И Не Аргументы.params.Свойство("values") Тогда Аргументы.params.Вставить("values", Новый Массив); КонецЕсли;
		КонецЕсли;
		Сеанс = Неопределено; Аргументы.Свойство("session_id", Сеанс);
		Новая = Ложь;
        Контекст = Новый Структура("session_id", Сеанс);
        // Чтение существующей операции не создаёт новую команду/ключ в журнале.
        Если Инструмент = "test_session" И Действие = "status" И Аргументы.params.Свойство("operation_id") Тогда
            Снимок = ВстроенныйСнимокLifecycle(Канал, Аргументы.params.operation_id);
            Ключ = LifecycleХеш(ЗаписатьJSON2(Новый Структура("channel,request_id", Канал, Аргументы.request_id)));
            ПрежнийИд = ОбщийLifecycle.keys.Получить(Ключ);
            Если ПрежнийИд <> Неопределено Тогда
                // Совместимость с уже сохранёнными status и конфликты занятых ключей.
                Ид = LifecycleПринять(Канал, Аргументы.request_id, Инструмент, Аргументы, Контекст, Новая);
                Возврат ВстроенныйСнимокLifecycle(Канал, Ид);
            КонецЕсли;
            Ответ = ВстроенныйКонвертLifecycle(Аргументы, Аргументы.params.operation_id);
            Ответ.status = "succeeded";
            Ответ.data = Новый Структура("operation,observation_unavailable_reason", Снимок, "journal_read_only");
            Возврат Ответ;
        КонецЕсли;
        Ид = LifecycleПринять(Канал, Аргументы.request_id, Инструмент, Аргументы, Контекст, Новая);
        Если Новая Тогда
            Команда = Новый Структура("id,tool,params,_lifecycle_route", Ид, Инструмент, Аргументы, Новый Структура("address,channel", "embedded", Канал));
            Команда.Вставить("_test_log_command", Истина); // Запрос уже записан внешним обработчиком.
            Команда.Вставить("lifecycle_progress_version", 1);
            ОбщийLifecycle.queue.Добавить(Команда);
            ПодключитьОбработчикОжидания("ИсполнитьОчередьLifecycle", 0.25, Истина);
        КонецЕсли;
		Возврат ВстроенныйСнимокLifecycle(Канал, Ид);
	Исключение
		Код = "operation_store_unavailable";
		Для Каждого Имя Из СтрРазделить("request_conflict,permission_denied,operation_quota_exceeded,invalid_params,operation_result_unavailable", ",") Цикл
			Если СтрНайти(ОписаниеОшибки(), Имя) > 0 Тогда Код = Имя; КонецЕсли;
		КонецЦикла;
		Возврат ВстроенныйКонвертLifecycle(Аргументы, , Код);
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ИсполнитьОчередьLifecycle() Экспорт
	Если ОбщийLifecycle = Неопределено Или Не ОбщийLifecycle.healthy Или ОбщийLifecycle.queue.Количество() = 0 Тогда Возврат; КонецЕсли;
	Команда = ОбщийLifecycle.queue[0]; ОбщийLifecycle.queue.Удалить(0);
	Попытка
		ЗаписьОперации = LifecycleПолучить(Команда._lifecycle_route.channel, Команда.id);
		Если ЗаписьОперации.state = "queued" Тогда
			ЗаписьОперации.state = "running";
			LifecycleСохранить(ЗаписьОперации); // Барьер до любого вызова исполнителя.
			ПринятьПубличнуюКомандуТестирования(Команда);
		КонецЕсли;
	Исключение
		ОбщийLifecycle.healthy = Ложь; // Не исполняем и не повторяем после неоднозначной ошибки записи.
	КонецПопытки;
	Если ОбщийLifecycle.healthy И ОбщийLifecycle.queue.Количество() > 0 Тогда ПодключитьОбработчикОжидания("ИсполнитьОчередьLifecycle", 0.25, Истина); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВстроенныйСрокСнимковLifecycle(Канал, Снимок, Глубина)
    Если Глубина > 8 Тогда ВызватьИсключение "operation_result_unavailable"; КонецЕсли;
    Если ТипЗнч(Снимок.data) <> Тип("Структура") Или Не Снимок.data.Свойство("operation") Тогда Возврат; КонецЕсли;
    Вложенный = Снимок.data.operation;
    Если ТипЗнч(Вложенный) <> Тип("Структура") Или Не Вложенный.Свойство("contract_version") Тогда Возврат; КонецЕсли;
    ЗаписьОперации = LifecycleПолучить(Канал, Вложенный.operation_id);
    Если ЗаписьОперации.state = "result_expired" Тогда
        Снимок.data.operation = ВстроенныйСнимокLifecycle(Канал, Вложенный.operation_id, Глубина + 1);
    Иначе
        ВстроенныйСрокСнимковLifecycle(Канал, Вложенный, Глубина + 1);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВстроенныйЗависимостиLifecycle(Записи, ДополнительныеПараметры = Неопределено) Экспорт
    // Миграция старых сохранённых status: метаданные зависимостей принадлежат общему владельцу.
    Для Каждого Пара Из Записи Цикл
        ЗаписьОперации = Пара.Значение;
        Если ЗаписьОперации.tool <> "test_session" Или ЗаписьОперации.context.Свойство("result_dependencies") Тогда Продолжить; КонецЕсли;
        Если ТипЗнч(ЗаписьОперации.result) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
        Ответ = ЗаписьОперации.result.data;
        Если ТипЗнч(Ответ.data) <> Тип("Структура") Или Не Ответ.data.Свойство("operation") Тогда Продолжить; КонецЕсли;
        Вложенный = Ответ.data.operation;
        Если ТипЗнч(Вложенный) <> Тип("Структура") Или Не Вложенный.Свойство("contract_version") Тогда Продолжить; КонецЕсли;
        Зависимости = Новый Массив; Зависимости.Добавить(Вложенный.operation_id);
        ЗаписьОперации.context.Вставить("result_dependencies", Зависимости);
    КонецЦикла;
КонецПроцедуры
