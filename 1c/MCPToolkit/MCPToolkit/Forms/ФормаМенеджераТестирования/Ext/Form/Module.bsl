// Локальный клиентский драйвер TASK-012. Публичный transport/lifecycle - TASK-016.
// Профиль передаёт доверенный локальный адаптер, не аргументы внешней команды.
&НаКлиенте
Перем ТКИдентификаторМенеджера;
&НаКлиенте
Перем ТКПрофиль;
&НаКлиенте
Перем ТКПриложение;
&НаКлиенте
Перем ТКСостояние;
&НаКлиенте
Перем ТКПроцесс;
&НаКлиенте
Перем ТКВладелец;
&НаКлиенте
Перем ТКСеанс;
&НаКлиенте
Перем ТКОперация;
&НаКлиенте
Перем ТКСрок;
&НаКлиенте
Перем ТКОшибка;
&НаКлиенте
Перем ТКПерваяПроверка;
&НаКлиенте
Перем ТКОкна;
&НаКлиенте
Перем ТКДиалогОстановки;
&НаКлиенте
Перем ТКОчередьUI; // Только незавершённые шаги; результаты хранит общий lifecycle.
&НаКлиенте
Перем ТКШагUI;
&НаКлиенте
Перем ТКЦелиUI; // Живые ссылки, не сериализуются на сервер.
&НаКлиенте
Перем ТКПоколениеUI;
&НаКлиенте
Перем ТКТабличныйСнимок;
&НаКлиенте
Перем ТКДиагностика;

#Область ПрограммныйИнтерфейс

&НаКлиенте
Функция РежимМенеджера() Экспорт
	Попытка
		ТипПриложения = Тип("ТестируемоеПриложение");
		Возврат ТипПриложения <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Вызывается один раз владельцем формы. Секреты остаются только в памяти клиента.
&НаКлиенте
Процедура Настроить(Профиль) Экспорт
	Если ТКПрофиль <> Неопределено Тогда
		ВызватьИсключение "Профиль менеджера уже установлен";
	КонецЕсли;
	Если ТипЗнч(Профиль.port) <> Тип("Число") Или Профиль.port <> Цел(Профиль.port)
		Или Профиль.port < 1024 Или Профиль.port > 65535 Тогда
		ВызватьИсключение "Некорректный порт локального профиля";
	КонецЕсли;
	ТКПрофиль = Новый Структура;
	Для Каждого Поле Из Профиль Цикл
		ТКПрофиль.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	ТКСостояние = "absent";
	ТКДиагностика = Новый Структура("process_state,connection_stage,last_api_error,requested_endpoint,observed_endpoint",
		"Unknown", "not_started", Неопределено, Новый Структура("host,port", "localhost", Профиль.port), Неопределено);
	ТКСеанс = "";
	ТКВладелец = Ложь;
	ТКОшибка = Неопределено;
	// Незавершённый запуск переживает аварийное закрытие. Это receipt процесса,
	// не реестр операций: прежние operation_id и разрешения здесь не восстанавливаются.
	ФайлReceipt = Новый Файл(ТКПрофиль.receipt_path);
	Если ФайлReceipt.Существует() Тогда
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.ОткрытьФайл(ТКПрофиль.receipt_path);
			ТКПроцесс = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
			Если ТипЗнч(ТКПроцесс) <> Тип("Структура")
				Или Не ТКПроцесс.Свойство("pid") Или Не ТКПроцесс.Свойство("created")
				Или Не ТКПроцесс.Свойство("token") Тогда
				ВызватьИсключение "Повреждён receipt";
			КонецЕсли;
		Исключение
			ТКПроцесс = Новый Структура("pid,created,token", 0, "", "");
		КонецПопытки;
		ТКСостояние = "disconnected";
		ТКОшибка = ОшибкаДрайвера("connection_lost", "lifecycle",
			"Предыдущий менеджер завершён. Исход прежней операции неизвестен; требуется явное подключение.");
	КонецЕсли;
КонецПроцедуры

// operation_id выдаёт общий владелец lifecycle; драйвер хранит только текущий шаг.
&НаКлиенте
Функция МожноИзменитьПрофиль(Настройка) Экспорт
	Если ТКШагUI <> Неопределено Или (ТКОчередьUI <> Неопределено И ТКОчередьUI.Количество() > 0)
		Или (ТКОперация <> Неопределено И ТКОперация.status = "running") Тогда Возврат Ложь; КонецЕсли;
	Если Настройка.enabled И Настройка.id = ТКПрофиль.id
		И Настройка.user = ТКПрофиль.user И Настройка.port = ТКПрофиль.port Тогда Возврат Истина; КонецЕсли;
	Попытка
		Если ТКПроцесс <> Неопределено Тогда
			Если ПроцессЖив(ТКПроцесс) Или ТКДиагностика.process_state <> "Exited" Тогда Возврат Ложь; КонецЕсли;
		КонецЕсли;
		Если ПроцессПорта() <> Неопределено Тогда Возврат Ложь; КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ИзменитьПрофиль(Профиль) Экспорт
	Если Профиль.id = ТКПрофиль.id И Профиль.user = ТКПрофиль.user И Профиль.port = ТКПрофиль.port Тогда
		Если Не ПустаяСтрока(Профиль.password) Или Не Профиль.password_required Тогда
			ТКПрофиль.Вставить("password", Профиль.password);
		КонецЕсли;
		ТКПрофиль.Вставить("password_required", Профиль.password_required);
	Иначе
		ЗавершитьМенеджер();
		ТКПрофиль = Неопределено;
		ТКПроцесс = Неопределено;
		ТКЦелиUI = Неопределено;
		Настроить(Профиль);
	КонецЕсли;
КонецПроцедуры

// Разрешение проверяет вызывающий адаптер до обращения к этому внутреннему API.
&НаКлиенте
Функция ВыполнитьСеанс(Действие, ИдСеанса, ИдОперации, ТаймаутМс = 120000) Экспорт
	Если Действие = "status" Тогда
		Если ЗначениеЗаполнено(ИдСеанса) И ИдСеанса <> ТКСеанс Тогда
			Возврат ОтказДрайвера("session_invalid", "validation", "Сеанс устарел");
		КонецЕсли;
		Возврат СостояниеСеанса();
	КонецЕсли;
	Если ТКШагUI <> Неопределено Или (ТКОчередьUI <> Неопределено И ТКОчередьUI.Количество() > 0) Тогда
		Возврат ОтказДрайвера("session_not_ready", "lifecycle", "Выполняется команда интерфейса");
	КонецЕсли;
	Если ТипЗнч(ТаймаутМс) <> Тип("Число") Или ТаймаутМс < 0
		Или ТаймаутМс > 300000 Или ТаймаутМс <> Цел(ТаймаутМс) Тогда
		Возврат ОтказДрайвера("invalid_params", "validation", "Некорректный тайм-аут");
	КонецЕсли;
	Если Не ПоддерживаетсяПлатформа() Тогда
		Возврат ОтказДрайвера("unsupported_platform", "availability", "Требуется тонкий клиент Windows 8.5");
	КонецЕсли;
	Если Не РежимМенеджера() Тогда
		Возврат ОтказДрайвера("manager_mode_required", "availability", "Требуется /TESTMANAGER");
	КонецЕсли;
	Если ТКПрофиль = Неопределено Тогда
		Возврат ОтказДрайвера("session_not_ready", "availability", "Локальный профиль не настроен");
	КонецЕсли;
	Если Действие <> "start" И Действие <> "attach" И Действие <> "detach" И Действие <> "stop" Тогда
		Возврат ОтказДрайвера("invalid_params", "validation", "Неизвестное действие сеанса");
	КонецЕсли;
	Если (Действие = "stop" Или Действие = "detach")
		И (ПустаяСтрока(ИдСеанса) Или ИдСеанса <> ТКСеанс) Тогда
		Возврат ОтказДрайвера("session_invalid", "validation", "Сеанс устарел");
	КонецЕсли;
	Попытка
		Если Действие = "start" Или Действие = "attach" Тогда
			Возврат НачатьПодключение(Действие, ИдОперации, ТаймаутМс);
		ИначеЕсли Действие = "detach" Тогда
			Если ТКСостояние = "starting" Или ТКСостояние = "stopping" Тогда
				Возврат ОтказДрайвера("session_not_ready", "lifecycle", "Переход состояния ещё выполняется");
			КонецЕсли;
			ОтключитьAPI();
			ТКСостояние = "detached";
			ТКОшибка = Неопределено;
			ТКОперация = Новый Структура("id,status,execution,verification", ИдОперации, "succeeded", "invoked", "confirmed");
		Иначе
			Возврат ОстановитьКлиент(ИдОперации, ТаймаутМс);
		КонецЕсли;
	Исключение
		// Не выводим WMI CommandLine и профили: они могут содержать пароль.
		Если ТКДиагностика <> Неопределено И ТКДиагностика.process_state <> "Alive" Тогда
			ТКВладелец = Ложь;
			ОтключитьAPI();
			ТКСостояние = "disconnected";
		КонецЕсли;
		Возврат ОтказДрайвера("internal_error", "execute", "Не удалось выполнить действие менеджера; повтор не выполнялся");
	КонецПопытки;
	Возврат СостояниеСеанса();
КонецФункции

&НаКлиенте
Функция СостояниеСеанса() Экспорт
	Если ТКСостояние = Неопределено Тогда ТКСостояние = "absent"; КонецЕсли;
	Поддерживается = ПоддерживаетсяПлатформа();
	Информация = Новый СистемнаяИнформация;
	Результат = Новый Структура("state,session_id,owned,supported,manager_mode,platform_version,operation,error",
		ТКСостояние, ТКСеанс, ТКВладелец = Истина, Поддерживается, РежимМенеджера(),
		Информация.ВерсияПриложения, ТКОперация, ТКОшибка);
	Если Не Поддерживается Тогда
		Результат.error = ОшибкаДрайвера("unsupported_platform", "availability", "Требуется тонкий клиент Windows 8.5");
	КонецЕсли;
	Если ТКИдентификаторМенеджера = Неопределено Тогда ТКИдентификаторМенеджера = Строка(Новый УникальныйИдентификатор); КонецЕсли;
	Если ТКПрофиль <> Неопределено И ТКПрофиль.Свойство("base_id") Тогда
		Результат.Вставить("scenario_binding", Новый Структура("owner,base_id,profile_id,generation,implementation_revision,base_mode",
			ТКИдентификаторМенеджера, ТКПрофиль.base_id, ТКПрофиль.id, ТКСеанс, "scenario-context-v1", ТКПрофиль.base_mode));
	КонецЕсли;
	Результат.Вставить("process_known", ТКПроцесс <> Неопределено);
	Результат.Вставить("diagnostics", ТКДиагностика);
	Результат.Вставить("windows", ТКОкна);
	Если ТКДиалогОстановки <> Неопределено Тогда
		Результат.Вставить("blocking_window", ТКДиалогОстановки.data);
	КонецЕсли;
	Результат.Вставить("ui_operation_id", ?(ТКШагUI = Неопределено, Неопределено, ТКШагUI.result.operation_id));
	Результат.Вставить("ui_queue_length", ?(ТКОчередьUI = Неопределено, 0, ТКОчередьUI.Количество()));
	Результат.Вставить("observed_at", XMLСтрока(Дата(1, 1, 1) + Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() / 1000)) + "Z");
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ЗавершитьМенеджер() Экспорт
	ОтключитьОбработчикОжидания("ШагНаблюдения");
	ОтключитьAPI();
	ТКСеанс = "";
	ТКВладелец = Ложь;
	Если ТКОперация <> Неопределено И ТКОперация.status = "running" Тогда
		ТКОперация.status = "unknown";
		ТКОперация.verification = "not_confirmed";
	КонецЕсли;
	Если ТКПроцесс <> Неопределено Тогда ТКСостояние = "disconnected"; КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Исполнение

&НаКлиенте
Функция ПоддерживаетсяПлатформа()
	#Если ТонкийКлиент Тогда
		Информация = Новый СистемнаяИнформация;
		Возврат Лев(Информация.ВерсияПриложения, 4) = "8.5."
			И (Информация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Или Информация.ТипПлатформы = ТипПлатформы.Windows_x86);
	#Иначе
		Возврат Ложь;
	#КонецЕсли
КонецФункции

&НаКлиенте
Функция НачатьПодключение(Действие, ИдОперации, ТаймаутМс)
	ТребуетсяПароль = Ложь;
	Если Действие = "start" И ТКПрофиль.Свойство("password_required", ТребуетсяПароль) И ТребуетсяПароль Тогда
		Пароль = "";
		Если Не ТКПрофиль.Свойство("password", Пароль) Или ПустаяСтрока(Пароль) Тогда
			Возврат ОтказДрайвера("profile_credentials_required", "validation", "Введите пароль тест-клиента в локальных настройках Toolkit");
		КонецЕсли;
	КонецЕсли;
	Если ТКПрофиль.connection <> СтрокаСоединенияИнформационнойБазы() Тогда
		Возврат ОтказДрайвера("database_mismatch", "validation", "Профиль относится к другой базе");
	КонецЕсли;
	Если НРег(ТКПрофиль.exe) <> НРег(КаталогПрограммы() + "1cv8c.exe") Тогда
		Возврат ОтказДрайвера("unsupported_platform", "availability", "Клиент должен использовать ту же проверенную платформу, что и менеджер");
	КонецЕсли;
	Если ТКСостояние = "starting" Или ТКСостояние = "ready" Или ТКСостояние = "stopping" Тогда
		Возврат ОтказДрайвера("client_already_exists", "lifecycle", "Клиент уже занят");
	КонецЕсли;
	Если ТКПроцесс <> Неопределено И ТКПроцесс.pid <> 0 И Не ПроцессЖив(ТКПроцесс) Тогда
		ТКПроцесс = Неопределено;
		ТКВладелец = Ложь;
	КонецЕсли;
	Слушатель = ПроцессПорта();
	Если Действие = "start" Тогда
		Если ТКПроцесс <> Неопределено Или Слушатель <> Неопределено Тогда
			Возврат ОтказДрайвера("client_already_exists", "lifecycle", "Судьба прежнего клиента не позволяет новый запуск");
		КонецЕсли;
		ТКПроцесс = Новый Структура("pid,created,token", 0, "", Строка(Новый УникальныйИдентификатор));
		ТКСеанс = Строка(Новый УникальныйИдентификатор);
		ТКОперация = Новый Структура("id,status,execution,verification", ИдОперации, "running", "unknown", "not_requested");
		СохранитьReceipt(); // Барьер ДО запуска: при сбое после Create повтор запрещён.
		ТКСостояние = "starting";
		ТКВладелец = Ложь;
		Попытка
			ЗапуститьКлиент();
			СохранитьReceipt();
			ТКВладелец = Истина;
		Исключение
			ТКСостояние = "failed";
			ТКОперация.status = "unknown";
			ТКОперация.verification = "not_confirmed";
			Возврат ОтказДрайвера("internal_error", "execute", "Запуск не подтверждён; receipt сохранён, автоматического повтора нет");
		КонецПопытки;
	Иначе
		Если Слушатель = Неопределено Тогда
			Возврат ОтказДрайвера("session_not_ready", "resolve", "Клиент ещё не слушает настроенный порт");
		КонецЕсли;
		Если Не СовпадаетБазаПроцесса(Слушатель) Тогда
			Возврат ОтказДрайвера("database_mismatch", "resolve", "База процесса не подтверждена");
		КонецЕсли;
		Если ТКПроцесс <> Неопределено И ТКПроцесс.pid <> 0
			И (ТКПроцесс.pid <> Слушатель.pid Или ТКПроцесс.created <> Слушатель.created) Тогда
			Возврат ОтказДрайвера("client_already_exists", "resolve", "Порт принадлежит другому процессу");
		КонецЕсли;
		Если ТКПроцесс = Неопределено Или ТКПроцесс.pid = 0 Тогда
			ТКПроцесс = Новый Структура("pid,created,token", Слушатель.pid, Слушатель.created, "");
			ТКВладелец = Ложь;
		КонецЕсли;
		СохранитьReceipt(); // После restart неизвестный исход attach также запрещает второй запуск.
	КонецЕсли;
	ОтключитьAPI();
	ТКСеанс = Строка(Новый УникальныйИдентификатор);
	ТКОшибка = Неопределено;
	ТКСостояние = "starting";
	ТКОперация = Новый Структура("id,status,execution,verification", ИдОперации, "running", "invoked", "not_requested");
	ТКСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутМс;
	ТКПерваяПроверка = Истина;
	ШагНаблюдения();
	Возврат СостояниеСеанса();
КонецФункции

&НаКлиенте
Процедура ШагНаблюдения() Экспорт
	Попытка
		Если ТКПроцесс = Неопределено Тогда Возврат; КонецЕсли;
		// Ответ на диалог сам подтвердит завершение собственного процесса.
		Если ТКШагUI <> Неопределено И ТКШагUI.Свойство("stop_dialog_answer") Тогда
			ПодключитьОбработчикОжидания("ШагНаблюдения", 0.25, Истина);
			Возврат;
		КонецЕсли;
		Если (ТКСостояние = "starting" Или ТКСостояние = "stopping") И Не ТКПерваяПроверка
			И ТекущаяУниверсальнаяДатаВМиллисекундах() >= ТКСрок Тогда
			ТКСостояние = "failed";
			ТКОперация.status = "failed";
			ТКОперация.verification = "not_confirmed";
			ТКОшибка = ОшибкаДрайвера("action_not_confirmed", "verify", "Ожидание истекло; действие не повторялось");
			Возврат;
		КонецЕсли;
		ТКПерваяПроверка = Ложь;
		Если Не ПроцессЖив(ТКПроцесс) Тогда
			Если ТКСостояние = "stopping" Тогда
				ТКСостояние = "stopped";
				ТКОперация.status = "succeeded";
				ТКОперация.verification = "confirmed";
			Иначе
				ТКСостояние = "disconnected";
				ТКОшибка = ОшибкаДрайвера("connection_lost", "observe", "Процесс завершён");
				Если ТКОперация <> Неопределено И ТКОперация.status = "running" Тогда
					ТКОперация.status = "failed";
					ТКОперация.verification = "not_confirmed";
				КонецЕсли;
			КонецЕсли;
			ОтключитьAPI();
			ТКВладелец = Ложь;
			Возврат;
		КонецЕсли;
		Если ТКСостояние = "starting" Тогда
			ТКДиагностика.connection_stage = "endpoint_owner";
			Слушатель = ПроцессПорта();
			Если Слушатель <> Неопределено Тогда
				Если Слушатель.pid <> ТКПроцесс.pid Или Слушатель.created <> ТКПроцесс.created
					Или Не СовпадаетБазаПроцесса(Слушатель) Тогда
					ТКСостояние = "failed";
					ТКОшибка = ОшибкаДрайвера("database_mismatch", "resolve", "Идентичность клиента не подтверждена");
				Иначе
					Попытка
						Аргументы = Новый Массив;
						Аргументы.Добавить("localhost");
						Аргументы.Добавить(ТКПрофиль.port);
						ТКПриложение = Новый(Тип("ТестируемоеПриложение"), Аргументы);
						ТКДиагностика.connection_stage = "connect_api";
						ТКПриложение.УстановитьСоединение();
						ТКПриложение.УстановитьМаксимальноеВремяВыполненияДействия(1);
						ПослеПодключения = ПроцессПорта();
						Если ПослеПодключения = Неопределено Или ПослеПодключения.pid <> ТКПроцесс.pid
							Или ПослеПодключения.created <> ТКПроцесс.created Тогда
							ВызватьИсключение "endpoint_changed";
						КонецЕсли;
						ТКДиагностика.connection_stage = "observe_windows";
						НаблюдатьОкна();
						ТКДиагностика.connection_stage = "ready";
						ТКДиагностика.last_api_error = Неопределено;
						ТКСостояние = "ready";
						ТКОперация.status = "succeeded";
						ТКОперация.verification = "confirmed";
					Исключение
						// Без текста исключения: он может содержать локальный профиль/секреты.
						ТКДиагностика.last_api_error = Новый Структура("code,stage,observed_at",
							?(СтрНайти(ОписаниеОшибки(), "endpoint_changed") > 0, "endpoint_changed", "api_call_failed"), ТКДиагностика.connection_stage, ДатаНаблюденияUI());
						ОтключитьAPI();
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТКСостояние = "ready" Тогда
			// Продолжение команды само наблюдает переход окон. Проверка процесса выше сохраняется.
			Если ТКШагUI = Неопределено
				Или (Не ТКШагUI.Свойство("cell_choice") И Не ТКШагUI.Свойство("observation")) Тогда
				ТКДиагностика.connection_stage = "observe_windows";
				Попытка
					НаблюдатьОкна();
					ТКДиагностика.Вставить("consecutive_window_errors", 0);
					ТКДиагностика.connection_stage = "ready";
				Исключение
					Сбои = 0;
					ТКДиагностика.Свойство("consecutive_window_errors", Сбои);
					ТКДиагностика.Вставить("consecutive_window_errors", Сбои + 1);
					ТКОкна = Неопределено;
					Если Сбои >= 2 Тогда ВызватьИсключение; КонецЕсли;
				КонецПопытки;
			КонецЕсли;
		ИначеЕсли ТКСостояние = "stopping" Тогда
			Попытка
				НаблюдатьОкна();
				ОкнаПослеЗакрытия = ОкнаUI();
				Диалог = АктивныйДиалогUI(ОкнаПослеЗакрытия);
				Если Диалог <> Неопределено Тогда
					ТКДиалогОстановки = Новый Структура("data,ref", Диалог, ОкнаПослеЗакрытия.active);
					ТКСостояние = "ready";
					ТКОперация.status = "failed";
					ТКОперация.verification = "not_confirmed";
					ТКОшибка = ОшибкаДрайвера("blocking_window", "observe", "Клиент ожидает явного ответа в диалоге");
				КонецЕсли;
			Исключение
				// Закрывающийся процесс может разорвать API раньше фактического выхода.
				ТКОкна = Неопределено;
			КонецПопытки;
		КонецЕсли;
		Если (ТКСостояние = "starting" Или ТКСостояние = "stopping")
			И ТекущаяУниверсальнаяДатаВМиллисекундах() >= ТКСрок Тогда
			ТКСостояние = "failed";
			ТКОшибка = ОшибкаДрайвера("action_not_confirmed", "verify", "Ожидание истекло; процесс не завершался принудительно");
		КонецЕсли;
		Если ТКСостояние = "failed" И ТКОперация <> Неопределено Тогда
			ТКОперация.status = "failed";
			ТКОперация.verification = "not_confirmed";
		КонецЕсли;
	Исключение
		ТКСостояние = "disconnected";
		ОтключитьAPI();
		// Сбой наблюдения не отменяет факт собственного запуска в текущем менеджере.
		// После явного attach stop заново проверяет PID, время, базу и launch token.
		// После перезапуска менеджера владение по-прежнему не восстанавливается из receipt.
		ТКДиагностика.Вставить("last_connection_loss", Новый Структура("process_state,stage,observed_at",
			ТКДиагностика.process_state, ТКДиагностика.connection_stage, ДатаНаблюденияUI()));
		ТКОшибка = ОшибкаДрайвера("connection_lost", "observe", "Связь или сведения о процессе недоступны");
		Если ТКОперация <> Неопределено И ТКОперация.status = "running" Тогда
			ТКОперация.status = "unknown";
			ТКОперация.verification = "not_confirmed";
		КонецЕсли;
	КонецПопытки;
	Если ТКСостояние = "starting" Или ТКСостояние = "stopping" Или ТКСостояние = "ready" Тогда
		ПодключитьОбработчикОжидания("ШагНаблюдения", 0.25, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ОстановитьКлиент(ИдОперации, ТаймаутМс)
	Если Не ТКВладелец Или ТКПроцесс = Неопределено Или Не ПроцессЖив(ТКПроцесс) Тогда
		Возврат ОтказДрайвера("client_not_owned", "resolve", "Нет действующего доказательства владения");
	КонецЕсли;
	Слушатель = ПроцессПорта();
	Если Слушатель = Неопределено Или Слушатель.pid <> ТКПроцесс.pid
		Или Слушатель.created <> ТКПроцесс.created Или Не СовпадаетБазаПроцесса(Слушатель)
		Или СтрНайти(Слушатель.command, ТКПроцесс.token) = 0 Тогда
		Возврат ОтказДрайвера("client_not_owned", "resolve", "Процесс не совпадает с сохранённым запуском");
	КонецЕсли;
	Если ТКПриложение = Неопределено Или ТКСостояние <> "ready" Тогда
		Возврат ОтказДрайвера("session_not_ready", "availability", "Для штатного закрытия требуется готовое подключение");
	КонецЕсли;
	ОткрытыйДиалог = АктивныйДиалогUI(ОкнаUI());
	Если ОткрытыйДиалог <> Неопределено Тогда
		Отказ = ОтказДрайвера("blocking_window", "resolve", "Клиент ожидает явного ответа в открытом диалоге");
		Отказ.Вставить("blocking_window", ОткрытыйДиалог);
		Возврат Отказ;
	КонецЕсли;
	ТКДиалогОстановки = Неопределено;
	ОсновноеОкно = Неопределено;
	Для Каждого ОкноКлиента Из ТКПриложение.ПолучитьПодчиненныеОбъекты() Цикл
		Если ОкноКлиента.Основное Тогда
			Если ОсновноеОкно <> Неопределено Тогда
				Возврат ОтказДрайвера("ambiguous_target", "resolve", "Несколько основных окон");
			КонецЕсли;
			ОсновноеОкно = ОкноКлиента;
		КонецЕсли;
	КонецЦикла;
	Если ОсновноеОкно = Неопределено Тогда
		Возврат ОтказДрайвера("window_not_found", "resolve", "Основное окно недоступно");
	КонецЕсли;
	ТКОперация = Новый Структура("id,status,execution,verification", ИдОперации, "running", "invoked", "not_requested");
	ТКСостояние = "stopping";
	ТКСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутМс;
	ТКПерваяПроверка = Истина;
	Попытка
		ОсновноеОкно.Закрыть(); // Один вызов. Ответ на диалог — отдельная команда.
	Исключение
		// Закрытие может разорвать API до ответа. Исход устанавливается по процессу.
		ТКОперация.execution = "unknown";
	КонецПопытки;
	ШагНаблюдения();
	Возврат СостояниеСеанса();
КонецФункции

&НаКлиенте
Процедура ОтключитьAPI()
	ТКДиалогОстановки = Неопределено;
	СброситьИсполнительUI();
	Если ТКПриложение <> Неопределено Тогда
		Попытка
			ТКПриложение.РазорватьСоединение();
		Исключение
			// Локальная ссылка отзывается и при уже потерянном соединении.
			ТКПриложение = Неопределено;
		КонецПопытки;
	КонецЕсли;
	ТКПриложение = Неопределено;
	ТКОкна = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура НаблюдатьОкна()
	Попытка
		ТКОкна = СнимокОконКлиента();
	Исключение
		// Закрытие окна может сделать один элемент снимка неактуальным.
		// Повторяем только чтение, без переподключения или повтора UI-действия.
		Повторы = 0;
		Если Не ТКДиагностика.Свойство("window_read_retries", Повторы) Тогда Повторы = 0; КонецЕсли;
		ТКДиагностика.Вставить("window_read_retries", Повторы + 1);
		ТКОкна = СнимокОконКлиента();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция СнимокОконКлиента()
	Окна = Новый Массив;
	Для Каждого ОкноКлиента Из ТКПриложение.ПолучитьПодчиненныеОбъекты() Цикл
		Окна.Добавить(Новый Структура("title,main", ОкноКлиента.Заголовок, ОкноКлиента.Основное));
		Если Окна.Количество() >= 20 Тогда Прервать; КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("items,truncated,observed_at", Окна, Окна.Количество() >= 20,
		XMLСтрока(Дата(1, 1, 1) + Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() / 1000)) + "Z");
КонецФункции

#КонецОбласти

#Область ПроцессыWindows

&НаКлиенте
Функция СлужбаWMI(Пространство = "root\cimv2")
	Если Не ПоддерживаетсяПлатформа() Тогда
		ВызватьИсключение "WMI доступен только в поддержанном клиенте Windows";
	КонецЕсли;
	// Проверка Windows выполняется выше; COM здесь является намеренным адаптером ОС.
	// BSLLS:UsingObjectNotAvailableUnix-off
	Локатор = Новый COMОбъект("WbemScripting.SWbemLocator");
	// BSLLS:UsingObjectNotAvailableUnix-on
	Возврат Локатор.ConnectServer(".", Пространство);
КонецФункции

&НаКлиенте
Функция ДанныеПроцесса(ИдПроцесса)
	Служба = СлужбаWMI();
	Для Каждого Процесс Из Служба.ExecQuery("SELECT ProcessId,CreationDate,CommandLine,ExecutablePath FROM Win32_Process WHERE ProcessId="
		+ Формат(ИдПроцесса, "ЧГ=0")) Цикл
		Возврат Новый Структура("pid,created,command,exe", Процесс.ProcessId, Процесс.CreationDate, Процесс.CommandLine, Процесс.ExecutablePath);
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ПроцессЖив(Доказательство)
	ТКДиагностика.process_state = "Unknown";
	Если Доказательство.pid = 0 Тогда ВызватьИсключение "Идентичность процесса неизвестна"; КонецЕсли;
	Попытка
		Данные = ДанныеПроцесса(Доказательство.pid);
	Исключение
		Текст = НРег(ОписаниеОшибки());
		Если СтрНайти(Текст, "80041003") > 0 Или СтрНайти(Текст, "80070005") > 0 Тогда
			ТКДиагностика.process_state = "AccessDenied";
		КонецЕсли;
		ВызватьИсключение "Состояние процесса недоступно";
	КонецПопытки;
	Если Данные = Неопределено Тогда
		ТКДиагностика.process_state = "Exited"; Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Данные.created) Тогда ВызватьИсключение "Время запуска процесса недоступно"; КонецЕсли;
	Если Данные.created <> Доказательство.created Тогда
		ТКДиагностика.process_state = "StartTimeMismatch";
		// Только подтверждённый Exited разрешает завершить stop или повторный start.
		ВызватьИсключение "Идентичность процесса изменилась";
	КонецЕсли;
	ТКДиагностика.process_state = "Alive";
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ПроцессПорта()
	Служба = СлужбаWMI("root\StandardCimv2");
	Результат = Неопределено;
	ТКДиагностика.observed_endpoint = Неопределено;
	Для Каждого Соединение Из Служба.ExecQuery("SELECT OwningProcess FROM MSFT_NetTCPConnection WHERE State=2 AND LocalPort="
		+ Формат(ТКПрофиль.port, "ЧГ=0")) Цикл
		Если Результат <> Неопределено И Результат.pid <> Соединение.OwningProcess Тогда
			ВызватьИсключение "Неоднозначный владелец порта";
		КонецЕсли;
		Результат = ДанныеПроцесса(Соединение.OwningProcess);
		ТКДиагностика.observed_endpoint = Новый Структура("port,process_id", ТКПрофиль.port, Соединение.OwningProcess);
		Если Результат = Неопределено Тогда ВызватьИсключение "Владелец endpoint недоступен"; КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция АргументЗапуска(Значение)
	Если СтрНайти(Значение, Символы.ПС) > 0 Или СтрНайти(Значение, Символы.ВК) > 0 Тогда
		ВызватьИсключение "Недопустимый перевод строки в профиле";
	КонецЕсли;
	Возврат """" + СтрЗаменить(Значение, """", """""") + """";
КонецФункции

&НаКлиенте
Функция СовпадаетБазаПроцесса(Данные)
	// Принимается только однозначный формат локального профиля, без /F, /S, /IBName.
	// Неизвестный формат не считается другой базой доказанно, но готовность запрещена.
	ОжидаемыйПрефикс = АргументЗапуска(ТКПрофиль.exe) + " ENTERPRISE /IBConnectionString "
		+ АргументЗапуска(ТКПрофиль.connection) + " /TESTCLIENT -TPort" + Формат(ТКПрофиль.port, "ЧГ=0") + " ";
	Возврат НРег(Данные.exe) = НРег(ТКПрофиль.exe)
		И Лев(Данные.command, СтрДлина(ОжидаемыйПрефикс)) = ОжидаемыйПрефикс
		И СтрНайти(НРег(" " + Сред(Данные.command, СтрДлина(ОжидаемыйПрефикс) + 1)), " /ib") = 0
		И СтрНайти(НРег(Данные.command), " /f") = 0
		И СтрНайти(НРег(Данные.command), " /s") = 0;
КонецФункции

&НаКлиенте
Процедура ЗапуститьКлиент()
	Команда = АргументЗапуска(ТКПрофиль.exe) + " ENTERPRISE /IBConnectionString "
		+ АргументЗапуска(ТКПрофиль.connection) + " /TESTCLIENT -TPort" + Формат(ТКПрофиль.port, "ЧГ=0")
		+ " /N " + АргументЗапуска(ТКПрофиль.user) + " /C " + АргументЗапуска("toolkit-test-" + ТКПроцесс.token)
		+ " /DisableStartupDialogs /DisableStartupMessages";
	Пароль = "";
	Если ТКПрофиль.Свойство("password", Пароль) И Не ПустаяСтрока(Пароль) Тогда
		Команда = Команда + " /P " + АргументЗапуска(Пароль);
	КонецЕсли;
	Служба = СлужбаWMI();
	Класс = Служба.Get("Win32_Process");
	ПараметрыСоздания = Класс.Methods_.Item("Create").InParameters.SpawnInstance_();
	ПараметрыСоздания.CommandLine = Команда;
	ПараметрыОкна = Служба.Get("Win32_ProcessStartup").SpawnInstance_();
	ПараметрыОкна.ShowWindow = 0;
	ПараметрыСоздания.ProcessStartupInformation = ПараметрыОкна;
	Итог = Класс.ExecMethod_("Create", ПараметрыСоздания);
	Если Итог.ReturnValue <> 0 Тогда ВызватьИсключение "Не удалось создать клиент"; КонецЕсли;
	Данные = ДанныеПроцесса(Итог.ProcessId);
	Если Данные = Неопределено Тогда ВызватьИсключение "Запущенный процесс недоступен"; КонецЕсли;
	ТКПроцесс.pid = Данные.pid;
	ТКПроцесс.created = Данные.created;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьReceipt()
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ТКПрофиль.receipt_path);
	ЗаписатьJSON(Запись, ТКПроцесс);
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти

#Область Диагностика

&НаКлиенте
Функция ОшибкаДрайвера(Код, Стадия, Сообщение)
	Возврат Новый Структура("code,stage,message,details", Код, Стадия, Сообщение, Новый Структура);
КонецФункции

&НаКлиенте
Функция ОтказДрайвера(Код, Стадия, Сообщение)
	Результат = СостояниеСеанса();
	Результат.error = ОшибкаДрайвера(Код, Стадия, Сообщение);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ИсполнительUI

// Внутренний интерфейс TASK-013. Адаптер lifecycle передаёт выданный operation_id
// и callback публикации. Внешняя регистрация, разрешения и анонимизация - TASK-016.
&НаКлиенте
Функция ПринятьКомандуUI(Инструмент, Аргументы, ИдОперации, Оповещение = Неопределено, КомандаLifecycle = Неопределено) Экспорт
	Если ТКОчередьUI = Неопределено Тогда ТКОчередьUI = Новый Массив; КонецЕсли;
	Если ТКЦелиUI = Неопределено Тогда ИнвалидироватьЦелиUI(); КонецЕсли;
	Результат = Новый Структура("contract_version,request_id,operation_id,session_id,status,execution,verification,observed_at,observed_state,data,messages,error",
		"1", Неопределено, ИдОперации, ТКСеанс, "queued", "not_started", "not_requested",
		Неопределено, Неопределено, Неопределено, Новый Массив, Неопределено);
	Попытка
		ПроверитьАргументыUI(Инструмент, Аргументы);
		Результат.request_id = Аргументы.request_id;
		Если Не ПоддерживаетсяПлатформа() Тогда ОшибкаUI("unsupported_platform"); КонецЕсли;
		Если Аргументы.session_id <> ТКСеанс Тогда ОшибкаUI("session_invalid"); КонецЕсли;
		Если ТКСостояние <> "ready" Тогда ОшибкаUI("session_not_ready"); КонецЕсли;
		Если ТКОчередьUI.Количество() >= 100 Тогда ОшибкаUI("session_not_ready"); КонецЕсли;
		// Снимок входа: вызывающая сторона не может изменить уже поставленный шаг.
		Копия = КопияJSONUI(Аргументы);
		Таймаут = 30000;
		Если Копия.Свойство("timeout_ms") Тогда Таймаут = Копия.timeout_ms; КонецЕсли;
		Шаг = Новый Структура("tool,args,result,callback,deadline,started,first,zero",
			Инструмент, Копия, Результат, Оповещение,
			ТекущаяУниверсальнаяДатаВМиллисекундах() + Таймаут, 0, Истина, Таймаут = 0);
		Шаг.Вставить("last_confirmed_step", Неопределено);
		Шаг.Вставить("confirmed_count", 0);
		Шаг.Вставить("progress_seq", 2); Шаг.Вставить("progress_at", 0);
		Шаг.Вставить("progress_count", -1); Шаг.Вставить("progress_phase", "");
		Шаг.Вставить("permission_state", "new");
		Шаг.Вставить("permission_token", Строка(Новый УникальныйИдентификатор));
		Шаг.Вставить("permission_form", Неопределено);
		Шаг.Вставить("permission_command", Новый Структура("tool,params", Инструмент, Новый Структура("tool,args", Инструмент, Копия)));
		Если КомандаLifecycle <> Неопределено Тогда
			Шаг.permission_command.Вставить("id", ИдОперации);
			Шаг.permission_command.Вставить("_lifecycle_route", КомандаLifecycle._lifecycle_route);
			ВерсияПрогресса = Неопределено;
			Если КомандаLifecycle.Свойство("lifecycle_progress_version", ВерсияПрогресса) И ВерсияПрогресса = 1 Тогда
				Шаг.permission_command.Вставить("lifecycle_progress_version", 1);
			КонецЕсли;
		КонецЕсли;
		Шаг.Вставить("permission_consumed", Ложь);
		ТКОчередьUI.Добавить(Шаг);
		ПодключитьОбработчикОжидания("ВыполнитьШагUI", 0.25, Истина);
	Исключение
		Результат.status = "failed";
		Результат.verification = "not_confirmed";
		Результат.error = ОшибкаДрайвера(КодИсключенияUI(ОписаниеОшибки()), "validation", "Команда интерфейса не принята");
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВыполнитьШагUI() Экспорт
	Если ТКШагUI = Неопределено Тогда
		Если ТКОчередьUI = Неопределено Или ТКОчередьUI.Количество() = 0 Тогда Возврат; КонецЕсли;
		ТКШагUI = ТКОчередьUI[0];
		ТКОчередьUI.Удалить(0);
		ТКШагUI.started = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ТКШагUI.result.status = "running";
	КонецЕсли;
	Шаг = ТКШагUI;
	Попытка
		Если Шаг.args.session_id <> ТКСеанс Тогда ОшибкаUI("session_invalid"); КонецЕсли;
		Если ТКСостояние <> "ready" Тогда ОшибкаUI("session_not_ready"); КонецЕсли;
		Если Не Шаг.Свойство("observation") И (Не Шаг.first Или Не Шаг.zero)
			И ТекущаяУниверсальнаяДатаВМиллисекундах() >= Шаг.deadline Тогда
			ОшибкаUI("expectation_timeout");
		КонецЕсли;
		Шаг.first = Ложь;
		Если Не Шаг.Свойство("observation") И Не ПодготовитьРазрешениеUI(Шаг) Тогда
			ПодключитьОбработчикОжидания("ВыполнитьШагUI", 0.25, Истина);
			Возврат;
		КонецЕсли;
		Если Не Шаг.Свойство("diagnostic_before") Тогда Шаг.Вставить("diagnostic_before", СнимокДиагностикиUI()); КонецЕсли;
		Если Шаг.progress_seq = 2 Тогда ОпубликоватьПрогрессUI(Шаг, "executing"); КонецЕсли;
		Если Шаг.Свойство("observation") Тогда
			Если Не ПродолжитьНаблюдениеДействияUI(Шаг) Тогда
				ПодключитьОбработчикОжидания("ВыполнитьШагUI", 0.25, Истина);
				Возврат;
			КонецЕсли;
			Шаг.Удалить("observation");
		ИначеЕсли Шаг.tool = "test_open" Тогда
			НачатьОткрытиеUI(Шаг);
		ИначеЕсли Шаг.tool = "test_inspect" Тогда
			Шаг.result.data = ПрочитатьUI(Шаг.args);
		ИначеЕсли Шаг.tool = "test_input" Тогда
			ВыполнитьВводUI(Шаг);
			Если Шаг.Свойство("cell_choice") Тогда
				ПодключитьОбработчикОжидания("ВыполнитьШагUI", 0.25, Истина);
				Возврат;
			КонецЕсли;
		ИначеЕсли Шаг.tool = "test_table" Тогда
			ВыполнитьТаблицуUI(Шаг);
		ИначеЕсли Шаг.tool = "test_action" Тогда
			ВыполнитьДействиеUI(Шаг);
		Иначе
			Шаг.result.data = ПроверитьУсловиеUI(Шаг.args);
			Шаг.result.data.Вставить("elapsed_ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - Шаг.started);
			Если Не Шаг.result.data.matched Тогда
				ОпубликоватьПрогрессUI(Шаг, "waiting");
				Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Шаг.deadline Тогда ОшибкаUI("expectation_timeout"); КонецЕсли;
				ПодключитьОбработчикОжидания("ВыполнитьШагUI", 0.25, Истина);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Если Шаг.Свойство("observation") Тогда
			ПодключитьОбработчикОжидания("ВыполнитьШагUI", 0.25, Истина);
			Возврат;
		КонецЕсли;
		Если Шаг.tool = "test_inspect" Тогда
			Шаг.result.data.Вставить("coverage", ОхватInspectUI(Шаг.args.action, Шаг.result.data, Истина));
		КонецЕсли;
		Если РазмерJSONUI(Шаг.result.data) > 982912 Тогда
			Шаг.result.data = Новый Структура("complete,truncated,reason", Ложь, Истина, "response_size_limit");
			ОшибкаUI("value_unavailable");
		КонецЕсли;
		Шаг.result.status = "succeeded";
		Шаг.result.verification = "confirmed";
	Исключение
		Код = КодИсключенияUI(ОписаниеОшибки());
		Шаг.result.status = ?(Шаг.result.execution = "unknown", "unknown", "failed");
		Шаг.result.verification = "not_confirmed";
		Шаг.result.error = ОшибкаДрайвера(Код, "observe", "Команда не подтверждена; изменяющее действие не повторялось");
		Если Шаг.tool = "test_table" Или (Шаг.tool = "test_action" И ВСпискеUI(Шаг.args.action, "expand,collapse")) Тогда
			Причина = ИнформацияОбОшибке();
			Шаг.result.error.details.Вставить("module_line", Причина.НомерСтроки);
		КонецЕсли;
		СтадияДиагностики = Неопределено;
		Если Шаг.Свойство("diagnostic_stage", СтадияДиагностики) Тогда Шаг.result.error.stage = СтадияДиагностики; КонецЕсли;
		Если Код = "permission_denied" Тогда Шаг.result.error.stage = "permission"; КонецЕсли;
	КонецПопытки;
	Шаг.result.observed_at = ДатаНаблюденияUI();
	Если Шаг.tool = "test_expect" И Шаг.result.data <> Неопределено Тогда
		Шаг.result.data.Вставить("elapsed_ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - Шаг.started);
	КонецЕсли;
	Если Шаг.result.data = Неопределено Тогда
		Шаг.result.data = Новый Структура("observation_unavailable_reason", "command_failed_before_observation");
	КонецЕсли;
	Если Шаг.tool = "test_inspect" Тогда
		Шаг.result.data.Вставить("coverage", ОхватInspectUI(Шаг.args.action, Шаг.result.data, Шаг.result.status = "succeeded"));
	КонецЕсли;
	ДополнитьДиагностикуUI(Шаг);
	Шаг.result.observed_state = Новый Структура("state,session_id", ТКСостояние, ТКСеанс);
	ТКШагUI = Неопределено;
	Если Шаг.Свойство("disconnect_after_observation") Тогда ОтключитьAPI(); КонецЕсли;
	Если Шаг.permission_form <> Неопределено Тогда
		Попытка
			Шаг.permission_form.Закрыть();
		Исключение
			Шаг.result.data.Вставить("permission_dialog_close_failed", Истина);
		КонецПопытки;
	КонецЕсли;
	ОпубликоватьUI(Шаг);
	Если ТКОчередьUI.Количество() > 0 Тогда ПодключитьОбработчикОжидания("ВыполнитьШагUI", 0.25, Истина); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачатьОткрытиеUI(Шаг)
	ОкноЦель = РазрешитьОкноUI(Шаг.args.window);
	Ссылка = Шаг.args.params.link;
	Шаг.result.data = Новый Структура("windows,link,completed_steps", Новый Массив, Ссылка, Новый Массив);
	Варианты = Новый Массив;
	Если Лев(Ссылка, 16) = "e1cib/app/Отчет." И СтрРазделить(Сред(Ссылка, 11), ".").Количество() = 2 Тогда
		Варианты = СсылкиВариантовОтчетаUI(Сред(Ссылка, 11));
	КонецЕсли;
	Если Не Шаг.zero И ТекущаяУниверсальнаяДатаВМиллисекундах() >= Шаг.deadline Тогда ОшибкаUI("expectation_timeout"); КонецЕсли;
	ПередИзменениемUI(Шаг);
	ОкноЦель.ref.ВыполнитьКоманду(Ссылка);
	ИзменениеЗавершеноUI(Шаг, "open");
	Шаг.Вставить("open_report_variants", Варианты);
	НачатьНаблюдениеДействияUI(Шаг, "open");
КонецПроцедуры

&НаСервереБезКонтекста
Функция СсылкиВариантовОтчетаUI(ИмяОтчета)
	Ссылки = Новый Массив;
	Если Метаданные.НайтиПоПолномуИмени(ИмяОтчета) = Неопределено
		Или Метаданные.Справочники.Найти("ВариантыОтчетов") = Неопределено Тогда Возврат Ссылки; КонецЕсли;
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 501 Варианты.Ссылка ИЗ Справочник.ВариантыОтчетов КАК Варианты
		| ГДЕ Варианты.Отчет.ПолноеИмя = &Имя");
		Запрос.УстановитьПараметр("Имя", ИмяОтчета);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Ссылки.Количество() >= 500 Тогда Возврат Новый Массив; КонецЕсли;
			Ссылки.Добавить(ПолучитьНавигационнуюСсылку(Выборка.Ссылка));
		КонецЦикла;
	Исключение
		// Не все конфигурации используют идентификатор метаданных в варианте.
		Возврат Новый Массив;
	КонецПопытки;
	Возврат Ссылки;
КонецФункции

&НаКлиенте
Функция ОткрытиеПодтвержденоUI(Шаг, Окна)
	Ссылка = Шаг.args.params.link;
	Совпадения = 0;
	Для Каждого ДанныеОкна Из Окна.data Цикл
		Если ТочноРавныUI(ДанныеОкна.navigation_link, Ссылка)
			Или ФормаСоответствуетПрикладнойСсылкеUI(ДанныеОкна.form_name, Ссылка)
			Или (ДанныеОкна.active И (Шаг.open_report_variants.Найти(ДанныеОкна.navigation_link) <> Неопределено
				Или ФормаСоответствуетСпискуUI(ДанныеОкна.form_name, Ссылка))) Тогда
			Совпадения = Совпадения + 1;
			Шаг.result.data.Вставить("opened_window", ДанныеОкна);
		КонецЕсли;
	КонецЦикла;
	Если Совпадения <> 1 Тогда Шаг.result.data.Удалить("opened_window"); КонецЕсли;
	Возврат Совпадения = 1;
КонецФункции

&НаКлиенте
Функция ФормаСоответствуетСпискуUI(ИмяФормы, Ссылка)
	Если Лев(Ссылка, 11) <> "e1cib/list/" Тогда Возврат Ложь; КонецЕсли;
	Части = СтрРазделить(Сред(Ссылка, 12), ".");
	Если Части.Количество() <> 2 Или Не ВСпискеUI(Части[0], "Справочник,Документ,РегистрСведений") Тогда Возврат Ложь; КонецЕсли;
	Префикс = Сред(Ссылка, 12) + ".Форма.";
	Возврат ТочноРавныUI(Лев(ИмяФормы, СтрДлина(Префикс)), Префикс);
КонецФункции

&НаКлиенте
Функция ФормаСоответствуетПрикладнойСсылкеUI(ИмяФормы, Ссылка)
	Если ПустаяСтрока(ИмяФормы) Тогда Возврат Ложь; КонецЕсли;
	Если ТочноРавныUI("e1cib/app/" + ИмяФормы, Ссылка) Тогда Возврат Истина; КонецЕсли;
	Если Лев(Ссылка, 10) <> "e1cib/app/" Тогда Возврат Ложь; КонецЕсли;
	ПолноеИмя = Сред(Ссылка, 11);
	Части = СтрРазделить(ПолноеИмя, ".", Истина);
	// Ссылка объекта открывает его основную форму, чье полное имя длиннее ссылки.
	// Только точная принадлежность метаданных; заголовок окна не используется.
	Если Части.Количество() <> 2 Или ПустаяСтрока(Части[1]) Тогда Возврат Ложь; КонецЕсли;
	Если Не ВСпискеUI(Части[0], "Отчет,Обработка") Тогда Возврат Ложь; КонецЕсли;
	Префикс = ПолноеИмя + ".Форма.";
	Возврат ТочноРавныUI(Лев(ИмяФормы, СтрДлина(Префикс)), Префикс);
КонецФункции

&НаКлиенте
Процедура СброситьИсполнительUI()
	ОтключитьОбработчикОжидания("ВыполнитьШагUI");
	ИнвалидироватьЦелиUI();
	Если ТКОчередьUI = Неопределено Тогда ТКОчередьUI = Новый Массив; КонецЕсли;
	Если ТКШагUI <> Неопределено Тогда
		ТКШагUI.result.status = "unknown";
		ТКШагUI.result.verification = "not_confirmed";
		ТКШагUI.result.error = ОшибкаДрайвера("connection_lost", "lifecycle", "Соединение отозвано");
		ТКОчередьUI.Вставить(0, ТКШагUI);
		ТКШагUI = Неопределено;
	КонецЕсли;
	Очередь = ТКОчередьUI;
	ТКОчередьUI = Новый Массив;
	Для Каждого Шаг Из Очередь Цикл
		Если Шаг.result.status <> "unknown" Тогда
			Шаг.result.status = "failed";
			Шаг.result.verification = "not_confirmed";
			Шаг.result.error = ОшибкаДрайвера("session_invalid", "lifecycle", "Сеанс отозван до выполнения");
		КонецЕсли;
		ОпубликоватьUI(Шаг);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОпубликоватьUI(Шаг)
	Если Шаг.callback = Неопределено Тогда Возврат; КонецЕсли;
	Попытка
		ВыполнитьОбработкуОповещения(Шаг.callback, Шаг.result);
	Исключение
		// Ошибка доставки результата не разрешает повтор UI-действия.
		Шаг.result.error = ОшибкаДрайвера("internal_error", "lifecycle", "Ошибка публикации результата");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ИнвалидироватьЦелиUI()
	ТКТабличныйСнимок = Неопределено;
	ТКЦелиUI = Новый Соответствие;
	ТКПоколениеUI = Строка(Новый УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Функция ЗарегистрироватьЦельUI(Ссылка, Вид, ОкноВладелец = Неопределено, Область = "form_tree")
	Если ТКЦелиUI.Количество() >= 10000 Тогда ОшибкаUI("incomplete_search"); КонецЕсли;
	Для Каждого Пара Из ТКЦелиUI Цикл
		Если Пара.Значение.ref = Ссылка И Пара.Значение.kind = Вид
			И Пара.Значение.window = ОкноВладелец И Пара.Значение.scope = Область Тогда Возврат Пара.Ключ; КонецЕсли;
	КонецЦикла;
	Ид = Строка(Новый УникальныйИдентификатор);
	ТКЦелиUI.Вставить(Ид, Новый Структура("ref,kind,window,session,generation,scope",
		Ссылка, Вид, ОкноВладелец, ТКСеанс, ТКПоколениеUI, Область));
	Возврат Ид;
КонецФункции

&НаКлиенте
Функция ЦельПоИдUI(Ид, Вид)
	Цель = ТКЦелиUI.Получить(Ид);
	Если Цель = Неопределено Тогда ОшибкаUI("stale_target"); КонецЕсли;
	Если Цель.session <> ТКСеанс Или Цель.generation <> ТКПоколениеUI Или Цель.kind <> Вид Тогда ОшибкаUI("stale_target"); КонецЕсли;
	// Не подбираем новую цель по прежнему имени. Обращаемся к сохранённому объекту.
	Попытка
		Если Вид = "window" Тогда
			ЗаголовокЦели = Цель.ref.Заголовок;
		ИначеЕсли Цель.scope = "command_interface" Тогда
			ЗаголовокЦели = Цель.ref.ТекстЗаголовка;
		Иначе
			ДоступностьЦели = Цель.ref.ТекущаяДоступность();
		КонецЕсли;
	Исключение
		ОшибкаUI("stale_target");
	КонецПопытки;
	Возврат Цель;
КонецФункции

