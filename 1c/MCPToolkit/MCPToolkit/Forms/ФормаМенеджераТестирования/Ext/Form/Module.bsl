&НаКлиенте
Функция РазрешитьОкноUI(Адрес)
	Если Адрес.Свойство("id") Тогда
		Цель = ЦельПоИдUI(Адрес.id, "window");
		Найдено = Ложь;
		Для Каждого ЖивоеОкно Из ТКПриложение.ПолучитьПодчиненныеОбъекты() Цикл
			Если ЖивоеОкно = Цель.ref Тогда Найдено = Истина; КонецЕсли;
		КонецЦикла;
		Если Не Найдено Тогда ОшибкаUI("stale_target"); КонецЕсли;
		Возврат Цель;
	КонецЕсли;
	Список = ОкнаUI();
	Кандидаты = Новый Массив;
	Для Индекс = 0 По Список.data.Количество() - 1 Цикл
		Данные = Список.data[Индекс];
		Совпадает = Истина;
		Если Адрес.Свойство("active") Тогда
			Совпадает = Данные.active;
		Иначе
			Для Каждого Пара Из Адрес.selector Цикл
				Если Данные[Пара.Ключ] = Неопределено Тогда ОшибкаUI("incomplete_search"); КонецЕсли;
				Если Не ТочноРавныUI(Данные[Пара.Ключ], Пара.Значение) Тогда Совпадает = Ложь; КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Совпадает Тогда Кандидаты.Добавить(Список.refs[Индекс]); КонецЕсли;
	КонецЦикла;
	Если Кандидаты.Количество() <> 1 Тогда
		ЗапомнитьКандидатовUI(Список.data, "window", Кандидаты.Количество());
		ОшибкаUI(?(Кандидаты.Количество() = 0, "window_not_found", "ambiguous_target"));
	КонецЕсли;
	Возврат Новый Структура("ref", Кандидаты[0]);
КонецФункции

&НаКлиенте
Функция ТипЭлементаUI(Ссылка)
	ТипСсылки = ТипЗнч(Ссылка);
	Если ТипСсылки = Тип("ТестируемыйКомандныйИнтерфейсОкна") Тогда Возврат "command_interface"; КонецЕсли;
	Если ТипСсылки = Тип("ТестируемаяГруппаКомандногоИнтерфейса") Тогда Возврат "command_group"; КонецЕсли;
	Если ТипСсылки = Тип("ТестируемаяКнопкаКомандногоИнтерфейса") Тогда Возврат "command_button"; КонецЕсли;
	Если ТипСсылки = Тип("ТестируемаяФорма") Тогда Возврат "form"; КонецЕсли;
	Если ТипСсылки = Тип("ТестируемаяГруппаФормы") Тогда Возврат "group"; КонецЕсли;
	Если ТипСсылки = Тип("ТестируемоеПолеФормы") Тогда Возврат "field"; КонецЕсли;
	Если ТипСсылки = Тип("ТестируемаяКнопкаФормы") Тогда Возврат "button"; КонецЕсли;
	Если ТипСсылки = Тип("ТестируемаяТаблицаФормы") Тогда Возврат "table"; КонецЕсли;
	Если ТипСсылки = Тип("ТестируемаяДекорацияФормы") Тогда Возврат "decoration"; КонецЕсли;
	Возврат "unsupported";
КонецФункции

&НаКлиенте
Функция УзелUI(Ссылка, Путь, ОкноВладелец, Область = "form_tree")
	Данные = Новый Структура("element_id,type,path,children,unavailable",
		ЗарегистрироватьЦельUI(Ссылка, "element", ОкноВладелец, Область), ТипЭлементаUI(Ссылка),
		Путь, Новый Массив, Новый Массив);
	Данные.Вставить("scope", Область);
	Данные.Вставить("unavailable_reasons", Новый Структура);
	Для Каждого Пара Из Новый Структура("name,title,visible,enabled,read_only,editing",
		"Имя", "ТекстЗаголовка", "visible", "enabled", "read_only", "editing") Цикл
		Прочитано = СвойствоUI(Ссылка, Пара.Значение);
		Если Пара.Ключ = "name" И Данные.type = "form" Тогда Прочитано = СвойствоUI(Ссылка, "ИмяФормы"); КонецЕсли;
		Данные.Вставить(Пара.Ключ, Прочитано.value);
		Если Не Прочитано.available Тогда
			Данные.unavailable.Добавить(Пара.Ключ);
			Данные.unavailable_reasons.Вставить(Пара.Ключ, Прочитано.reason);
		КонецЕсли;
	КонецЦикла;
	Возврат Данные;
КонецФункции

&НаКлиенте
Функция ДеревоUI(Корень, ОкноВладелец, Глубина, Лимит, ВключатьКорень = Ложь, ПутьКорня = Неопределено, ВидимостьКорня = Неопределено, ДоступностьКорня = Неопределено, Область = "form_tree")
	Результат = Новый Структура("snapshot_id,expires_at,tree,complete,truncated,reason,flat",
		Строка(Новый УникальныйИдентификатор), XMLСтрока(Дата(1, 1, 1)
		+ Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() / 1000) + 300) + "Z",
		Новый Массив, Истина, Ложь, "", Новый Массив);
	Обход = Новый Массив;
	Если ВключатьКорень Тогда
		Обход.Добавить(Новый Структура("ref,depth,path,parent,parent_visible,parent_enabled", Корень, 0, ПутьКорня, Результат.tree, ВидимостьКорня, ДоступностьКорня));
	Иначе
		Для Каждого Ребенок Из Корень.ПолучитьПодчиненныеОбъекты() Цикл
			Обход.Добавить(Новый Структура("ref,depth,path,parent", Ребенок, 0, Новый Массив, Результат.tree));
		КонецЦикла;
	КонецЕсли;
	Индекс = 0;
	Пока Индекс < Обход.Количество() Цикл
		Если Результат.flat.Количество() >= Лимит Тогда
			Результат.reason = "max_nodes"; Прервать;
		КонецЕсли;
		Если ТКШагUI <> Неопределено И Не ТКШагUI.zero И Результат.flat.Количество() > 0
			И ТекущаяУниверсальнаяДатаВМиллисекундах() > ТКШагUI.deadline Тогда
			Результат.reason = "timeout"; Прервать;
		КонецЕсли;
		Элемент = Обход[Индекс]; Индекс = Индекс + 1;
		Данные = УзелUI(Элемент.ref, Элемент.path, ОкноВладелец, Область);
		Если Элемент.Свойство("parent_visible") И Элемент.parent_visible = Ложь Тогда Данные.visible = Ложь; КонецЕсли;
		Если Элемент.Свойство("parent_enabled") И Элемент.parent_enabled = Ложь Тогда Данные.enabled = Ложь; КонецЕсли;
		Элемент.parent.Добавить(Данные);
		Результат.flat.Добавить(Новый Структура("ref,data", Элемент.ref, Данные));
		Попытка
			Дети = Элемент.ref.ПолучитьПодчиненныеОбъекты();
		Исключение
			Результат.reason = "children_unavailable";
			Продолжить;
		КонецПопытки;
		Если Элемент.depth >= Глубина Тогда
			Если Дети.Количество() > 0 Тогда Результат.reason = "depth"; КонецЕсли;
			Продолжить;
		КонецЕсли;
		Путь = КопияJSONUI(Элемент.path);
		Если Данные.type <> "form" Тогда
			СегментПути = ?(Область = "command_interface", Данные.title, Данные.name);
			Если СегментПути = Неопределено Тогда Результат.reason = "path_unavailable"; КонецЕсли;
			Путь.Добавить(СегментПути);
		КонецЕсли;
		ТекущаяСтраница = Неопределено;
		Если Данные.type = "group" Тогда
			Если Элемент.ref.Вид = ВидГруппыФормы.Страницы Тогда
				ТекущаяСтраница = Элемент.ref.ПолучитьТекущуюСтраницу();
			КонецЕсли;
		КонецЕсли;
		Для Каждого Ребенок Из Дети Цикл
			Если Обход.Количество() >= 10000 Тогда Результат.reason = "max_nodes"; Прервать; КонецЕсли;
			ВидимостьРодителя = Данные.visible;
			Если ТекущаяСтраница <> Неопределено И Ребенок <> ТекущаяСтраница Тогда ВидимостьРодителя = Ложь; КонецЕсли;
			Обход.Добавить(Новый Структура("ref,depth,path,parent,parent_visible,parent_enabled", Ребенок, Элемент.depth + 1, Путь, Данные.children, ВидимостьРодителя, Данные.enabled));
		КонецЦикла;
	КонецЦикла;
	Результат.complete = ПустаяСтрока(Результат.reason);
	Результат.truncated = Не Результат.complete;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция РазрешитьЭлементUI(ОкноВладелец, Адрес)
	Область = "form_tree";
	Если Адрес.Свойство("id") Тогда
		Область = ЦельПоИдUI(Адрес.id, "element").scope;
	ИначеЕсли Не Адрес.selector.Свойство("scope", Область) Тогда
		Область = "form_tree";
		ТипЦели = ""; Адрес.selector.Свойство("type", ТипЦели);
		Если ВСпискеUI(ТипЦели, "command_interface,command_group,command_button") Тогда Область = "command_interface"; КонецЕсли;
	КонецЕсли;
	Дерево = ДеревоОбластиUI(ОкноВладелец, Область, 32, 5000);
	Если Не Дерево.complete Тогда
		Сведения = Новый Массив;
		Для Каждого Узел Из Дерево.flat Цикл Сведения.Добавить(Узел.data); КонецЦикла;
		ЗапомнитьКандидатовUI(Сведения, "element", Неопределено, Дерево.reason);
		ОшибкаUI(?(Дерево.reason = "timeout", "expectation_timeout", "incomplete_search"));
	КонецЕсли;
	Кандидаты = Новый Массив;
	Непроверенные = Новый Массив;
	ЦельИд = Неопределено;
	Если Адрес.Свойство("id") Тогда
		ЦельИд = ЦельПоИдUI(Адрес.id, "element");
		Если ЦельИд.window <> ОкноВладелец Тогда ОшибкаUI("stale_target"); КонецЕсли;
	КонецЕсли;
	Для Каждого Узел Из Дерево.flat Цикл
		Совпадает = Истина;
		Если ЦельИд <> Неопределено Тогда
			Совпадает = Узел.ref = ЦельИд.ref;
		Иначе
			НеизвестноеСвойство = Ложь;
			Для Каждого Пара Из Адрес.selector Цикл
				Если Пара.Ключ = "path" Тогда
					Совпадает = Совпадает И ПутиСовпадаютUI(Узел.data.path, Пара.Значение);
				Иначе
					Если Узел.data[Пара.Ключ] = Неопределено Тогда
						НеизвестноеСвойство = Истина;
					Иначе
						Совпадает = Совпадает И ТочноРавныUI(Узел.data[Пара.Ключ], Пара.Значение);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если Совпадает И НеизвестноеСвойство Тогда
				Непроверенные.Добавить(Узел.data);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если Совпадает Тогда Кандидаты.Добавить(Узел); КонецЕсли;
	КонецЦикла;
	Если Непроверенные.Количество() > 0 Тогда
		ЗапомнитьКандидатовUI(Непроверенные, "element", Неопределено, "selector_property_unavailable");
		ОшибкаUI("incomplete_search");
	КонецЕсли;
	Если Кандидаты.Количество() <> 1 Тогда
		Сведения = Новый Массив;
		Для Каждого Узел Из ?(Кандидаты.Количество() = 0, Дерево.flat, Кандидаты) Цикл Сведения.Добавить(Узел.data); КонецЦикла;
		ЗапомнитьКандидатовUI(Сведения, "element", Кандидаты.Количество());
		ОшибкаUI(?(Кандидаты.Количество() > 1, "ambiguous_target", ?(ЦельИд = Неопределено, "element_not_found", "stale_target")));
	КонецЕсли;
	Возврат Кандидаты[0];
КонецФункции

&НаКлиенте
Процедура ЗапомнитьКандидатовUI(Сведения, Область, ЧислоСовпадений, Причина = Неопределено)
	Если ТКШагUI = Неопределено Тогда Возврат; КонецЕсли;
	Кандидаты = Новый Массив;
	Для Каждого Сведение Из Сведения Цикл
		Если Кандидаты.Количество() >= 20 Тогда Прервать; КонецЕсли;
		Данные = Новый Структура;
		Для Каждого Имя Из СтрРазделить("window_id,element_id,name,type,title,path,form_name,visible,enabled,read_only,editing,unavailable,unavailable_reasons", ",") Цикл
			Значение = Неопределено;
			Если Сведение.Свойство(Имя, Значение) Тогда Данные.Вставить(Имя, Значение); КонецЕсли;
		КонецЦикла;
		Если РазмерJSONUI(Кандидаты) + РазмерJSONUI(Данные) > 65536 Тогда Прервать; КонецЕсли;
		Кандидаты.Добавить(Данные);
	КонецЦикла;
	Если ТКШагUI.result.data = Неопределено Тогда ТКШагUI.result.data = Новый Структура; КонецЕсли;
	ТКШагUI.result.data.Вставить("resolution", Новый Структура("scope,exact_matches,candidates,truncated,suggestions_only",
		Область, ЧислоСовпадений, Кандидаты, Кандидаты.Количество() < Сведения.Количество(), Истина));
	Если Причина <> Неопределено Тогда ТКШагUI.result.data.resolution.Вставить("reason", Причина); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ОхватInspectUI(Действие, Данные, Успех)
	Охват = Новый Массив;
	Область = ?(Действие = "tree", "form_tree", Действие);
	Полнота = Ложь;
	Причина = "observation_unavailable";
	Если Успех Тогда
		Если Действие = "values" Тогда
			Полнота = Истина;
			Для Каждого ЗначениеПоля Из Данные.values Цикл
				Если Не ЗначениеПоля.available Тогда Полнота = Ложь; КонецЕсли;
			КонецЦикла;
			Причина = ?(Полнота, "requested_targets_only", "value_unavailable");
		Иначе
			Данные.Свойство("complete", Полнота);
			Причина = ?(Действие = "messages", "current_snapshot_only", "requested_scope_only");
			Если Не Полнота Тогда
				Причина = "incomplete_observation";
				Данные.Свойство("reason", Причина);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Данные.Свойство("reason") Тогда
		Причина = Данные.reason;
	КонецЕсли;
	Охват.Добавить(Новый Структура("scope,status,reason", Область, ?(Полнота, "complete", "partial"), Причина));
	Если Область <> "form_tree" Тогда
		Охват.Добавить(Новый Структура("scope,status,reason", "form_tree", "partial", "not_requested"));
	КонецЕсли;
	Для Каждого НеподдержаннаяОбласть Из СтрРазделить("command_interface,command_bars,table_additions", ",") Цикл
		Если НеподдержаннаяОбласть = Область Тогда Продолжить; КонецЕсли;
		Охват.Добавить(Новый Структура("scope,status,reason", НеподдержаннаяОбласть,
			?(НеподдержаннаяОбласть = "table_additions", "unsupported", "partial"),
			?(НеподдержаннаяОбласть = "table_additions", "adapter_not_implemented", "not_requested")));

	КонецЦикла;
	Возврат Охват;
КонецФункции

&НаКлиенте
Функция ПрочитатьUI(Аргументы)
	Если Аргументы.action = "windows" Тогда
		Список = ОкнаUI();
		Возврат Новый Структура("windows,complete", Список.data, Истина);
	КонецЕсли;
	Цель = РазрешитьОкноUI(Аргументы.window);
	Если Аргументы.action = "messages" Тогда
		Результат = Новый Структура("available,messages,scope,complete", Ложь, Новый Массив, "current_snapshot", Ложь);
		Попытка
			Для Каждого Текст Из Цель.ref.ПолучитьТекстыСообщенийПользователю() Цикл
				Результат.messages.Добавить(Новый Структура("text", Строка(Текст)));
			КонецЦикла;
			Результат.available = Истина;
			Результат.complete = Истина;
		Исключение
			Результат.Вставить("reason", "user_messages_unavailable");
		КонецПопытки;
		Возврат Результат;
	КонецЕсли;
	Если ВСпискеUI(Аргументы.action, "tree,command_interface,command_bars") Тогда
		Глубина = 8; Лимит = 1000;
		Если Аргументы.params.Свойство("depth") Тогда Глубина = Аргументы.params.depth; КонецЕсли;
		Если Аргументы.params.Свойство("max_nodes") Тогда Лимит = Аргументы.params.max_nodes; КонецЕсли;
		Если Аргументы.action <> "tree" Тогда
			Если Аргументы.Свойство("element") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			Дерево = ДеревоОбластиUI(Цель.ref, Аргументы.action, Глубина, Лимит);
			Дерево.Удалить("flat");
			Возврат Дерево;
		КонецЕсли;
		Корень = Цель.ref;
		ПутьКорня = Новый Массив;
		ВидимостьКорня = Неопределено;
		ДоступностьКорня = Неопределено;
		Если Аргументы.Свойство("element") Тогда
			Узел = РазрешитьЭлементUI(Цель.ref, Аргументы.element);
			Корень = Узел.ref;
			ПутьКорня = Узел.data.path;
			ВидимостьКорня = Узел.data.visible;
			ДоступностьКорня = Узел.data.enabled;
		КонецЕсли;
		Дерево = ДеревоUI(Корень, Цель.ref, Глубина, Лимит, Аргументы.Свойство("element"), ПутьКорня, ВидимостьКорня, ДоступностьКорня);
		Дерево.Вставить("editor", АктивныйРедакторUI(Дерево));
		Дерево.Удалить("flat");
		Возврат Дерево;
	КонецЕсли;
	Значения = Новый Массив;
	Для Каждого Адрес Из Аргументы.params.targets Цикл
		Узел = РазрешитьЭлементUI(Цель.ref, Адрес);
		Прочитано = СвойствоUI(Узел.ref, "value");
		Значения.Добавить(Новый Структура("element_id,available,value,visible,enabled",
			Узел.data.element_id, Прочитано.available, Прочитано.value, Узел.data.visible, Узел.data.enabled));
	КонецЦикла;
	Возврат Новый Структура("values", Значения);
КонецФункции

&НаКлиенте
Функция ПроверитьУсловиеUI(Аргументы)
	Условие = Аргументы.params.condition;
	Если Условие.property = "message" Тогда
		Запрос = Новый Структура("action,window,params", "messages", Аргументы.window, Новый Структура);
		Снимок = ПрочитатьUI(Запрос);
		Если Не Снимок.available Или Не Снимок.complete Тогда ОшибкаUI("value_unavailable"); КонецЕсли;
		Найдено = Ложь;
		Для Каждого Сообщение Из Снимок.messages Цикл
			Если ТочноРавныUI(Сообщение.text, Условие.value) Тогда Найдено = Истина; КонецЕсли;
		КонецЦикла;
		Возврат Новый Структура("expected,actual,matched", Условие.value, Снимок,
			?(Условие.operator = "equals", Найдено, Не Найдено));
	КонецЕсли;
	Если Условие.property = "row" Тогда
		Возврат ПроверитьУсловиеСтрокиUI(Аргументы);
	КонецЕсли;
	Фактически = Неопределено;
	Попытка
		Цель = РазрешитьОкноUI(Аргументы.window);
		Если Аргументы.Свойство("element") Тогда
			Узел = РазрешитьЭлементUI(Цель.ref, Аргументы.element);
			Ссылка = Узел.ref;
		Иначе
			Ссылка = Цель.ref;
		КонецЕсли;
		Если Условие.property = "exists" Тогда
			Фактически = Истина;
		ИначеЕсли Условие.property = "closed" Тогда
			Фактически = Ложь;
		ИначеЕсли Условие.property = "visible" Тогда
			Фактически = Узел.data.visible;
			Если Фактически = Неопределено Тогда ОшибкаUI("value_unavailable"); КонецЕсли;
		Иначе
			ИмяСвойства = Условие.property;
			Если ИмяСвойства = "title" Тогда ИмяСвойства = ?(Аргументы.Свойство("element"), "ТекстЗаголовка", "Заголовок"); КонецЕсли;
			Прочитано = СвойствоUI(Ссылка, ИмяСвойства);
			Если Не Прочитано.available Тогда ОшибкаUI("value_unavailable"); КонецЕсли;
			Фактически = Прочитано.value;
		КонецЕсли;
	Исключение
		Код = КодИсключенияUI(ОписаниеОшибки());
		Если (Код = "window_not_found" Или Код = "element_not_found")
			И (Условие.property = "exists" Или Условие.property = "closed") Тогда
			Фактически = Условие.property = "closed";
		Иначе
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	Совпадает = ТочноРавныUI(Фактически, Условие.value);
	Если Условие.operator = "not_equals" Тогда Совпадает = Не Совпадает; КонецЕсли;
	Возврат Новый Структура("expected,actual,matched", Условие.value, Фактически, Совпадает);
КонецФункции

#КонецОбласти

#Область КонтрактUI

&НаКлиенте
Процедура ПроверитьАргументыUI(Инструмент, Аргументы)
	Если Не ВСпискеUI(Инструмент, "test_open,test_inspect,test_expect,test_input,test_action,test_table") Тогда ОшибкаUI("unsupported_operation"); КонецЕсли;
	ПроверитьКлючиUI(Аргументы, "request_id,session_id,params", "window,element,action,timeout_ms");
	ПроверитьСтрокуUI(Аргументы.request_id, 128);
	ПроверитьСтрокуUI(Аргументы.session_id, 128);
	Если Аргументы.Свойство("timeout_ms") Тогда ПроверитьЧислоUI(Аргументы.timeout_ms, 0, 300000); КонецЕсли;
	Если Аргументы.Свойство("window") Тогда ПроверитьАдресUI(Аргументы.window, Истина); КонецЕсли;
	Если Аргументы.Свойство("element") Тогда ПроверитьАдресUI(Аргументы.element, Ложь); КонецЕсли;
	Если Инструмент = "test_table" Тогда
		Если Не Аргументы.Свойство("action") Или Не Аргументы.Свойство("window") Или Не Аргументы.Свойство("element") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		ПроверитьПараметрыТаблицыUI(Аргументы.action, Аргументы.params);
	ИначеЕсли Инструмент = "test_action" Тогда
		Если Не Аргументы.Свойство("action") Или Не Аргументы.Свойство("window") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		Если Не ВСпискеUI(Аргументы.action, "click,activate_window,select_page,close,expand,collapse") Тогда ОшибкаUI("unsupported_operation"); КонецЕсли;
		ПроверитьКлючиUI(Аргументы.params, "", "");
		Если ВСпискеUI(Аргументы.action, "click,select_page,expand,collapse") <> Аргументы.Свойство("element") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	ИначеЕсли Инструмент = "test_input" Тогда
		ПроверитьВводUI(Аргументы);
	ИначеЕсли Инструмент = "test_open" Тогда
		ПроверитьКлючиUI(Аргументы.params, "link", "");
		Если Аргументы.Свойство("action") Или Аргументы.Свойство("element") Или Не Аргументы.Свойство("window") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		ПроверитьСтрокуUI(Аргументы.params.link, 4096);
		Если Лев(Аргументы.params.link, 6) <> "e1cib/" Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	ИначеЕсли Инструмент = "test_inspect" Тогда
		Если Не Аргументы.Свойство("action") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		Если Аргументы.action = "windows" Тогда
			ПроверитьКлючиUI(Аргументы.params, "", "");
			Если Аргументы.Свойство("window") Или Аргументы.Свойство("element") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		Иначе
			Если Не Аргументы.Свойство("window") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			Если ВСпискеUI(Аргументы.action, "tree,command_interface,command_bars") Тогда
				Если Аргументы.action <> "tree" И Аргументы.Свойство("element") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
				ПроверитьКлючиUI(Аргументы.params, "", "depth,max_nodes");
				Если Аргументы.params.Свойство("depth") Тогда ПроверитьЧислоUI(Аргументы.params.depth, 0, 32); КонецЕсли;
				Если Аргументы.params.Свойство("max_nodes") Тогда ПроверитьЧислоUI(Аргументы.params.max_nodes, 1, 5000); КонецЕсли;
			ИначеЕсли Аргументы.action = "values" Тогда
				ПроверитьКлючиUI(Аргументы.params, "targets", "");
				Если Аргументы.Свойство("element") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
				Если ТипЗнч(Аргументы.params.targets) <> Тип("Массив") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
				ПроверитьЧислоUI(Аргументы.params.targets.Количество(), 1, 100);
				Для Каждого Цель Из Аргументы.params.targets Цикл ПроверитьАдресUI(Цель, Ложь); КонецЦикла;
			ИначеЕсли Аргументы.action = "messages" Тогда
				ПроверитьКлючиUI(Аргументы.params, "", "");
				Если Аргументы.Свойство("element") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			Иначе
				ОшибкаUI("invalid_params");
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если Аргументы.Свойство("action") Или Не Аргументы.Свойство("window") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		ПроверитьКлючиUI(Аргументы.params, "condition", "");
		Условие = Аргументы.params.condition;
		ПроверитьКлючиUI(Условие, "property,operator,value", "");
		Если Не ВСпискеUI(Условие.property, "exists,visible,enabled,read_only,editing,value,title,closed,message,row") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		Если Не ВСпискеUI(Условие.operator, "equals,not_equals") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		Если Условие.property = "row" Тогда
			ПроверитьКлючиUI(Условие.value, "where", "");
			Если ТипЗнч(Условие.value.where) <> Тип("Массив") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			ПроверитьЧислоUI(Условие.value.where.Количество(), 1, 100);
			Колонки = Новый Соответствие;
			Для Каждого Отбор Из Условие.value.where Цикл
				ПроверитьКлючиUI(Отбор, "column,equals", "");
				ПроверитьСтрокуUI(Отбор.column, 4096);
				Если ТипЗнч(Отбор.equals) <> Тип("Строка") Или СтрДлина(Отбор.equals) > 65536 Тогда ОшибкаUI("invalid_params"); КонецЕсли;
				Если Колонки.Получить(Отбор.column) <> Неопределено Тогда ОшибкаUI("invalid_params"); КонецЕсли;
				Колонки.Вставить(Отбор.column, Истина);
			КонецЦикла;
		ИначеЕсли ВСпискеUI(Условие.property, "value,title,message") Тогда
			Если ТипЗнч(Условие.value) <> Тип("Строка") Или СтрДлина(Условие.value) > 65536 Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		ИначеЕсли ТипЗнч(Условие.value) <> Тип("Булево") Тогда
			ОшибкаUI("invalid_params");
		КонецЕсли;
		Если ВСпискеUI(Условие.property, "visible,enabled,read_only,editing,value,row") И Не Аргументы.Свойство("element") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		Если ВСпискеUI(Условие.property, "closed,message") И Аргументы.Свойство("element") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьАдресUI(Адрес, ЭтоОкно)
	Если ТипЗнч(Адрес) <> Тип("Структура") Или Адрес.Количество() <> 1 Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	Если Адрес.Свойство("id") Тогда
		ПроверитьСтрокуUI(Адрес.id, 128);
	ИначеЕсли ЭтоОкно И Адрес.Свойство("active") Тогда
		Если ТипЗнч(Адрес.active) <> Тип("Булево") Или Не Адрес.active Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	ИначеЕсли Адрес.Свойство("selector") Тогда
		Допустимые = ?(ЭтоОкно, "title,form_name,navigation_link", "name,type,title,path,scope");
		ПроверитьКлючиUI(Адрес.selector, "", Допустимые);
		Если Адрес.selector.Количество() = 0 Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		Для Каждого Пара Из Адрес.selector Цикл
			Если Пара.Ключ = "path" Тогда
				Если ТипЗнч(Пара.Значение) <> Тип("Массив") Или Пара.Значение.Количество() > 32 Тогда ОшибкаUI("invalid_params"); КонецЕсли;
				Для Каждого Имя Из Пара.Значение Цикл ПроверитьСтрокуUI(Имя, 4096); КонецЦикла;
			Иначе
				ПроверитьСтрокуUI(Пара.Значение, 4096);
			КонецЕсли;
			Если Пара.Ключ = "scope" И Не ВСпискеUI(Пара.Значение, "form_tree,command_interface,command_bars") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			Если Пара.Ключ = "type" И Не ВСпискеUI(Пара.Значение, "form,group,field,button,table,decoration,command_interface,command_group,command_button") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		КонецЦикла;
	Иначе
		ОшибкаUI("invalid_params");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКлючиUI(Данные, Обязательные, Необязательные)
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	Для Каждого Имя Из СтрРазделить(Обязательные, ",", Ложь) Цикл
		Если Не Данные.Свойство(Имя) Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	КонецЦикла;
	Для Каждого Пара Из Данные Цикл
		Если Не ВСпискеUI(Пара.Ключ, Обязательные + "," + Необязательные) Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСтрокуUI(Значение, Максимум)
	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) = 0 Или СтрДлина(Значение) > Максимум Тогда ОшибкаUI("invalid_params"); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЧислоUI(Значение, Минимум, Максимум)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	Если Значение <> Цел(Значение) Или Значение < Минимум Или Значение > Максимум Тогда ОшибкаUI("invalid_params"); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ВСпискеUI(Значение, Список)
	Возврат ТипЗнч(Значение) = Тип("Строка") И СтрРазделить(Список, ",", Ложь).Найти(Значение) <> Неопределено;
КонецФункции

&НаКлиенте
Функция ТочноРавныUI(Первое, Второе)
	Если ТипЗнч(Первое) <> ТипЗнч(Второе) Тогда Возврат Ложь; КонецЕсли;
	Если ТипЗнч(Первое) = Тип("Строка") Тогда
		Возврат СтрДлина(Первое) = СтрДлина(Второе) И (Первое = "" Или СтрНайти(Первое, Второе) = 1);
	КонецЕсли;
	Возврат Первое = Второе;
КонецФункции

&НаКлиенте
Функция ПутиСовпадаютUI(Первый, Второй)
	Если Первый.Количество() <> Второй.Количество() Тогда Возврат Ложь; КонецЕсли;
	Для Индекс = 0 По Первый.Количество() - 1 Цикл
		Если Не ТочноРавныUI(Первый[Индекс], Второй[Индекс]) Тогда Возврат Ложь; КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ОшибкаUI(Код)
	ВызватьИсключение "TKUI:" + Код;
КонецПроцедуры

&НаКлиенте
Функция КодИсключенияUI(Текст)
	Позиция = СтрНайти(Текст, "TKUI:");
	// Нативный отказ действия сам по себе не доказывает потерю соединения.
	Если Позиция = 0 Тогда Возврат "action_not_confirmed"; КонецЕсли;
	Хвост = Сред(Текст, Позиция + 5);
	Код = "";
	Для Индекс = 1 По СтрДлина(Хвост) Цикл
		Символ = Сред(Хвост, Индекс, 1);
		Если СтрНайти("abcdefghijklmnopqrstuvwxyz_", Символ) = 0 Тогда Прервать; КонецЕсли;
		Код = Код + Символ;
	КонецЦикла;
	Возврат Код;
КонецФункции

&НаКлиенте
Функция ДатаНаблюденияUI()
	Возврат XMLСтрока(Дата(1, 1, 1) + Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() / 1000)) + "Z";
КонецФункции

&НаКлиенте
Функция КопияJSONUI(Значение)
	Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Значение);
	Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(Запись.Закрыть());
	Возврат ПрочитатьJSON(Чтение);
КонецФункции

&НаКлиенте
Функция РазмерJSONUI(Значение)
	Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Значение);
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8).Размер();
КонецФункции

#КонецОбласти

&НаКлиенте
Функция ПроверитьУсловиеСтрокиUI(Аргументы)
	Условие = Аргументы.params.condition;
	Цель = РазрешитьОкноUI(Аргументы.window);
	Узел = РазрешитьЭлементUI(Цель.ref, Аргументы.element);
	Если Узел.data.type <> "table" Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	// Описание текущей строки содержит отображаемые данные, а не идентификатор.
	// Отсутствие во всей таблице без полного поиска также не доказано.
	Если Условие.operator = "not_equals" Тогда ОшибкаUI("incomplete_search"); КонецЕсли;
	Таблица = Узел.ref;
	Текущая = Таблица.ПолучитьТекущуюСтроку();
	Фактически = Новый Структура("scope,complete,found,values,cursor_changed,selection_changed",
		"current_row", Ложь, Ложь, Новый Массив, Ложь, Ложь);
	Фактически.Вставить("identity", Новый Структура("status,reason", "unavailable", "stable_row_identity_unavailable"));
	Фактически.Вставить("values_verified", Ложь);
	Если Текущая <> Неопределено Тогда
		Для Каждого Отбор Из Условие.value.where Цикл
			// Имя элемента колонки подтверждается API; ключ данных не угадывается.
			Колонки = Таблица.НайтиОбъекты(Тип("ТестируемоеПолеФормы"), , Отбор.column, 0);
			Точных = 0;
			Для Каждого Колонка Из Колонки Цикл
				Если ТочноРавныUI(Колонка.Имя, Отбор.column) Тогда Точных = Точных + 1; КонецЕсли;
			КонецЦикла;
			Если Точных = 0 Тогда ОшибкаUI("element_not_found"); КонецЕсли;
			Если Точных > 1 Тогда ОшибкаUI("ambiguous_target"); КонецЕсли;
			ТекстЯчейки = Таблица.ПолучитьТекстЯчейки(Отбор.column);
			Если ТипЗнч(ТекстЯчейки) <> Тип("Строка") Или СтрДлина(ТекстЯчейки) > 65536 Тогда ОшибкаUI("value_unavailable"); КонецЕсли;
			Фактически.values.Добавить(Новый Структура("column,text", Отбор.column, ТекстЯчейки));
		КонецЦикла;
	КонецЕсли;
	// Даже одинаковые тексты не доказывают, что ячейки прочитаны из одной строки.
	// До появления независимой идентичности это только диагностические значения.
	ТКШагUI.result.data = Новый Структура("expected,actual,matched", Условие.value, Фактически, Ложь);
	Если РазмерJSONUI(ТКШагUI.result.data) > 1048576 Тогда
		ТКШагUI.result.data = Новый Структура("complete,truncated,reason,identity", Ложь, Истина,
			"response_size_limit", Фактически.identity);
	КонецЕсли;
	ОшибкаUI("incomplete_search");
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ПроверитьВводUI(Аргументы)
	Если Не Аргументы.Свойство("window") Или Не Аргументы.Свойство("element")
		Или Не Аргументы.Свойство("action") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	Если Аргументы.action = "text" Тогда
		ПроверитьКлючиUI(Аргументы.params, "text", "finish_focus");
		Если Аргументы.params.Свойство("finish_focus") Тогда
			УсловиеФокуса = Аргументы.params.finish_focus;
			ПроверитьКлючиUI(УсловиеФокуса, "selector,same_form", "");
			Если ТипЗнч(УсловиеФокуса.same_form) <> Тип("Булево") Или Не УсловиеФокуса.same_form Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			ПроверитьКлючиUI(УсловиеФокуса.selector, "name,type", "title");
			ПроверитьСтрокуUI(УсловиеФокуса.selector.name, 256);
			Если УсловиеФокуса.selector.type <> "field" Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			Если УсловиеФокуса.selector.Свойство("title") Тогда ПроверитьСтрокуUI(УсловиеФокуса.selector.title, 1024); КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(Аргументы.params.text) <> Тип("Строка") Или СтрДлина(Аргументы.params.text) > 65536 Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	ИначеЕсли ВСпискеUI(Аргументы.action, "number,date") Тогда
		ПроверитьКлючиUI(Аргументы.params, "value", "");
		ТекстПроверки = ТекстТипизированногоВводаUI(Аргументы);
	ИначеЕсли Аргументы.action = "check" Тогда
		ПроверитьКлючиUI(Аргументы.params, "checked", "");
		Если ТипЗнч(Аргументы.params.checked) <> Тип("Булево") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	ИначеЕсли Аргументы.action = "select" Тогда
		ПроверитьКлючиUI(Аргументы.params, "choice", "");
		Выбор = Аргументы.params.choice;
		Если ТипЗнч(Выбор) <> Тип("Структура") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		Если Выбор.Свойство("list_value") Тогда
			ПроверитьКлючиUI(Выбор, "list_value", ""); ПроверитьСтрокуUI(Выбор.list_value, 65536);
		ИначеЕсли Выбор.Свойство("source_row") Тогда
			ПроверитьКлючиUI(Выбор, "selection_window,table,row,source_row,expected_text", "");
			ПроверитьАдресUI(Выбор.selection_window, Истина); ПроверитьАдресUI(Выбор.table, Ложь);
			Если Не Выбор.selection_window.Свойство("selector") Или Не Выбор.table.Свойство("selector") Тогда
				ОшибкаUI("invalid_params");
			КонецЕсли;
			ПроверитьКлючиUI(Выбор.table.selector, "name", "type");
			Если Выбор.table.selector.Свойство("type") И Выбор.table.selector.type <> "table" Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			ПроверитьПараметрыТаблицыUI("select", Новый Структура("row", Выбор.source_row));
			ПроверитьПараметрыТаблицыUI("select", Новый Структура("row", Выбор.row));
			Если Не Выбор.source_row.Свойство("where") Или Не Выбор.row.Свойство("where") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			ПроверитьСтрокуUI(Выбор.expected_text, 65536);
		Иначе
			ПроверитьКлючиUI(Выбор, "selection_window,table,row", "");
			ПроверитьАдресUI(Выбор.selection_window, Истина); ПроверитьАдресUI(Выбор.table, Ложь);
			Если ТипЗнч(Выбор.row) <> Тип("Структура") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			Если Выбор.row.Свойство("id") Тогда
				ПроверитьКлючиUI(Выбор.row, "id,snapshot_id", "");
				ПроверитьСтрокуUI(Выбор.row.id, 128); ПроверитьСтрокуUI(Выбор.row.snapshot_id, 128);
				Возврат;
			КонецЕсли;
			ПроверитьКлючиUI(Выбор.row, "where", "");
			Если ТипЗнч(Выбор.row.where) <> Тип("Массив") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			ПроверитьЧислоUI(Выбор.row.where.Количество(), 1, 100);
			Имена = Новый Соответствие;
			Для Каждого Отбор Из Выбор.row.where Цикл
				ПроверитьКлючиUI(Отбор, "column,equals", ""); ПроверитьСтрокуUI(Отбор.column, 256);
				Если Имена.Получить(Отбор.column) <> Неопределено Тогда ОшибкаUI("invalid_params"); КонецЕсли;
				Имена.Вставить(Отбор.column, Истина);
				Если ТипЗнч(Отбор.equals) <> Тип("Строка") Или СтрДлина(Отбор.equals) > 65536 Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Иначе
		ОшибкаUI("invalid_params");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ЗначениеВводаUI(Поле, Флажок)
	Чтение = СвойствоUI(Поле, "value");
	Если Не Чтение.available Тогда ОшибкаUI("value_unavailable"); КонецЕсли;
	Если Не Флажок Тогда Возврат Чтение.value; КонецЕсли;
	// Не интерпретируем неизвестное/третье состояние как false.
	Если ТочноРавныUI(Чтение.value, Строка(Истина)) Тогда Возврат Истина; КонецЕсли;
	Если ТочноРавныUI(Чтение.value, Строка(Ложь)) Тогда Возврат Ложь; КонецЕсли;
	ОшибкаUI("value_unavailable");
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ТекстТипизированногоВводаUI(Аргументы)
	ЗначениеВвода = Аргументы.params.value;
	Если Аргументы.action = "number" Тогда
		Если ТипЗнч(ЗначениеВвода) <> Тип("Число") Или ЗначениеВвода < -999999999999999
			Или ЗначениеВвода > 999999999999999 Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		Возврат Строка(ЗначениеВвода);
	КонецЕсли;
	Если ТипЗнч(ЗначениеВвода) <> Тип("Строка") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	Если СтрДлина(ЗначениеВвода) <> 10 И СтрДлина(ЗначениеВвода) <> 19 Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	Для ИндексСимвола = 1 По СтрДлина(ЗначениеВвода) Цикл
		ОжидаемыеСимволы = "0123456789";
		Если ИндексСимвола = 5 Или ИндексСимвола = 8 Тогда ОжидаемыеСимволы = "-"; КонецЕсли;
		Если ИндексСимвола = 11 Тогда ОжидаемыеСимволы = "T"; КонецЕсли;
		Если ИндексСимвола = 14 Или ИндексСимвола = 17 Тогда ОжидаемыеСимволы = ":"; КонецЕсли;
		Если СтрНайти(ОжидаемыеСимволы, Сред(ЗначениеВвода, ИндексСимвола, 1)) = 0 Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	КонецЦикла;
	Попытка
		ДатаВвода = XMLЗначение(Тип("Дата"), ЗначениеВвода + ?(СтрДлина(ЗначениеВвода) = 10, "T00:00:00", ""));
	Исключение
		ОшибкаUI("invalid_params");
	КонецПопытки;
	// Нативный GetDataPresentation возвращает полную дату со временем, даже для поля даты.
	// Текстовый ввод по-прежнему сравнивается точно; тип выбирает вызывающий явно.
	Возврат Строка(ДатаВвода);
КонецФункции

&НаКлиенте
Процедура ПередИзменениемUI(Шаг)
	Если Не Шаг.zero И ТекущаяУниверсальнаяДатаВМиллисекундах() >= Шаг.deadline Тогда ОшибкаUI("expectation_timeout"); КонецЕсли;
	Если ВладелецФормы = Неопределено Тогда ОшибкаUI("permission_denied"); КонецЕсли;
	Если Не ВладелецФормы.ПроверитьРазрешениеТестирования(Шаг.permission_command, Шаг.permission_consumed) Тогда ОшибкаUI("permission_denied"); КонецЕсли;
	Шаг.permission_consumed = Истина;
	Шаг.Вставить("diagnostic_stage", "invoke");
	Шаг.result.execution = "unknown";
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьРазрешениеUI(Шаг)
	Если Не ВСпискеUI(Шаг.tool, "test_open,test_input,test_action,test_table") Тогда Возврат Истина; КонецЕсли;
	Если ВладелецФормы = Неопределено Тогда ОшибкаUI("permission_denied"); КонецЕсли;
	Если Не ВладелецФормы.КомандаТребуетПодтверждения(Шаг.permission_command) Тогда Возврат Истина; КонецЕсли;
	Режим = ВладелецФормы.РежимРазрешенийТестирования();
	Если Режим <> "ask" И Режим <> "session_allow" Тогда ОшибкаUI("permission_denied"); КонецЕсли;
	Если Шаг.permission_state = "denied" Тогда ОшибкаUI("permission_denied"); КонецЕсли;
	Если Шаг.permission_state = "new" Тогда
		Если Режим = "session_allow" Тогда
			Шаг.permission_state = "allowed";
		Иначе
			Шаг.permission_state = "pending";
			Шаг.result.status = "awaiting_approval";
			Шаг.permission_form = ВладелецФормы.ЗапроситьРазрешениеТестирования(Шаг.permission_command, ЭтаФорма, Шаг.permission_token);
			Если Шаг.permission_form = Неопределено Тогда ОшибкаUI("permission_denied"); КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Шаг.permission_state = "pending" Тогда Возврат Ложь; КонецЕсли;
	Шаг.result.status = "running";
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция АктуальноПодтверждениеUI(Токен) Экспорт
	Если ТКШагUI = Неопределено Тогда Возврат Ложь; КонецЕсли;
	Возврат ТКШагUI.permission_token = Токен И ТКШагUI.permission_state = "pending"
		И ТКШагUI.args.session_id = ТКСеанс И ТКСостояние = "ready"
		И ТекущаяУниверсальнаяДатаВМиллисекундах() < ТКШагUI.deadline;
КонецФункции

&НаКлиенте
Процедура ЗавершитьПодтверждениеUI(Токен, Разрешено) Экспорт
	Если Не АктуальноПодтверждениеUI(Токен) Тогда Возврат; КонецЕсли;
	ТКШагUI.permission_state = ?(Разрешено, "allowed", "denied");
	ТКШагUI.permission_form = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеЗавершеноUI(Шаг, ИмяШага)
	Шаг.Вставить("diagnostic_stage", "observe");
	Шаг.result.execution = "invoked";
	Шаг.result.data.completed_steps.Добавить(ИмяШага);
	Шаг.last_confirmed_step = ИмяШага;
	Шаг.confirmed_count = Шаг.confirmed_count + 1;
	ОпубликоватьПрогрессUI(Шаг, "observing");
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВводUI(Шаг)
	Если Шаг.Свойство("cell_choice") Тогда
		ПродолжитьВыборЯчейкиUI(Шаг);
		Возврат;
	КонецЕсли;
	Аргументы = Шаг.args;
	ЦелевоеОкно = РазрешитьОкноUI(Аргументы.window);
	Узел = РазрешитьЭлементUI(ЦелевоеОкно.ref, Аргументы.element);
	Если Узел.data.type <> "field" Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	Поле = Узел.ref;
	Флажок = Аргументы.action = "check";
	Если Поле.Вид <> ?(Флажок, ВидПоляФормы.ПолеФлажка, ВидПоляФормы.ПолеВвода) Тогда ОшибкаUI("unsupported_operation"); КонецЕсли;
	Если Аргументы.action = "select" И Аргументы.params.choice.Свойство("source_row") Тогда
		ВыбратьЗначениеЯчейкиUI(Шаг, ЦелевоеОкно.ref, Поле);
		Возврат;
	КонецЕсли;
	Если Узел.data.visible <> Истина Или Узел.data.enabled <> Истина
		Или Не Поле.ТекущаяВидимость() Или Не Поле.ТекущаяДоступность() Или Поле.ТекущееТолькоПросмотр() Тогда ОшибкаUI("target_unavailable"); КонецЕсли;
	Форма = Поле.ПолучитьРодителя();
	Для Глубина = 1 По 32 Цикл
		Если ТипЗнч(Форма) = Тип("ТестируемаяТаблицаФормы") Тогда ОшибкаUI("incomplete_search"); КонецЕсли;
		Если ТипЗнч(Форма) = Тип("ТестируемаяФорма") Тогда Прервать; КонецЕсли;
		Форма = Форма.ПолучитьРодителя();
	КонецЦикла;
	Если ТипЗнч(Форма) <> Тип("ТестируемаяФорма") Тогда ОшибкаUI("incomplete_search"); КонецЕсли;
	Данные = Новый Структура("expected,actual,editing,completed_steps", Неопределено, Неопределено, Неопределено, Новый Массив);
	Шаг.result.data = Данные;
	Если ВСпискеUI(Аргументы.action, "text,number,date") Тогда
		Данные.expected = ?(Аргументы.action = "text", Аргументы.params.text, ТекстТипизированногоВводаUI(Аргументы));
		Если Аргументы.action <> "text" Тогда
			Данные.Вставить("value_type", Аргументы.action);
			Данные.Вставить("typed_expected", Аргументы.params.value);
		КонецЕсли;
	ИначеЕсли Флажок Тогда
		Данные.expected = Аргументы.params.checked;
	ИначеЕсли Аргументы.params.choice.Свойство("list_value") Тогда
		Данные.expected = Аргументы.params.choice.list_value;
	Иначе
		НаблюдатьФормуВыбораUI(Шаг);
		Возврат;
	КонецЕсли;
	Данные.actual = ЗначениеВводаUI(Поле, Флажок);
	Если Флажок И Данные.actual = Данные.expected Тогда
		Данные.editing = Ложь; Возврат;
	КонецЕсли;
	Данные.Вставить("before", Данные.actual);
	Данные.actual = Неопределено;
	Если Флажок Тогда
		ОкнаДо = ОкнаUI();
		ИндексОкна = ОкнаДо.refs.Найти(ЦелевоеОкно.ref);
		Если ИндексОкна = Неопределено Тогда ОшибкаUI("stale_target"); КонецЕсли;
		Шаг.Вставить("check_window", ОкнаДо.data[ИндексОкна]);
		Шаг.Вставить("check_unique_form", ЧислоОконФормыUI(ОкнаДо, Шаг.check_window.form_name) = 1);
		Шаг.Вставить("check_form", Форма);
		Шаг.Вставить("check_target", Новый Структура("selector",
			Новый Структура("name,type,path,scope", Узел.data.name, Узел.data.type, Узел.data.path, Узел.data.scope)));
	КонецЕсли;
	ЦельЗавершения = ЦельЗавершенияВводаUI(Форма, Поле);
	Если Аргументы.params.Свойство("finish_focus") Тогда
		Данные.Вставить("finish_focus", Новый Структура("before_confirmed,after_confirmed", Ложь, Ложь));
		Шаг.Вставить("diagnostic_stage", "resolve");
		ОжидаемыйФокус = РазрешитьЭлементUI(Форма, Новый Структура("selector", Аргументы.params.finish_focus.selector));
		Если ОжидаемыйФокус.data.visible <> Истина Или ОжидаемыйФокус.data.enabled <> Истина Тогда ОшибкаUI("target_unavailable"); КонецЕсли;
		// Цель выбирается среди непосредственных детей той же живой формы.
		// Сравниваем нативные ссылки, а не изменяемый заголовок оболочки формы.
		Если ЦельЗавершения = Неопределено Или ЦельЗавершения <> ОжидаемыйФокус.ref Тогда ОшибкаUI("finish_focus_mismatch"); КонецЕсли;
		Данные.finish_focus.before_confirmed = Истина;
		Шаг.Удалить("diagnostic_stage");
	КонецЕсли;
	ПередИзменениемUI(Шаг); Поле.Активизировать(); ИзменениеЗавершеноUI(Шаг, "activate");
	Если Аргументы.action = "select" Тогда
		ПередИзменениемUI(Шаг); Поле.ВыбратьИзСпискаВыбора(); ИзменениеЗавершеноUI(Шаг, "open_choice_list");
		// Поиск варианта остаётся частью команды даже после открытия списка.
		Шаг.Вставить("diagnostic_stage", "resolve");
		Выбор = КандидатыСпискаUI(Поле, Данные.expected);
		Данные.Вставить("choice", Выбор);
		Если Выбор.candidates.Количество() > 1 Тогда ОшибкаUI("ambiguous_target"); КонецЕсли;
		Если Не Выбор.complete Тогда ОшибкаUI("choice_search_incomplete"); КонецЕсли;
		Если Выбор.candidates.Количество() = 0 Тогда ОшибкаUI("element_not_found"); КонецЕсли;
		Данные.expected = Выбор.candidates[0].value;
		Шаг.Удалить("diagnostic_stage");
		ПередИзменениемUI(Шаг);
		Поле.ВыполнитьВыборИзСпискаВыбора(Аргументы.params.choice.list_value);
		ИзменениеЗавершеноUI(Шаг, "select_choice");
	ИначеЕсли Флажок Тогда
		ПередИзменениемUI(Шаг); Поле.УстановитьОтметку(); ИзменениеЗавершеноUI(Шаг, "toggle_check");
		НачатьНаблюдениеДействияUI(Шаг, "check");
		Возврат;
	ИначеЕсли Данные.expected = "" Тогда
		ПередИзменениемUI(Шаг); Поле.Очистить(); ИзменениеЗавершеноUI(Шаг, "clear");
	Иначе
		ПередИзменениемUI(Шаг); Поле.ВвестиТекст(Данные.expected); ИзменениеЗавершеноUI(Шаг, "input_text");
	КонецЕсли;
	// Ввод может открыть вопрос платформы. Не пытаемся завершить редактирование
	// в заблокированной форме и не отвечаем на вопрос вместо пользователя.
	АктивноеПослеВвода = ТКПриложение.ПолучитьАктивноеОкно();
	Если АктивноеПослеВвода <> Неопределено И АктивноеПослеВвода <> ЦелевоеОкно.ref
		И Не АктивноеПослеВвода.Основное И Не ОкноСодержитФормуUI(АктивноеПослеВвода, Форма) Тогда
		Данные.Вставить("input_completion", "blocked_by_other_window");
		Данные.Вставить("blocking_window_id", ЗарегистрироватьЦельUI(АктивноеПослеВвода, "window"));
		ОшибкаUI("action_not_confirmed");
	КонецЕсли;
	ПередИзменениемUI(Шаг);
	Если ЦельЗавершения = Неопределено Тогда
		Форма.ПерейтиКСледующемуЭлементу();
	Иначе
		ЦельЗавершения.Активизировать();
	КонецЕсли;
	ИзменениеЗавершеноUI(Шаг, "finish_edit");
	Если Аргументы.params.Свойство("finish_focus") Тогда
		Шаг.Вставить("diagnostic_stage", "verify");
		Если Форма.ПолучитьТекущийЭлемент() <> ЦельЗавершения Тогда ОшибкаUI("finish_focus_mismatch"); КонецЕсли;
		Данные.finish_focus.after_confirmed = Истина;
		Шаг.Удалить("diagnostic_stage");
	КонецЕсли;
	// При ошибке readback управление уходит в общий catch; мутация не повторяется.
	Данные.actual = Неопределено;
	Данные.actual = ЗначениеВводаUI(Поле, Флажок);
	Данные.editing = Форма.ПолучитьТекущийЭлемент() = Поле;
	Если Данные.editing Тогда ОшибкаUI("action_not_confirmed"); КонецЕсли;
	Если Не ТочноРавныUI(Данные.actual, Данные.expected) Тогда ОшибкаUI("action_not_confirmed"); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ЧислоОконФормыUI(Окна, ИмяФормы)
	ЧислоОкон = 0;
	Для Каждого ДанныеОкна Из Окна.data Цикл
		Если ТочноРавныUI(ДанныеОкна.form_name, ИмяФормы) Тогда ЧислоОкон = ЧислоОкон + 1; КонецЕсли;
	КонецЦикла;
	Возврат ЧислоОкон;
КонецФункции

&НаКлиенте
Функция ФлажокПодтвержденUI(Шаг, Окна)
	Диалог = АктивныйДиалогUI(Окна);
	Если Диалог <> Неопределено Тогда
		Шаг.result.data.Вставить("blocking_window", Диалог);
		Шаг.result.data.Вставить("blocking_window_id", Диалог.window_id);
		ОшибкаUI("blocking_window");
	КонецЕсли;
	Если Окна.active = Неопределено Тогда Возврат Ложь; КонецЕсли;
	Активное = АктивноеОкноИзСнимкаUI(Окна);
	До = Шаг.check_window;
	Если Не ОкноСодержитФормуUI(Окна.active, Шаг.check_form) Тогда
		Если Активное = Неопределено Или ПустаяСтрока(До.form_name)
			Или Не ТочноРавныUI(Активное.form_name, До.form_name) Тогда Возврат Ложь; КонецЕсли;
		Если ЗначениеЗаполнено(До.navigation_link) Тогда
			Если Не ТочноРавныUI(Активное.navigation_link, До.navigation_link) Тогда Возврат Ложь; КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Активное.navigation_link) Или Не Шаг.check_unique_form
			Или ЧислоОконФормыUI(Окна, До.form_name) <> 1
			Или Не ТочноРавныUI(Активное.title, До.title + " *") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Поле = РазрешитьЭлементUI(Окна.active, Шаг.check_target).ref;
	Шаг.result.data.actual = ЗначениеВводаUI(Поле, Истина);
	Шаг.result.data.editing = Ложь;
	Возврат Шаг.result.data.actual = Шаг.result.data.expected;
КонецФункции

&НаКлиенте
Функция ОкноСодержитФормуUI(ОкноКлиента, Форма)
	// Оболочка окна меняется при появлении звездочки модифицированности.
	// Принимаем только ту же нативную форму, без сравнения заголовков или имен.
	Для Каждого Дочерний Из ОкноКлиента.ПолучитьПодчиненныеОбъекты() Цикл
		Если Дочерний = Форма Тогда Возврат Истина; КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция ЦельЗавершенияВводаUI(Форма, Поле)
	// Способ завершения выбирается до мутации, а не как fallback после отказа.
	// Только непосредственные поля/кнопки формы: не трогаем страницы и курсор таблиц.
	Для Каждого ЭлементФормы Из Форма.ПолучитьПодчиненныеОбъекты() Цикл
		Если ЭлементФормы = Поле Тогда Продолжить; КонецЕсли;
		Если ТипЗнч(ЭлементФормы) <> Тип("ТестируемоеПолеФормы") И ТипЗнч(ЭлементФормы) <> Тип("ТестируемаяКнопкаФормы") Тогда Продолжить; КонецЕсли;
		Если ЭлементФормы.ТекущаяВидимость() И ЭлементФормы.ТекущаяДоступность() Тогда Возврат ЭлементФормы; КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция КандидатыСпискаUI(Поле, Текст)
	Результат = Новый Структура("scope,complete,candidates", "choice_list", Истина, Новый Массив);
	Представления = Поле.ПолучитьПредставлениеСпискаВыбора();
	Если Представления.Количество() > 500 Тогда
		Результат.complete = Ложь; Результат.Вставить("reason", "candidate_limit"); Возврат Результат;
	КонецЕсли;
	Для Каждого Вариант Из Представления Цикл
		Если ТипЗнч(Вариант) <> Тип("Структура") Тогда
			Результат.complete = Ложь; Продолжить;
		КонецЕсли;
		Отображение = Неопределено; Значение = Неопределено;
		Если Не Вариант.Свойство("ОтображаемыйТекст", Отображение) Тогда Вариант.Свойство("DisplayedText", Отображение); КонецЕсли;
		Если Не Вариант.Свойство("ПредставлениеДанных", Значение) Тогда Вариант.Свойство("DataPresentation", Значение); КонецЕсли;
		Если ТипЗнч(Отображение) <> Тип("Строка") Или ТипЗнч(Значение) <> Тип("Строка") Тогда
			Результат.complete = Ложь; Продолжить;
		КонецЕсли;
		Если СтрДлина(Отображение) > 65536 Или СтрДлина(Значение) > 65536 Тогда Результат.complete = Ложь; Продолжить; КонецЕсли;
		Если ТочноРавныUI(Отображение, Текст) Тогда Результат.candidates.Добавить(Новый Структура("text,value", Отображение, Значение)); КонецЕсли;
	КонецЦикла;
	Если РазмерJSONUI(Результат) > 524288 Тогда
		Результат.candidates = Новый Массив; Результат.complete = Ложь;
		Результат.Вставить("reason", "response_size_limit");
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура НаблюдатьФормуВыбораUI(Шаг)
	Выбор = Шаг.args.params.choice;
	Если Выбор.row.Свойство("id") Тогда ОшибкаUI("stale_target"); КонецЕсли;
	ОкноВыбора = РазрешитьОкноUI(Выбор.selection_window);
	Таблица = РазрешитьЭлементUI(ОкноВыбора.ref, Выбор.table);
	Если Таблица.data.type <> "table" Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	Снимок = КандидатыВыделенныхСтрокUI(Таблица.ref, Выбор.row.where);
	Шаг.result.data.Вставить("choice", Снимок);
	Если Снимок.candidates.Количество() > 1 Тогда ОшибкаUI("ambiguous_target"); КонецЕсли;
	ОшибкаUI("choice_search_incomplete");
КонецПроцедуры

&НаКлиенте
Функция ОтборДляВыбораUI(Таблица, Отборы)
	Поля = Таблица.НайтиОбъекты(Тип("ТестируемоеПолеФормы"), , , 0);
	Условия = Новый Соответствие;
	Для Каждого Отбор Из Отборы Цикл
		Колонка = КолонкаТаблицыUI(Поля, Отбор.column);
		Заголовок = Колонка.ТекстЗаголовка;
		Если ПустаяСтрока(Заголовок) Или Условия.Получить(Заголовок) <> Неопределено Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		Для Каждого ДругаяКолонка Из Поля Цикл
			Если ДругаяКолонка <> Колонка И ТочноРавныUI(ДругаяКолонка.ТекстЗаголовка, Заголовок) Тогда ОшибкаUI("ambiguous_target"); КонецЕсли;
		КонецЦикла;
		Если СтрНайти(Отбор.equals, "*") > 0 Или СтрНайти(Отбор.equals, "?") > 0 Тогда ОшибкаUI("unsupported_operation"); КонецЕсли;
		Условия.Вставить(Заголовок, Отбор.equals);
	КонецЦикла;
	Возврат Условия;
КонецФункции

&НаКлиенте
Функция НайтиСтрокуДляВыбораUI(Шаг, Таблица, Условия, ИмяШага)
	Если Таблица.ТекущийРежимРедактирование() Тогда ОшибкаUI("row_edit_pending"); КонецЕсли;
	ПередИзменениемUI(Шаг);
	Таблица.ВыделитьВсеСтроки();
	ИзменениеЗавершеноUI(Шаг, ИмяШага);
	Строки = Таблица.ПолучитьВыделенныеСтроки();
	Если Строки.Количество() > 10000
		Или (Строки.Количество() = 0 И Таблица.ПолучитьТекущуюСтроку() <> Неопределено) Тогда
		ОшибкаUI("choice_search_incomplete");
	КонецЕсли;
	Цель = Неопределено;
	Для Каждого Описание Из Строки Цикл
		Для Каждого Условие Из Условия Цикл
			Если ТипЗнч(Описание.Получить(Условие.Ключ)) <> Тип("Строка") Тогда ОшибкаUI("choice_search_incomplete"); КонецЕсли;
		КонецЦикла;
		Если Не СовпадаетСтрокаUI(Описание, Условия) Тогда Продолжить; КонецЕсли;
		Если Цель <> Неопределено Тогда ОшибкаUI("ambiguous_target"); КонецЕсли;
		Цель = Описание;
	КонецЦикла;
	Если Цель = Неопределено Тогда ОшибкаUI("element_not_found"); КонецЕсли;
	ПередИзменениемUI(Шаг);
	Таблица.ПерейтиКПервойСтроке();
	Если Не СовпадаетСтрокаUI(Таблица.ПолучитьТекущуюСтроку(), Условия) Тогда
		Если Не Таблица.ПерейтиКСтроке(Условия) Тогда ОшибкаUI("stale_target"); КонецЕсли;
	КонецЕсли;
	ИзменениеЗавершеноUI(Шаг, "position_" + ИмяШага);
	Выделение = Таблица.ПолучитьВыделенныеСтроки();
	Если Выделение.Количество() <> 1 Или Не СовпадаетСтрокаUI(Выделение[0], Цель)
		Или Не СовпадаетСтрокаUI(Таблица.ПолучитьТекущуюСтроку(), Цель) Тогда ОшибкаUI("stale_target"); КонецЕсли;
	Возврат Цель;
КонецФункции

&НаКлиенте
Процедура ВыбратьЗначениеЯчейкиUI(Шаг, ИсходноеОкно, Поле)
	Выбор = Шаг.args.params.choice;
	Если Шаг.zero Тогда ОшибкаUI("expectation_timeout"); КонецЕсли;
	Таблица = Поле.ПолучитьРодителя();
	Пока ТипЗнч(Таблица) = Тип("ТестируемаяГруппаФормы") Цикл
		Таблица = Таблица.ПолучитьРодителя();
	КонецЦикла;
	Если ТипЗнч(Таблица) <> Тип("ТестируемаяТаблицаФормы") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	Форма = Таблица.ПолучитьРодителя();
	Пока ТипЗнч(Форма) = Тип("ТестируемаяГруппаФормы") Цикл
		Форма = Форма.ПолучитьРодителя();
	КонецЦикла;
	Если ТипЗнч(Форма) <> Тип("ТестируемаяФорма") Или ТКПриложение.ПолучитьАктивноеОкно() <> ИсходноеОкно Тогда
		ОшибкаUI("target_unavailable");
	КонецЕсли;
	Если Не Таблица.ТекущаяВидимость() Или Не Таблица.ТекущаяДоступность() Или Таблица.ТекущееТолькоПросмотр() Тогда
		ОшибкаUI("target_unavailable");
	КонецЕсли;
	УсловияСтроки = ОтборДляВыбораUI(Таблица, Выбор.source_row.where);
	ЗаголовокПоля = Поле.ТекстЗаголовка;
	Если ПустаяСтрока(ЗаголовокПоля) Или УсловияСтроки.Получить(ЗаголовокПоля) <> Неопределено Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	Данные = Новый Структура("expected,actual,editing,completed_steps", Выбор.expected_text, Неопределено, Ложь, Новый Массив);
	Шаг.result.data = Данные;
	СсылкаОкна = СвойствоUI(ИсходноеОкно, "НавигационнаяСсылка");
	СелекторВозврата = Неопределено;
	Если СсылкаОкна.available И ТипЗнч(СсылкаОкна.value) = Тип("Строка")
		И Лев(СсылкаОкна.value, 11) = "e1cib/data/" И СтрНайти(СсылкаОкна.value, "?ref=") > 11 Тогда
		СелекторВозврата = Новый Структура("selector",
			Новый Структура("navigation_link,form_name", СсылкаОкна.value, Форма.ИмяФормы));
	КонецЕсли;
	СтрокаДо = НайтиСтрокуДляВыбораUI(Шаг, Таблица, УсловияСтроки, "scan_source");
	Данные.Вставить("before", СтрокаДо.Получить(ЗаголовокПоля));
	ИсходныеОкна = ОкнаUI().refs;
	ТекущаяКолонка = Таблица.ПолучитьТекущийЭлемент();
	Данные.Вставить("column_before", ?(ТекущаяКолонка = Неопределено, Неопределено, ТекущаяКолонка.Имя));
	// ИзменитьСтроку действует на текущую ячейку. При открытии сохранённого
	// документа фокус может быть в служебной колонке, например в колонке номера.
	Если Не Поле.ТекущаяВидимость() Или Не Поле.ТекущаяДоступность() Тогда ОшибкаUI("target_unavailable"); КонецЕсли;
	ПередИзменениемUI(Шаг);
	Поле.Активизировать();
	ИзменениеЗавершеноUI(Шаг, "activate_cell");
	Шаг.Вставить("cell_choice", Новый Структура("form,table,field,source_filter,column,previous_windows,stage,return_selector,table_name",
		Форма, Таблица, Поле, УсловияСтроки, ЗаголовокПоля, ИсходныеОкна, "activate", СелекторВозврата, Таблица.Имя));
	Шаг.cell_choice.Вставить("window_wait_until", ТекущаяУниверсальнаяДатаВМиллисекундах() + 5000);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВыборЯчейкиUI(Шаг, Контекст)
	Таблица = Контекст.table;
	Поле = Контекст.field;
	Данные = Шаг.result.data;
	АктивноеОкно = ТКПриложение.ПолучитьАктивноеОкно();
	Если АктивноеОкно = Неопределено Или Не ОкноСодержитФормуUI(АктивноеОкно, Контекст.form) Тогда ОшибкаUI("blocking_window"); КонецЕсли;
	Если Не СовпадаетСтрокаUI(Таблица.ПолучитьТекущуюСтроку(), Контекст.source_filter) Тогда ОшибкаUI("stale_target"); КонецЕсли;
	Если Таблица.ПолучитьТекущийЭлемент() <> Поле Тогда
		Если Контекст.stage = "activate" И ТекущаяУниверсальнаяДатаВМиллисекундах() < Контекст.window_wait_until Тогда Возврат; КонецЕсли;
		ОшибкаUI("stale_target");
	КонецЕсли;
	Данные.Вставить("column_active", Поле.Имя);
	Данные.editing = Таблица.ТекущийРежимРедактирование();
	Если Не Данные.editing Тогда
		Если Контекст.stage = "activate" Тогда
			ПередИзменениемUI(Шаг);
			Таблица.ИзменитьСтроку();
			ИзменениеЗавершеноUI(Шаг, "edit_row");
			Контекст.stage = "editor";
			Контекст.window_wait_until = ТекущаяУниверсальнаяДатаВМиллисекундах() + 5000;
		ИначеЕсли ТекущаяУниверсальнаяДатаВМиллисекундах() >= Контекст.window_wait_until Тогда
			ОшибкаUI("action_not_confirmed");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Не Поле.ТекущаяВидимость() Или Не Поле.ТекущаяДоступность() Или Поле.ТекущееТолькоПросмотр() Тогда ОшибкаUI("target_unavailable"); КонецЕсли;
	ПередИзменениемUI(Шаг);
	Поле.Выбрать();
	ИзменениеЗавершеноUI(Шаг, "open_selection");
	Контекст.stage = "selection";
	Контекст.window_wait_until = ТекущаяУниверсальнаяДатаВМиллисекундах() + 5000;
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыборЯчейкиUI(Шаг)
	Контекст = Шаг.cell_choice;
	Выбор = Шаг.args.params.choice;
	Данные = Шаг.result.data;
	Если ВСпискеUI(Контекст.stage, "activate,editor") Тогда
		ОткрытьВыборЯчейкиUI(Шаг, Контекст);
		Возврат;
	КонецЕсли;
	Если Контекст.stage <> "selection" Тогда
		Если ПроверитьВыборЯчейкиUI(Шаг, Контекст, Данные) Тогда Шаг.Удалить("cell_choice"); КонецЕсли;
		Возврат;
	КонецЕсли;
	ОкноВыбора = Неопределено;
	Попытка
		ОкноКандидат = РазрешитьОкноUI(Выбор.selection_window).ref;
		Если ТКПриложение.ПолучитьАктивноеОкно() = ОкноКандидат Тогда ОкноВыбора = ОкноКандидат; КонецЕсли;
	Исключение
		Код = КодИсключенияUI(ОписаниеОшибки());
		Если Не ВСпискеUI(Код, "window_not_found,action_not_confirmed") Тогда ВызватьИсключение; КонецЕсли;
	КонецПопытки;
	Если ОкноВыбора = Неопределено Тогда
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() < Контекст.window_wait_until Тогда Возврат; КонецЕсли;
		ОшибкаUI("blocking_window");
	КонецЕсли;
	Для Каждого ПрежнееОкно Из Контекст.previous_windows Цикл
		Если ПрежнееОкно = ОкноВыбора Тогда ОшибкаUI("stale_target"); КонецЕсли;
	КонецЦикла;
	ТаблицаВыбора = НайтиТаблицуВыбораUI(ОкноВыбора, Выбор.table.selector.name);
	Если Не ТаблицаВыбора.ТекущаяВидимость() Или Не ТаблицаВыбора.ТекущаяДоступность() Тогда ОшибкаUI("target_unavailable"); КонецЕсли;
	УсловияВыбора = ОтборДляВыбораUI(ТаблицаВыбора, Выбор.row.where);
	Кандидат = НайтиСтрокуДляВыбораUI(Шаг, ТаблицаВыбора, УсловияВыбора, "scan_selection");
	Если ТКПриложение.ПолучитьАктивноеОкно() <> ОкноВыбора
		Или Не СовпадаетСтрокаUI(ТаблицаВыбора.ПолучитьТекущуюСтроку(), Кандидат) Тогда ОшибкаUI("stale_target"); КонецЕсли;
	ПередИзменениемUI(Шаг);
	ИнвалидироватьЦелиUI();
	ТаблицаВыбора.Выбрать();
	ИзменениеЗавершеноUI(Шаг, "choose");
	Контекст.stage = "readback";
	Контекст.window_wait_until = ТекущаяУниверсальнаяДатаВМиллисекундах() + 5000;
КонецПроцедуры

&НаКлиенте
Функция НайтиТаблицуВыбораUI(Окно, ИмяТаблицы)
	Таблица = Неопределено;
	Для Каждого Кандидат Из Окно.НайтиОбъекты(Тип("ТестируемаяТаблицаФормы"), , ИмяТаблицы, 1) Цикл
		Если Не ТочноРавныUI(Кандидат.Имя, ИмяТаблицы) Тогда Продолжить; КонецЕсли;
		Если Таблица <> Неопределено Тогда ОшибкаUI("ambiguous_target"); КонецЕсли;
		Таблица = Кандидат;
	КонецЦикла;
	Если Таблица = Неопределено Тогда ОшибкаUI("element_not_found"); КонецЕсли;
	Возврат Таблица;
КонецФункции

&НаКлиенте
Функция ПроверитьВыборЯчейкиUI(Шаг, Контекст, Данные)
	ОткрытаИсходнаяФорма = Ложь;
	ВозвратноеОкно = Неопределено;
	Попытка
		ВозвратноеОкно = ТКПриложение.ПолучитьАктивноеОкно();
		ОткрытаИсходнаяФорма = ВозвратноеОкно <> Неопределено И ОкноСодержитФормуUI(ВозвратноеОкно, Контекст.form);
	Исключение
		// Повторяем только наблюдение перехода окон.
	КонецПопытки;
	Таблица = Контекст.table;
	Если Не ОткрытаИсходнаяФорма И ВозвратноеОкно <> Неопределено И Контекст.return_selector <> Неопределено Тогда
		Попытка
			СсылкаСовпала = ТочноРавныUI(ВозвратноеОкно.НавигационнаяСсылка, Контекст.return_selector.selector.navigation_link);
			Если СсылкаСовпала И РазрешитьОкноUI(Контекст.return_selector).ref = ВозвратноеОкно Тогда
				Таблица = НайтиТаблицуВыбораUI(ВозвратноеОкно, Контекст.table_name);
				ОткрытаИсходнаяФорма = Истина;
				Данные.Вставить("return_binding", "navigation_link");
			КонецЕсли;
		Исключение
			Код = КодИсключенияUI(ОписаниеОшибки());
			Если Код = "ambiguous_target" Тогда ВызватьИсключение; КонецЕсли;
		КонецПопытки;
	КонецЕсли;
	Если Не ОткрытаИсходнаяФорма Тогда
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() < Контекст.window_wait_until Тогда Возврат Ложь; КонецЕсли;
		ОшибкаUI("blocking_window");
	КонецЕсли;
	Если Контекст.stage = "readback" И Таблица.ТекущийРежимРедактирование() Тогда
		Если Не СовпадаетСтрокаUI(Таблица.ПолучитьТекущуюСтроку(), Контекст.source_filter) Тогда ОшибкаUI("stale_target"); КонецЕсли;
		ПередИзменениемUI(Шаг);
		Таблица.ЗакончитьРедактированиеСтроки(Ложь);
		ИзменениеЗавершеноUI(Шаг, "finish_row");
		Контекст.stage = "verify_row";
		Контекст.window_wait_until = ТекущаяУниверсальнаяДатаВМиллисекундах() + 5000;
		Возврат Ложь;
	КонецЕсли;
	Данные.editing = Таблица.ТекущийРежимРедактирование();
	Если Данные.editing Тогда ОшибкаUI("row_edit_pending"); КонецЕсли;
	СтрокаПосле = Таблица.ПолучитьТекущуюСтроку();
	Если СтрокаПосле = Неопределено Тогда
		// После завершения редактора строка может остаться выделенной без текущей строки.
		Выделение = Таблица.ПолучитьВыделенныеСтроки();
		Если Выделение.Количество() = 1 Тогда СтрокаПосле = Выделение[0]; КонецЕсли;
	КонецЕсли;
	Если Не СовпадаетСтрокаUI(СтрокаПосле, Контекст.source_filter) Тогда ОшибкаUI("stale_target"); КонецЕсли;
	Данные.actual = СтрокаПосле.Получить(Контекст.column);
	Если Не ТочноРавныUI(Данные.actual, Данные.expected) Тогда ОшибкаUI("action_not_confirmed"); КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция КандидатыВыделенныхСтрокUI(Таблица, Отборы)
	// Чтение существующего выделения не меняет курсор. Это не вся таблица.
	Снимок = Новый Структура("scope,complete,candidates,reason,cursor_changed,selection_changed",
		"selected_rows", Ложь, Новый Массив, "stable_row_identity_unavailable", Ложь, Ложь);
	Колонки = Таблица.НайтиОбъекты(Тип("ТестируемоеПолеФормы"), , , 0);
	Заголовки = Новый Соответствие;
	Для Каждого Отбор Из Отборы Цикл
		ЗаголовокКолонки = Неопределено; ЧислоИмен = 0;
		Для Каждого Колонка Из Колонки Цикл
			Если ТочноРавныUI(Колонка.Имя, Отбор.column) Тогда
				ЧислоИмен = ЧислоИмен + 1; ЗаголовокКолонки = Колонка.ТекстЗаголовка;
			КонецЕсли;
		КонецЦикла;
		Если ЧислоИмен = 0 Тогда ОшибкаUI("element_not_found"); КонецЕсли;
		Если ЧислоИмен > 1 Тогда ОшибкаUI("ambiguous_target"); КонецЕсли;
		ЧислоЗаголовков = 0;
		Для Каждого Колонка Из Колонки Цикл
			Если ТочноРавныUI(Колонка.ТекстЗаголовка, ЗаголовокКолонки) Тогда ЧислоЗаголовков = ЧислоЗаголовков + 1; КонецЕсли;
		КонецЦикла;
		Если ЧислоЗаголовков <> 1 Тогда Возврат Снимок; КонецЕсли;
		Заголовки.Вставить(Отбор.column, ЗаголовокКолонки);
	КонецЦикла;
	СтрокиВыделения = Таблица.ПолучитьВыделенныеСтроки();
	Если СтрокиВыделения.Количество() > 500 Тогда Снимок.reason = "candidate_limit"; Возврат Снимок; КонецЕсли;
	Для Каждого ОписаниеСтроки Из СтрокиВыделения Цикл
		Значения = Новый Массив; Совпало = Истина;
		Для Каждого Отбор Из Отборы Цикл
			Текст = ОписаниеСтроки.Получить(Заголовки.Получить(Отбор.column));
			Если ТипЗнч(Текст) <> Тип("Строка") Или СтрДлина(Текст) > 65536 Тогда Возврат Снимок; КонецЕсли;
			Значения.Добавить(Новый Структура("column,text", Отбор.column, Текст));
			Совпало = Совпало И ТочноРавныUI(Текст, Отбор.equals);
		КонецЦикла;
		// Каждое описание остаётся отдельным кандидатом, даже если тексты равны.
		Если Совпало Тогда Снимок.candidates.Добавить(Новый Структура("values,identity_confirmed", Значения, Ложь)); КонецЕсли;
		Если РазмерJSONUI(Снимок) > 524288 Тогда
			Снимок.candidates = Новый Массив; Снимок.reason = "response_size_limit"; Возврат Снимок;
		КонецЕсли;
	КонецЦикла;
	Возврат Снимок;
КонецФункции

&НаКлиенте
Процедура ВыполнитьДействиеUI(Шаг)
	Аргументы = Шаг.args;
	ЦелевоеОкно = РазрешитьОкноUI(Аргументы.window);
	// Завершение приложения идёт через stop с доказательством владения процессом.
	Если Аргументы.action = "close" И ЦелевоеОкно.ref.Основное Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	СсылкаДействия = ЦелевоеОкно.ref;
	ГруппаСтраниц = Неопределено;
	Если Аргументы.Свойство("element") Тогда
		Узел = РазрешитьЭлементUI(ЦелевоеОкно.ref, Аргументы.element);
		СсылкаДействия = Узел.ref;
		Если Аргументы.action = "click" И Не ВСпискеUI(Узел.data.type, "button,command_button") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		Если Аргументы.action = "select_page" Тогда
			Если Узел.data.type <> "group" Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			Если СсылкаДействия.Вид <> ВидГруппыФормы.Страница Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			ГруппаСтраниц = СсылкаДействия.ПолучитьРодителя();
			Если ТипЗнч(ГруппаСтраниц) <> Тип("ТестируемаяГруппаФормы") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			Если ГруппаСтраниц.Вид <> ВидГруппыФормы.Страницы Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		КонецЕсли;
		Если ВСпискеUI(Аргументы.action, "expand,collapse") И Узел.data.type <> "command_group" Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		Если Узел.data.scope <> "command_interface" Тогда
			Если Узел.data.enabled <> Истина Или (Аргументы.action <> "select_page" И Узел.data.visible <> Истина)
				Или Не СсылкаДействия.ТекущаяВидимость() Или Не СсылкаДействия.ТекущаяДоступность() Тогда ОшибкаUI("target_unavailable"); КонецЕсли;
		КонецЕсли;
		// У командного интерфейса нет CurrentEnable/CurrentVisible. Цель только из
		// полного свежего нативного дерева; права дополнительно проверяет платформа.

	КонецЕсли;
	Шаг.result.data = Новый Структура("action,completed_steps,observation_complete,verification_scope",
		Аргументы.action, Новый Массив, Ложь, ?(Аргументы.action = "click", "invocation_and_observation", "observed_ui_state"));
	Шаг.Вставить("acted_window", ЦелевоеОкно.ref);
	Шаг.Вставить("acted_element", СсылкаДействия);
	Шаг.Вставить("acted_page_group", ГруппаСтраниц);
	Шаг.Вставить("command_interface_action", Аргументы.Свойство("element") И Узел.data.scope = "command_interface");
	Если Аргументы.action = "click" И ТКДиалогОстановки <> Неопределено И ТКВладелец
		И ЦелевоеОкно.ref = ТКДиалогОстановки.ref
		И Узел.data.name = "Button0" И Узел.data.title = "Завершить работу" Тогда
		Шаг.Вставить("stop_dialog_answer", Истина);
	КонецЕсли;
	ПередИзменениемUI(Шаг);
	Если Аргументы.action = "click" Тогда
		Попытка
			СсылкаДействия.Нажать();
		Исключение
			Если Не Шаг.Свойство("stop_dialog_answer") Тогда ВызватьИсключение; КонецЕсли;
			// Завершившийся клиент может разорвать API до возврата из Нажать.
			НачатьНаблюдениеДействияUI(Шаг, "action");
			Возврат;
		КонецПопытки;
	ИначеЕсли Аргументы.action = "expand" Тогда
		СсылкаДействия.Развернуть();
	ИначеЕсли Аргументы.action = "collapse" Тогда
		СсылкаДействия.Свернуть();
	ИначеЕсли Аргументы.action = "close" Тогда
		СсылкаДействия.Закрыть();
	Иначе
		СсылкаДействия.Активизировать();
	КонецЕсли;
	ИзменениеЗавершеноUI(Шаг, "action");
	НачатьНаблюдениеДействияUI(Шаг, "action");
КонецПроцедуры

&НаКлиенте
Процедура НачатьНаблюдениеДействияUI(Шаг, Вид)
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Шаг.Вставить("observation", Вид);
	// Процесс после ответа в диалоге может завершаться дольше перехода окон.
	Срок = ?(Шаг.Свойство("stop_dialog_answer"), Шаг.deadline, Мин(Шаг.deadline, Сейчас + 10000));
	Шаг.Вставить("observation_deadline", ?(Шаг.zero, Сейчас, Срок));
КонецПроцедуры

&НаКлиенте
Функция ПродолжитьНаблюдениеДействияUI(Шаг)
	Код = "action_not_confirmed";
	Попытка
		Если Шаг.Свойство("stop_dialog_answer") Тогда
			Если Не ПроцессЖив(ТКПроцесс) И ТКДиагностика.process_state = "Exited" Тогда
				ТКСостояние = "stopped"; ТКВладелец = Ложь;
				Шаг.Вставить("disconnect_after_observation", Истина);
				Шаг.result.data.Вставить("closed", Истина);
				Шаг.result.data.Вставить("process_state", "Exited");
				Шаг.result.data.verification_scope = "observed_process_exit";
				Шаг.result.data.observation_complete = Истина;
				Возврат Истина;
			КонецЕсли;
		Иначе
			ОкнаПосле = ОкнаUI();
			Если Шаг.observation = "open" Тогда
				Шаг.result.data.windows = ОкнаПосле.data;
				Если ОткрытиеПодтвержденоUI(Шаг, ОкнаПосле) Тогда Возврат Истина; КонецЕсли;
			ИначеЕсли Шаг.observation = "check" Тогда
				Если ФлажокПодтвержденUI(Шаг, ОкнаПосле) Тогда Возврат Истина; КонецЕсли;
			ИначеЕсли ДействиеПодтвержденоUI(Шаг, ОкнаПосле) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Код = КодИсключенияUI(ОписаниеОшибки());
		Если Не ВСпискеUI(Код, "action_not_confirmed,value_unavailable,window_not_found,element_not_found") Тогда
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Шаг.observation_deadline Тогда ОшибкаUI(Код); КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция ДействиеПодтвержденоUI(Шаг, ОкнаПосле)
	Действие = Шаг.args.action;
	Данные = Шаг.result.data;
	Данные.Вставить("windows", ОкнаПосле.data);
	Данные.Вставить("closed", ОкнаПосле.refs.Найти(Шаг.acted_window) = Неопределено);
	Данные.Вставить("target_active", ОкнаПосле.active = Шаг.acted_window);
	Данные.Вставить("active_window", АктивноеОкноИзСнимкаUI(ОкнаПосле));
	Если ВСпискеUI(Действие, "expand,collapse") И ТипЗнч(Шаг.acted_element) = Тип("ТестируемаяГруппаКомандногоИнтерфейса") Тогда
		// Наличие дочерних команд одинаково у закрытого и открытого меню.
		Данные.Вставить("reason", "group_state_unobservable");
		Шаг.observation_deadline = 0;
		Возврат Ложь;
	КонецЕсли;
	Если Действие = "close" Тогда
		Диалог = АктивныйДиалогUI(ОкнаПосле);
		Если Диалог <> Неопределено Тогда
			Данные.Вставить("blocking_window", Диалог);
			ОшибкаUI("blocking_window");
		КонецЕсли;
		Если Не Данные.closed Тогда Возврат Ложь; КонецЕсли;
	ИначеЕсли Действие = "activate_window" И Не Данные.target_active Тогда
		Возврат Ложь;
	ИначеЕсли Действие = "select_page" Тогда
		ТекущаяСтраница = Шаг.acted_page_group.ПолучитьТекущуюСтраницу();
		Данные.Вставить("current_page", ТекущаяСтраница.Имя);
		Если ТекущаяСтраница <> Шаг.acted_element Тогда Возврат Ложь; КонецЕсли;
	КонецЕсли;
	Если ТКДиалогОстановки <> Неопределено И ОкнаПосле.refs.Найти(ТКДиалогОстановки.ref) = Неопределено Тогда
		ТКДиалогОстановки = Неопределено;
	КонецЕсли;
	НаблюдатьДействиеUI(Шаг, ОкнаПосле.active);
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура НаблюдатьДействиеUI(Шаг, АктивноеОкно)
	Данные = Шаг.result.data;
	Если Шаг.command_interface_action Тогда
		Данные.Вставить("observation_reason", "command_interface_window_snapshot");
		Возврат;
	КонецЕсли;
	ИсходныйСрок = Шаг.deadline;
	Шаг.deadline = Шаг.observation_deadline;
	Попытка
	Если АктивноеОкно <> Неопределено Тогда
		Дерево = ДеревоUI(АктивноеОкно, АктивноеОкно, 6, 200);
		Дерево.Удалить("flat");
		Данные.Вставить("active_window_tree", Дерево);
		ОграничитьНаблюдениеДействияUI(Шаг);
		Если Дерево.reason = "timeout" Тогда ОшибкаUI("value_unavailable"); КонецЕсли;
		Сообщения = Новый Массив;
		Данные.Вставить("user_messages_available", Ложь);
		ТекстыСообщений = Новый Массив;
		Попытка
			ТекстыСообщений = АктивноеОкно.ПолучитьТекстыСообщенийПользователю();
			Данные.user_messages_available = Истина;
		Исключение
			// Документированное исключение при закрытой панели, не доказательство отсутствия сообщений.
			Если СтрНайти(ОписаниеОшибки(), "Метод не может быть вызван для данного объекта") = 0 Тогда ОшибкаUI("value_unavailable"); КонецЕсли;
			Данные.Вставить("user_messages_reason", "messages_panel_closed");
		КонецПопытки;
		Для Каждого ТекстСообщения Из ТекстыСообщений Цикл
			Если Сообщения.Количество() >= 500 Или СтрДлина(ТекстСообщения) > 65536 Тогда ОшибкаUI("value_unavailable"); КонецЕсли;
			Сообщения.Добавить(Новый Структура("text", ТекстСообщения));
		КонецЦикла;
		Данные.Вставить("user_messages", Сообщения);
	КонецЕсли;
	ОграничитьНаблюдениеДействияUI(Шаг);
	Данные.observation_complete = Истина;
	Исключение
		// Недоступная дополнительная диагностика не отменяет подтверждённый результат.
		Данные.Вставить("observation_reason", "diagnostics_incomplete");
	КонецПопытки;
	Шаг.deadline = ИсходныйСрок;
КонецПроцедуры

&НаКлиенте
Процедура ОграничитьНаблюдениеДействияUI(Шаг)
	Если РазмерJSONUI(Шаг.result.data) <= 1048576 Тогда Возврат; КонецЕсли;
	Шаг.result.data.Удалить("active_window_tree");
	Шаг.result.data.Удалить("user_messages");
	Шаг.result.data.Вставить("truncated", Истина);
	Шаг.result.data.Вставить("reason", "response_size_limit");
	ОшибкаUI("value_unavailable");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПараметрыТаблицыUI(Действие, П)
	Если Действие = "read" Тогда
		ПроверитьКлючиUI(П, "", "allow_navigation,limit,cursor");
		Если П.Свойство("limit") Тогда ПроверитьЧислоUI(П.limit, 1, 500); КонецЕсли;
	ИначеЕсли Действие = "find" Тогда
		ПроверитьКлючиUI(П, "row", "allow_navigation");
	ИначеЕсли Действие = "add" Тогда
		ПроверитьКлючиUI(П, "", "values");
	ИначеЕсли Действие = "fill" Тогда
		ПроверитьКлючиUI(П, "row,values", "");
	ИначеЕсли ВСпискеUI(Действие, "select,delete") Тогда
		ПроверитьКлючиUI(П, "row", "");
	Иначе ОшибкаUI("unsupported_operation");
	КонецЕсли;
	Если П.Свойство("allow_navigation") И ТипЗнч(П.allow_navigation) <> Тип("Булево") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	Если П.Свойство("row") Тогда
		Если П.row.Свойство("id") Тогда
			ПроверитьКлючиUI(П.row, "id,snapshot_id", "");
		Иначе
			ПроверитьКлючиUI(П.row, "where", "");
			Если ТипЗнч(П.row.where) <> Тип("Массив") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			ПроверитьЧислоUI(П.row.where.Количество(), 1, 100);
			Для Каждого Отбор Из П.row.where Цикл
				ПроверитьКлючиUI(Отбор, "column,equals", "");
				ПроверитьСтрокуUI(Отбор.column, 256);
				Если ТипЗнч(Отбор.equals) <> Тип("Строка") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если П.Свойство("values") Тогда
		Если ТипЗнч(П.values) <> Тип("Массив") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
		ПроверитьЧислоUI(П.values.Количество(), ?(Действие = "fill", 1, 0), 100);
		Для Каждого Яч Из П.values Цикл
			Если Яч.Свойство("text") Тогда
				ПроверитьКлючиUI(Яч, "column,text", "");
				Если ТипЗнч(Яч.text) <> Тип("Строка") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			ИначеЕсли Яч.Свойство("number") Тогда
				ПроверитьКлючиUI(Яч, "column,number", "");
				Если ТипЗнч(Яч.number) <> Тип("Число") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			Иначе
				ПроверитьКлючиUI(Яч, "column,checked", "");
				Если ТипЗнч(Яч.checked) <> Тип("Булево") Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			КонецЕсли;
			ПроверитьСтрокуUI(Яч.column, 256);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция КолонкаТаблицыUI(Поля, ИмяКолонки)
	Цель = Неопределено;
	Для Каждого Поле Из Поля Цикл
		Если ТочноРавныUI(Поле.Имя, ИмяКолонки) Или ТочноРавныUI(Поле.ТекстЗаголовка, ИмяКолонки) Тогда
			Если Цель <> Неопределено Тогда ОшибкаUI("ambiguous_target"); КонецЕсли;
			Цель = Поле;
		КонецЕсли;
	КонецЦикла;
	Если Цель = Неопределено Тогда ОшибкаUI("element_not_found"); КонецЕсли;
	Для Каждого Поле Из Поля Цикл
		Если Поле <> Цель И ТочноРавныUI(Поле.ТекстЗаголовка, Цель.ТекстЗаголовка) Тогда ОшибкаUI("ambiguous_target"); КонецЕсли;
	КонецЦикла;
	Возврат Цель;
КонецФункции

&НаКлиенте
Функция СовпадаетСтрокаUI(Описание, Условия)
	Если Описание = Неопределено Тогда Возврат Ложь; КонецЕсли;
	Для Каждого Пара Из Условия Цикл
		Если Описание.Получить(Пара.Ключ) = Неопределено Или Не ТочноРавныUI(Описание.Получить(Пара.Ключ), Пара.Значение) Тогда Возврат Ложь; КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ПроверитьРедактированиеТаблицыUI(Таблица, Данные)
	Данные.Вставить("editing", Таблица.ТекущийРежимРедактирование());
	Если Не Данные.editing Тогда Возврат; КонецЕсли;
	Данные.Вставить("pending_row", Неопределено);
	Попытка
		ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
		Если ТекущаяСтрока <> Неопределено Тогда
			Ячейки = Новый Массив;
			Для Каждого Пара Из ТекущаяСтрока Цикл
				Ячейки.Добавить(Новый Структура("column,text", Пара.Ключ, Пара.Значение));
			КонецЦикла;
			Если РазмерJSONUI(Ячейки) <= 65536 Тогда Данные.pending_row = Ячейки; КонецЕсли;
		КонецЕсли;
	Исключение
		Данные.Вставить("pending_row_reason", "row_observation_failed");
	КонецПопытки;
	Если Данные.pending_row = Неопределено И Не Данные.Свойство("pending_row_reason") Тогда
		Данные.Вставить("pending_row_reason", "row_unavailable_or_over_budget");
	КонецЕсли;
	ОшибкаUI("row_edit_pending");
КонецПроцедуры

&НаКлиенте
Процедура НаблюдатьКурсорТаблицыUI(Таблица, Данные, ИсходнаяСтрока)
	Данные.Вставить("cursor_restoration", "unverified");
	Данные.Вставить("cursor_change_verified", Ложь);
	Попытка
		ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
		ТекстИзменился = ?(ИсходнаяСтрока = Неопределено, ТекущаяСтрока <> Неопределено,
			Не СовпадаетСтрокаUI(ТекущаяСтрока, ИсходнаяСтрока));
		Данные.Вставить("current_row_text_changed", ТекстИзменился);
		Данные.Вставить("cursor_changed", ТекстИзменился);
	Исключение
		Данные.Вставить("current_row_text_changed", Неопределено);
		Данные.Вставить("cursor_changed", Неопределено);
		Данные.Вставить("cursor_observation_reason", "row_observation_failed");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТаблицуUI(Шаг)
	А = Шаг.args; П = А.params;
	Шаг.Вставить("diagnostic_stage", "resolve");
	ЦелевоеОкно = РазрешитьОкноUI(А.window);
	Узел = РазрешитьЭлементUI(ЦелевоеОкно.ref, А.element);
	Если Узел.data.type <> "table" Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	Т = Узел.ref;
	Д = Новый Структура("action,scope,complete,rows,completed_steps,selection_changed", А.action, "selected_rows", Ложь, Новый Массив, Новый Массив, Ложь);
	Шаг.result.data = Д;
	Д.Вставить("identity", Новый Структура("status,reason", "unavailable", "stable_row_identity_unavailable"));
	Д.Вставить("cursor_changed", Ложь);
	Д.Вставить("cursor_change_verified", Истина);
	Д.Вставить("cursor_restoration", "not_needed");
	ПоСнимку = П.Свойство("row") И П.row.Свойство("id");
	Страница = П.Свойство("cursor");
	Снимок = ТКТабличныйСнимок;
	Если ПоСнимку Или Страница Тогда
		Если Снимок = Неопределено Или Снимок.table <> Т Или Снимок.window <> ЦелевоеОкно.ref Или Снимок.session <> А.session_id Тогда ОшибкаUI("stale_target"); КонецЕсли;
		Если ПоСнимку И (П.row.snapshot_id <> Снимок.id Или Снимок.ids.Получить(П.row.id) = Неопределено) Тогда ОшибкаUI("stale_target"); КонецЕсли;
		Если Страница И Снимок.cursors.Получить(П.cursor) = Неопределено Тогда ОшибкаUI("stale_target"); КонецЕсли;
	КонецЕсли;
	Если Узел.data.visible <> Истина Или Не Т.ТекущаяВидимость() Тогда ОшибкаUI("target_unavailable"); КонецЕсли;
	Запись = ВСпискеUI(А.action, "add,fill,delete");
	Навигация = Не ВСпискеUI(А.action, "read,find");
	Если П.Свойство("allow_navigation") Тогда Навигация = П.allow_navigation; КонецЕсли;
	Если ПоСнимку И (Не Навигация Или Снимок.scope <> "ui_table") Тогда ОшибкаUI("incomplete_search"); КонецЕсли;
	// Позиция и тексты снимка не подтверждают нативную идентичность строки для записи.
	Если ПоСнимку И Запись Тогда ОшибкаUI("incomplete_search"); КонецЕсли;
	Если Навигация И Не Страница Тогда
		Если Узел.data.enabled <> Истина Или Не Т.ТекущаяДоступность() Тогда ОшибкаUI("target_unavailable"); КонецЕсли;
		Если Запись И Т.ТекущееТолькоПросмотр() Тогда ОшибкаUI("target_unavailable"); КонецЕсли;
		ПроверитьРедактированиеТаблицыUI(Т, Д);
	КонецЕсли;
	Поля = Т.НайтиОбъекты(Тип("ТестируемоеПолеФормы"), , , 0);
	Условия = Новый Соответствие;
	Если ПоСнимку Тогда
		Условия = Снимок.ids.Получить(П.row.id);
	ИначеЕсли П.Свойство("row") Тогда
		Для Каждого Отбор Из П.row.where Цикл
			Заг = КолонкаТаблицыUI(Поля, Отбор.column).ТекстЗаголовка;
			Если Условия.Получить(Заг) <> Неопределено Тогда ОшибкаUI("invalid_params"); КонецЕсли;
			Условия.Вставить(Заг, Отбор.equals);
		КонецЦикла;
	КонецЕсли;
	Редакторы = Новый Массив;
	Если П.Свойство("values") Тогда
		Д.Вставить("cell_steps", Новый Массив);
		Д.Вставить("rollback_performed", Ложь);
		Для Каждого Яч Из П.values Цикл
			Д.cell_steps.Добавить(Новый Структура("column,status", Яч.column, "not_started"));
		КонецЦикла;
		Для Каждого Яч Из П.values Цикл
			Поле = КолонкаТаблицыUI(Поля, Яч.column);
			Если Не Поле.ТекущаяДоступность() Или Поле.ТекущееТолькоПросмотр() Тогда ОшибкаUI("target_unavailable"); КонецЕсли;
			Редакторы.Добавить(Поле);
		КонецЦикла;
	КонецЕсли;
	Если Навигация И Не Страница Тогда
		ИсходнаяСтрока = Т.ПолучитьТекущуюСтроку();
		ПередИзменениемUI(Шаг);
		Т.ВыделитьВсеСтроки();
		ИзменениеЗавершеноUI(Шаг, "select_all");
		Д.selection_changed = Истина; Д.scope = "ui_table";
		НаблюдатьКурсорТаблицыUI(Т, Д, ИсходнаяСтрока);
	КонецЕсли;
	Если Страница Тогда
		Строки = Снимок.items;
	Иначе
		Строки = Т.ПолучитьВыделенныеСтроки();
		Если Строки.Количество() > 10000
			Или (Навигация И Строки.Количество() = 0 И Т.ПолучитьТекущуюСтроку() <> Неопределено) Тогда
			ОшибкаUI("incomplete_search");
		КонецЕсли;
	КонецЕсли;
	Если ПоСнимку И Снимок.scope = "ui_table" И Навигация Тогда
		Если Строки.Количество() <> Снимок.items.Количество() Тогда ОшибкаUI("stale_target"); КонецЕсли;
		Для Инд = 0 По Строки.Количество()-1 Цикл
			Если Не СовпадаетСтрокаUI(Строки[Инд], Снимок.items[Инд]) Тогда ОшибкаUI("stale_target"); КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Начало = 0;
	Если Страница Тогда
		// Продолжение сохранённого снимка не перемещает курсор и не перечитывает страницу.
		Начало = Снимок.cursors.Получить(П.cursor); Д.scope = Снимок.scope;
	ИначеЕсли А.action = "read" Или А.action = "find" Тогда
		Снимок = Новый Структура("id,items,ids,cursors,scope,table,window,session", Строка(Новый УникальныйИдентификатор), Строки, Новый Соответствие, Новый Соответствие, Д.scope, Т, ЦелевоеОкно.ref, А.session_id);
		ТКТабличныйСнимок = Снимок;
	КонецЕсли;
	Лимит = 100; П.Свойство("limit", Лимит);
	Если Лимит = Неопределено Тогда Лимит = 100; КонецЕсли;
	Д.Вставить("observed_count", Строки.Количество());
	Д.complete = Д.scope = "ui_table";
	Совпадения = 0;
	Для Номер = Начало По Строки.Количество()-1 Цикл
		Описание = Строки[Номер];
		Для Каждого Пара Из Условия Цикл
			Если ТипЗнч(Описание.Получить(Пара.Ключ)) <> Тип("Строка") Тогда
				Д.complete = Ложь;
				ОшибкаUI("incomplete_search");
			КонецЕсли;
		КонецЦикла;
		Если Не СовпадаетСтрокаUI(Описание, Условия) Тогда Продолжить; КонецЕсли;
		Совпадения = Совпадения + 1; Цель = Описание;
		Если ВСпискеUI(А.action, "read,find") И Д.rows.Количество() < Лимит Тогда
			Ячейки = Новый Массив;
			Для Каждого Пара Из Описание Цикл Ячейки.Добавить(Новый Структура("column,text", Пара.Ключ, Пара.Значение)); КонецЦикла;
			ИдСтроки = Строка(Номер + 1);
			Снимок.ids.Вставить(ИдСтроки, Описание);
			Д.Вставить("snapshot_id", Снимок.id);
			Д.rows.Добавить(Новый Структура("values,id,snapshot_id", Ячейки, ИдСтроки, Снимок.id));
			Если РазмерJSONUI(Д) > 524288 Тогда ОшибкаUI("value_unavailable"); КонецЕсли;
		КонецЕсли;
		Если А.action = "read" И Совпадения >= Лимит Тогда Прервать; КонецЕсли;
	КонецЦикла;
	Если А.action = "read" Тогда
		Д.Вставить("truncated", Строки.Количество() > Начало + Лимит);
		Если Д.truncated Тогда
			Курсор = Строка(Новый УникальныйИдентификатор);
			Снимок.cursors.Вставить(Курсор, Начало + Лимит);
			Д.Вставить("next_cursor", Курсор);
		КонецЕсли;
		Д.complete = Д.complete И Не Д.truncated; Возврат;
	КонецЕсли;
	Если А.action <> "add" Тогда
		Шаг.Вставить("diagnostic_stage", "resolve");
		Если Совпадения > 1 Тогда ОшибкаUI("ambiguous_target"); КонецЕсли;
		Если Не Д.complete Тогда ОшибкаUI("incomplete_search"); КонецЕсли;
		Если Совпадения = 0 Тогда ОшибкаUI("element_not_found"); КонецЕсли;
		Если А.action = "find" Тогда Возврат; КонецЕсли;
		Для Каждого Пара Из Условия Цикл
			Если СтрНайти(Пара.Значение, "*") > 0 Или СтрНайти(Пара.Значение, "?") > 0 Тогда ОшибкаUI("unsupported_operation"); КонецЕсли;
		КонецЦикла;
		ПередИзменениемUI(Шаг);
		Т.ПерейтиКПервойСтроке();
		Если Не СовпадаетСтрокаUI(Т.ПолучитьТекущуюСтроку(), Условия) Тогда
			Если Не Т.ПерейтиКСтроке(Условия) Тогда ОшибкаUI("stale_target"); КонецЕсли;
		КонецЕсли;
		ИзменениеЗавершеноUI(Шаг, "select");
		НаблюдатьКурсорТаблицыUI(Т, Д, ИсходнаяСтрока);
		Выделение = Т.ПолучитьВыделенныеСтроки();
		Если Выделение.Количество() <> 1 Или Не СовпадаетСтрокаUI(Выделение[0], Цель) Или Не СовпадаетСтрокаUI(Т.ПолучитьТекущуюСтроку(), Цель) Тогда ОшибкаUI("stale_target"); КонецЕсли;
		Если А.action = "select" Тогда Возврат; КонецЕсли;
	КонецЕсли;
	ПередИзменениемUI(Шаг);
	ИнвалидироватьЦелиUI();
	Если А.action = "delete" Тогда
		Т.УдалитьСтроку();
	ИначеЕсли А.action = "add" Тогда
		Т.ДобавитьСтроку();
	Иначе
		Т.ИзменитьСтроку();
	КонецЕсли;
	ИзменениеЗавершеноUI(Шаг, А.action);
	Если А.action <> "delete" Тогда
		Если Не Т.ТекущийРежимРедактирование() Тогда ОшибкаUI("action_not_confirmed"); КонецЕсли;
		Для Инд = 0 По Редакторы.Количество()-1 Цикл
			Поле = Редакторы[Инд]; Яч = П.values[Инд];
			Д.Вставить("next_cell", Инд);
			ПередИзменениемUI(Шаг);
			Д.cell_steps[Инд].status = "unknown";
			Поле.Активизировать();
			Если Яч.Свойство("text") Тогда
				Если Яч.text = "" Тогда Поле.Очистить(); Иначе Поле.ВвестиТекст(Яч.text); КонецЕсли;
			ИначеЕсли Яч.Свойство("number") Тогда
				Поле.ВвестиТекст(Формат(Яч.number, "ЧГ=0;ЧН=0"));
			ИначеЕсли ЗначениеВводаUI(Поле, Истина) <> Яч.checked Тогда Поле.УстановитьОтметку();
			КонецЕсли;
			Д.cell_steps[Инд].status = "invoked";
			Д.Вставить("next_cell", Инд + 1);
			ИзменениеЗавершеноUI(Шаг, "cell");
		КонецЦикла;
		ПередИзменениемUI(Шаг); Т.ЗакончитьРедактированиеСтроки(Ложь); ИзменениеЗавершеноUI(Шаг, "finish");
		ПроверитьРедактированиеТаблицыUI(Т, Д);
		Факт = Т.ПолучитьТекущуюСтроку();
		Если Факт = Неопределено Тогда ОшибкаUI("action_not_confirmed"); КонецЕсли;
		Значения = Новый Массив; ОтборСтроки = Новый Массив;
		Для Каждого Пара Из Факт Цикл
			Значения.Добавить(Новый Структура("column,text", Пара.Ключ, Пара.Значение));
			ОтборСтроки.Добавить(Новый Структура("column,equals", Пара.Ключ, Пара.Значение));
		КонецЦикла;
		Д.rows.Добавить(Новый Структура("values,selector", Значения, Новый Структура("where", ОтборСтроки)));
		Для Инд = 0 По Редакторы.Количество()-1 Цикл
			Яч = П.values[Инд]; Поле = Редакторы[Инд];
			Если Яч.Свойство("text") Тогда
				Если Не ТочноРавныUI(Факт.Получить(Поле.ТекстЗаголовка), Яч.text) Тогда ОшибкаUI("action_not_confirmed"); КонецЕсли;
			ИначеЕсли Яч.Свойство("number") Тогда
				Отображение = Факт.Получить(Поле.ТекстЗаголовка);
				Если Не ЗначениеЗаполнено(Отображение) Или Число(Отображение) <> Яч.number Тогда ОшибкаUI("action_not_confirmed"); КонецЕсли;
			ИначеЕсли ЗначениеВводаUI(Поле, Истина) <> Яч.checked Тогда ОшибкаUI("action_not_confirmed");
			КонецЕсли;
			Д.cell_steps[Инд].status = "confirmed";
		КонецЦикла;
	КонецЕсли;
	ПередИзменениемUI(Шаг); Т.ВыделитьВсеСтроки(); ИзменениеЗавершеноUI(Шаг, "verify_count");
	НаблюдатьКурсорТаблицыUI(Т, Д, ИсходнаяСтрока);
	После = Т.ПолучитьВыделенныеСтроки();
	Если После.Количество() <> Строки.Количество() + ?(А.action = "add", 1, ?(А.action = "delete", -1, 0)) Тогда ОшибкаUI("action_not_confirmed"); КонецЕсли;
	Если А.action = "delete" Тогда
		Для Каждого Описание Из После Цикл
			Если СовпадаетСтрокаUI(Описание, Условия) Тогда ОшибкаUI("action_not_confirmed"); КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Д.Вставить("after_count", После.Количество());
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДобавлениеСтрокиUI(Шаг)
	ЦелевоеОкно = РазрешитьОкноUI(Шаг.args.window);
	Узел = РазрешитьЭлементUI(ЦелевоеОкно.ref, Шаг.args.element);
	Если Узел.data.type <> "table" Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	Таблица = Узел.ref;
	Если Узел.data.visible <> Истина Или Узел.data.enabled <> Истина
		Или Не Таблица.ТекущаяВидимость() Или Не Таблица.ТекущаяДоступность()
		Или Таблица.ТекущееТолькоПросмотр() Тогда ОшибкаUI("target_unavailable"); КонецЕсли;
	Шаг.result.data = Новый Структура("action,completed_steps,editing,identity,verification_scope",
		"add", Новый Массив, Неопределено,
		Новый Структура("status,reason", "unavailable", "stable_row_identity_unavailable"),
		"invocation_and_editing_state");
	Шаг.result.data.Вставить("steps", Новый Массив);
	ШагДобавления = Новый Структура("name,status", "add", "not_started");
	ШагНаблюдения = Новый Структура("name,status", "observe_editing", "not_started");
	Шаг.result.data.steps.Добавить(ШагДобавления);
	Шаг.result.data.steps.Добавить(ШагНаблюдения);
	Шаг.result.data.Вставить("rollback_performed", Ложь);
	Шаг.result.data.editing = Таблица.ТекущийРежимРедактирование();
	Если Шаг.result.data.editing Тогда ОшибкаUI("row_edit_pending"); КонецЕсли;
	ПередИзменениемUI(Шаг);
	// Старые цели недействительны и при неизвестном исходе изменяющего вызова.
	ИнвалидироватьЦелиUI();
	Шаг.result.data.editing = Неопределено;
	ШагДобавления.status = "unknown";
	Таблица.ДобавитьСтроку();
	ИзменениеЗавершеноUI(Шаг, "add");
	ШагДобавления.status = "invoked";
	ШагНаблюдения.status = "unknown";
	Шаг.result.data.editing = Таблица.ТекущийРежимРедактирование();
	ШагНаблюдения.status = "observed";
	// Наблюдение режима не доказывает появление новой строки или её идентичность.
	ОшибкаUI("incomplete_search");
КонецПроцедуры

&НаКлиенте
Функция ИзмерениеРедактораUI(Ссылка, Метод)
	Попытка
		Если Метод = "text" Тогда Значение = Ссылка.ПолучитьТекстРедактирования();
		ИначеЕсли Метод = "column" Тогда Значение = Ссылка.ПолучитьТекущийЭлемент().Имя;
		ИначеЕсли Метод = "choice_list" Тогда
			Если Ссылка.Вид <> ВидПоляФормы.ПолеВвода Тогда
				Возврат Новый Структура("available,value,reason", Ложь, Неопределено, "not_an_input_field");
			КонецЕсли;
			Значение = Ссылка.ВыпадающийСписокОткрыт();
		Иначе Значение = Ссылка.ТекущийРежимРедактирование(); КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Строка") И СтрДлина(Значение) > 16384 Тогда
			Возврат Новый Структура("available,value,reason", Ложь, Неопределено, "value_limit");
		КонецЕсли;
		Возврат Новый Структура("available,value,reason", Истина, Значение, Неопределено);
	Исключение
		Возврат Новый Структура("available,value,reason", Ложь, Неопределено, "property_read_failed");
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция АктивныйРедакторUI(Дерево)
	Результат = Новый Структура("status,reason", "unavailable", "active_form_unavailable");
	Попытка
		Формы = Новый Массив;
		Для Каждого Узел Из Дерево.flat Цикл
			Если Узел.data.type = "form" Тогда Формы.Добавить(Узел.ref); КонецЕсли;
		КонецЦикла;
		Если Формы.Количество() <> 1 Тогда Возврат Результат; КонецЕсли;
		Форма = Формы[0];
		Элемент = Форма.ПолучитьТекущийЭлемент();
		Если Элемент = Неопределено Тогда Возврат Результат; КонецЕсли;
		Результат.Вставить("active_element", Новый Структура("name,type", СвойствоUI(Элемент, "Имя"), ТипЭлементаUI(Элемент)));
		Результат.Вставить("editing", ИзмерениеРедактораUI(Элемент, "editing"));
		Результат.Вставить("column", Новый Структура("available,value,reason", Ложь, Неопределено, "not_a_table"));
		Редактор = Элемент;
		Если ТипЗнч(Элемент) = Тип("ТестируемаяТаблицаФормы") Тогда
			Результат.column = ИзмерениеРедактораUI(Элемент, "column");
			Редактор = Элемент.ПолучитьТекущийЭлемент();
		КонецЕсли;
		Результат.Вставить("text", ИзмерениеРедактораUI(Редактор, "text"));
		Результат.Вставить("choice_list", ИзмерениеРедактораUI(Редактор, "choice_list"));
		Если Элемент <> Форма.ПолучитьТекущийЭлемент() Тогда
			Возврат Новый Структура("status,reason", "unavailable", "active_element_changed");
		КонецЕсли;
		Если ТипЗнч(Элемент) = Тип("ТестируемаяТаблицаФормы") И Редактор <> Элемент.ПолучитьТекущийЭлемент() Тогда
			Возврат Новый Структура("status,reason", "unavailable", "active_editor_changed");
		КонецЕсли;
		Если РазмерJSONUI(Результат) > 65536 Тогда Возврат Новый Структура("status,reason", "unavailable", "response_size_limit"); КонецЕсли;
		Результат.status = "partial";
		Результат.reason = "requested_properties_only";
	Исключение
		Результат = Новый Структура("status,reason", "unavailable", "editor_observation_failed");
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция СнимокДиагностикиUI()
	Результат = Новый Структура("state,observed_at,application_error", ТКСостояние, ДатаНаблюденияUI(),
		Новый Структура("available,present,reason", Ложь, Неопределено, "application_error_api_unavailable"));
	Попытка
		ОшибкаПриложения = ТКПриложение.ПолучитьТекущуюИнформациюОбОшибке();
		Результат.application_error = Новый Структура("available,present,reason", Истина, ОшибкаПриложения <> Неопределено,
			?(ОшибкаПриложения = Неопределено, Неопределено, "sensitive_error_text_omitted"));
	Исключение
		Результат.application_error.reason = "application_error_api_unavailable";
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ДополнитьДиагностикуUI(Шаг)
	Попытка
		До = Неопределено; Шаг.Свойство("diagnostic_before", До);
		После = СнимокДиагностикиUI();
		АктивноеОкно = Неопределено;
		Если Шаг.result.data.Свойство("active_window", АктивноеОкно)
			И ТипЗнч(АктивноеОкно) = Тип("Структура")
			И АктивноеОкно.Свойство("form_name") И АктивноеОкно.form_name = "ErrorWindow" Тогда
			// Реальное окно ошибки подтверждено наблюдением, даже если API текста вернул пусто.
			После.application_error = Новый Структура("available,present,reason", Истина, Истина, "error_window_present");
		КонецЕсли;
		Последний = Шаг.last_confirmed_step;
		Ошибки = Новый Структура("command,observation,application", Неопределено, Неопределено, После.application_error);
		Если Шаг.result.error <> Неопределено Тогда
			Если ВСпискеUI(Шаг.result.error.stage, "observe,verify")
				И (Шаг.result.execution = "invoked" Или ВСпискеUI(Шаг.tool, "test_inspect,test_expect")) Тогда
				Ошибки.observation = Шаг.result.error;
			Иначе Ошибки.command = Шаг.result.error; КонецЕсли;
		КонецЕсли;
		Ссылки = Новый Массив;
		Для Каждого Имя Из СтрРазделить("before,after", ",") Цикл
			Ссылки.Добавить(Новый Структура("kind,operation_id,json_pointer", "inline", Шаг.result.operation_id, "/data/diagnostics/" + Имя));
		КонецЦикла;
		Диагностика = Новый Структура("operation_id,before,after,last_confirmed_step,progress,errors,artifacts,complete,reason",
			Шаг.result.operation_id, До, После, Последний,
			Новый Структура("completed_count,elapsed_ms,scope", Шаг.confirmed_count, ТекущаяУниверсальнаяДатаВМиллисекундах() - Шаг.started, "terminal_snapshot"),
			Ошибки, Ссылки, Истина, Неопределено);
		Если РазмерJSONUI(Диагностика) > 65536 Или РазмерJSONUI(Шаг.result.data) + РазмерJSONUI(Диагностика) > 1048576 Тогда
			Диагностика = Новый Структура("operation_id,last_confirmed_step,complete,reason", Шаг.result.operation_id, Последний, Ложь, "diagnostic_budget_exceeded");
		КонецЕсли;
		Если Шаг.Свойство("progress_delivery_failed") Тогда Диагностика.Вставить("progress_delivery_failed", Истина); КонецЕсли;
		Шаг.result.data.Вставить("diagnostics", Диагностика);
	Исключение
		Шаг.result.data.Вставить("diagnostics", Новый Структура("operation_id,last_confirmed_step,complete,reason", Шаг.result.operation_id, Шаг.last_confirmed_step, Ложь, "diagnostic_observation_failed"));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ДоказательствоСнимкаКлиента(Сеанс) Экспорт
	Если Сеанс <> ТКСеанс Или ТКСостояние <> "ready" Или ТКПроцесс = Неопределено Тогда ВызватьИсключение "screenshot_target_unavailable"; КонецЕсли;
	Если Не ПроцессЖив(ТКПроцесс) Тогда ВызватьИсключение "screenshot_target_unavailable"; КонецЕсли;
	Слушатель = ПроцессПорта();
	Если Слушатель = Неопределено Или Слушатель.pid <> ТКПроцесс.pid Или Слушатель.created <> ТКПроцесс.created
		Или Не СовпадаетБазаПроцесса(Слушатель) Тогда ВызватьИсключение "screenshot_target_unavailable"; КонецЕсли;
	Возврат Новый Структура("session_id,pid,created", ТКСеанс, ТКПроцесс.pid, ТКПроцесс.created);
КонецФункции

&НаКлиенте
Процедура ОпубликоватьПрогрессUI(Шаг, Фаза)
	ВерсияПрогресса = Неопределено;
	Если Не Шаг.permission_command.Свойство("lifecycle_progress_version", ВерсияПрогресса) Или ВерсияПрогресса <> 1 Тогда Возврат; КонецЕсли;
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Шаг.progress_count = Шаг.confirmed_count И Шаг.progress_phase = Фаза И Сейчас - Шаг.progress_at < 1000 Тогда Возврат; КонецЕсли;
	Шаг.progress_seq = Шаг.progress_seq + 1; Шаг.progress_at = Сейчас;
	Шаг.progress_count = Шаг.confirmed_count; Шаг.progress_phase = Фаза;
	Попытка
		Прогресс = Новый Структура("phase,completed_count,elapsed_ms,last_confirmed_step", Фаза, Шаг.confirmed_count, Сейчас - Шаг.started, Шаг.last_confirmed_step);
		ВладелецФормы.ПередатьСостояниеLifecycle(Шаг.permission_command, "progress", Шаг.progress_seq, Прогресс);
	Исключение
		// Ошибка необязательного наблюдения не повторяет UI и не заменяет результат команды.
		Шаг.Вставить("progress_delivery_failed", Истина);
	КонецПопытки;
КонецПроцедуры


&НаКлиенте
Функция ДеревоОбластиUI(ОкноВладелец, Область, Глубина, Лимит)
	Если Область = "form_tree" Тогда Возврат ДеревоUI(ОкноВладелец, ОкноВладелец, Глубина, Лимит); КонецЕсли;
	Если Область = "command_interface" Тогда
		Корень = ОкноВладелец.ПолучитьКомандныйИнтерфейс();
		Возврат ДеревоUI(Корень, ОкноВладелец, Глубина, Лимит, Ложь, , , , Область);
	КонецЕсли;
	Если Область <> "command_bars" Тогда ОшибкаUI("invalid_params"); КонецЕсли;
	// Панели формы и таблиц выдаются отдельной областью, без смешения с form_tree.
	Формы = ДеревоUI(ОкноВладелец, ОкноВладелец, 32, 5000);
	Результат = Новый Структура("snapshot_id,expires_at,tree,complete,truncated,reason,flat",
		Формы.snapshot_id, Формы.expires_at, Новый Массив, Формы.complete, Формы.truncated, Формы.reason, Новый Массив);
	Панели = Новый Массив;
	Для Каждого Узел Из Формы.flat Цикл
		Если Не ВСпискеUI(Узел.data.type, "form,table") Тогда Продолжить; КонецЕсли;
		Если Результат.flat.Количество() >= Лимит Тогда Результат.reason = "max_nodes"; Прервать; КонецЕсли;
		Попытка
			Панель = Узел.ref.ПолучитьКоманднуюПанель();
		Исключение
			Результат.reason = "command_bar_unavailable"; Продолжить;
		КонецПопытки;
		Если Панель = Неопределено Или Панели.Найти(Панель) <> Неопределено Тогда Продолжить; КонецЕсли;
		Панели.Добавить(Панель);
		Путь = КопияJSONUI(Узел.data.path); Путь.Добавить(Узел.data.name);
		Ветка = ДеревоUI(Панель, ОкноВладелец, Глубина, Лимит - Результат.flat.Количество(), Истина, Путь, , , Область);
		Для Каждого Элемент Из Ветка.tree Цикл Результат.tree.Добавить(Элемент); КонецЦикла;
		Для Каждого Элемент Из Ветка.flat Цикл Результат.flat.Добавить(Элемент); КонецЦикла;
		Если Не Ветка.complete Тогда Результат.reason = Ветка.reason; КонецЕсли;
	КонецЦикла;
	Результат.complete = ПустаяСтрока(Результат.reason);
	Результат.truncated = Не Результат.complete;
	Возврат Результат;
КонецФункции
