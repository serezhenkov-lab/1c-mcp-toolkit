#Область ЧтениеUI

// Адаптированы идеи ОбъектВСтруктуру, БезопасноеСвойство,
// БезопасноеЗначениеМетода и СообщенияПользователяMCP из Answer42 0406669a.
// MIT copyright/permission notice: 1c/MCPToolkit/licenses/Answer42-MIT.txt.
// Ошибки не подменяются пустыми данными; чтение сообщений не закрывает панель.
&НаКлиенте
Функция СвойствоUI(Ссылка, Имя)
	Если ВСпискеUI(ТипЭлементаUI(Ссылка), "command_interface,command_group,command_button") И Имя <> "ТекстЗаголовка" Тогда
		Возврат Новый Структура("available,value,reason", Ложь, Неопределено, "property_not_supported_for_type");
	КонецЕсли;
	Попытка
		Если Имя = "visible" Тогда
			Значение = Ссылка.ТекущаяВидимость();
		ИначеЕсли Имя = "enabled" Тогда
			Значение = Ссылка.ТекущаяДоступность();
		ИначеЕсли Имя = "read_only" Тогда
			Значение = Ссылка.ТекущееТолькоПросмотр();
		ИначеЕсли Имя = "editing" Тогда
			// CurrentModeIsEdit есть у таблицы и поля табличного документа.
			// Фокус обычного поля ввода не доказывает режим редактирования.
			ПоддерживаетсяРедактирование = ТипЗнч(Ссылка) = Тип("ТестируемаяТаблицаФормы");
			Если ТипЗнч(Ссылка) = Тип("ТестируемоеПолеФормы") Тогда
				ПоддерживаетсяРедактирование = Ссылка.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
			КонецЕсли;
			Если Не ПоддерживаетсяРедактирование Тогда
				Возврат Новый Структура("available,value,reason", Ложь, Неопределено, "property_not_supported_for_type");
			КонецЕсли;
			Значение = Ссылка.ТекущийРежимРедактирование();
		ИначеЕсли Имя = "value" Тогда
			Значение = Ссылка.ПолучитьПредставлениеДанных();
		Иначе
			Значение = Ссылка[Имя];
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Строка") И СтрДлина(Значение) > 65536 Тогда
			Возврат Новый Структура("available,value,reason", Ложь, Неопределено, "value_limit");
		КонецЕсли;
		Возврат Новый Структура("available,value", Истина, Значение);
	Исключение
		Возврат Новый Структура("available,value,reason", Ложь, Неопределено, "property_read_failed");
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ОкнаUI()
	Данные = Новый Массив;
	Ссылки = Новый Массив;
	Активное = ТКПриложение.ПолучитьАктивноеОкно();
	Для Каждого ОкноКлиента Из ТКПриложение.ПолучитьПодчиненныеОбъекты() Цикл
		Если Данные.Количество() >= 500 Тогда ОшибкаUI("incomplete_search"); КонецЕсли;
		Ид = ЗарегистрироватьЦельUI(ОкноКлиента, "window");
		ИмяФормыОкна = "";
		Для Каждого Дочерний Из ОкноКлиента.ПолучитьПодчиненныеОбъекты() Цикл
			Если ТипЗнч(Дочерний) = Тип("ТестируемаяФорма") Тогда
				ИмяФормыОкна = Дочерний.ИмяФормы;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Данные.Добавить(Новый Структура("window_id,title,form_name,navigation_link,active,main",
			Ид, ОкноКлиента.Заголовок, ИмяФормыОкна, ОкноКлиента.НавигационнаяСсылка,
			Активное <> Неопределено И Активное = ОкноКлиента, ОкноКлиента.Основное));
		Ссылки.Добавить(ОкноКлиента);
	КонецЦикла;
	Возврат Новый Структура("data,refs,active", Данные, Ссылки, Активное);
КонецФункции

