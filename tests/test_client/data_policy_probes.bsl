&НаКлиенте
Функция ТестРазрешениеЧтенияUI(Навигация) Экспорт
	КомандаТеста = Новый Структура("tool,params", "test_table",
		Новый Структура("action,params", "read", Новый Структура("allow_navigation", Навигация)));
	ШагТеста = Новый Структура("tool,permission_command", "test_table", КомандаТеста);
	Попытка
		Возврат ПодготовитьРазрешениеUI(ШагТеста);
	Исключение
		Если СтрНайти(ОписаниеОшибки(), "permission_denied") > 0 Тогда Возврат Ложь; КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецФункции
