&НаКлиенте
Процедура ТестUIСтарт()
	ТестРезультаты = Новый Массив;
	ТестСрок = ТекущаяДата() + 180;
	Попытка
		Профиль = Новый Структура("id,exe,connection,user,port,receipt_path", "ui-probe",
			КаталогПрограммы() + "1cv8c.exe", СтрокаСоединенияИнформационнойБазы(), "ApiProbe", 16538, "@ROOT@/receipt.json");
		ТестДрайвер = ПолучитьМенеджерТестирования(Профиль);
		Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "ui-start", 60000);
		ТестСеанс = Снимок.session_id;
		ПодключитьОбработчикОжидания("ТестUIГотовность", 1, Истина);
	Исключение
		ТестПроверка("ui_start_exception", Ложь, ОписаниеОшибки()); ТестФиниш();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ТестUIГотовность()
	Снимок = ТестДрайвер.СостояниеСеанса();
	Если Снимок.state = "ready" Тогда
		ТестUIКоманда("windows", "test_inspect", "windows", Новый Структура, Ложь);
	ИначеЕсли ТекущаяДата() > ТестСрок Или Снимок.state = "failed" Тогда
		ТестПроверка("ready", Ложь, Снимок); ТестФиниш();
	Иначе
		ПодключитьОбработчикОжидания("ТестUIГотовность", 1, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ТестUIКоманда(Имя, Инструмент, Действие, Параметры, СОкном = Истина, Элемент = Неопределено, Таймаут = 30000)
	Аргументы = Новый Структура("request_id,session_id,params,timeout_ms", Имя, ТестСеанс, Параметры, Таймаут);
	Если Не ПустаяСтрока(Действие) Тогда Аргументы.Вставить("action", Действие); КонецЕсли;
	Если СОкном Тогда Аргументы.Вставить("window", ТестОкноUI); КонецЕсли;
	Если Элемент <> Неопределено Тогда Аргументы.Вставить("element", Элемент); КонецЕсли;
	Результат = ПринятьКомандуТестирования(Инструмент, Аргументы, "op-" + Имя, Новый ОписаниеОповещения("ТестUIОтвет", ЭтаФорма));
	Если Результат.status = "failed" Тогда
		ТестПроверка(Имя + "_accepted", Ложь, Результат); ТестФиниш();
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ТестUIПоле(Имя)
	Возврат Новый Структура("selector", Новый Структура("name", Имя));
КонецФункции

&НаКлиенте
Функция ТестUIУсловие(Свойство, Значение)
	Возврат Новый Структура("condition", Новый Структура("property,operator,value", Свойство, "equals", Значение));
КонецФункции

&НаКлиенте
Процедура ТестUIОтвет(Результат, ДополнительныеПараметры) Экспорт
	Попытка
		Имя = Результат.request_id;
		ОжидаемаяОшибка = "";
		Если Имя = "missing" Или Имя = "case" Или Имя = "path_wrong" Тогда ОжидаемаяОшибка = "element_not_found"; КонецЕсли;
		Если Имя = "ambiguous" Тогда ОжидаемаяОшибка = "ambiguous_target"; КонецЕсли;
		Если Имя = "zero" Или Имя = "queue_wait" Тогда ОжидаемаяОшибка = "expectation_timeout"; КонецЕсли;
		Если Имя = "stale_window" Или Имя = "stale_element" Тогда ОжидаемаяОшибка = "stale_target"; КонецЕсли;
		Если Имя = "row_absence" Или Имя = "expect_row" Или Имя = "row_duplicates" Или Имя = "row_switched" Тогда ОжидаемаяОшибка = "incomplete_search"; КонецЕсли;
		Если ОжидаемаяОшибка <> "" Тогда
			Успех = Результат.error <> Неопределено И Результат.error.code = ОжидаемаяОшибка;
		Иначе
			Успех = Результат.status = "succeeded";
		КонецЕсли;
		ТестПроверка(Имя, Успех, Результат);
		Если Не Успех Тогда ТестФиниш(); Возврат; КонецЕсли;
		Если Имя = "tree" Или Имя = "depth" Или Имя = "nodes" Или Имя = "values"
			Или Имя = "messages1" Или Имя = "windows" Тогда
			Области = Новый Соответствие;
			Для Каждого Охват Из Результат.data.coverage Цикл Области.Вставить(Охват.scope, Охват); КонецЦикла;
			Для Каждого Область Из СтрРазделить("command_interface,command_bars,table_additions", ",") Цикл
				ТестПроверка(Имя + "_unsupported_" + Область, Области[Область].status = "unsupported"
					И Области[Область].reason = "adapter_not_implemented", Результат.data);
			КонецЦикла;
			Если Имя = "tree" Тогда
				ТестПроверка("coverage_tree_complete", Области["form_tree"].status = "complete", Результат.data);
			ИначеЕсли Имя = "depth" Или Имя = "nodes" Тогда
				ТестПроверка(Имя + "_coverage_partial", Области["form_tree"].status = "partial"
					И Области["form_tree"].reason = Результат.data.reason, Результат.data);
			Иначе
				Область = ?(Имя = "messages1", "messages", Имя);
				ТестПроверка(Имя + "_coverage_scope", Области[Область].status = "complete"
					И Области["form_tree"].reason = "not_requested", Результат.data);
			КонецЕсли;
		КонецЕсли;
		Если Имя = "windows" Тогда
			Для Каждого ОкноДанные Из Результат.data.windows Цикл
				Если ОкноДанные.main Тогда ТестОкноUI = Новый Структура("id", ОкноДанные.window_id); КонецЕсли;
			КонецЦикла;
			ТестСтароеОкноUI = ТестОкноUI;
			ТестUIКоманда("open", "test_open", "", Новый Структура("link", "e1cib/app/Обработка.ApiFixture.Форма.Main"));
		ИначеЕсли Имя = "open" Тогда
			ТестUIКоманда("windows_after", "test_inspect", "windows", Новый Структура, Ложь);
		ИначеЕсли Имя = "windows_after" Тогда
			Для Каждого ОкноДанные Из Результат.data.windows Цикл
				Если ОкноДанные.navigation_link = "e1cib/app/Обработка.ApiFixture" Тогда
					ТестОкноUI = Новый Структура("id", ОкноДанные.window_id);
				КонецЕсли;
			КонецЦикла;
			ТестUIКоманда("tree", "test_inspect", "tree", Новый Структура);
		ИначеЕсли Имя = "tree" Тогда
			ТестПроверка("tree_complete", Результат.data.complete, Результат.data);
			ТестНайтиПолеВТесте(Результат.data.tree);
			Цели = Новый Массив; Цели.Добавить(Новый Структура("id", ТестПолеUI));
			ТестUIКоманда("values", "test_inspect", "values", Новый Структура("targets", Цели));
		ИначеЕсли Имя = "values" Тогда
			ТестПроверка("value_actual", Результат.data.values[0].available И Результат.data.values[0].value = "Начальное", Результат.data);
			ТестUIКоманда("expect", "test_expect", "", ТестUIУсловие("value", "Начальное"), Истина, ТестUIПоле("Текст"));
		ИначеЕсли Имя = "expect" Тогда
			ТестUIКоманда("zero", "test_expect", "", ТестUIУсловие("value", "Не совпало"), Истина, ТестUIПоле("Текст"), 0);
		ИначеЕсли Имя = "zero" Тогда
			ТестUIКоманда("missing", "test_expect", "", ТестUIУсловие("value", ""), Истина, ТестUIПоле("НетТакогоПоля"), 0);
		ИначеЕсли Имя = "missing" Тогда
			ТестUIКоманда("absent", "test_expect", "", ТестUIУсловие("exists", Ложь), Истина, ТестUIПоле("НетТакогоПоля"), 0);
		ИначеЕсли Имя = "absent" Тогда
			ТестUIКоманда("ambiguous", "test_expect", "", ТестUIУсловие("exists", Истина), Истина,
				Новый Структура("selector", Новый Структура("type", "field")));
		ИначеЕсли Имя = "ambiguous" Тогда
			ТестUIКоманда("case", "test_expect", "", ТестUIУсловие("value", ""), Истина, ТестUIПоле("текст"), 0);
		ИначеЕсли Имя = "case" Тогда
			ТестUIКоманда("path", "test_expect", "", ТестUIУсловие("exists", Истина), Истина,
				Новый Структура("selector", Новый Структура("name,path", "Текст", ТестПутьUI)));
		ИначеЕсли Имя = "path" Тогда
			Путь = Новый Массив; Путь.Добавить("НесуществующийРодитель");
			ТестUIКоманда("path_wrong", "test_expect", "", ТестUIУсловие("value", ""), Истина,
				Новый Структура("selector", Новый Структура("name,path", "Текст", Путь)), 0);
		ИначеЕсли Имя = "path_wrong" Тогда
			ТестUIКоманда("depth", "test_inspect", "tree", Новый Структура("depth", 0));
		ИначеЕсли Имя = "depth" Тогда
			ТестПроверка("depth_truncated", Результат.data.truncated И Не Результат.data.complete, Результат.data);
			ТестUIКоманда("nodes", "test_inspect", "tree", Новый Структура("max_nodes", 1));
		ИначеЕсли Имя = "nodes" Тогда
			ТестПроверка("nodes_truncated", Результат.data.truncated, Результат.data);
			ТестДрайвер.ТестСообщениеUI();
			ТестUIКоманда("messages1", "test_inspect", "messages", Новый Структура);
		ИначеЕсли Имя = "messages1" Тогда
			ТестСообщенияUI = Результат.data.messages;
			ТестПроверка("messages_available", Результат.data.available И ТестСообщенияUI.Количество() > 0, Результат.data);
			ТестUIКоманда("messages2", "test_inspect", "messages", Новый Структура);
		ИначеЕсли Имя = "messages2" Тогда
			ТестПроверка("messages_preserved", Результат.data.available И Результат.data.messages.Количество() = ТестСообщенияUI.Количество(), Результат.data);
			ТестUIКоманда("expect_message", "test_expect", "", ТестUIУсловие("message", ТестСообщенияUI[0].text));
		ИначеЕсли Имя = "expect_message" Тогда
			Условие = ТестUIУсловие("message", "Несуществующее сообщение");
			Условие.condition.operator = "not_equals";
			ТестUIКоманда("message_absent", "test_expect", "", Условие);
		ИначеЕсли Имя = "message_absent" Тогда
			ТестДрайвер.ТестВыбратьСтрокуUI("A");
			ТестUIКоманда("expect_row", "test_expect", "", ТестУсловиеСтрокиUI("A"), Истина, ТестUIПоле("Строки"));
		ИначеЕсли Имя = "expect_row" Тогда
			ТестПроверка("row_no_navigation", ТестДрайвер.ТестКлючСтрокиUI() = "A" И Не Результат.data.actual.cursor_changed, Результат.data);
			ТестДрайвер.ТестОдинаковыеСтрокиUI();
			Условие = ТестУсловиеСтрокиUI("Дубль");
			Условие.condition.value.where.Добавить(Новый Структура("column,equals", "СтрокиЗначение", "Дубль"));
			ТестUIКоманда("row_duplicates", "test_expect", "", Условие, Истина, ТестUIПоле("Строки"));
		ИначеЕсли Имя = "row_duplicates" Или Имя = "row_switched" Тогда
			ТестПроверка(Имя + "_not_confirmed", Результат.verification = "not_confirmed"
				И Не Результат.data.matched И Не Результат.data.actual.values_verified
				И Результат.data.actual.identity.reason = "stable_row_identity_unavailable", Результат);
			ТестПроверка(Имя + "_values", Результат.data.actual.values.Количество() = 2
				И Результат.data.actual.values[0].text = "Дубль" И Результат.data.actual.values[1].text = "Дубль", Результат.data);
			ТестПроверка(Имя + "_switch_count", ТестДрайвер.ТестСменыUI() = ?(Имя = "row_switched", 1, 0), ТестДрайвер.ТестСменыUI());
			Если Имя = "row_duplicates" Тогда
				ТестДрайвер.ТестВключитьСменуUI();
				Условие = ТестУсловиеСтрокиUI("Дубль");
				Условие.condition.value.where.Добавить(Новый Структура("column,equals", "СтрокиЗначение", "Дубль"));
				ТестUIКоманда("row_switched", "test_expect", "", Условие, Истина, ТестUIПоле("Строки"));
				Возврат;
			КонецЕсли;
			ТестПроверка("row_distinct_physical_rows", ТестДрайвер.ТестРазныеФизическиеСтрокиUI(), "Маркер второй строки не изменяет первую");
			Условие = ТестУсловиеСтрокиUI("НетСтроки"); Условие.condition.operator = "not_equals";
			ТестUIКоманда("row_absence", "test_expect", "", Условие, Истина, ТестUIПоле("Строки"));
		ИначеЕсли Имя = "row_absence" Тогда
			ТестUIКоманда("visible", "test_expect", "", ТестUIУсловие("visible", Истина), Истина, ТестUIПоле("Текст"));
		ИначеЕсли Имя = "visible" Тогда
			ТестUIКоманда("hidden", "test_expect", "", ТестUIУсловие("visible", Ложь), Истина, ТестUIПоле("Метка2"), 0);
		ИначеЕсли Имя = "hidden" Тогда
			ТестUIКоманда("subtree", "test_inspect", "tree", Новый Структура, Истина, ТестUIПоле("Метка2"));
		ИначеЕсли Имя = "subtree" Тогда
			ТестПроверка("subtree_hidden", Результат.data.tree.Количество() = 1
				И Результат.data.tree[0].name = "Метка2" И Результат.data.tree[0].visible = Ложь, Результат.data);
			ТестUIКоманда("readonly", "test_expect", "", ТестUIУсловие("read_only", Истина), Истина, ТестUIПоле("Результат"));
		ИначеЕсли Имя = "readonly" Тогда
			ТестUIКоманда("editing", "test_expect", "", ТестUIУсловие("editing", Ложь), Истина, ТестUIПоле("Строки"));
		ИначеЕсли Имя = "editing" Тогда
			ТестОчередьUI = Новый Массив;
			ТестUIКоманда("queue_wait", "test_expect", "", ТестUIУсловие("value", "Не совпало"), Истина, ТестUIПоле("Текст"), 1500);
			Второй = ТестUIКоманда("queue_inspect", "test_inspect", "windows", Новый Структура, Ложь);
			ТестПроверка("queued", Второй.status = "queued", Второй);
			Состояние = ТестДрайвер.СостояниеСеанса();
			ТестПроверка("status_during_queue", Состояние.state = "ready" И Состояние.ui_queue_length >= 1, Состояние);
		ИначеЕсли Имя = "queue_wait" Тогда
			ТестОчередьUI.Добавить(Имя);
		ИначеЕсли Имя = "queue_inspect" Тогда
			ТестПроверка("serial_order", ТестОчередьUI.Количество() = 1, ТестОчередьUI);
			ТестUIКоманда("eventually", "test_expect", "", ТестUIУсловие("value", "Изменено"), Истина, ТестUIПоле("Текст"), 10000);
			ПодключитьОбработчикОжидания("ТестUIИзменить", 1, Истина);
		ИначеЕсли Имя = "eventually" Тогда
			Текущий = ТестОкноUI; ТестОкноUI = ТестСтароеОкноUI;
			ТестUIКоманда("stale_window", "test_inspect", "tree", Новый Структура);
			ТестОкноUI = Текущий;
		ИначеЕсли Имя = "stale_window" Тогда
			ТестДрайвер.ТестЗакрытьФормуUI();
			ТестОкноUI = Новый Структура("selector", Новый Структура("navigation_link", "e1cib/app/Обработка.ApiFixture"));
			ТестUIКоманда("closed", "test_expect", "", ТестUIУсловие("closed", Истина), Истина, , 0);
		ИначеЕсли Имя = "closed" Тогда
			ТестUIКоманда("end_windows", "test_inspect", "windows", Новый Структура, Ложь);
		ИначеЕсли Имя = "end_windows" Тогда
			Для Каждого ОкноДанные Из Результат.data.windows Цикл
				Если ОкноДанные.main Тогда ТестОкноUI = Новый Структура("id", ОкноДанные.window_id); КонецЕсли;
			КонецЦикла;
			ТестДрайвер.ТестОткрытьФормуUI();
			ТестОкноUI = Новый Структура("selector", Новый Структура("navigation_link", "e1cib/app/Обработка.ApiFixture"));
			ТестUIКоманда("stale_element", "test_expect", "", ТестUIУсловие("exists", Истина), Истина, Новый Структура("id", ТестПолеUI));
		ИначеЕсли Имя = "stale_element" Тогда
			ТестПроверитьНеверныйКонтрактUI();
			ТестФиниш();
		КонецЕсли;
	Исключение
		ТестПроверка("ui_callback_exception", Ложь, ОписаниеОшибки()); ТестФиниш();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ТестНайтиПолеВТесте(Узлы)
	Для Каждого Узел Из Узлы Цикл
		Если Узел.name = "Текст" Тогда ТестПолеUI = Узел.element_id; ТестПутьUI = Узел.path; КонецЕсли;
		ТестНайтиПолеВТесте(Узел.children);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТестUIИзменить()
	ТестДрайвер.ТестИзменитьТекстUI();
КонецПроцедуры

&НаКлиенте
Процедура ТестПроверитьНеверныйКонтрактUI()
	Аргументы = Новый Структура("request_id,session_id,action,params", "invalid", ТестСеанс, "windows", Новый Структура("extra", Истина));
	Результат = ТестДрайвер.ПринятьКомандуUI("test_inspect", Аргументы, "invalid");
	ТестПроверка("unknown_parameter", Результат.error.code = "invalid_params", Результат);
	Аргументы.params = Новый Структура;
	Аргументы.session_id = "old-session";
	Результат = ТестДрайвер.ПринятьКомандуUI("test_inspect", Аргументы, "invalid-session");
	ТестПроверка("invalid_session", Результат.error.code = "session_invalid", Результат);
КонецПроцедуры

&НаКлиенте
Функция ТестУсловиеСтрокиUI(Ключ)
	Отбор = Новый Массив; Отбор.Добавить(Новый Структура("column,equals", "СтрокиКлюч", Ключ));
	Возврат ТестUIУсловие("row", Новый Структура("where", Отбор));
КонецФункции
