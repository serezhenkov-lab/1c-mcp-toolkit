// Только в тестовой копии менеджера, без клиентского наблюдателя.
&НаКлиенте
Функция ПробаEditingТабДок(Режим = "read") Экспорт
    ПолеПробы = ТКПриложение.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "ТабДок", 1);
    Если Режим = "begin" Тогда
        ПолеПробы.Активизировать();
        ПолеПробы.УстановитьТекущуюОбласть("R1C1");
        ПолеПробы.НачатьРедактированиеТекущейОбласти();
    ИначеЕсли Режим = "end" Тогда
        ПолеПробы.ЗакончитьРедактированиеТекущейОбласти(Истина);
    КонецЕсли;
    Возврат Новый Структура("kind,editing,text", Строка(ПолеПробы.Вид),
        ПолеПробы.ТекущийРежимРедактирование(), ПолеПробы.ПолучитьТекстОбласти("R1C1"));
КонецФункции
