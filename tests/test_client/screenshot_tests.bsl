&НаКлиенте
Процедура ТестЦелиСнимка()
	Для Каждого СеансТеста Из СтрРазделить(ТестСеанс + ",stale-session", ",") Цикл
		АргументыТеста = Новый Структура("target,session_id", "test_client", СеансТеста);
		ОтветТеста = ПолучитьСкриншот(АргументыТеста);
		ТестПроверка("client_unavailable_" + СеансТеста, Не ОтветТеста.success И Не ОтветТеста.Свойство("image_base64")
			И СтрНайти(ОтветТеста.error, "screenshot_target_unavailable") = 1, ОтветТеста);
		ОтветТеста = ВыполнитьПолучениеСкриншота(АргументыТеста, Неопределено);
		ТестПроверка("dispatcher_unavailable_" + СеансТеста, Не ОтветТеста.success И Не ОтветТеста.Свойство("image_base64")
			И СтрНайти(ОтветТеста.error, "screenshot_target_unavailable") = 1, ОтветТеста);
	КонецЦикла;
	Для Каждого ЦельТеста Из СтрРазделить("unknown,test_client", ",") Цикл
		ОтветТеста = ПолучитьСкриншот(Новый Структура("target", ЦельТеста));
		ТестПроверка("invalid_" + ЦельТеста, Не ОтветТеста.success И СтрНайти(ОтветТеста.error, "invalid_params") = 1, ОтветТеста);
	КонецЦикла;
	АргументыТеста = Новый Структура("target,session_id,form_name", "test_client", ТестСеанс, "DO_NOT_OPEN");
	ОтветТеста = ВыполнитьПолучениеСкриншота(АргументыТеста, Неопределено);
	ТестПроверка("no_manager_form_selector", Не ОтветТеста.success И СтрНайти(ОтветТеста.error, "invalid_params") = 1, ОтветТеста);
	ПодключитьКомпонентуScreenCaptureСинхронно();
	ТестПроверка("capture_component_loaded", КомпонентаScreenCapture <> Неопределено, "ScreenCapture");
	Если КомпонентаScreenCapture = Неопределено Тогда ТестТранспортныйОтказ(); ТестПубличныйОтказ(); Возврат; КонецЕсли;
	Для Каждого ОкноТеста Из ПолучитьОкна() Цикл
		Если ОкноТеста.Основное Тогда ОкноТеста.Активизировать(); КонецЕсли;
	КонецЦикла;
	ОкнаТеста = Новый Массив;
	Для Каждого ОкноТеста Из ПолучитьОкна() Цикл
		ОкнаТеста.Добавить(Новый Структура("main,caption", ОкноТеста.Основное, ОкноТеста.Заголовок));
	КонецЦикла;
	ЗаписьТеста = Новый ЗаписьJSON; ЗаписьТеста.ОткрытьФайл("@ROOT@/capture-ready.json");
	ЗаписатьJSON(ЗаписьТеста, ОкнаТеста); ЗаписьТеста.Закрыть();
	ПодключитьОбработчикОжидания("ТестЗахватМенеджера", 5, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ТестЗахватМенеджера()
	ОтветТеста = ПолучитьСкриншот(Новый Структура);
	ТестПроверитьИзображение(ОтветТеста, "legacy");
	ОтветТеста = ПолучитьСкриншот(Новый Структура("target", "toolkit"));
	ТестПроверитьИзображение(ОтветТеста, "toolkit");
	ОтветТеста = ПолучитьСкриншот(Новый Структура("target,session_id", "test_client", ТестСеанс));
	ТестПроверка("loaded_component_no_substitution", Не ОтветТеста.success И Не ОтветТеста.Свойство("image_base64")
		И СтрНайти(ОтветТеста.error, "screenshot_target_unavailable") = 1, ОтветТеста);
	ТестТранспортныйОтказ(); ТестПубличныйОтказ();
КонецПроцедуры

&НаКлиенте
Процедура ТестПроверитьИзображение(ОтветТеста, ИмяТеста)
	ЕстьИзображение = ОтветТеста.success И ОтветТеста.Свойство("image_base64");
	Если ЕстьИзображение Тогда
		ДанныеСнимка = Base64Значение(ОтветТеста.image_base64);
		ДанныеСнимка.Записать("@ROOT@/" + ИмяТеста + ".png");
		ОтветТеста.Удалить("image_base64");
	КонецЕсли;
	ТестПроверка(ИмяТеста + "_capture", ЕстьИзображение, ОтветТеста);
КонецПроцедуры
