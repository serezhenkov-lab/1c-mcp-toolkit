
&НаКлиенте
Процедура ТестРежимДиагностики(Режим) Экспорт
	ТестДиагностика = Режим;
КонецПроцедуры

&НаКлиенте
Функция ТестРедакторОчереди2(Действие = "read", Текст = "BUFFER_QUEUE2") Экспорт
	Поле = ТКПриложение.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Текст", 1);
	Таблица = ТКПриложение.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Строки", 1);
	Если Действие = "text" Тогда Поле.Активизировать(); Поле.ВвестиТекст(Текст);
	ИначеЕсли Действие = "table" Тогда
		Таблица.Активизировать(); Таблица.ПерейтиКПервойСтроке(); Таблица.ИзменитьСтроку();
		Таблица.ПолучитьТекущийЭлемент().ВвестиТекст("CELL_BUFFER_QUEUE2");
	КонецЕсли;
	Форма = Поле.ПолучитьРодителя();
	Текущий = Форма.ПолучитьТекущийЭлемент();
	Редактор = ?(ТипЗнч(Текущий) = Тип("ТестируемаяТаблицаФормы"), Текущий.ПолучитьТекущийЭлемент(), Текущий);
	Возврат Новый Структура("current,text,column,editing", Текущий.Имя,
		ИзмерениеРедактораUI(Редактор, "text"), ИзмерениеРедактораUI(Таблица, "column"), ИзмерениеРедактораUI(Таблица, "editing"));
КонецФункции

&НаКлиенте
Функция ТестСчетчикОчереди2() Экспорт
	Поле = ТКПриложение.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Результат", 1);
	Возврат Поле.ПолучитьПредставлениеДанных();
КонецФункции
