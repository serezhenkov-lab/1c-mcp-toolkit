&НаКлиенте
Процедура ТестПриемкаПодготовка()
	Попытка
		ПривязкаТеста = ТестДрайвер.ТестБазаКлиентаПодтверждена();
		ТестПроверка("client_manager_database", ПривязкаТеста.matched, ПривязкаТеста);
		Если Не ПривязкаТеста.matched Тогда ТестФиниш(); Возврат; КонецЕсли;
		ИдПрогона = Строка(Новый УникальныйИдентификатор);
		НомерПрогона = "T71" + Лев(СтрЗаменить(ИдПрогона, "-", ""), 8);
		РезультатТеста = ТестПроверитьДанныеПриемки(СтрокаСоединенияИнформационнойБазы(), НомерПрогона, "TASK071:" + ИдПрогона);
		Для Каждого ПроверкаТеста Из РезультатТеста.checks Цикл
			ТестПроверка(ПроверкаТеста.name, ПроверкаТеста.ok, ПроверкаТеста.details);
		КонецЦикла;
		ЗаписьТеста = Новый ЗаписьJSON; ЗаписьТеста.ОткрытьФайл("@ROOT@/preflight-data.json");
		ЗаписатьJSON(ЗаписьТеста, РезультатТеста); ЗаписьТеста.Закрыть();
	Исключение
		ТестПроверка("preflight_exception", Ложь, ОписаниеОшибки());
	КонецПопытки;
	ТестФиниш();
КонецПроцедуры

&НаСервере
Функция ТестПроверитьДанныеПриемки(БазаМенеджера, НомерПрогона, МаркерПрогона)
	ПроверкиТеста = Новый Массив;
	РезультатТеста = Новый Структура("checks,number,marker,date,rollback_performed,query", ПроверкиТеста,
		НомерПрогона, МаркерПрогона, "2026-11-14T12:00:00", Ложь, "@QUERY@");
	БазаСовпадает = БазаМенеджера = СтрокаСоединенияИнформационнойБазы();
	ТестДобавитьПроверкуДанных(ПроверкиТеста, "query_manager_database", БазаСовпадает, "server connection compared without disclosure");
	Если Не БазаСовпадает Тогда Возврат РезультатТеста; КонецЕсли;
	ОписаниеДокумента = Метаданные.Документы.Найти("T43_Required");
	ТестДобавитьПроверкуДанных(ПроверкиТеста, "document_metadata", ОписаниеДокумента <> Неопределено, "T43_Required");
	Если ОписаниеДокумента = Неопределено Тогда Возврат РезультатТеста; КонецЕсли;
	ОписаниеПоля = ОписаниеДокумента.Реквизиты.Найти("ОбязательноеПоле");
	ТестДобавитьПроверкуДанных(ПроверкиТеста, "required_attribute", ОписаниеПоля <> Неопределено, "ОбязательноеПоле");
	Если ОписаниеПоля = Неопределено Тогда Возврат РезультатТеста; КонецЕсли;
	ТестДобавитьПроверкуДанных(ПроверкиТеста, "initial_query_empty", ТестДанныеПриемки(НомерПрогона).Количество() = 0, НомерПрогона);
	Если ТестДанныеПриемки(НомерПрогона).Количество() <> 0 Тогда Возврат РезультатТеста; КонецЕсли;
	НачатьТранзакцию();
	Попытка
		ДокументТеста = Документы["T43_Required"].СоздатьДокумент();
		ДокументТеста.Дата = Дата(2026, 11, 14, 12, 0, 0);
		ДокументТеста.Номер = НомерПрогона;
		ДокументТеста.ОбязательноеПоле = "";
		ТестДобавитьПроверкуДанных(ПроверкиТеста, "empty_required_rejected", Не ДокументТеста.ПроверитьЗаполнение(), "standard ПроверитьЗаполнение, not UI save");
		ТестДобавитьПроверкуДанных(ПроверкиТеста, "after_rejection_query_empty", ТестДанныеПриемки(НомерПрогона).Количество() = 0, НомерПрогона);
		ДокументТеста.ОбязательноеПоле = МаркерПрогона;
		ЗаполненКорректно = ДокументТеста.ПроверитьЗаполнение();
		ТестДобавитьПроверкуДанных(ПроверкиТеста, "filled_required_accepted", ЗаполненКорректно, МаркерПрогона);
		Если Не ЗаполненКорректно Тогда ВызватьИсключение "preflight filling check failed"; КонецЕсли;
		ДокументТеста.Записать();
		СтрокиТеста = ТестДанныеПриемки(НомерПрогона);
		ТестДобавитьПроверкуДанных(ПроверкиТеста, "exactly_one_document", СтрокиТеста.Количество() = 1, СтрокиТеста.Количество());
		Если СтрокиТеста.Количество() = 1 Тогда
			СтрокаТеста = СтрокиТеста[0];
			ТестДобавитьПроверкуДанных(ПроверкиТеста, "written_values_match", СтрокаТеста.ОбязательноеПоле = МаркерПрогона
				И СтрокаТеста.Номер = НомерПрогона И СтрокаТеста.Дата = ДокументТеста.Дата
				И СтрокаТеста.Ссылка = ДокументТеста.Ссылка И Не СтрокаТеста.ПометкаУдаления, Строка(СтрокаТеста.Ссылка.УникальныйИдентификатор()));
			РезультатТеста.Вставить("document_ref", Строка(СтрокаТеста.Ссылка.УникальныйИдентификатор()));
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	ОтменитьТранзакцию();
	РезультатТеста.rollback_performed = Истина;
	ТестДобавитьПроверкуДанных(ПроверкиТеста, "rollback_leaves_no_run_document", ТестДанныеПриемки(НомерПрогона).Количество() = 0, НомерПрогона);
	Возврат РезультатТеста;
КонецФункции

&НаСервере
Функция ТестДанныеПриемки(НомерПрогона)
	ЗапросТеста = Новый Запрос("@QUERY@");
	ЗапросТеста.УстановитьПараметр("Номер", НомерПрогона);
	ЗапросТеста.УстановитьПараметр("НачалоГода", Дата(2026, 1, 1));
	ЗапросТеста.УстановитьПараметр("КонецГода", Дата(2027, 1, 1));
	Возврат ЗапросТеста.Выполнить().Выгрузить();
КонецФункции

&НаСервере
Процедура ТестДобавитьПроверкуДанных(ПроверкиТеста, ИмяПроверки, УспехПроверки, ДеталиПроверки)
	ПроверкиТеста.Добавить(Новый Структура("name,ok,details", ИмяПроверки, УспехПроверки, ДеталиПроверки));
КонецПроцедуры
