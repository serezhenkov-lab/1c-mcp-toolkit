&НаКлиенте
Процедура ТестВводСтарт()
	ТестРезультаты = Новый Массив; ТестСрок = ТекущаяДата() + 180;
	Попытка
		Профиль = Новый Структура("id,exe,connection,user,port,receipt_path", "input-probe",
			КаталогПрограммы() + "1cv8c.exe", СтрокаСоединенияИнформационнойБазы(), "ApiProbe", 16538, "@ROOT@/receipt.json");
		ТестДрайвер = ПолучитьМенеджерТестирования(Профиль);
		Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "input-start", 60000);
		ТестСеанс = Снимок.session_id;
		ПодключитьОбработчикОжидания("ТестВводГотовность", 1, Истина);
	Исключение
		ТестПроверка("start_exception", Ложь, ОписаниеОшибки()); ТестФиниш();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ТестВводГотовность()
	Снимок = ТестДрайвер.СостояниеСеанса();
	Если Снимок.state = "ready" Тогда
		ТестОкноUI = Новый Структура("selector", Новый Структура("title", "Input Fixture"));
		РежимПодтвержденияОпасныхОпераций = "session_allow";
		ТестПубличныйОтказ();
	ИначеЕсли ТекущаяДата() > ТестСрок Или Снимок.state = "failed" Тогда
		ТестПроверка("ready", Ложь, Снимок); ТестФиниш();
	Иначе
		ПодключитьОбработчикОжидания("ТестВводГотовность", 1, Истина);
	КонецЕсли;
КонецПроцедуры



&НаКлиенте
Процедура ТестПубличныйОтказ()
	Попытка
		Для Каждого ИмяИнструмента Из СтрРазделить("test_session,test_open,test_inspect,test_input,test_action,test_table,test_expect", ",") Цикл
			Для НомерПопытки = 1 По 3 Цикл
				ПараметрыТеста = Новый Структура("request_id,action", "same-key", ?(НомерПопытки = 3, "changed", "add"));
				КомандаТеста = Новый Структура("tool,params", ИмяИнструмента, ПараметрыТеста);
				Ответ = ВыполнитьКомандуСУчетомКонтекста(КомандаТеста);
				ТестПроверка(ИмяИнструмента + "_" + Строка(НомерПопытки), Не Ответ.success
					И СтрНайти(Ответ.error, "client_context_unavailable") = 1, Ответ);
			КонецЦикла;
		КонецЦикла;
		ТестПроверка("no_fallback", ТестВызовыFallback = 0, ТестВызовыFallback);
		ТестПроверка("session_ready", ТестДрайвер.СостояниеСеанса().state = "ready", ТестДрайвер.СостояниеСеанса());
	Исключение
		ТестПроверка("exception", Ложь, ОписаниеОшибки());
	КонецПопытки;
	ТестФиниш();
КонецПроцедуры
