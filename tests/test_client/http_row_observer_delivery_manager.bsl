&НаКлиенте
Перем СостояниеПробыДоставки;

&НаКлиенте
Функция НазначитьПробуДоставки(ПропуститьПервуюВыдачу = Ложь) Экспорт
	Если ПаузаДляПробыДоставки() Тогда ВызватьИсключение "probe_in_progress"; КонецЕсли;
	СеансПробы = ФормаМенеджераТестирования.СостояниеСеанса();
	Если СеансПробы.state <> "ready" Или СеансПробы.ui_operation_id <> Неопределено Или СеансПробы.ui_queue_length <> 0 Тогда
		ВызватьИсключение "test_manager_busy";
	КонецЕсли;
	СейчасПроба = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СостояниеПробыДоставки = Новый Структура("id,deadline,drop_first,takes,reply_count,wait_ui,wait_monitor,result,finished_at",
		Строка(Новый УникальныйИдентификатор), СейчасПроба + 18000, ПропуститьПервуюВыдачу,
		0, 0, 0, 0, Неопределено, Неопределено);
	Возврат СостояниеПробыДоставки.id;
КонецФункции

&НаКлиенте
Функция ПаузаДляПробыДоставки(Ожидающий = "") Экспорт
	Если СостояниеПробыДоставки = Неопределено Или СостояниеПробыДоставки.finished_at <> Неопределено
		Или ТекущаяУниверсальнаяДатаВМиллисекундах() >= СостояниеПробыДоставки.deadline Тогда Возврат Ложь; КонецЕсли;
	Если Ожидающий = "ui" Тогда
		СостояниеПробыДоставки.wait_ui = СостояниеПробыДоставки.wait_ui + 1;
	ИначеЕсли Ожидающий = "monitor" Тогда
		СостояниеПробыДоставки.wait_monitor = СостояниеПробыДоставки.wait_monitor + 1;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ОбработатьHTTPПробуДоставки(ЗапросПроба)
	ОтветПробы = Новый Структура("status", "unavailable");
	Попытка
		Если ЗапросПроба.method = "POST" И СтрДлина(ЗапросПроба.body) <= 8192 Тогда
			ТелоПробы = ПрочитатьJSON2(ЗапросПроба.body);
			Если ТелоПробы.token = "@CLIENT_TOKEN@" И СостояниеПробыДоставки <> Неопределено
				И ТелоПробы.id = СостояниеПробыДоставки.id Тогда
				ОтветПробы = ВыполнитьHTTPПробуДоставки(ТелоПробы);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ОтветПробы.status = "invalid_request";
	КонецПопытки;
	КомпонентаSendResponse(ЗапросПроба.id, 200, ЗаголовкиJSON(), ЗаписатьJSON2(ОтветПробы));
КонецПроцедуры

&НаКлиенте
Функция ВыполнитьHTTPПробуДоставки(ТелоПробы)
	ПробаДоставки = СостояниеПробыДоставки;
	Если ПробаДоставки.finished_at <> Неопределено Тогда
		Возврат Новый Структура("status", "finished");
	КонецЕсли;
	Если Не ПаузаДляПробыДоставки() Тогда Возврат Новый Структура("status", "expired"); КонецЕсли;
	Если ТелоПробы.action = "take" Тогда
		ПробаДоставки.takes = ПробаДоставки.takes + 1;
		Возврат Новый Структура("status,id,drop_first", "offered", ПробаДоставки.id,
			ПробаДоставки.drop_first И ПробаДоставки.takes = 1);
	ИначеЕсли ТелоПробы.action = "reply" И ПробаДоставки.takes > 0 И ТелоПробы.snapshot.probe_id = ПробаДоставки.id Тогда
		ПробаДоставки.reply_count = ПробаДоставки.reply_count + 1;
		Если ПробаДоставки.result = Неопределено Тогда ПробаДоставки.result = ТелоПробы.snapshot; КонецЕсли;
		Возврат Новый Структура("status", "accepted");
	ИначеЕсли ТелоПробы.action = "finish" И ПробаДоставки.result <> Неопределено Тогда
		ПробаДоставки.finished_at = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Возврат Новый Структура("status", "finished");
	КонецЕсли;
	Возврат Новый Структура("status", "invalid_request");
КонецФункции
