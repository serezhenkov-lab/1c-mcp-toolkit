&НаКлиенте
Процедура ТестТранспортныйОтказ()
	Для Каждого ИмяИнструмента Из СтрРазделить("test_session,test_open,test_inspect,test_input,test_action,test_table,test_expect", ",") Цикл
		ОтказТеста = ПроверитьДоступностьИнструментаMCP(ИмяИнструмента);
		ТестПроверка(ИмяИнструмента + "_embedded_gate", ОтказТеста.ВидОтказа = "client_context_unavailable", ОтказТеста);
		ОтказТеста = ТестОтказСерверногоРантайма(ИмяИнструмента);
		ТестПроверка(ИмяИнструмента + "_object_gate", ОтказТеста.ВидОтказа = "client_context_unavailable", ОтказТеста);
		ТелоТеста = Новый Структура("params", Новый Структура("name,arguments", ИмяИнструмента,
			Новый Структура("request_id,action,params", "transport-gate", "status", Новый Структура)));
		ОтветТеста = ВыполнитьПринятыйToolsCall(Новый Структура, ТелоТеста, "transport-gate");
		ТекстТеста = ЗаписатьJSON2(ОтветТеста);
		ТестПроверка(ИмяИнструмента + "_tools_call", СтрНайти(ТекстТеста, "client_context_unavailable") > 0, ОтветТеста);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ТестОтказСерверногоРантайма(ИмяИнструмента)
	ОбработкаТеста = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаТеста.ПроверитьДоступностьИнструментаMCP(Неопределено, ИмяИнструмента);
КонецФункции
