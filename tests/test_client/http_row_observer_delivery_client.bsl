&НаКлиенте
Перем ТекущаяПробаДоставки;
&НаКлиенте
Перем ДоставкаПробыЗанята;
&НаКлиенте
Перем ПредыдущаяКоллекцияПробы;
&НаКлиенте
Перем ПредыдущаяФормаПробы;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ДоставкаПробыЗанята = Ложь;
	ПодключитьОбработчикОжидания("ШагДоставкиПробы", 1, Ложь);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ШагДоставкиПробы() Экспорт
	Если ДоставкаПробыЗанята Тогда Возврат; КонецЕсли;
	ДоставкаПробыЗанята = Истина;
	Попытка
		УправлениеПробой = Новый ТекстовыйДокумент;
		УправлениеПробой.Прочитать("@MODE_PATH@");
		ИдПробы = СокрЛП(УправлениеПробой.ПолучитьТекст());
		Если СтрДлина(ИдПробы) = 36 Тогда
			Если ТекущаяПробаДоставки = Неопределено Или ТекущаяПробаДоставки.id <> ИдПробы Тогда
				ТекущаяПробаДоставки = Новый Структура("id,stage,snapshot", ИдПробы, "take", Неопределено);
			КонецЕсли;
			Если ТекущаяПробаДоставки.stage <> "done" Тогда Ждать ОбработатьДоставкуПробы(); КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписатьСобытиеПроб("delivery_failed", Неопределено, Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 300));
	КонецПопытки;
	ДоставкаПробыЗанята = Ложь;
КонецПроцедуры

&НаКлиенте
Асинх Функция ОбработатьДоставкуПробы()
	ПробаДоставки = ТекущаяПробаДоставки;
	ОтветПробы = Ждать ЗапросДоставкиПробы(ПробаДоставки);
	Если ОтветПробы = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Если ОтветПробы.status = "finished" Или ОтветПробы.status = "expired" Или ОтветПробы.status = "unavailable" Тогда
		ПробаДоставки.stage = "done";
		Возврат Неопределено;
	КонецЕсли;
	Если ПробаДоставки.stage = "take" И ОтветПробы.status = "offered" И ОтветПробы.id = ПробаДоставки.id Тогда
		Если ОтветПробы.drop_first Тогда
			ЗаписатьСобытиеПроб("drop_first_take", ПробаДоставки.id);
			Возврат Неопределено;
		КонецЕсли;
		ПробаДоставки.snapshot = СнимокНакладнойДляПроб();
		ПробаДоставки.snapshot.Вставить("probe_id", ПробаДоставки.id);
		ЗаписатьСобытиеПроб("snapshot", ПробаДоставки.id, ПробаДоставки.snapshot);
		ПробаДоставки.stage = "reply";
	ИначеЕсли ПробаДоставки.stage = "reply" И ОтветПробы.status = "accepted" Тогда
		ПробаДоставки.stage = "finish";
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Асинх Функция ЗапросДоставкиПробы(ПробаДоставки)
	ТелоПробы = Новый Структура("token,action,id", "@CLIENT_TOKEN@", ПробаДоставки.stage, ПробаДоставки.id);
	Если ПробаДоставки.stage = "reply" Тогда ТелоПробы.Вставить("snapshot", ПробаДоставки.snapshot); КонецЕсли;
	СоединениеПробы = Новый HTTPСоединение("127.0.0.1", 17825, , , , 3);
	ЗапросПробы = Новый HTTPЗапрос("/api/_fixture_row_delivery");
	ЗапросПробы.Заголовки.Вставить("Content-Type", "application/json");
	ЗапросПробы.УстановитьТелоИзСтроки(ЗаписатьJSONПроб(ТелоПробы), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	ЗаписатьСобытиеПроб(ПробаДоставки.stage + "_start", ПробаДоставки.id);
	ОтветПробы = Ждать СоединениеПробы.ВызватьHTTPМетодАсинх("POST", ЗапросПробы);
	Если ОтветПробы.КодСостояния <> 200 Тогда Возврат Неопределено; КонецЕсли;
	ЧтениеПробы = Новый ЧтениеJSON;
	ЧтениеПробы.УстановитьСтроку(ОтветПробы.ПолучитьТелоКакСтроку());
	РазборПробы = ПрочитатьJSON(ЧтениеПробы);
	ЗаписатьСобытиеПроб(ПробаДоставки.stage + "_finish", ПробаДоставки.id, РазборПробы.status);
	Возврат РазборПробы;
КонецФункции

&НаКлиенте
Процедура ДополнитьИсточникПробы(СнимокПроб, КоллекцияПроб)
	СнимокПроб.Вставить("source_comparison", "baseline");
	Если СнимокПроб.form_id = ПредыдущаяФормаПробы Тогда
		Попытка
			СнимокПроб.source_comparison = ?(КоллекцияПроб = ПредыдущаяКоллекцияПробы, "equal", "different");
		Исключение
			СнимокПроб.source_comparison = "unavailable";
			СнимокПроб.Вставить("source_comparison_error", Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 300));
		КонецПопытки;
	КонецЕсли;
	ПредыдущаяФормаПробы = СнимокПроб.form_id;
	ПредыдущаяКоллекцияПробы = КоллекцияПроб;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьСобытиеПроб(Событие, ИдПробы, Значение = Неопределено)
	Попытка
		ТрассаПробы = Новый ЗаписьТекста("@TRACE_PATH@", КодировкаТекста.UTF8, , Истина);
		ТрассаПробы.ЗаписатьСтроку(ЗаписатьJSONПроб(Новый Структура("time,event,probe_id,value",
			ТекущаяУниверсальнаяДатаВМиллисекундах(), Событие, ИдПробы, Значение)));
		ТрассаПробы.Закрыть();
	Исключение
		Результат = "trace_unavailable";
	КонецПопытки;
КонецПроцедуры
