&НаКлиенте
Перем РежимОпросаПроб;
&НаКлиенте
Перем ОпросПробЗанят;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	РежимОпросаПроб = "off";
	ОпросПробЗанят = Ложь;
	Результат = "off";
	ПодключитьОбработчикОжидания("ОпроситьМенеджерПроб", 1, Ложь);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ОпроситьМенеджерПроб() Экспорт
	Если ОпросПробЗанят Тогда Возврат; КонецЕсли;
	ОпросПробЗанят = Истина;
	Попытка
		НовыйРежим = РежимИзУправленияПроб();
		Если НовыйРежим <> РежимОпросаПроб Тогда
			РежимОпросаПроб = НовыйРежим;
			Результат = НовыйРежим;
		КонецЕсли;
		Если РежимОпросаПроб <> "off" Тогда
			Задание = Ждать ОбменПробойHTTP("take", Неопределено, Неопределено);
			Если Задание <> Неопределено И Задание.Свойство("id") Тогда
				Снимок = СнимокНакладнойДляПроб();
				Снимок.Вставить("poll_mode", РежимОпросаПроб);
				Снимок.Вставить("probe_id", Задание.id);
				ЗаписатьСобытиеПроб("snapshot", Снимок);
				Ждать ОбменПробойHTTP("reply", Задание.id, Снимок);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписатьСобытиеПроб("poll_failed", Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 300));
	КонецПопытки;
	ОпросПробЗанят = Ложь;
КонецПроцедуры

&НаКлиенте
Функция РежимИзУправленияПроб()
	Управление = Новый ТекстовыйДокумент;
	Управление.Прочитать("@MODE_PATH@");
	Режим = СокрЛП(Управление.ПолучитьТекст());
	Если Режим <> "sync" И Режим <> "async" Тогда Возврат "off"; КонецЕсли;
	Возврат Режим;
КонецФункции

&НаКлиенте
Асинх Функция ОбменПробойHTTP(Действие, Ид, Снимок)
	Тело = Новый Структура("token,action,id,snapshot", "@CLIENT_TOKEN@", Действие, Ид, Снимок);
	Соединение = Новый HTTPСоединение("127.0.0.1", 17825, , , , 2);
	Запрос = Новый HTTPЗапрос("/api/_fixture_row_observer");
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.УстановитьТелоИзСтроки(ЗаписатьJSONПроб(Тело), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	ЗаписатьСобытиеПроб(Действие + "_start");
	Если РежимОпросаПроб = "sync" Тогда
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
	Иначе
		Ответ = Ждать Соединение.ВызватьHTTPМетодАсинх("POST", Запрос);
	КонецЕсли;
	ЗаписатьСобытиеПроб(Действие + "_finish", Ответ.КодСостояния);
	Если Ответ.КодСостояния <> 200 Тогда Возврат Неопределено; КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Возврат ПрочитатьJSON(Чтение);
КонецФункции

&НаКлиенте
Функция СнимокНакладнойДляПроб()
	Стадия = "windows";
	СнимокПроб = Новый Структура("status", "unavailable");
	Попытка
		ФормаНакладнойПроб = Неопределено;
		Для Каждого ОкноКлиентаПроб Из ПолучитьОкна() Цикл
			Стадия = "window_content";
			Для Каждого КандидатФормыПроб Из ОкноКлиентаПроб.Содержимое Цикл
				Если ТипЗнч(КандидатФормыПроб) <> Тип("ФормаКлиентскогоПриложения") Тогда Продолжить; КонецЕсли;
				Стадия = "form_name";
				Если КандидатФормыПроб.ИмяФормы <> "Документ.ПриходнаяНакладная.ФормаОбъекта" Тогда Продолжить; КонецЕсли;
				Если ФормаНакладнойПроб <> Неопределено Тогда Возврат Новый Структура("status,reason", "unavailable", "ambiguous_form"); КонецЕсли;
				ФормаНакладнойПроб = КандидатФормыПроб;
			КонецЦикла;
		КонецЦикла;
		Если ФормаНакладнойПроб = Неопределено Тогда Возврат Новый Структура("status,reason", "unavailable", "form_not_found"); КонецЕсли;
		Стадия = "table_element";
		ТаблицаНакладнойПроб = ФормаНакладнойПроб.Элементы.Найти("СписокНоменклатуры");
		Если ТаблицаНакладнойПроб = Неопределено Тогда Возврат Новый Структура("status,reason", "unavailable", "table_not_found"); КонецЕсли;
		Стадия = "data_path";
		СнимокПроб.Вставить("form_id", Строка(ФормаНакладнойПроб.УникальныйИдентификатор));
		Попытка
			СнимокПроб.Вставить("path", ТаблицаНакладнойПроб.ПутьКДанным);
		Исключение
			СнимокПроб.Вставить("path_error", Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 300));
		КонецПопытки;
		Если СнимокПроб.Свойство("path") И СнимокПроб.path <> "Объект.СписокНоменклатуры" Тогда
			СнимокПроб.Вставить("reason", "unexpected_data_path");
			Возврат СнимокПроб;
		КонецЕсли;
		Попытка
			СнимокПроб.Вставить("current_row", ТаблицаНакладнойПроб.ТекущаяСтрока);
		Исключение
			СнимокПроб.Вставить("current_row_error", Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 300));
		КонецПопытки;
		Стадия = "form_data";
		// Фиксированный реквизит конкретной формы. При недоступном ПутьКДанным
		// проба проверяет доступ к коллекции отдельно от привязки элемента таблицы.
		СтрокиНакладнойПроб = ФормаНакладнойПроб.Объект.СписокНоменклатуры;
		Если ТипЗнч(СтрокиНакладнойПроб) <> Тип("ДанныеФормыКоллекция") Тогда
			СнимокПроб.Вставить("reason", "unsupported_source");
			Возврат СнимокПроб;
		КонецЕсли;
		Если СтрокиНакладнойПроб.Количество() > 50 Тогда
			СнимокПроб.Вставить("reason", "row_limit");
			Возврат СнимокПроб;
		КонецЕсли;
		Стадия = "native_ids";
		СтрокиПроб = Новый Массив;
		Для Каждого СтрокаДанных Из СтрокиНакладнойПроб Цикл
			СтрокиПроб.Добавить(СтрокаДанных.ПолучитьИдентификатор());
		КонецЦикла;
		СнимокПроб.Вставить("row_ids", СтрокиПроб);
		СнимокПроб.status = "observed";
		Возврат СнимокПроб;
	Исключение
		СнимокПроб.Вставить("reason", "form_observation_failed");
		СнимокПроб.Вставить("stage", Стадия);
		СнимокПроб.Вставить("error", Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 300));
		Возврат СнимокПроб;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ЗаписатьJSONПроб(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

&НаКлиенте
Процедура ЗаписатьСобытиеПроб(Событие, Значение = Неопределено)
	Попытка
		Трасса = Новый ЗаписьТекста("@TRACE_PATH@", КодировкаТекста.UTF8, , Истина);
		Трасса.ЗаписатьСтроку(ЗаписатьJSONПроб(Новый Структура("time,mode,event,value",
			ТекущаяУниверсальнаяДатаВМиллисекундах(), РежимОпросаПроб, Событие, Значение)));
		Трасса.Закрыть();
	Исключение
		Результат = "trace_unavailable";
	КонецПопытки;
КонецПроцедуры
