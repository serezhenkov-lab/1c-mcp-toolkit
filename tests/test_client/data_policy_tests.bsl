&НаКлиенте
Процедура ТестПолитикаДанных()
	Для Каждого ДействиеТеста Из СтрРазделить("start,attach,status,detach,stop", ",") Цикл
		ТестКлассификацияРазрешения("test_session", ДействиеТеста, Ложь, ДействиеТеста <> "status");
	КонецЦикла;
	Для Каждого ДействиеТеста Из СтрРазделить("read,find,select,add,fill,delete", ",") Цикл
		ТестКлассификацияРазрешения("test_table", ДействиеТеста, Ложь, ДействиеТеста <> "read" И ДействиеТеста <> "find");
		ТестКлассификацияРазрешения("test_table", ДействиеТеста, Истина, Истина);
	КонецЦикла;
	Для Каждого ИнструментТеста Из СтрРазделить("test_open,test_input,test_action,test_inspect,test_expect", ",") Цикл
		ТестКлассификацияРазрешения(ИнструментТеста, "", Ложь, ИнструментТеста <> "test_inspect" И ИнструментТеста <> "test_expect");
	КонецЦикла;
	КомандаТеста = Новый Структура("tool,params", "test_session", Новый Структура("action,params", "start", Новый Структура));
	РежимПодтвержденияОпасныхОпераций = "ask";
	ЗафиксироватьПоказаннуюКоманду(КомандаТеста);
	КомандаТеста._toolkit_approval.approved = Истина;
	ТестПроверка("approved_current", ПроверитьРазрешениеПередИсполнением(КомандаТеста) = Неопределено, "ask");
	РежимПодтвержденияОпасныхОпераций = "deny";
	ТестПроверка("deny_before_dispatch", ПроверитьРазрешениеПередИсполнением(КомандаТеста) <> Неопределено, "deny");
	ТестПроверка("driver_read_without_navigation", ТестДрайвер.ТестРазрешениеЧтенияUI(Ложь), "deny");
	ТестПроверка("driver_navigation_denied", Не ТестДрайвер.ТестРазрешениеЧтенияUI(Истина), "deny");
	РежимПодтвержденияОпасныхОпераций = "ask";
	ПоколениеРазрешений = ПоколениеРазрешений + 1;
	ТестПроверка("stale_generation", ПроверитьРазрешениеПередИсполнением(КомандаТеста) <> Неопределено, "ask");
	ЗафиксироватьПоказаннуюКоманду(КомандаТеста);
	КомандаТеста._toolkit_approval.approved = Истина;
	КомандаТеста.params.action = "stop";
	ТестПроверка("changed_action", ПроверитьРазрешениеПередИсполнением(КомандаТеста) <> Неопределено, "stop");
	КомандаТеста.tool = "get_metadata";
	ТестПроверка("old_read_unchanged", Не КомандаТребуетПодтверждения(КомандаТеста), "get_metadata");
	РежимПодтвержденияОпасныхОпераций = "session_allow";
КонецПроцедуры

&НаКлиенте
Процедура ТестКлассификацияРазрешения(ИнструментТеста, ДействиеТеста, НавигацияТеста, Ожидается)
	АргументыТеста = Новый Структура("action,params", ДействиеТеста, Новый Структура("allow_navigation", НавигацияТеста));
	КомандаТеста = Новый Структура("tool,params", ИнструментТеста, АргументыТеста);
	ИмяТеста = ИнструментТеста + "_" + ДействиеТеста + "_" + Строка(НавигацияТеста);
	ТестПроверка(ИмяТеста + "_classification", КомандаТребуетПодтверждения(КомандаТеста) = Ожидается, Ожидается);
	РежимПодтвержденияОпасныхОпераций = "deny";
	ТестПроверка(ИмяТеста + "_deny", (ПроверитьРазрешениеПередИсполнением(КомандаТеста) <> Неопределено) = Ожидается, Ожидается);
	РежимПодтвержденияОпасныхОпераций = "ask";
	ТестПроверка(ИмяТеста + "_ask", (ПроверитьРазрешениеПередИсполнением(КомандаТеста) <> Неопределено) = Ожидается, Ожидается);
	РежимПодтвержденияОпасныхОпераций = "session_allow";
	ТестПроверка(ИмяТеста + "_allow", ПроверитьРазрешениеПередИсполнением(КомандаТеста) = Неопределено, Истина);
КонецПроцедуры
