// Диагностическая проба API менеджера. Не включается в поставку Toolkit.
&НаКлиенте
Функция ТестСвойстваГруппUI() Экспорт
	Результаты = Новый Массив;
	Форма = ТКПриложение.НайтиОбъект(Тип("ТестируемаяФорма"), "Action Fixture", , 1);
	Для Каждого ИмяГруппы Из СтрРазделить("Карточка,Обычная,БезГиперссылки", ",") Цикл
		Группа = Форма.НайтиОбъект(Тип("ТестируемаяГруппаФормы"), , ИмяГруппы, 1);
		Свойства = Новый Структура("kind,visible,enabled,read_only", Строка(Группа.Вид), Группа.ТекущаяВидимость(), Группа.ТекущаяДоступность(), Группа.ТекущееТолькоПросмотр());
		Результаты.Добавить(Новый Структура("name,ok,details", ИмяГруппы + "_known_properties", Истина, Свойства));
		Для Каждого Свойство Из СтрРазделить("ОтображатьКакКарточку,Гиперссылка,ShowAsCard,Hyperlink", ",") Цикл
			Доступно = Ложь; Ошибка = ""; Значение = Неопределено;
			Попытка
				Значение = Вычислить("Группа." + Свойство);
				Доступно = Истина;
			Исключение
				Ошибка = ОписаниеОшибки();
			КонецПопытки;
			Результаты.Добавить(Новый Структура("name,ok,details", ИмяГруппы + "_" + Свойство, Истина,
				Новый Структура("available,value,error", Доступно, Значение, Ошибка)));
		КонецЦикла;
		Поле = Форма.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Результат", 1);
		До = Поле.ПолучитьПредставлениеДанных();
		Вызвано = Ложь; Ошибка = "";
		Попытка Группа.Нажать(); Вызвано = Истина; Исключение Ошибка = ОписаниеОшибки(); КонецПопытки;
		После = Поле.ПолучитьПредставлениеДанных();
		Результаты.Добавить(Новый Структура("name,ok,details", ИмяГруппы + "_click", Истина,
			Новый Структура("invoked,before,after,error", Вызвано, До, После, Ошибка)));
	КонецЦикла;
	Возврат Результаты;
КонецФункции
