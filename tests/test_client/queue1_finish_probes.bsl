
// Test-copy exports, never part of the production EPF.
&НаКлиенте
Функция ПроверкаЗапретаУправления(Профиль, ИдЖивого) Экспорт
	ТКПрофиль = Профиль;
	ТКДиагностика = Новый Структура("process_state,connection_stage,last_api_error,requested_endpoint,observed_endpoint", "Unknown", "not_started");
	ТКСеанс = "probe-session";
	Результат = Новый Массив;
	Для Каждого Действие Из СтрРазделить("start,stop", ",") Цикл
		ТКПроцесс = Новый Структура("pid,created,token", ИдЖивого, "mismatch", "test-proof");
		ТКВладелец = Истина;
		ТКСостояние = ?(Действие = "start", "disconnected", "ready");
		Ответ = ВыполнитьСеанс(Действие, ТКСеанс, "probe-" + Действие);
		Результат.Добавить(Новый Структура("action,answer,proof", Действие, КопияJSONUI(Ответ), КопияJSONUI(ТКПроцесс)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ПроверкаПричинПроцесса(ИдЖивого) Экспорт
	Результат = Новый Массив;
	ТКДиагностика = Новый Структура("process_state,connection_stage,last_api_error,requested_endpoint,observed_endpoint", "Unknown", "not_started");
	Для Каждого Случай Из СтрРазделить("Unknown,AccessDenied,Exited,StartTimeMismatch,Alive", ",") Цикл
		Доказательство = Новый Структура("pid,created", ИдЖивого, "mismatch");
		Если Случай = "Unknown" Тогда Доказательство.pid = 0;
		ИначеЕсли Случай = "AccessDenied" Тогда Доказательство.pid = -81;
		ИначеЕсли Случай = "Exited" Тогда Доказательство.pid = 2147483647;
		ИначеЕсли Случай = "Alive" Тогда Доказательство = ДанныеПроцесса(ИдЖивого); КонецЕсли;
		Данные = Новый Структура("case,value,exception,state", Случай);
		Попытка Данные.value = ПроцессЖив(Доказательство);
		Исключение Данные.exception = ОписаниеОшибки(); КонецПопытки;
		Данные.state = ТКДиагностика.process_state;
		Результат.Добавить(Данные);
	КонецЦикла;
	ТКПроцесс = Новый Структура("pid,created", ИдЖивого, "mismatch");
	ТКВладелец = Истина;
	ТКСостояние = "stopping";
	ТКОперация = Новый Структура("status,verification", "running", "not_requested");
	ТКПерваяПроверка = Истина;
	ТКСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 5000;
	ШагНаблюдения();
	Результат.Добавить(Новый Структура("case,state,owned,operation,diagnostics", "stopping_mismatch", ТКСостояние, ТКВладелец, ТКОперация, ТКДиагностика));
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ПроверкаEndpoint(Профиль, ИдПроцесса, Случай) Экспорт
	ТКПрофиль = Профиль;
	ТКПрофиль.id = Случай;
	ТКДиагностика = Новый Структура("process_state,connection_stage,last_api_error,requested_endpoint,observed_endpoint",
		"Unknown", "not_started", Неопределено, Новый Структура("host,port", "localhost", Профиль.port));
	ТКПроцесс = ДанныеПроцесса(ИдПроцесса);
	ТКСостояние = "starting";
	ТКВладелец = Ложь;
	ТКОперация = Новый Структура("status,verification", "running", "not_requested");
	ТКПерваяПроверка = Истина;
	ТКСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 5000;
	ШагНаблюдения();
	ОтключитьОбработчикОжидания("ШагНаблюдения");
	ОтключитьAPI();
	Возврат Новый Структура("state,owned,error,operation,diagnostics", ТКСостояние, ТКВладелец, ТКОшибка, ТКОперация, ТКДиагностика);
КонецФункции

&НаКлиенте
Функция ПроверкаСвойствПредков() Экспорт
	Результат = Новый Массив;
	Для Каждого Имя Из СтрРазделить("СкрытаяКнопка,НедоступнаяКнопка,Текст", ",") Цикл
		ТипЦели = ?(Имя = "Текст", Тип("ТестируемоеПолеФормы"), Тип("ТестируемаяКнопкаФормы"));
		Цель = ТКПриложение.НайтиОбъект(ТипЦели, , Имя, 1);
		Данные = Новый Структура("name,visible,enabled,editing,value", Имя,
			СвойствоUI(Цель, "visible"), СвойствоUI(Цель, "enabled"), СвойствоUI(Цель, "editing"), СвойствоUI(Цель, "value"));
		Результат.Добавить(Данные);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ПроверкаАктивногоВвода(Начать = Ложь) Экспорт
	Поле = ТКПриложение.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Текст", 1);
	Если Начать Тогда Поле.Активизировать(); Поле.ВвестиТекст("BUFFER_NOT_COMMITTED"); КонецЕсли;
	Форма = Поле.ПолучитьРодителя();
	Результат = Новый Структура("current,buffer,buffer_unavailable,editing",
		Форма.ПолучитьТекущийЭлемент().Имя, Неопределено, Неопределено, СвойствоUI(Поле, "editing"));
	Попытка Результат.buffer = Поле.ПолучитьТекстРедактирования();
	Исключение Результат.buffer_unavailable = "property_read_failed"; КонецПопытки;
	Возврат Результат;
КонецФункции
