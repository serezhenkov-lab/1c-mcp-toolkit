&НаКлиенте
Процедура ВыполнитьТестыЖурнала(ПутьРезультатов)
	Проверки = Новый Массив;
	Для Каждого Инструмент Из СтрРазделить("test_session,test_open,test_inspect,test_input,test_action,test_table,test_expect", ",") Цикл
		Лог = "";
		Аргументы = Новый Структура("request_id,action,params", "log-request", "status", Новый Структура);
		Команда = Новый Структура("tool,params,id", Инструмент, Аргументы, "log-operation");
		До = ЗаписатьJSON2(Аргументы);
		ЖурналТестирования(Команда, "command");
		ЖурналТестирования(Команда, "response", Новый Структура("operation_id,status", "log-operation", "queued"));
		Ответ = Новый Структура("operation_id,status,data,error", "log-operation", "succeeded", Новый Структура("value", "LOG_RESULT"), Неопределено);
		ЖурналТестирования(Команда, "completed", Ответ);
		ПроверитьЖурнал(СтрНайти(Лог, "Получена команда: " + Инструмент) > 0
			И СтрНайти(Лог, "queued") > 0 И СтрНайти(Лог, "LOG_RESULT") > 0
			И СтрНайти(Лог, "operation_id=log-operation") > 0, Инструмент, Проверки);
		ПроверитьЖурнал(ЗаписатьJSON2(Аргументы) = До, "params unchanged " + Инструмент, Проверки);
		ПрежнийЛог = Лог;
		ЖурналТестирования(Команда, "command");
		ЖурналТестирования(Команда, "completed", Ответ);
		ПроверитьЖурнал(Лог = ПрежнийЛог, "no duplicate callback " + Инструмент, Проверки);
	КонецЦикла;

	Лог = "";
	Команда = Новый Структура("tool,params,id", "test_action", Новый Структура, "failure-operation");
	Ошибка = Новый Структура("code,message", "element_not_found", "Тестовая ошибка");
	Ответ = Новый Структура("status,data,error", "failed", Неопределено, Ошибка);
	ЖурналТестирования(Команда, "completed", Ответ);
	ПроверитьЖурнал(СтрНайти(Лог, "element_not_found") > 0 И СтрНайти(Лог, "Тестовая ошибка") > 0, "structured error", Проверки);

	Состояние = Новый Структура("status", "awaiting_approval");
	ЖурналТестирования(Команда, "state", Состояние);
	ПрежнийЛог = Лог;
	ЖурналТестирования(Команда, "state", Состояние);
	ПроверитьЖурнал(Лог = ПрежнийЛог И СтрНайти(Лог, "awaiting_approval") > 0, "approval state once", Проверки);
	Состояние.status = "running";
	ЖурналТестирования(Команда, "state", Состояние);
	ПроверитьЖурнал(СтрНайти(Лог, "running") > 0, "running state", Проверки);

	Лог = "";
	Команда = Новый Структура("tool,params,id", "test_inspect", Новый Структура, "long-operation");
	ЖурналТестирования(Команда, "command");
	ДлиннаяСтрока = "x";
	Для Индекс = 1 По 15 Цикл ДлиннаяСтрока = ДлиннаяСтрока + ДлиннаяСтрока; КонецЦикла;
	Ответ = Новый Структура("status,data", "succeeded", ДлиннаяСтрока);
	До = ЗаписатьJSON2(Ответ);
	ЖурналТестирования(Команда, "completed", Ответ);
	ПроверитьЖурнал(СтрДлина(Лог) < 17000 И СтрНайти(Лог, "усечена") > 0
		И СтрНайти(Лог, "Получена команда: test_inspect") > 0, "bounded entry preserves command", Проверки);
	ПроверитьЖурнал(ЗаписатьJSON2(Ответ) = До, "full response unchanged", Проверки);
	Для Индекс = 1 По 8 Цикл ЖурналТестирования(Команда, "response", Ответ); КонецЦикла;
	ПроверитьЖурнал(СтрДлина(Лог) <= 70000, "existing total log limit", Проверки);
	ПрежнийЛог = Лог;
	ЖурналТестирования(Новый Структура, "command");
	ПроверитьЖурнал(Лог = ПрежнийЛог, "logging failure isolated", Проверки);

	Лог = "";
	Запрос = Новый Структура("query", Новый Структура);
	НеверныеАргументы = Новый Структура("unexpected", Истина);
	Отказ = ВстроенныйВызовТестирования(Запрос, "test_action", НеверныеАргументы);
	ПроверитьЖурнал(Отказ.error.code = "invalid_params" И СтрНайти(Лог, "Получена команда: test_action") > 0
		И СтрНайти(Лог, "invalid_params") > 0, "actual embedded validation path", Проверки);

	Лог = "";
	Команда = Новый Структура("tool,params,id,_lifecycle_route", "test_action", Новый Структура, "callback-operation", Новый Структура("address,channel", "embedded", "default"));
	Ответ = Новый Структура("status,data,error", "succeeded", Новый Структура("marker", "CALLBACK_RESULT"), Неопределено);
	ПослеПубличногоТестирования(Ответ, Команда);
	ПроверитьЖурнал(СтрНайти(Лог, "CALLBACK_RESULT") > 0, "actual async callback path", Проверки);
	ЛокальныйПрофильУправляется = Истина;
	ЛокальныйПрофильВключен = Ложь;
	Лог = "";
	Команда = Новый Структура("tool,params,id,_lifecycle_route", "test_inspect", Новый Структура, "proxy-operation", Новый Структура("address,channel", "embedded", "default"));
	ПринятьПубличнуюКомандуТестирования(Команда);
	ПроверитьЖурнал(СтрНайти(Лог, "Получена команда: test_inspect") > 0
		И СтрНайти(Лог, "session_not_ready") > 0, "actual public rejection path", Проверки);

	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(ЗаписатьJSON2(Новый Структура("checks,log", Проверки, Лог)));
	Документ.Записать(ПутьРезультатов);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЖурнал(Условие, Имя, Проверки)
	Если Не Условие Тогда ВызватьИсключение "FAILED: " + Имя; КонецЕсли;
	Проверки.Добавить(Имя);
КонецПроцедуры
