&НаКлиенте
Функция ПробаФормыUILog(Режим) Экспорт
    Итог = Новый Структура;
    Если Режим = "stale" Тогда
        Попытка
            Итог.Вставить("old_field_value", UILogПоле.ПолучитьПредставлениеДанных());
            Итог.Вставить("old_field_readable", Истина);
        Исключение
            Итог.Вставить("old_field_readable", Ложь);
            Итог.Вставить("old_field_error", ОписаниеОшибки());
        КонецПопытки;
        Попытка
            Текущий = UILogФорма.ПолучитьТекущийЭлемент();
            Итог.Вставить("old_form_readable", Истина);
        Исключение
            Итог.Вставить("old_form_readable", Ложь);
            Итог.Вставить("old_form_error", ОписаниеОшибки());
        КонецПопытки;
        Возврат Итог;
    КонецЕсли;
    Адрес = Новый Структура("selector", Новый Структура("form_name", "Документ.T43_Required.ФормаОбъекта"));
    ОкноПробногоВвода = РазрешитьОкноUI(Адрес);
    Элемент = РазрешитьЭлементUI(ОкноПробногоВвода.ref, Новый Структура("selector", Новый Структура("name", "ОбязательноеПоле")));
    Форма = Элемент.ref.ПолучитьРодителя();
    Если ТипЗнч(Форма) <> Тип("ТестируемаяФорма") Тогда ВызватьИсключение "Unexpected parent type"; КонецЕсли;
    Если Режим = "before" Тогда
        UILogФорма = Форма;
        UILogПоле = Элемент.ref;
        UILogЦель = ЦельЗавершенияВводаUI(Форма, Элемент.ref);
        Если UILogЦель = Неопределено Тогда ВызватьИсключение "No exact finish target"; КонецЕсли;
    КонецЕсли;
    Итог.Вставить("same_form_reference", UILogФорма = Форма);
    Итог.Вставить("same_field_reference", UILogПоле = Элемент.ref);
    Итог.Вставить("held_form_title", UILogФорма.ТекстЗаголовка);
    Итог.Вставить("fresh_form_title", Форма.ТекстЗаголовка);
    Итог.Вставить("form_name", UILogФорма.ИмяФормы);
    Итог.Вставить("held_value", UILogПоле.ПолучитьПредставлениеДанных());
    Итог.Вставить("chosen_finish_name", UILogЦель.Имя);
    Итог.Вставить("chosen_finish_title", UILogЦель.ТекстЗаголовка);
    Текущий = UILogФорма.ПолучитьТекущийЭлемент();
    Итог.Вставить("current_name", Текущий.Имя);
    Итог.Вставить("current_equals_chosen", Текущий = UILogЦель);
    Итог.Вставить("fresh_current_equals_chosen", Форма.ПолучитьТекущийЭлемент() = UILogЦель);
    Возврат Итог;
КонецФункции
