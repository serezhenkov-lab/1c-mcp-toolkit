&НаКлиенте
Функция ТестПриемкаИсходныеДанные()
    Привязка = ТестДрайвер.ТестБазаКлиентаПодтверждена();
    ТестПроверка("client_manager_database", Привязка.matched, Привязка);
    БазаЗапросов = ТестПриемкаБазаЗапросов(СтрокаСоединенияИнформационнойБазы());
    ТестПроверка("query_manager_database", БазаЗапросов, "connection equality without disclosure");
    Пусто = ТестПриемкаЗапрос().Количество() = 0;
    ТестПроверка("unique_before_ui", Пусто, "@NUMBER@");
    Возврат Привязка.matched И БазаЗапросов И Пусто;
КонецФункции

&НаСервереБезКонтекста
Функция ТестПриемкаБазаЗапросов(БазаМенеджера)
    Возврат БазаМенеджера = СтрокаСоединенияИнформационнойБазы();
КонецФункции

&НаСервере
Функция ТестПриемкаЗапрос()
    ЗапросТеста = Новый Запрос("@QUERY@");
    ЗапросТеста.УстановитьПараметр("Номер", "@NUMBER@");
    ЗапросТеста.УстановитьПараметр("НачалоГода", Дата(2026, 1, 1));
    ЗапросТеста.УстановитьПараметр("КонецГода", Дата(2027, 1, 1));
    СтрокиТеста = Новый Массив;
    Выборка = ЗапросТеста.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        СтрокиТеста.Добавить(Новый Структура("reference,number,date,marker,deletion_mark",
            Строка(Выборка.Ссылка.УникальныйИдентификатор()), Выборка.Номер,
            Формат(Выборка.Дата, "ДФ=yyyy-MM-dd'T'HH:mm:ss"), Выборка.ОбязательноеПоле, Выборка.ПометкаУдаления));
    КонецЦикла;
    Возврат СтрокиТеста;
КонецФункции

&НаКлиенте
Процедура ТестПриемкаИтог()
    СтрокиТеста = ТестПриемкаЗапрос();
    ТестПроверка("unique_after_ui", СтрокиТеста.Количество() = 1, СтрокиТеста);
    Если СтрокиТеста.Количество() = 1 Тогда
        СтрокаТеста = СтрокиТеста[0];
        ТестПроверка("unique_values", СтрокаТеста.number = "@NUMBER@" И СтрокаТеста.marker = "@MARKER@"
            И СтрокаТеста.date = "2026-11-14T12:00:00" И Не СтрокаТеста.deletion_mark, СтрокаТеста);
    КонецЕсли;
    ЗаписьТеста = Новый ЗаписьJSON; ЗаписьТеста.ОткрытьФайл("@ROOT@/acceptance-data.json");
    ЗаписатьJSON(ЗаписьТеста, СтрокиТеста); ЗаписьТеста.Закрыть();
КонецПроцедуры
