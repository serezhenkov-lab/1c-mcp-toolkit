// Только одноразовая копия: сбой после фактического ввода и сбой readback.
&НаКлиенте
Процедура ТестСбойВводаUI(Режим) Экспорт
	ТестОтказВвода = Режим;
	ТестЧислоВводов = 0;
КонецПроцедуры

&НаКлиенте
Процедура ТестПослеВводаUI()
	Если ТестЧислоВводов = Неопределено Тогда ТестЧислоВводов = 0; КонецЕсли;
	ТестЧислоВводов = ТестЧислоВводов + 1;
	Если ТестОтказВвода = "unknown" Тогда
		ТестОтказВвода = ""; ВызватьИсключение "TEST_INPUT_UNKNOWN";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТестПередЧтениемUI()
	Если ТестОтказВвода = "readback" Тогда
		ТестОтказВвода = ""; ОшибкаUI("value_unavailable");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ТестЧислоВводовUI() Экспорт
	Возврат ТестЧислоВводов;
КонецФункции

&НаКлиенте
Функция ТестТекстВводаUI() Экспорт
	Поле = ТКПриложение.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Текст", 1);
	Возврат Поле.ПолучитьПредставлениеДанных();
КонецФункции

&НаКлиенте
Функция ТестТекстРедактораUI() Экспорт
	Поле = ТКПриложение.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Текст", 1);
	Возврат Поле.ПолучитьТекстРедактирования();
КонецФункции

&НаКлиенте
Процедура ТестВыделитьВсеUI() Экспорт
	Таблица = ТКПриложение.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Строки", 1);
	Таблица.ВыделитьВсеСтроки();
КонецПроцедуры

&НаКлиенте
Функция ТестИдентичностьОписаниеUI() Экспорт
	Таблица = ТКПриложение.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Строки", 1);
	Таблица.ПерейтиКПервойСтроке();
	Первое = Таблица.ПолучитьТекущуюСтроку();
	Повтор = Таблица.ПолучитьТекущуюСтроку();
	Таблица.ПерейтиКСледующейСтроке();
	Второе = Таблица.ПолучитьТекущуюСтроку();
	ПовторВторого = Таблица.ПолучитьТекущуюСтроку();
	Таблица.ПерейтиКПервойСтроке();
	Восстановленное = Таблица.ПолучитьТекущуюСтроку();
	Возврат Новый Структура("same_row_equal,next_row_equal,next_repeat_equal,first_restored_equal",
		Первое = Повтор, Первое = Второе, Второе = ПовторВторого, Первое = Восстановленное);
КонецФункции
