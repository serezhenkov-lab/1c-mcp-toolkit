&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Текст = "Начальное";
    Элементы.Выбор.СписокВыбора.Добавить("Green", "Зелёный");
    Элементы.Выбор.СписокВыбора.Добавить("D1", "Дубль");
    Элементы.Выбор.СписокВыбора.Добавить("D2", "Дубль");
    НоваяСтрока = Строки.Добавить();
    НоваяСтрока.Ключ = "A";
    НоваяСтрока.Значение = "Первое";
    НоваяСтрока = Строки.Добавить();
    НоваяСтрока.Ключ = "B";
    НоваяСтрока.Значение = "Второе";
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОбработка(Команда)
    Если ПустаяСтрока(Текст) Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "API_REQUIRED_TEXT";
        Сообщение.Сообщить();
        Возврат;
    КонецЕсли;
    Результат = Текст + ":" + Строка(Флаг);
КонецПроцедуры

&НаКлиенте
Процедура ДиалогОбработка(Команда)
    ПоказатьВопрос(Новый ОписаниеОповещения("ПослеДиалога", ЭтотОбъект), "API_MODAL", РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ПослеДиалога(Ответ, ДополнительныеПараметры) Экспорт
    Результат = "Ответ:" + Строка(Ответ);
КонецПроцедуры

&НаКлиенте
Процедура ВыборНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    ОткрытьФорму("ВнешняяОбработка.ApiFixture.Форма.Choice", , Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ТекстПриИзменении(Элемент)
    Если Текст = "Отклонено" Тогда Текст = "Исправлено"; КонецЕсли;
    Если Текст = "БольшойСписок" Тогда
        Элементы.Выбор.СписокВыбора.Очистить();
        Для Номер = 0 По 500 Цикл
            Элементы.Выбор.СписокВыбора.Добавить("Value" + Строка(Номер), ?(Номер = 0, "Зелёный", "Пункт" + Строка(Номер)));
        КонецЦикла;
    КонецЕсли;
КонецПроцедуры
