// Только тестовая копия менеджера: воспроизведение неверного API и установка режима таблицы.
&НаКлиенте
Функция ПробаEditing(Режим = "read") Экспорт
    ПолеПробы = ТКПриложение.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Текст", 1);
    ТаблицаПробы = ТКПриложение.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Строки", 1);
    Если Режим = "begin" Тогда
        ТаблицаПробы.ПерейтиКПервойСтроке();
        ТаблицаПробы.ИзменитьСтроку();
    ИначеЕсли Режим = "end" Тогда
        ТаблицаПробы.ЗакончитьРедактированиеСтроки(Истина);
    ИначеЕсли Режим = "field" Тогда
        ПолеПробы.Активизировать();
    КонецЕсли;
    ОшибкаПоля = "";
    Попытка
        ПолеПробы.ТекущийРежимРедактирование();
    Исключение
        ОшибкаПоля = ОписаниеОшибки();
    КонецПопытки;
    Возврат Новый Структура("field_type,field_error,table_type,table_editing", Строка(ТипЗнч(ПолеПробы)),
        ОшибкаПоля, Строка(ТипЗнч(ТаблицаПробы)), ТаблицаПробы.ТекущийРежимРедактирование());
КонецФункции
