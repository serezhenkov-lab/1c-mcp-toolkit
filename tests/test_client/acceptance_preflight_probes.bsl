&НаКлиенте
Функция ТестБазаКлиентаПодтверждена() Экспорт
	СлушательТеста = ПроцессПорта();
	Если СлушательТеста = Неопределено Тогда Возврат Новый Структура("matched", Ложь); КонецЕсли;
	Возврат Новый Структура("matched,pid,created,method",
		ТКСостояние = "ready" И ТКПроцесс <> Неопределено
		И ТКПроцесс.pid = СлушательТеста.pid И ТКПроцесс.created = СлушательТеста.created
		И СовпадаетБазаПроцесса(СлушательТеста)
		И ТКПрофиль.connection = СтрокаСоединенияИнформационнойБазы(),
		СлушательТеста.pid, СлушательТеста.created, "owned_port_process_connection_string");
КонецФункции
