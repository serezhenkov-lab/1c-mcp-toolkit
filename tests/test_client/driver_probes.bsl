// Доступ к API только для инъекции отказов в тестовой копии; в поставку не входит.
&НаКлиенте
Процедура ТестНезавершеннаяОперация() Экспорт
	ТКОперация = Новый Структура("id,status,execution,verification", "injected-pending", "running", "invoked", "not_requested");
КонецПроцедуры

&НаКлиенте
Процедура ТестОткрытьВопрос() Экспорт
	Для Каждого ОкноКлиента Из ТКПриложение.ПолучитьПодчиненныеОбъекты() Цикл
		Если ОкноКлиента.Основное Тогда
			ОкноКлиента.ВыполнитьКоманду("e1cib/app/Обработка.ApiFixture.Форма.Main");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Кнопка = ТКПриложение.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , "Диалог", 1);
	Кнопка.Нажать();
КонецПроцедуры

&НаКлиенте
Функция ТестВопросОстался() Экспорт
	Возврат ТКПриложение.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Да", , 1) <> Неопределено;
КонецФункции

&НаКлиенте
Процедура ТестОтветитьНет() Экспорт
	Кнопка = ТКПриложение.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Нет", , 1);
	Кнопка.Нажать();
КонецПроцедуры
