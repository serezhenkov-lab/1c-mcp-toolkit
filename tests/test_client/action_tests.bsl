&НаКлиенте
Процедура ТестДействиеСтарт()
	ТестРезультаты = Новый Массив; ТестСрок = ТекущаяДата() + 180;
	Попытка
		Профиль = Новый Структура("id,exe,connection,user,port,receipt_path", "action-probe",
			КаталогПрограммы() + "1cv8c.exe", СтрокаСоединенияИнформационнойБазы(), "ApiProbe", 16538, "@ROOT@/receipt.json");
		ТестДрайвер = ПолучитьМенеджерТестирования(Профиль);
		Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "action-start", 60000);
		ТестСеанс = Снимок.session_id;
		ПодключитьОбработчикОжидания("ТестДействиеГотовность", 1, Истина);
	Исключение
		ТестПроверка("start_exception", Ложь, ОписаниеОшибки()); ТестФиниш();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ТестДействиеГотовность()
	Снимок = ТестДрайвер.СостояниеСеанса();
	Если Снимок.state = "ready" Тогда
		ТестОкноUI = Новый Структура("selector", Новый Структура("title", "Action Fixture"));
		ТестДрайвер.ТестОсновноеОкноUI();
		ТестДействиеКоманда("activate", "activate_window");
	ИначеЕсли ТекущаяДата() > ТестСрок Или Снимок.state = "failed" Тогда
		ТестПроверка("ready", Ложь, Снимок); ТестФиниш();
	Иначе
		ПодключитьОбработчикОжидания("ТестДействиеГотовность", 1, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТестДействиеКоманда(Имя, Действие, Элемент = Неопределено)
	Аргументы = Новый Структура("request_id,session_id,params,window,action,timeout_ms", Имя, ТестСеанс, Новый Структура, ТестОкноUI, Действие, 30000);
	Если Элемент <> Неопределено Тогда Аргументы.Вставить("element", Элемент); КонецЕсли;
	Ответ = ПринятьКомандуТестирования("test_action", Аргументы, "op-" + Имя, Новый ОписаниеОповещения("ТестДействиеОтвет", ЭтаФорма));
	Если Ответ.status = "failed" Тогда ТестПроверка(Имя + "_accepted", Ложь, Ответ); ТестФиниш(); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ТестКнопкаДиалогаUI(Узлы, Заголовок)
	Для Каждого Узел Из Узлы Цикл
		Если Узел.type = "button" И Узел.title = Заголовок Тогда Возврат Узел.element_id; КонецЕсли;
		Найдено = ТестКнопкаДиалогаUI(Узел.children, Заголовок);
		Если Найдено <> Неопределено Тогда Возврат Найдено; КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ТестДействиеОтвет(Результат, ДополнительныеПараметры) Экспорт
	Попытка
		Имя = Результат.request_id; Ошибка = "";
		Если Имя = "diagnostic_failure" Тогда Ошибка = "value_unavailable"; КонецЕсли;
		Если Имя = "invalid_button" Тогда Ошибка = "invalid_params"; КонецЕсли;
		Если Имя = "close_dialog" Тогда Ошибка = "action_not_confirmed"; КонецЕсли;
		Успех = ?(Ошибка = "", Результат.status = "succeeded" И Результат.verification = "confirmed",
			Результат.error <> Неопределено И Результат.error.code = Ошибка И Результат.verification = "not_confirmed");
		ТестПроверка(Имя, Успех, Результат);
		Если Не Успех Тогда ТестФиниш(); Возврат; КонецЕсли;
		Если Имя = "activate" Тогда
			ТестПроверка("window_active", Результат.data.target_active И Результат.data.active_window.title = "Action Fixture", Результат.data);
			ТестДействиеКоманда("page", "select_page", ТестUIПоле("Вторая"));
		ИначеЕсли Имя = "page" Тогда
			ТестПроверка("page_current", Результат.data.current_page = "Вторая", Результат.data);
			ТестДействиеКоманда("click", "click", ТестUIПоле("Проверить"));
		ИначеЕсли Имя = "click" Тогда
			ТестПроверка("click_once", Результат.execution = "invoked" И ТестДрайвер.ТестСчетчикДействийUI() = "1", Результат);
			ТестПроверка("click_scope", Результат.data.verification_scope = "invocation_and_observation" И Результат.data.observation_complete, Результат.data);
			ТестПроверка("click_message", Результат.data.user_messages.Количество() > 0 И Результат.data.user_messages[0].text = "ACTION_CLICK", Результат.data);
			ТестДрайвер.ТестСломатьНаблюдениеДействияUI();
			ТестДействиеКоманда("diagnostic_failure", "click", ТестUIПоле("Проверить"));
		ИначеЕсли Имя = "diagnostic_failure" Тогда
			ТестПроверка("diagnostic_no_retry", Результат.execution = "invoked" И ТестДрайвер.ТестСчетчикДействийUI() = "2"
				И Результат.data.completed_steps.Количество() = 1 И Не Результат.data.observation_complete, Результат);
			ТестДействиеКоманда("invalid_button", "click", ТестUIПоле("Текст"));
		ИначеЕсли Имя = "invalid_button" Тогда
			ТестПроверка("invalid_no_invocation", Результат.execution = "not_started" И ТестДрайвер.ТестСчетчикДействийUI() = "2", Результат);
			ТестДействиеКоманда("close_dialog", "close");
		ИначеЕсли Имя = "close_dialog" Тогда
			ТестПроверка("close_not_confirmed", Результат.execution = "invoked" И Не Результат.data.closed, Результат);
			КнопкаНет = ТестКнопкаДиалогаUI(Результат.data.active_window_tree.tree, "Нет");
			ТестПроверка("dialog_returned", КнопкаНет <> Неопределено И ТестДрайвер.ТестВопросОстался(), Результат.data);
			Если КнопкаНет = Неопределено Тогда ТестФиниш(); Возврат; КонецЕсли;
			ТестОкноUI = Новый Структура("id", Результат.data.active_window.window_id);
			ТестДействиеКоманда("explicit_no", "click", Новый Структура("id", КнопкаНет));
		ИначеЕсли Имя = "explicit_no" Тогда
			ТестПроверка("dialog_answer_separate", Не ТестДрайвер.ТестВопросОстался() И ТестДрайвер.ТестСчетчикДействийUI() = "2", Результат);
			ТестОкноUI = Новый Структура("selector", Новый Структура("title", "Action Fixture"));
			ТестДействиеКоманда("close_final", "close");
		ИначеЕсли Имя = "close_final" Тогда
			ТестПроверка("closed_observed", Результат.data.closed И Результат.execution = "invoked", Результат);
			ТестФиниш();
		КонецЕсли;
	Исключение
		ТестПроверка("action_exception", Ложь, ОписаниеОшибки()); ТестФиниш();
	КонецПопытки;
КонецПроцедуры
