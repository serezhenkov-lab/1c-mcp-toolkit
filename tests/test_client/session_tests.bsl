// Выполняется только в одноразовой тестовой копии Toolkit.
&НаКлиенте
Процедура ТестСеансаСтарт()
	ТестРезультаты = Новый Массив;
	ТестЭтап = 0;
	ТестСрок = ТекущаяДата() + 110;
	Попытка
		Профиль = Новый Структура("id,exe,connection,user,port,receipt_path", "probe",
			КаталогПрограммы() + "1cv8c.exe", СтрокаСоединенияИнформационнойБазы(), "ApiProbe", 16538, "@ROOT@/receipt.json");
		ТестДрайвер = ПолучитьМенеджерТестирования(Профиль);
		ТестПрофиль = Профиль;
		Снимок = ТестДрайвер.СостояниеСеанса();
		Если Не Снимок.supported Тогда
			ТестПроверка("unsupported_platform", Снимок.error.code = "unsupported_platform", Снимок);
			ТестФиниш(); Возврат;
		КонецЕсли;
		Если Не Снимок.manager_mode Тогда
			Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "normal");
			ТестПроверка("no_manager", Снимок.error.code = "manager_mode_required", Снимок);
			ТестПроверка("restart_normal", КомандаСРольюМенеджераТестирования("test") = "test", Снимок);
			ТестФиниш(); Возврат;
		КонецЕсли;
		ТестПроверка("restart_role", КомандаСРольюМенеджераТестирования("test") = "test /TESTMANAGER", Снимок);
		ТестПроверка("utc_date", Лев(Снимок.observed_at, 4) = "2026", Снимок);
		Если ПараметрЗапуска = "recover" Тогда
			ТестПроверка("restart_disconnected", Снимок.state = "disconnected" И Не Снимок.owned, Снимок);
			ТестПроверка("permission_reset", РежимПодтвержденияОпасныхОпераций <> "session_allow", РежимПодтвержденияОпасныхОпераций);
			Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "restart-start");
			ТестПроверка("restart_no_duplicate", Снимок.error.code = "client_already_exists", Снимок);
			Чтение = Новый ЧтениеТекста("@ROOT@/old-session.txt");
			ПрежнийСеанс = Чтение.Прочитать(); Чтение.Закрыть();
			Снимок = ТестДрайвер.ВыполнитьСеанс("status", ПрежнийСеанс, "old-session");
			ТестПроверка("restart_stale_session", Снимок.error.code = "session_invalid", Снимок);
			Снимок = ТестДрайвер.ВыполнитьСеанс("attach", "", "recover-attach");
			ТестСеанс = Снимок.session_id;
			ТестЭтап = 8;
			ПодключитьОбработчикОжидания("ТестСеансаШаг", 1, Истина); Возврат;
		КонецЕсли;
		ДругойПрофиль = Новый Структура;
		Для Каждого Поле Из Профиль Цикл ДругойПрофиль.Вставить(Поле.Ключ, Поле.Значение); КонецЦикла;
		ДругойПрофиль.connection = "File=""C:/not-this-database"";";
		ДругойПрофиль.receipt_path = "@ROOT@/other-receipt.json";
		Другой = ПолучитьФорму(ИмяСлужебнойФормыМенеджераТестирования(), , ЭтаФорма, Новый УникальныйИдентификатор);
		Другой.Настроить(ДругойПрофиль);
		Снимок = Другой.ВыполнитьСеанс("attach", "", "other-database");
		ТестПроверка("other_database", Снимок.error.code = "database_mismatch", Снимок);
		Другой.ЗавершитьМенеджер();
		Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "start-1", 60000);
		ТестПроверка("start", Снимок.state = "starting" Или Снимок.state = "ready", Снимок);
		ТестСеанс = Снимок.session_id;
		Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "start-2");
		ТестПроверка("second_start", Снимок.error.code = "client_already_exists", Снимок);
		ТестЭтап = 1;
		ПодключитьОбработчикОжидания("ТестСеансаШаг", 1, Истина);
	Исключение
		ТестПроверка("exception_start", Ложь, ОписаниеОшибки()); ТестФиниш();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ТестСеансаШаг()
	Попытка
		Снимок = ТестДрайвер.СостояниеСеанса();
		Если ТекущаяДата() > ТестСрок Тогда
			ТестПроверка("timeout", Ложь, Снимок); ТестФиниш(); Возврат;
		КонецЕсли;
		Если ТестЭтап = 1 И Снимок.state = "ready" Тогда
			ТестПроверка("ready_owned", Снимок.owned И Снимок.operation.verification = "confirmed", Снимок);
			Снимок = ТестДрайвер.ВыполнитьСеанс("detach", ТестСеанс, "detach-1");
			ТестПроверка("detach", Снимок.state = "detached" И Снимок.owned, Снимок);
			Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "start-detached");
			ТестПроверка("no_second_after_detach", Снимок.error.code = "client_already_exists", Снимок);
			ТестЧужой = ПолучитьФорму(ИмяСлужебнойФормыМенеджераТестирования(), , ЭтаФорма, Новый УникальныйИдентификатор);
			ЧужойПрофиль = Новый Структура;
			Для Каждого Поле Из ТестПрофиль Цикл ЧужойПрофиль.Вставить(Поле.Ключ, Поле.Значение); КонецЦикла;
			ЧужойПрофиль.receipt_path = "@ROOT@/foreign-receipt.json";
			ТестЧужой.Настроить(ЧужойПрофиль);
			Снимок = ТестЧужой.ВыполнитьСеанс("start", "", "foreign-start");
			ТестПроверка("port_is_not_ownership", Снимок.error.code = "client_already_exists", Снимок);
			Снимок = ТестЧужой.ВыполнитьСеанс("attach", "", "foreign-attach");
			ТестПроверка("foreign_attached", Не Снимок.owned И Снимок.state = "ready", Снимок);
			ЧужойСеанс = Снимок.session_id;
			Снимок = ТестЧужой.ВыполнитьСеанс("stop", ЧужойСеанс, "foreign-stop");
			ТестПроверка("foreign_stop_denied", Снимок.error.code = "client_not_owned", Снимок);
			ТестЧужой.ВыполнитьСеанс("detach", ЧужойСеанс, "foreign-detach");
			ТестЧужой.ЗавершитьМенеджер();
			Снимок = ТестДрайвер.ВыполнитьСеанс("attach", "", "attach-1", 30000);
			ТестПроверка("reattach_new_id", Снимок.session_id <> ТестСеанс И Снимок.owned, Снимок);
			Старый = ТестДрайвер.ВыполнитьСеанс("status", ТестСеанс, "old-id");
			ТестПроверка("stale_session", Старый.error.code = "session_invalid", Старый);
			ТестСеанс = Снимок.session_id;
			ТестЭтап = 2;
		ИначеЕсли ТестЭтап = 2 И Снимок.state = "ready" Тогда
			ТестДрайвер.ТестОткрытьВопрос();
			Снимок = ТестДрайвер.ВыполнитьСеанс("stop", ТестСеанс, "stop-modal", 1000);
			ТестЭтап = 12;
		ИначеЕсли ТестЭтап = 12 И Снимок.state = "failed" Тогда
			ТестПроверка("modal_not_confirmed", Снимок.operation.verification = "not_confirmed", Снимок);
			ТестПроверка("modal_not_answered", ТестДрайвер.ТестВопросОстался(), Снимок);
			ТестДрайвер.ТестОтветитьНет();
			Снимок = ТестДрайвер.ВыполнитьСеанс("attach", "", "after-modal");
			ТестСеанс = Снимок.session_id;
			ТестЭтап = 13;
		ИначеЕсли ТестЭтап = 13 И Снимок.state = "ready" Тогда
			Снимок = ТестДрайвер.ВыполнитьСеанс("stop", ТестСеанс, "stop-1", 15000);
			ТестПроверка("stop_started", Снимок.state = "stopping" Или Снимок.state = "stopped", Снимок);
			ТестЭтап = 3;
		ИначеЕсли ТестЭтап = 3 И Снимок.state = "stopped" Тогда
			ТестПроверка("stop_confirmed", Снимок.operation.verification = "confirmed", Снимок);
			Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "zero-timeout", 0);
			ТестПроверка("zero_timeout", Снимок.state = "failed" И Снимок.process_known, Снимок);
			Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "no-retry");
			ТестПроверка("timeout_no_retry", Снимок.error.code = "client_already_exists", Снимок);
			ТестЭтап = 4;
		ИначеЕсли ТестЭтап = 4 Тогда
			Снимок = ТестДрайвер.ВыполнитьСеанс("attach", "", "after-timeout", 30000);
			Если Снимок.state = "ready" Тогда
				ТестСеанс = Снимок.session_id;
				ТестУбитьСобственныйКлиент();
				ТестЭтап = 5;
			КонецЕсли;
		ИначеЕсли ТестЭтап = 5 И Снимок.state = "disconnected" Тогда
			ТестПроверка("connection_lost", Снимок.error.code = "connection_lost", Снимок);
			Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "before-restart", 60000);
			ТестСеанс = Снимок.session_id;
			Запись = Новый ЗаписьТекста("@ROOT@/old-session.txt"); Запись.Записать(ТестСеанс); Запись.Закрыть();
			РежимПодтвержденияОпасныхОпераций = "session_allow";
			ТестПроверка("restart_prepared", Снимок.owned, Снимок);
			ОжидаемыйСтатус = ?(Снимок.operation.status = "running", "unknown", Снимок.operation.status);
			ТестДрайвер.ЗавершитьМенеджер();
			Снимок = ТестДрайвер.СостояниеСеанса();
			ТестПроверка("shutdown_preserves_completed_or_marks_pending", Снимок.operation.status = ОжидаемыйСтатус, Снимок);
			// Отдельная детерминированная инъекция pending: быстрый start мог уже завершиться.
			ТестДрайвер.ТестНезавершеннаяОперация();
			ТестДрайвер.ЗавершитьМенеджер();
			Снимок = ТестДрайвер.СостояниеСеанса();
			ТестПроверка("injected_pending_unknown", Снимок.operation.status = "unknown"
				И Снимок.operation.verification = "not_confirmed", Снимок);
			ТестФиниш(); Возврат;
		ИначеЕсли ТестЭтап = 8 И Снимок.state = "ready" Тогда
			ТестПроверка("restart_reattach", Не Снимок.owned, Снимок);
			Снимок = ТестДрайвер.ВыполнитьСеанс("stop", ТестСеанс, "restart-stop");
			ТестПроверка("restart_stop_denied", Снимок.error.code = "client_not_owned", Снимок);
			ТестФиниш(); Возврат;
		ИначеЕсли Снимок.state = "failed" Или Снимок.state = "disconnected" Тогда
			ТестПроверка("unexpected_state", Ложь, Снимок); ТестФиниш(); Возврат;
		КонецЕсли;
		ПодключитьОбработчикОжидания("ТестСеансаШаг", 1, Истина);
	Исключение
		ТестПроверка("exception_step", Ложь, ОписаниеОшибки()); ТестФиниш();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ТестПроверка(Имя, Успех, Данные)
	// Снимок не должен изменяться вместе с текущей операцией драйвера.
	Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Данные);
	ТестРезультаты.Добавить(Новый Структура("name,ok,details", Имя, Успех, Запись.Закрыть()));
КонецПроцедуры

&НаКлиенте
Процедура ТестФиниш()
	Суффикс = ?(ПараметрЗапуска = "recover", "-recover", ?(ПараметрЗапуска = "normal", "-normal", ""));
	Запись = Новый ЗаписьJSON; Запись.ОткрытьФайл("@ROOT@/result" + Суффикс + ".json");
	ЗаписатьJSON(Запись, ТестРезультаты); Запись.Закрыть();
	ТестДрайвер.ЗавершитьМенеджер();
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ТестУбитьСобственныйКлиент()
	Чтение = Новый ЧтениеJSON; Чтение.ОткрытьФайл("@ROOT@/receipt.json");
	Receipt = ПрочитатьJSON(Чтение); Чтение.Закрыть();
	Локатор = Новый COMОбъект("WbemScripting.SWbemLocator");
	Служба = Локатор.ConnectServer(".", "root\cimv2");
	Для Каждого Процесс Из Служба.ExecQuery("SELECT * FROM Win32_Process WHERE ProcessId=" + Формат(Receipt.pid, "ЧГ=0")) Цикл
		Если Процесс.CreationDate = Receipt.created И СтрНайти(Процесс.CommandLine, "toolkit-test-" + Receipt.token) > 0 Тогда
			Процесс.Terminate(); // Только fault injection в одноразовой тестовой копии.
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
