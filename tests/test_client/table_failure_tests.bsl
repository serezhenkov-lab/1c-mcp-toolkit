&НаКлиенте
Процедура ТестВводСтарт()
	ТестРезультаты = Новый Массив; ТестСрок = ТекущаяДата() + 180;
	Попытка
		Профиль = Новый Структура("id,exe,connection,user,port,receipt_path", "input-probe",
			КаталогПрограммы() + "1cv8c.exe", СтрокаСоединенияИнформационнойБазы(), "ApiProbe", 16538, "@ROOT@/receipt.json");
		ТестДрайвер = ПолучитьМенеджерТестирования(Профиль);
		Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "input-start", 60000);
		ТестСеанс = Снимок.session_id;
		ПодключитьОбработчикОжидания("ТестВводГотовность", 1, Истина);
	Исключение
		ТестПроверка("start_exception", Ложь, ОписаниеОшибки()); ТестФиниш();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ТестВводГотовность()
	Снимок = ТестДрайвер.СостояниеСеанса();
	Если Снимок.state = "ready" Тогда
		ТестОкноUI = Новый Структура("selector", Новый Структура("title", "Input Fixture"));
		РежимПодтвержденияОпасныхОпераций = "session_allow";
		ТестДрайвер.ТестНастроитьСбойТаблицы("@FAILURE@");
		ТестСбойТаблицыКоманда();
	ИначеЕсли ТекущаяДата() > ТестСрок Или Снимок.state = "failed" Тогда
		ТестПроверка("ready", Ложь, Снимок); ТестФиниш();
	Иначе
		ПодключитьОбработчикОжидания("ТестВводГотовность", 1, Истина);
	КонецЕсли;
КонецПроцедуры



&НаКлиенте
Процедура ТестСбойТаблицыКоманда()
	Аргументы = Новый Структура("request_id,session_id,params,window,element,action,timeout_ms",
		"@FAILURE@", ТестСеанс, Новый Структура, ТестОкноUI, ТестUIПоле("Строки"), "add", 30000);
	Ответ = ПринятьКомандуТестирования("test_table", Аргументы, "table-failure", Новый ОписаниеОповещения("ТестСбойТаблицыОтвет", ЭтаФорма));
	Если Ответ.status = "failed" Тогда ТестПроверка("accepted", Ложь, Ответ); ТестФиниш(); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТестСбойТаблицыОтвет(Результат, ДополнительныеПараметры) Экспорт
	Попытка
		Неизвестно = "@FAILURE@" = "unknown";
		ТестПроверка("outcome", Результат.status = ?(Неизвестно, "unknown", "failed")
			И Результат.execution = ?(Неизвестно, "unknown", "invoked") И Результат.verification = "not_confirmed", Результат);
		ТестПроверка("error", Результат.error <> Неопределено И Результат.error.code = ?("@FAILURE@" = "readback", "value_unavailable", "connection_lost"), Результат);
		ТестПроверка("completed", Результат.data.completed_steps.Количество() = ?(Неизвестно, 0, 1), Результат);
		ТестПроверка("steps", Результат.data.steps[0].status = ?(Неизвестно, "unknown", "invoked")
			И Результат.data.steps[1].status = ?(Неизвестно, "not_started", "unknown"), Результат);
		ТестПроверка("editing_not_stale", Результат.data.editing = Неопределено, Результат);
		ТестПроверка("no_rollback", Не Результат.data.rollback_performed, Результат);
		Проба = ТестДрайвер.ТестРезультатСбояТаблицы();
		ТестПроверка("once_and_invalidated", Проба.calls = 1 И Проба.invalidated, Проба);
		Если "@FAILURE@" <> "disconnect" Тогда
			ТестПроверка("editor_preserved", Проба.editing, Проба);
		Иначе
			ТестПроверка("owned_client_terminated", Проба.terminated, Проба);
		КонецЕсли;
	Исключение
		ТестПроверка("exception", Ложь, ОписаниеОшибки());
	КонецПопытки;
	ТестФиниш();
КонецПроцедуры
