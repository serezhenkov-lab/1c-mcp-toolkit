// Инъекции только в одноразовый менеджер. Клиентского адаптера нет.
&НаКлиенте
Процедура ТестНастроитьСбойТаблицы(Режим) Экспорт
	ТестСбойТаблицы = Режим;
	ТестВызовыТаблицы = 0;
	ТестПоколениеТаблицы = ТКПоколениеUI;
	ТестКлиентЗавершен = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ТестПослеДобавленияСтроки()
	ТестВызовыТаблицы = ТестВызовыТаблицы + 1;
	Если ТестСбойТаблицы = "unknown" Тогда ВызватьИсключение "TEST_TABLE_UNKNOWN"; КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТестПередНаблюдениемСтроки()
	Если ТестСбойТаблицы = "readback" Тогда ОшибкаUI("value_unavailable"); КонецЕсли;
	Если ТестСбойТаблицы <> "disconnect" Тогда Возврат; КонецЕсли;
	Если Не ТКВладелец Тогда ВызватьИсключение "NOT_OWNED"; КонецЕсли;
	Локатор = Новый COMОбъект("WbemScripting.SWbemLocator");
	Служба = Локатор.ConnectServer(".", "root\cimv2");
	Для Каждого Процесс Из Служба.ExecQuery("SELECT * FROM Win32_Process WHERE ProcessId=" + Формат(ТКПроцесс.pid, "ЧГ=0")) Цикл
		Если Процесс.CreationDate = ТКПроцесс.created И СтрНайти(Процесс.CommandLine, "toolkit-test-" + ТКПроцесс.token) > 0 Тогда
			ТестКлиентЗавершен = Процесс.Terminate() = 0;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ТестРезультатСбояТаблицы() Экспорт
	Проба = Новый Структура("calls,invalidated,editing,terminated", ТестВызовыТаблицы,
		ТКПоколениеUI <> ТестПоколениеТаблицы, Неопределено, ТестКлиентЗавершен);
	Если ТестСбойТаблицы <> "disconnect" Тогда
		Таблица = ТКПриложение.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Строки", 1);
		Проба.editing = Таблица.ТекущийРежимРедактирование();
	КонецЕсли;
	Возврат Проба;
КонецФункции
