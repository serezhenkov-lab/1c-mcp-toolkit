&НаКлиенте
Процедура ТестВводСтарт()
	ТестРезультаты = Новый Массив; ТестСрок = ТекущаяДата() + 180;
	Попытка
		Профиль = Новый Структура("id,exe,connection,user,port,receipt_path", "input-probe",
			КаталогПрограммы() + "1cv8c.exe", СтрокаСоединенияИнформационнойБазы(), "ApiProbe", 16538, "@ROOT@/receipt.json");
		ТестДрайвер = ПолучитьМенеджерТестирования(Профиль);
		Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "input-start", 60000);
		ТестСеанс = Снимок.session_id;
		ПодключитьОбработчикОжидания("ТестВводГотовность", 1, Истина);
	Исключение
		ТестПроверка("start_exception", Ложь, ОписаниеОшибки()); ТестФиниш();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ТестВводГотовность()
	Снимок = ТестДрайвер.СостояниеСеанса();
	Если Снимок.state = "ready" Тогда
		ТестОкноUI = Новый Структура("selector", Новый Структура("title", "Input Fixture"));
		ТестВводКоманда("text", "text", Новый Структура("text", "Введено"), "Текст");
	ИначеЕсли ТекущаяДата() > ТестСрок Или Снимок.state = "failed" Тогда
		ТестПроверка("ready", Ложь, Снимок); ТестФиниш();
	Иначе
		ПодключитьОбработчикОжидания("ТестВводГотовность", 1, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТестВводКоманда(Имя, Действие, Параметры, Поле)
	Аргументы = Новый Структура("request_id,session_id,params,window,element,action,timeout_ms",
		Имя, ТестСеанс, Параметры, ТестОкноUI, ТестUIПоле(Поле), Действие, 30000);
	Ответ = ПринятьКомандуТестирования("test_input", Аргументы, "op-" + Имя, Новый ОписаниеОповещения("ТестВводОтвет", ЭтаФорма));
	Если Ответ.status = "failed" Тогда ТестПроверка(Имя + "_accepted", Ложь, Ответ); ТестФиниш(); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТестВводОтвет(Результат, ДополнительныеПараметры) Экспорт
	Попытка
		Имя = Результат.request_id;
		Ошибка = "";
		Если Имя = "duplicate" Или Имя = "table_duplicates" Тогда Ошибка = "ambiguous_target"; КонецЕсли;
		Если Имя = "rejected" Тогда Ошибка = "action_not_confirmed"; КонецЕсли;
		Если Имя = "readback" Тогда Ошибка = "value_unavailable"; КонецЕсли;
		Если Имя = "unknown" Тогда Ошибка = "connection_lost"; КонецЕсли;
		Если Имя = "table_field" Тогда Ошибка = "incomplete_search"; КонецЕсли;
		Если Имя = "readonly" Тогда Ошибка = "target_unavailable"; КонецЕсли;
		Если Имя = "selection_table" Или Имя = "list_incomplete" Тогда Ошибка = "choice_search_incomplete"; КонецЕсли;
		Успех = ?(Ошибка = "", Результат.status = "succeeded" И Результат.verification = "confirmed",
			Результат.error <> Неопределено И Результат.error.code = Ошибка И Результат.verification = "not_confirmed");
		ТестПроверка(Имя, Успех, Результат);
		Если Не Успех Тогда ТестФиниш(); Возврат; КонецЕсли;
		Если Имя = "text" Тогда
			ТестПроверка("text_readback", Результат.data.actual = "Введено" И Не Результат.data.editing, Результат.data);
			ТестВводКоманда("clear", "text", Новый Структура("text", ""), "Текст");
		ИначеЕсли Имя = "clear" Тогда
			ТестПроверка("clear_readback", Результат.data.actual = "" И Результат.data.completed_steps.Найти("clear") <> Неопределено, Результат.data);
			ТестВводКоманда("check_on", "check", Новый Структура("checked", Истина), "Флаг");
		ИначеЕсли Имя = "check_on" Тогда
			ТестПроверка("check_boolean", ТипЗнч(Результат.data.actual) = Тип("Булево") И Результат.data.actual, Результат.data);
			ТестВводКоманда("check_same", "check", Новый Структура("checked", Истина), "Флаг");
		ИначеЕсли Имя = "check_same" Тогда
			ТестПроверка("check_no_toggle", Результат.execution = "not_started" И Результат.data.completed_steps.Количество() = 0, Результат);
			ТестВводКоманда("check_off", "check", Новый Структура("checked", Ложь), "Флаг");
		ИначеЕсли Имя = "check_off" Тогда
			ТестПроверка("check_off_readback", Результат.data.actual = Ложь, Результат.data);
			ТестВводКоманда("select", "select", Новый Структура("choice", Новый Структура("list_value", "Зелёный")), "Выбор");
		ИначеЕсли Имя = "select" Тогда
			ТестПроверка("choice_complete", Результат.data.choice.complete И Результат.data.choice.candidates.Количество() = 1 И Результат.data.actual = "Green", Результат.data);
			ТестВводКоманда("duplicate", "select", Новый Структура("choice", Новый Структура("list_value", "Дубль")), "Выбор");
		ИначеЕсли Имя = "duplicate" Тогда
			ТестПроверка("duplicate_not_selected", Результат.data.choice.candidates.Количество() = 2 И Результат.data.completed_steps.Найти("select_choice") = Неопределено, Результат.data);
			ТестВводКоманда("rejected", "text", Новый Структура("text", "Отклонено"), "Текст");
		ИначеЕсли Имя = "rejected" Тогда
			ТестПроверка("rejected_actual", Результат.execution = "invoked" И Результат.data.actual = "Исправлено", Результат);
			ТестДрайвер.ТестСбойВводаUI("readback");
			ТестВводКоманда("readback", "text", Новый Структура("text", "ПослеСбояЧтения"), "Текст");
		ИначеЕсли Имя = "readback" Тогда
			ТестПроверка("readback_no_retry", Результат.execution = "invoked" И ТестДрайвер.ТестЧислоВводовUI() = 1 И ТестДрайвер.ТестТекстВводаUI() = "ПослеСбояЧтения", Результат);
			ТестДрайвер.ТестСбойВводаUI("unknown");
			ТестВводКоманда("unknown", "text", Новый Структура("text", "НеизвестныйИсход"), "Текст");
		ИначеЕсли Имя = "unknown" Тогда
			ТестПроверка("unknown_no_fallback", Результат.execution = "unknown" И Результат.status = "unknown" И ТестДрайвер.ТестЧислоВводовUI() = 1
				И Результат.data.completed_steps.Найти("finish_edit") = Неопределено И ТестДрайвер.ТестТекстРедактораUI() = "НеизвестныйИсход"
				И Результат.data.actual = Неопределено И ТестДрайвер.ТестТекстВводаUI() = "ПослеСбояЧтения", Результат);
			ТестВводКоманда("table_field", "text", Новый Структура("text", "НеВводить"), "СтрокиКлюч");
		ИначеЕсли Имя = "table_field" Тогда
			ТестПроверка("table_no_mutation", Результат.execution = "not_started", Результат);
			ТестВводКоманда("readonly", "text", Новый Структура("text", "НеВводить"), "Результат");
		ИначеЕсли Имя = "readonly" Тогда
			Отбор = Новый Массив; Отбор.Добавить(Новый Структура("column,equals", "СтрокиКлюч", "A"));
			Выбор = Новый Структура("selection_window,table,row", ТестОкноUI, ТестUIПоле("Строки"), Новый Структура("where", Отбор));
			ТестВводКоманда("selection_table", "select", Новый Структура("choice", Выбор), "Выбор");
		ИначеЕсли Имя = "selection_table" Тогда
			ТестПроверка("selection_no_navigation", Результат.execution = "not_started" И Не Результат.data.choice.complete И Не Результат.data.choice.cursor_changed, Результат);
			ТестДрайвер.ТестОдинаковыеСтрокиUI();
			Идентичность = ТестДрайвер.ТестИдентичностьОписаниеUI();
			ТестПроверка("row_description_not_stable", Не Идентичность.same_row_equal И Не Идентичность.next_repeat_equal, Идентичность);
			ТестДрайвер.ТестВыделитьВсеUI();
			Отбор = Новый Массив; Отбор.Добавить(Новый Структура("column,equals", "СтрокиКлюч", "Дубль"));
			Выбор = Новый Структура("selection_window,table,row", ТестОкноUI, ТестUIПоле("Строки"), Новый Структура("where", Отбор));
			ТестВводКоманда("table_duplicates", "select", Новый Структура("choice", Выбор), "Выбор");
		ИначеЕсли Имя = "table_duplicates" Тогда
			ТестПроверка("table_distinct_candidates", Результат.data.choice.candidates.Количество() = 2 И Не Результат.data.choice.candidates[0].identity_confirmed
				И Результат.execution = "not_started" И Не Результат.data.choice.selection_changed, Результат);
			ТестВводКоманда("large_list", "text", Новый Структура("text", "БольшойСписок"), "Текст");
		ИначеЕсли Имя = "large_list" Тогда
			ТестВводКоманда("list_incomplete", "select", Новый Структура("choice", Новый Структура("list_value", "Зелёный")), "Выбор");
		ИначеЕсли Имя = "list_incomplete" Тогда
			ТестПроверка("incomplete_not_selected", Не Результат.data.choice.complete И Результат.data.choice.reason = "candidate_limit"
				И Результат.data.completed_steps.Найти("select_choice") = Неопределено, Результат);
			ТестФиниш();
		КонецЕсли;
	Исключение
		ТестПроверка("input_exception", Ложь, ОписаниеОшибки()); ТестФиниш();
	КонецПопытки;
КонецПроцедуры
