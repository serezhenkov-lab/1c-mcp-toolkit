// Исследовательские пробы только в одноразовой EPF. Не алгоритм Toolkit.
&НаКлиенте
Функция ТестНаправленногоПоискаUI() Экспорт
	Таблица = ТКПриложение.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Строки", 1);
	Наблюдения = Новый Структура;
	Таблица.ПерейтиКПервойСтроке();
	Отбор = Новый Соответствие; Отбор.Вставить("Ключ", "A");
	Наблюдения.Вставить("current_down", Таблица.ПерейтиКСтроке(Отбор, НаправлениеПереходаКСтроке.Вниз));
	Наблюдения.Вставить("current_up", Таблица.ПерейтиКСтроке(Отбор, НаправлениеПереходаКСтроке.Вверх));
	Отбор.Вставить("Ключ", "B");
	Наблюдения.Вставить("other_down", Таблица.ПерейтиКСтроке(Отбор, НаправлениеПереходаКСтроке.Вниз));
	Наблюдения.Вставить("other_current_key", Таблица.ПолучитьТекстЯчейки("СтрокиКлюч"));
	Наблюдения.Вставить("last_down", Таблица.ПерейтиКСтроке(Отбор, НаправлениеПереходаКСтроке.Вниз));
	Отбор.Вставить("Ключ", "НетТакойСтроки");
	Попытка
		Наблюдения.Вставить("missing_down", Таблица.ПерейтиКСтроке(Отбор, НаправлениеПереходаКСтроке.Вниз));
	Исключение
		Наблюдения.Вставить("missing_error", ОписаниеОшибки());
	КонецПопытки;
	Возврат Наблюдения;
КонецФункции

&НаКлиенте
Функция ТестНативногоНаблюдателяUI() Экспорт
	ТестОдинаковыеСтрокиUI();
	Таблица = ТКПриложение.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Строки", 1);
	Таблица.ПерейтиКПервойСтроке();
	Наблюдения = Новый Структура("first,repeat_first", ТестПрочитатьНативныеИдUI(), ТестПрочитатьНативныеИдUI());
	Таблица.ПерейтиКСледующейСтроке();
	Наблюдения.Вставить("second", ТестПрочитатьНативныеИдUI());
	Таблица.УстановитьПорядок("Ключ");
	Наблюдения.Вставить("after_sort", ТестПрочитатьНативныеИдUI());
	Таблица.ПерейтиКПервойСтроке();
	Наблюдения.Вставить("first_sorted", ТестПрочитатьНативныеИдUI());
	Наблюдения.Вставить("after_move", ТестПрочитатьНативныеИдUI("__native_move__"));
	Наблюдения.Вставить("after_replace", ТестПрочитатьНативныеИдUI("__native_replace__"));
	Наблюдения.Вставить("after_clear", ТестПрочитатьНативныеИдUI("__native_clear__"));
	Возврат Наблюдения;
КонецФункции

&НаКлиенте
Функция ТестПрочитатьНативныеИдUI(Режим = "__native_identity__")
	Поле = ТКПриложение.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Текст", 1);
	Поле.ВвестиТекст(Режим);
	Кнопка = ТКПриложение.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , "Проверить", 1);
	Кнопка.Активизировать(); Кнопка.Нажать();
	ПолеРезультата = ТКПриложение.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Результат", 1);
	Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(ПолеРезультата.ПолучитьПредставлениеДанных());
	Возврат ПрочитатьJSON(Чтение);
КонецФункции

&НаКлиенте
Функция ТестВыделенияКакМаркераUI() Экспорт
	ТестОдинаковыеСтрокиUI();
	Таблица = ТКПриложение.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Строки", 1);
	Наблюдения = Новый Структура;
	Таблица.СнятьВыделениеВсехСтрок(); Таблица.ВыделитьСтроку();
	Наблюдения.Вставить("first_count", Таблица.ПолучитьВыделенныеСтроки().Количество());
	Таблица.ПерейтиКСледующейСтроке(Истина);
	Наблюдения.Вставить("shift_next_count", Таблица.ПолучитьВыделенныеСтроки().Количество());
	Попытка
		Таблица.ПерейтиКСледующейСтроке(Истина);
	Исключение
		Наблюдения.Вставить("shift_end_error", ОписаниеОшибки());
	КонецПопытки;
	Наблюдения.Вставить("shift_end_count", Таблица.ПолучитьВыделенныеСтроки().Количество());
	Таблица.ПерейтиКПредыдущейСтроке(Истина);
	Наблюдения.Вставить("shift_back_count", Таблица.ПолучитьВыделенныеСтроки().Количество());
	Таблица.ПерейтиКПервойСтроке();
	Таблица.СнятьВыделениеВсехСтрок(); Таблица.ВыделитьСтроку();
	Наблюдения.Вставить("before_external_switch_count", Таблица.ПолучитьВыделенныеСтроки().Количество());
	Таблица.ПерейтиКСледующейСтроке();
	Наблюдения.Вставить("after_external_switch_count", Таблица.ПолучитьВыделенныеСтроки().Количество());
	Таблица.ПерейтиКСтроке(Неопределено, НаправлениеПереходаКСтроке.Вниз, Истина);
	Наблюдения.Вставить("toggle_after_switch_count", Таблица.ПолучитьВыделенныеСтроки().Количество());
	// Независимое подтверждение физической смены в контролируемой фикстуре.
	Наблюдения.Вставить("physical_switch_confirmed", ТестРазныеФизическиеСтрокиUI());
	Возврат Наблюдения;
КонецФункции
