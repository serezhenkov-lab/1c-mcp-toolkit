&НаКлиенте
Процедура ТестРазрешениеСтарт()
	ТестЧислоРазрешений = 0;
	ТестИсходноеЧислоДокументов = ТестЧислоДокументов();
	ТестДействиеСтарт();
КонецПроцедуры

&НаКлиенте
Процедура ТестРазрешениеГотовность()
	Снимок = ТестДрайвер.СостояниеСеанса();
	Если Снимок.state = "ready" Тогда
		ТестОкноUI = Новый Структура("selector", Новый Структура("title", "Action Fixture"));
		ТестРежимUI("deny");
		ТестРазрешениеКоманда("deny");
	ИначеЕсли ТекущаяДата() > ТестСрок Или Снимок.state = "failed" Тогда
		ТестПроверка("ready", Ложь, Снимок); ТестФиниш();
	Иначе
		ПодключитьОбработчикОжидания("ТестРазрешениеГотовность", 1, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТестРежимUI(Режим)
	РежимПодтвержденияОпасныхОпераций = Режим;
	РежимПодтвержденияПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ТестРазрешениеКоманда(Имя, Инструмент = "test_action", Поле = "Проверить", Значение = "")
	Аргументы = Новый Структура("request_id,session_id,params,window,action,element,timeout_ms", Имя, ТестСеанс,
		Новый Структура, ТестОкноUI, "click", ТестUIПоле(Поле), 30000);
	Если Инструмент = "test_input" Тогда
		Аргументы.action = "text"; Аргументы.params.Вставить("text", Значение);
	ИначеЕсли Инструмент = "test_inspect" Тогда
		Аргументы.action = "values"; Аргументы.Удалить("element");
		Цели = Новый Массив; Цели.Добавить(ТестUIПоле("Текст")); Аргументы.params.Вставить("targets", Цели);
	КонецЕсли;
	Ответ = ПринятьКомандуТестирования(Инструмент, Аргументы, "op-" + Имя, Новый ОписаниеОповещения("ТестРазрешениеОтвет", ЭтаФорма));
	Если Ответ.status = "failed" Тогда ТестПроверка(Имя + "_accepted", Ложь, Ответ); ТестФиниш(); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТестОтветРазрешения()
	ТестЧислоРазрешений = ТестЧислоРазрешений + 1;
	Состояние = ТестДрайвер.ТестСостояниеРазрешенияUI();
	ТестПроверка(Состояние.request_id + "_awaiting", Состояние.status = "awaiting_approval" И Состояние.execution = "not_started", Состояние);
	Если ТестРешениеРазрешения = "change" Тогда
		ТестДрайвер.ТестИзменитьПодтвержденныйВходUI(); ТестОкноРазрешения.Закрыть(Истина);
	ИначеЕсли ТестРешениеРазрешения = "generation" Тогда
		ТестРежимUI("ask"); ТестОкноРазрешения.Закрыть("session_allow");
	ИначеЕсли ТестРешениеРазрешения = "expired" Тогда
		ТестДрайвер.ТестПросрочитьРазрешениеUI(); ТестОкноРазрешения.Закрыть("session_allow");
	Иначе
		ТестОкноРазрешения.Закрыть(ТестРешениеРазрешения);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТестЧислоДокументов()
	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ Документ.T43_Required");
	Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий(); Возврат Выборка.Число;
КонецФункции

&НаКлиенте
Процедура ТестРазрешениеОтвет(Результат, ДополнительныеПараметры) Экспорт
	Попытка
		Имя = Результат.request_id;
		Отказ = СтрНайти(",deny,ask_no,ask_again,revoked,deny_input,changed,generation,", "," + Имя + ",") > 0;
		Если Отказ Тогда
			Успех = Результат.status = "failed" И Результат.execution = "not_started" И Результат.verification = "not_confirmed"
				И Результат.error.code = "permission_denied" И Результат.error.stage = "permission";
		ИначеЕсли Имя = "expired" Тогда
			Успех = Результат.execution = "not_started" И Результат.error.code = "expectation_timeout";
		Иначе
			Успех = Результат.status = "succeeded" И Результат.verification = "confirmed";
		КонецЕсли;
		ТестПроверка(Имя, Успех, Результат);
		Если Не Успех Тогда ТестФиниш(); Возврат; КонецЕсли;
		Если Имя = "deny" Тогда
			ТестПроверка("deny_no_effect", ТестДрайвер.ТестСчетчикДействийUI() = "0" И ТестЧислоРазрешений = 0, Результат);
			ТестРазрешениеКоманда("read_in_deny", "test_inspect");
		ИначеЕсли Имя = "read_in_deny" Тогда
			ТестРежимUI("ask"); ТестРешениеРазрешения = Ложь; ТестРазрешениеКоманда("ask_no");
		ИначеЕсли Имя = "ask_no" Тогда
			ТестПроверка("ask_no_effect", ТестДрайвер.ТестСчетчикДействийUI() = "0", Результат);
			ТестРешениеРазрешения = Истина; ТестРазрешениеКоманда("ask_once");
		ИначеЕсли Имя = "ask_once" Тогда
			ТестПроверка("once_invoked", Результат.execution = "invoked" И ТестДрайвер.ТестСчетчикДействийUI() = "1" И РежимПодтвержденияОпасныхОпераций = "ask", Результат);
			ТестРешениеРазрешения = Неопределено; ТестРазрешениеКоманда("ask_again");
		ИначеЕсли Имя = "ask_again" Тогда
			ТестПроверка("once_not_reused", ТестДрайвер.ТестСчетчикДействийUI() = "1" И ТестЧислоРазрешений = 3, Результат);
			ТестРешениеРазрешения = "session_allow"; ТестРазрешениеКоманда("session");
		ИначеЕсли Имя = "session" Тогда
			ТестПроверка("session_enabled", РежимПодтвержденияОпасныхОпераций = "session_allow" И ТестДрайвер.ТестСчетчикДействийUI() = "2", Результат);
			ТестРазрешениеКоманда("session_next");
		ИначеЕсли Имя = "session_next" Тогда
			ТестПроверка("session_no_dialog", ТестЧислоРазрешений = 4 И ТестДрайвер.ТестСчетчикДействийUI() = "3", Результат);
			ТестРазрешениеКоманда("revoked"); ТестРежимUI("deny");
		ИначеЕсли Имя = "revoked" Тогда
			ТестПроверка("queue_rechecked", ТестДрайвер.ТестСчетчикДействийUI() = "3", Результат);
			ТестРазрешениеКоманда("deny_input", "test_input", "Текст", "Запрет");
		ИначеЕсли Имя = "deny_input" Тогда
			ТестРежимUI("ask"); ТестРешениеРазрешения = "change"; ТестРазрешениеКоманда("changed");
		ИначеЕсли Имя = "changed" Тогда
			ТестРешениеРазрешения = "generation"; ТестРазрешениеКоманда("generation");
		ИначеЕсли Имя = "generation" Тогда
			ТестПроверка("stale_cannot_allow_session", РежимПодтвержденияОпасныхОпераций = "ask", Результат);
			ТестРешениеРазрешения = "expired"; ТестРазрешениеКоманда("expired");
		ИначеЕсли Имя = "expired" Тогда
			ТестПроверка("late_cannot_allow_session", РежимПодтвержденияОпасныхОпераций = "ask" И ТестДрайвер.ТестСчетчикДействийUI() = "3", Результат);
			ТестРешениеРазрешения = Истина; ТестРазрешениеКоманда("ask_input", "test_input", "Текст", "");
		ИначеЕсли Имя = "ask_input" Тогда
			ТестПроверка("once_covers_input_steps", Результат.execution = "invoked" И Результат.data.completed_steps.Количество() > 1 И РежимПодтвержденияОпасныхОпераций = "ask", Результат);
			ТестРежимUI("session_allow"); ТестРазрешениеКоманда("required", "test_action", "Диалог");
		ИначеЕсли Имя = "required" Тогда
			ТестПроверка("save_call_not_save_result", Результат.execution = "invoked" И Результат.data.verification_scope = "invocation_and_observation" И Не Результат.data.closed, Результат);
			СообщениеОбязательности = Ложь;
			Для Каждого Сообщение Из Результат.data.user_messages Цикл
				СообщениеОбязательности = СообщениеОбязательности Или СтрНайти(НРег(Сообщение.text), "обязательное") > 0;
			КонецЦикла;
			ТестПроверка("required_message", Результат.data.user_messages_available И СообщениеОбязательности, Результат);
			ТестПроверка("document_not_written", ТестЧислоДокументов() = ТестИсходноеЧислоДокументов, Результат);
			ТестРазрешениеКоманда("fill_required", "test_input", "Текст", "TASK043");
		ИначеЕсли Имя = "fill_required" Тогда
			ТестРазрешениеКоманда("save_control", "test_action", "Диалог");
		ИначеЕсли Имя = "save_control" Тогда
			ТестПроверка("document_written_control", ТестЧислоДокументов() = ТестИсходноеЧислоДокументов + 1, Результат);
			ЗавершитьСеансРазрешений(); ТестПроверка("session_grant_reset", РежимПодтвержденияОпасныхОпераций = "ask", Результат);
			ТестФиниш();
		КонецЕсли;
	Исключение
		ТестПроверка("permission_exception", Ложь, ОписаниеОшибки()); ТестФиниш();
	КонецПопытки;
КонецПроцедуры
