&НаКлиенте
Процедура ТестВводСтарт()
	ТестРезультаты = Новый Массив; ТестСрок = ТекущаяДата() + 180;
	Попытка
		Профиль = Новый Структура("id,exe,connection,user,port,receipt_path", "input-probe",
			КаталогПрограммы() + "1cv8c.exe", СтрокаСоединенияИнформационнойБазы(), "ApiProbe", 16538, "@ROOT@/receipt.json");
		ТестДрайвер = ПолучитьМенеджерТестирования(Профиль);
		Снимок = ТестДрайвер.ВыполнитьСеанс("start", "", "input-start", 60000);
		ТестСеанс = Снимок.session_id;
		ПодключитьОбработчикОжидания("ТестВводГотовность", 1, Истина);
	Исключение
		ТестПроверка("start_exception", Ложь, ОписаниеОшибки()); ТестФиниш();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ТестВводГотовность()
	Снимок = ТестДрайвер.СостояниеСеанса();
	Если Снимок.state = "ready" Тогда
		ТестОкноUI = Новый Структура("selector", Новый Структура("title", "Input Fixture"));
		РежимПодтвержденияОпасныхОпераций = "deny";
		ТестТаблицаКоманда("deny");
	ИначеЕсли ТекущаяДата() > ТестСрок Или Снимок.state = "failed" Тогда
		ТестПроверка("ready", Ложь, Снимок); ТестФиниш();
	Иначе
		ПодключитьОбработчикОжидания("ТестВводГотовность", 1, Истина);
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ТестТаблицаКоманда(Имя)
	ПараметрыТаблицы = Новый Структура;
	Если Имя = "values" Тогда ПараметрыТаблицы.Вставить("values", Новый Массив); КонецЕсли;
	Аргументы = Новый Структура("request_id,session_id,params,window,element,action,timeout_ms",
		Имя, ТестСеанс, ПараметрыТаблицы, ТестОкноUI, ТестUIПоле("Строки"), "add", 30000);
	Ответ = ПринятьКомандуТестирования("test_table", Аргументы, "op-" + Имя, Новый ОписаниеОповещения("ТестТаблицаОтвет", ЭтаФорма));
	Если Ответ.status = "failed" Тогда Ответ.request_id = Имя; ТестТаблицаОтвет(Ответ, Неопределено); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТестТаблицаОтвет(Результат, ДополнительныеПараметры) Экспорт
	Попытка
		Имя = Результат.request_id;
		Код = ?(Имя = "deny", "permission_denied", ?(Имя = "pending", "row_edit_pending", "incomplete_search"));
		Успех = Результат.error <> Неопределено И Результат.error.code = Код И Результат.verification = "not_confirmed";
		ТестПроверка(Имя, Успех, Результат);
		Если Не Успех Тогда ТестФиниш(); Возврат; КонецЕсли;
		Если Имя = "add" Тогда
			ТестПроверка("steps_observed", Результат.data.steps[0].status = "invoked"
				И Результат.data.steps[1].status = "observed" И Не Результат.data.rollback_performed, Результат);
			ТестПроверка("add_once_editing", Результат.execution = "invoked" И Результат.data.editing
				И Результат.data.completed_steps.Количество() = 1 И Результат.data.identity.status = "unavailable", Результат);
			ТестТаблицаКоманда("pending");
		Иначе
			ТестПроверка(Имя + "_not_started", Результат.execution = "not_started", Результат);
			Если Имя = "deny" Тогда
				РежимПодтвержденияОпасныхОпераций = "session_allow";
				ТестТаблицаКоманда("values");
			ИначеЕсли Имя = "values" Тогда
				ТестТаблицаКоманда("add");
			Иначе
				ТестПроверка("pending_preserved", Результат.data.editing, Результат);
				ТестФиниш();
			КонецЕсли;
		КонецЕсли;
	Исключение
		ТестПроверка("exception", Ложь, ОписаниеОшибки()); ТестФиниш();
	КонецПопытки;
КонецПроцедуры
