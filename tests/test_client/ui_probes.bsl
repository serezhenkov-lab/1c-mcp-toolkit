// Только в копии для тестов: подготовка сообщений и изменение поля вне команды expect.
&НаКлиенте
Процедура ТестОткрытьФормуUI() Экспорт
	Для Каждого ОкноКлиента Из ТКПриложение.ПолучитьПодчиненныеОбъекты() Цикл
		Если ОкноКлиента.Основное Тогда
			ОкноКлиента.ВыполнитьКоманду("e1cib/app/Обработка.ApiFixture.Форма.Main"); Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТестСообщениеUI() Экспорт
	Поле = ТКПриложение.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Текст", 1);
	Поле.Очистить();
	Форма = Поле.ПолучитьРодителя(); Форма.ПерейтиКСледующемуЭлементу();
	Кнопка = ТКПриложение.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , "Проверить", 1);
	Кнопка.Нажать();
КонецПроцедуры

&НаКлиенте
Процедура ТестИзменитьТекстUI() Экспорт
	Поле = ТКПриложение.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Текст", 1);
	Поле.ВвестиТекст("Изменено");
	Форма = Поле.ПолучитьРодителя(); Форма.ПерейтиКСледующемуЭлементу();
КонецПроцедуры

&НаКлиенте
Процедура ТестЗакрытьФормуUI() Экспорт
	Для Каждого ОкноКлиента Из ТКПриложение.ПолучитьПодчиненныеОбъекты() Цикл
		Если ОкноКлиента.НавигационнаяСсылка = "e1cib/app/Обработка.ApiFixture" Тогда
			ОкноКлиента.Закрыть(); Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТестВыбратьСтрокуUI(Ключ) Экспорт
	Таблица = ТКПриложение.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Строки", 1);
	Отбор = Новый Соответствие; Отбор.Вставить("Ключ", Ключ);
	Таблица.ПерейтиКСтроке(Отбор);
КонецПроцедуры

&НаКлиенте
Функция ТестКлючСтрокиUI() Экспорт
	Таблица = ТКПриложение.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Строки", 1);
	Возврат Таблица.ПолучитьТекстЯчейки("СтрокиКлюч");
КонецФункции

// Только стенд: обе физические строки получают одинаковые отображаемые данные.
&НаКлиенте
Процедура ТестОдинаковыеСтрокиUI() Экспорт
	Таблица = ТКПриложение.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Строки", 1);
	Таблица.ПерейтиКПервойСтроке();
	Для Номер = 1 По 2 Цикл
		Для Каждого Имя Из СтрРазделить("СтрокиКлюч,СтрокиЗначение", ",") Цикл
			Таблица.ИзменитьСтроку();
			Поле = Таблица.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , Имя, 1);
			Поле.Активизировать(); Поле.ВвестиТекст("Дубль");
			Таблица.ЗакончитьРедактированиеСтроки(Ложь);
		КонецЦикла;
		Если Номер = 1 Тогда Таблица.ПерейтиКСледующейСтроке(); КонецЕсли;
	КонецЦикла;
	Таблица.ПерейтиКПервойСтроке();
	ТестЧислоСмен = 0;
КонецПроцедуры

&НаКлиенте
Процедура ТестВключитьСменуUI() Экспорт
	ТестСменаСтроки = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТестМеждуЧтениямиUI(Таблица)
	Если ТестСменаСтроки = Истина Тогда
		ТестСменаСтроки = Ложь;
		Таблица.ПерейтиКСледующейСтроке();
		ТестЧислоСмен = ТестЧислоСмен + 1;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ТестСменыUI() Экспорт
	Возврат ТестЧислоСмен;
КонецФункции

// После гонки помечаем текущую физическую строку: первая должна остаться прежней.
&НаКлиенте
Функция ТестРазныеФизическиеСтрокиUI() Экспорт
	Таблица = ТКПриложение.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Строки", 1);
	Таблица.ИзменитьСтроку();
	Поле = Таблица.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "СтрокиКлюч", 1);
	Поле.Активизировать(); Поле.ВвестиТекст("МеткаВторой");
	Таблица.ЗакончитьРедактированиеСтроки(Ложь);
	Таблица.ПерейтиКПервойСтроке();
	ПерваяНеИзменена = Таблица.ПолучитьТекстЯчейки("СтрокиКлюч") = "Дубль";
	Таблица.ПерейтиКСледующейСтроке();
	Возврат ПерваяНеИзменена И Таблица.ПолучитьТекстЯчейки("СтрокиКлюч") = "МеткаВторой";
КонецФункции
