&НаКлиенте
Функция ТестЛимитПринять(Ключ)
    Новая = Ложь;
    Возврат LifecycleПринять("test", Ключ, "probe", Новый Структура("value", Ключ), Новый Структура("session_id", "test-session"), Новая);
КонецФункции

&НаКлиенте
Процедура ТестЛимитСохранить()
    Если ОбщийLifecycle <> Неопределено Тогда
        ТестЛимитОтчет.Вставить("healthy", ОбщийLifecycle.healthy);
        ТестЛимитОтчет.Вставить("count", ОбщийLifecycle.records.Количество());
        ТестЛимитОтчет.Вставить("bytes", ОбщийLifecycle.bytes);
        ТестЛимитОтчет.Вставить("initializing", ОбщийLifecycle.initializing);
    КонецЕсли;
    Документ = Новый ТекстовыйДокумент; Документ.УстановитьТекст(ЗаписатьJSON2(ТестЛимитОтчет));
    Документ.Записать("@ROOT@/" + ТестЛимитСлучай.name + ".json");
КонецПроцедуры

&НаКлиенте
Процедура ТестЛимитЗапрос(Ключ)
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Итог = Новый Структура("key,id,error,ms", Ключ, Неопределено, Неопределено, 0);
    Попытка Итог.id = ТестЛимитПринять(Ключ); Исключение Итог.error = ОписаниеОшибки(); КонецПопытки;
    Итог.ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
    ТестЛимитОтчет.requests.Добавить(Итог);
КонецПроцедуры

&НаКлиенте
Процедура ТестЛимитыСтарт()
    Документ = Новый ТекстовыйДокумент; Документ.Прочитать("@ROOT@/case.json");
    ТестЛимитСлучай = ПрочитатьJSON2(Документ.ПолучитьТекст());
    ТестЛимитОтчет = Новый Структура("name,startup_ms,error,requests,rounds", ТестЛимитСлучай.name, 0, Неопределено, Новый Массив, Новый Массив);
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Попытка
        НастроитьОбщийLifecycle("@ROOT@/journal-" + ТестЛимитСлучай.journal, Новый ОписаниеОповещения("ВстроенныйЗависимостиLifecycle", ЭтаФорма), ТестЛимитСлучай.action = "initializing");
        ОтключитьОбработчикОжидания("LifecycleОбслуживание");
        ТестЛимитОтчет.startup_ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
        Если ТестЛимитСлучай.action = "initializing" Тогда
            Для Каждого Пара Из ОбщийLifecycle.records Цикл
                Если Пара.Значение.request_id = "keep" Тогда ТестЛимитОтчет.Вставить("target_id", Пара.Ключ); КонецЕсли;
            КонецЦикла;
            Каналы = Новый Массив; Каналы.Добавить("test");
            Запрос = Новый Структура("query", Новый Структура("channel", Каналы));
            Аргументы = Новый Структура("request_id,action,params", "during-initialization", "status", Новый Структура("operation_id", ТестЛимитОтчет.target_id));
            ИспользоватьТочнуюАнонимизацию = Ложь;
            ТестЛимитОтчет.Вставить("status_before_ready", ВстроенныйВызовТестирования(Запрос, "test_session", Аргументы));
        ИначеЕсли ТестЛимитСлучай.action = "bounds" Тогда
            ТестГраницаРезультата();
        ИначеЕсли ТестЛимитСлучай.action = "active" Тогда
            Для Индекс = 1 По 100 Цикл
                Ид = ТестЛимитПринять("active-" + Строка(Индекс));
                Если Индекс = 1 Тогда ПервыйИд = Ид; КонецЕсли;
            КонецЦикла;
            ТестЛимитЗапрос("active-over-limit");
            Каналы = Новый Массив; Каналы.Добавить("test");
            Запрос = Новый Структура("query", Новый Структура("channel", Каналы));
            Аргументы = Новый Структура("request_id,action,params", "status-at-active-limit", "status", Новый Структура("operation_id", ПервыйИд));
            ИспользоватьТочнуюАнонимизацию = Ложь;
            ТестЛимитОтчет.Вставить("public_status", ВстроенныйВызовТестирования(Запрос, "test_session", Аргументы));
            ТестЛимитОтчет.Вставить("direct_state", LifecycleПолучить("test", ПервыйИд).state);
            LifecycleСобытие("test", ПервыйИд, "awaiting_approval", 1);
            ТестЛимитОтчет.Вставить("public_status_refreshed", ВстроенныйВызовТестирования(Запрос, "test_session", Аргументы));
            Аргументы.request_id = "active-1";
            ТестЛимитОтчет.Вставить("public_status_conflict", ВстроенныйВызовТестирования(Запрос, "test_session", Аргументы));
            Аргументы.request_id = "foreign"; Каналы[0] = "other";
            ТестЛимитОтчет.Вставить("public_status_foreign", ВстроенныйВызовТестирования(Запрос, "test_session", Аргументы));
        ИначеЕсли ТестЛимитСлучай.action = "readttl" Тогда
            Ид = ТестЛимитПринять("keep");
            ТестЛимитОтчет.Вставить("before_bytes", ОбщийLifecycle.bytes);
            // Инъекция истечения в памяти после загрузки: проверяем чтение до фоновой очистки.
            ОбщийLifecycle.records[Ид].expires = 1;
            Каналы = Новый Массив; Каналы.Добавить("test");
            Запрос = Новый Структура("query", Новый Структура("channel", Каналы));
            Аргументы = Новый Структура("request_id,action,params", "ttl-at-byte-limit", "status", Новый Структура("operation_id", Ид));
            ИспользоватьТочнуюАнонимизацию = Ложь;
            ТестЛимитОтчет.Вставить("public_status", ВстроенныйВызовТестирования(Запрос, "test_session", Аргументы));
            ТестЛимитОтчет.Вставить("after_read_bytes", ОбщийLifecycle.bytes);
            LifecycleКомпактировать(Ложь, Истина);
            ТестЛимитОтчет.Вставить("after_cleanup_bytes", ОбщийLifecycle.bytes);
            ТестЛимитОтчет.Вставить("repeat_id", ТестЛимитПринять("keep"));
        ИначеЕсли ТестЛимитСлучай.action = "appendlocked" Или ТестЛимитСлучай.action = "renameblocked" Тогда
            Ид = ТестЛимитПринять("failure");
            Блокировка = Новый ФайловыйПоток(ОбщийLifecycle.path, РежимОткрытияФайла.Открыть);
            Если ТестЛимитСлучай.action = "appendlocked" Тогда
                LifecycleЗавершить("test", Ид, Новый Структура("success,data", Истина, "should-not-be-published"));
            Иначе
                LifecycleКомпактировать(Истина, Истина);
            КонецЕсли;
        ИначеЕсли ТестЛимитСлучай.action = "recover" Тогда
            Ид = ТестЛимитПринять("failure");
            ТестЛимитОтчет.Вставить("recovered", LifecycleПолучить("test", Ид));
        Иначе
            ТестЛимитЗапрос("keep");
            ТестЛимитЗапрос("fresh-one");
            ТестЛимитЗапрос("fresh-two");
        КонецЕсли;
        Если ТестЛимитСлучай.action = "benchmark" Или ТестЛимитСлучай.action = "initializing" Тогда
            РежимПодключения = 1; ПортВстроенногоСервера = 17661;
            ИспользоватьТочнуюАнонимизацию = Ложь;
            ЗапуститьВстроенныйСерверСинхронно();
            ТестЛимитРаунд = 0;
            ПодключитьОбработчикОжидания("ТестЛимитКонтроль", 1, Ложь);
            ТестЛимитОтчет.Вставить("ready", Истина);
            ТестЛимитСохранить();
            Возврат;
        КонецЕсли;
    Исключение
        ТестЛимитОтчет.error = ОписаниеОшибки();
        ТестЛимитОтчет.startup_ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
    КонецПопытки;
    Если Блокировка <> Неопределено Тогда Блокировка.Закрыть(); КонецЕсли;
    ТестЛимитСохранить(); ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ТестЛимитКонтроль()
    ФайлОстановки = Новый Файл("@ROOT@/" + ТестЛимитСлучай.name + ".stop");
    Если ФайлОстановки.Существует() Тогда ЗавершитьРаботуСистемы(Ложь); Возврат; КонецЕсли;
    Если ТестЛимитОтчет.rounds.Количество() > 0 Тогда
        Последний = ТестЛимитОтчет.rounds[ТестЛимитОтчет.rounds.Количество() - 1];
        Если Последний.ms = 0 Тогда
            Если ОбщийLifecycle.compaction = Неопределено Тогда
                Последний.ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - Последний.start;
                Последний.bytes_after = ОбщийLifecycle.bytes;
                Если Не ОбщийLifecycle.healthy Тогда Последний.error = "operation_store_unavailable"; КонецЕсли;
            Иначе
                ТестЛимитОтчет.Вставить("phase", ОбщийLifecycle.compaction.phase);
            КонецЕсли;
            ТестЛимитСохранить();
            Возврат;
        КонецЕсли;
    КонецЕсли;
    Файл = Новый Файл("@ROOT@/" + ТестЛимитСлучай.name + ".go");
    Если Не Файл.Существует() Тогда Возврат; КонецЕсли;
    Документ = Новый ТекстовыйДокумент; Документ.Прочитать(Файл.ПолноеИмя); Раунд = Число(Документ.ПолучитьТекст());
    Если Раунд <= ТестЛимитРаунд Тогда Возврат; КонецЕсли;
    ТестЛимитРаунд = Раунд;
    Замер = Новый Структура("round,start,ms,error,bytes_before,bytes_after", Раунд, ТекущаяУниверсальнаяДатаВМиллисекундах(), 0, Неопределено, ОбщийLifecycle.bytes, 0);
    ТестЛимитОтчет.rounds.Добавить(Замер); ТестЛимитСохранить();
    Попытка LifecycleКомпактировать(Истина); Исключение Замер.error = ОписаниеОшибки(); КонецПопытки;
    Если Замер.error <> Неопределено Тогда Замер.ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - Замер.start; КонецЕсли;
    ТестЛимитСохранить();
КонецПроцедуры

&НаКлиенте
Процедура ТестГраницаРезультата()
    Результат = Новый Структура("success,data", Истина, "");
    Длина = 1048576 - СтрДлина(ЗаписатьJSON2(Результат));
    Текст = "x"; Пока СтрДлина(Текст) <= Длина Цикл Текст = Текст + Текст; КонецЦикла;
    Итоги = Новый Массив;
    Для Шаг = 0 По 1 Цикл
        Результат.data = Лев(Текст, Длина + Шаг);
        Ид = ТестЛимитПринять("result-" + Строка(Шаг));
        Размер = СтрДлина(ЗаписатьJSON2(Результат));
        LifecycleЗавершить("test", Ид, Результат);
        ЗаписьОперации = LifecycleПолучить("test", Ид);
        Итоги.Добавить(Новый Структура("id,serialized_chars,state,error", Ид, Размер, ЗаписьОперации.state, ЗаписьОперации.error));
    КонецЦикла;
    LifecycleКомпактировать(Истина, Истина);
    ТестЛимитОтчет.Вставить("result_bounds", Итоги);
    Для Шаг = 0 По 1 Цикл ТестЛимитЗапрос("result-" + Строка(Шаг)); КонецЦикла;
КонецПроцедуры
