&НаКлиенте
Процедура ТестСбойКомпактации(Этап)
    Если ТестСбой = Этап Тогда ВызватьИсключение "injected_" + Этап; КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТестПроверить(Условие, Имя)
    ТестПроверки.Добавить(Новый Структура("name,passed", Имя, Условие));
    Если Не Условие Тогда ВызватьИсключение "assertion_" + Имя; КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ТестПринять(Ключ)
    Новая = Ложь;
    Возврат LifecycleПринять("test", Ключ, "probe", Новый Структура("value", Ключ), Новый Структура("session_id", "test-session"), Новая);
КонецФункции

&НаКлиенте
Процедура ТестНаполнить()
    Для Каждого Ключ Из СтрРазделить("expired,keep,queued,running,awaiting,unknown", ",") Цикл
        Ид = ТестПринять(Ключ);
        Если Ключ = "expired" Или Ключ = "keep" Или Ключ = "unknown" Тогда
            Ответ = Новый Структура("success,data", Истина, Новый Структура("text", "MARKER_" + Ключ));
            Если Ключ = "unknown" Тогда Ответ.Вставить("lifecycle_outcome", "unknown"); КонецЕсли;
            LifecycleЗавершить("test", Ид, Ответ);
        ИначеЕсли Ключ = "running" Или Ключ = "awaiting" Тогда
            LifecycleСобытие("test", Ид, ?(Ключ = "running", "running", "awaiting_approval"), ?(Ключ = "running", 2, 1));
        КонецЕсли;
        Если Ключ = "expired" Тогда
            Исходный = Ид;
        КонецЕсли;
        Если Ключ = "expired" Или Ключ = "unknown" Тогда
            ЗаписьОперации = LifecycleКопия(ОбщийLifecycle.records[Ид]);
            ЗаписьОперации.expires = 1; LifecycleСохранить(ЗаписьОперации);
        КонецЕсли;
    КонецЦикла;
    // Старый формат кэшированного status без метаданных зависимостей.
    Новая = Ложь;
    Кэш = LifecycleПринять("test", "cached", "test_session", Новый Структура, Новый Структура("session_id", "test-session"), Новая);
    Вложенный = Новый Структура("contract_version,operation_id,data", "1", Исходный, Новый Структура("text", "MARKER_expired"));
    Конверт = Новый Структура("data", Новый Структура("operation", Вложенный));
    LifecycleЗавершить("test", Кэш, Новый Структура("success,data", Истина, Конверт));
КонецПроцедуры

&НаКлиенте
Процедура ТестПроверитьЗаписи(ПослеПерезапуска)
    Для Каждого Ключ Из СтрРазделить("expired,keep,queued,running,awaiting,unknown", ",") Цикл
        Ид = ТестПринять(Ключ);
        ЗаписьОперации = LifecycleПолучить("test", Ид);
        Ожидается = Ключ;
        Если Ключ = "keep" Тогда Ожидается = "succeeded"; КонецЕсли;
        Если Ключ = "expired" Тогда Ожидается = "result_expired"; КонецЕсли;
        Если Ключ = "awaiting" Тогда Ожидается = "awaiting_approval"; КонецЕсли;
        Если ПослеПерезапуска И (Ключ = "queued" Или Ключ = "running" Или Ключ = "awaiting") Тогда Ожидается = "unknown"; КонецЕсли;
        ТестПроверить(ЗаписьОперации.state = Ожидается, Ключ + "_state");
        Новая = Ложь; Конфликт = Ложь;
        Попытка LifecycleПринять("test", Ключ, "probe", Новый Структура("value", "different"), Новый Структура, Новая);
        Исключение Конфликт = СтрНайти(ОписаниеОшибки(), "request_conflict") > 0; КонецПопытки;
        ТестПроверить(Конфликт, Ключ + "_conflict");
    КонецЦикла;
    Для Каждого Пара Из ОбщийLifecycle.records Цикл
        Если Пара.Значение.request_id = "cached" Тогда ТестПроверить(Пара.Значение.state = "result_expired", "cached_expired"); КонецЕсли;
    КонецЦикла;
    ТестПроверить(ОбщийLifecycle.records.Количество() = 7, "keys_preserved");
КонецПроцедуры

&НаКлиенте
Процедура ТестКомпактации()
    ТестСбой = ""; ТестПроверки = Новый Массив;
    Чтение = Новый ТекстовыйДокумент; Чтение.Прочитать("@ROOT@/case.json");
    Случай = ПрочитатьJSON2(Чтение.ПолучитьТекст());
    Отчет = Новый Структура("case,checks,error", Случай, ТестПроверки, Неопределено);
    Попытка
        НастроитьОбщийLifecycle("@ROOT@/" + Случай.journal, Новый ОписаниеОповещения("ВстроенныйЗависимостиLifecycle", ЭтаФорма));
        Если Случай.action = "recover" Тогда
            ТестПроверитьЗаписи(Истина);
        ИначеЕсли Случай.action = "quota" Тогда
            Для Индекс = 1 По 100 Цикл ТестПринять("active-" + Строка(Индекс)); КонецЦикла;
            Отказ = Ложь;
            Попытка ТестПринять("over-limit"); Исключение Отказ = СтрНайти(ОписаниеОшибки(), "operation_quota_exceeded") > 0; КонецПопытки;
            ТестПроверить(Отказ, "active_quota");
            LifecycleКомпактировать(Истина);
            ТестПроверить(ОбщийLifecycle.records.Количество() = 100, "active_not_evicted");
            Для Каждого Пара Из ОбщийLifecycle.records Цикл ТестПроверить(Пара.Значение.state = "queued", "queued_preserved"); КонецЦикла;
        ИначеЕсли Случай.action = "growth" Тогда
            Ид = ТестПринять("growth");
            Текст = "0123456789";
            Для Индекс = 1 По 14 Цикл Текст = Текст + Текст; КонецЦикла;
            LifecycleЗавершить("test", Ид, Новый Структура("success,data", Истина, Текст));
            Для Индекс = 1 По 60 Цикл
                ЗаписьОперации = LifecycleПолучить("test", Ид); LifecycleСохранить(ЗаписьОперации);
            КонецЦикла;
            Отчет.Вставить("bytes_before", ОбщийLifecycle.bytes);
            LifecycleКомпактировать(Ложь, Истина);
            Отчет.Вставить("bytes_after", ОбщийLifecycle.bytes);
            ТестПроверить(ОбщийLifecycle.bytes < Отчет.bytes_before / 10, "growth_reclaimed");
            ТестПроверить(LifecycleПолучить("test", Ид).result.data = Текст, "fresh_payload_preserved");
        Иначе
            ТестНаполнить();
            Если Случай.action = "idle" Тогда
                ВстроенныйЗависимостиLifecycle(ОбщийLifecycle.records);
                ТестОтложенныйОтчет = Отчет;
                ПодключитьОбработчикОжидания("ТестПослеПростоя", 65, Истина);
                Возврат;
            КонецЕсли;
            Если Случай.action <> "legacy" Тогда
                ВстроенныйЗависимостиLifecycle(ОбщийLifecycle.records);
                ТестСбой = Случай.action;
                Если Случай.action = "locked" Тогда
                    БлокирующийПоток = Новый ФайловыйПоток(ОбщийLifecycle.path + ".next", РежимОткрытияФайла.ОткрытьИлиСоздать);
                КонецЕсли;
                Отчет.Вставить("bytes_before", ОбщийLifecycle.bytes);
                LifecycleКомпактировать(Истина, Истина);
                Отчет.Вставить("bytes_after", ОбщийLifecycle.bytes);
                ТестПроверитьЗаписи(Ложь);
            КонецЕсли;
        КонецЕсли;
    Исключение
        Отчет.error = ОписаниеОшибки();
    КонецПопытки;
    Если БлокирующийПоток <> Неопределено Тогда БлокирующийПоток.Закрыть(); КонецЕсли;
    ТестСохранитьИтог(Отчет);
КонецПроцедуры

&НаКлиенте
Процедура ТестПослеПростоя()
    Если ОбщийLifecycle.compaction <> Неопределено И ОбщийLifecycle.healthy Тогда
        Если Не ТестОтложенныйОтчет.Свойство("idle_probes") Тогда ТестОтложенныйОтчет.Вставить("idle_probes", Новый Массив); КонецЕсли;
        ТестОтложенныйОтчет.idle_probes.Добавить(ОбщийLifecycle.compaction.phase);
        Если ТестОтложенныйОтчет.idle_probes.Количество() < 25 Тогда
            ПодключитьОбработчикОжидания("ТестПослеПростоя", 1, Истина); Возврат;
        КонецЕсли;
    КонецЕсли;
    Попытка ТестПроверитьЗаписи(Ложь); Исключение ТестОтложенныйОтчет.error = ОписаниеОшибки(); КонецПопытки;
    ТестСохранитьИтог(ТестОтложенныйОтчет);
КонецПроцедуры

&НаКлиенте
Процедура ТестСохранитьИтог(Отчет)
    Если ОбщийLifecycle <> Неопределено Тогда
        Отчет.Вставить("healthy", ОбщийLifecycle.healthy);
        Записи = Новый Массив;
        Для Каждого Пара Из ОбщийLifecycle.records Цикл Записи.Добавить(Пара.Значение); КонецЦикла;
        Отчет.Вставить("records", Записи);
    КонецЕсли;
    Запись = Новый ТекстовыйДокумент; Запись.УстановитьТекст(ЗаписатьJSON2(Отчет)); Запись.Записать("@ROOT@/" + Отчет.case.report + ".json");
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
