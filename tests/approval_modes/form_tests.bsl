// Appended only to an isolated copy of the real form by prepare_runtime.py.
// No test hook is included in the deliverable EPF.
&НаКлиенте
Процедура ВыполнитьТестыРежимов(ПутьРезультатов)
	Проверки = Новый Массив;
	Попытка
		ИнициализироватьРежимПодтверждения();
		ИспользоватьТочнуюАнонимизацию = Ложь;
		ИспользоватьАсинхронноеПодключениеКомпонент = Ложь;
		АвтоРазрешитьЗаписать = Истина;
		АвтоРазрешитьПривилегированныйРежим = Истина;
		ПрименитьСтарыйФлагПодтверждения(Ложь);
		ПроверитьТестРежима(РежимПодтвержденияОпасныхОпераций = "deny", "legacy false -> deny", Проверки);
		Безопасная = ТестоваяКомандаРежима("Результат = 42;", "client");
		ПроверитьТестРежима(ВыполнитьКомандуСУчетомКонтекста(Безопасная).data = 42, "safe code in deny", Проверки);
		Опасная = ТестоваяКомандаРежима("Результат = 43; // Записать Удалить", "client");
		Опасная.params.Вставить("requires_approval", Истина);
		ПроверитьТестРежима(НЕ ВыполнитьКомандуСУчетомКонтекста(Опасная).success, "deny despite legacy auto flags", Проверки);
		ПрименитьСтарыйФлагПодтверждения(Истина);
		ПроверитьТестРежима(РежимПодтвержденияОпасныхОпераций = "ask", "legacy true -> ask", Проверки);
		ПроверитьТестРежима(НЕ ВыполнитьКомандуСУчетомКонтекста(Опасная).success, "ask blocks before decision", Проверки);
		ЗафиксироватьПоказаннуюКоманду(Опасная);
		ПроверитьТестРежима(ПринятьРешениеПоОпаснойКоманде(Опасная, Истина), "accept exact command", Проверки);
		ПроверитьТестРежима(ВыполнитьКомандуСУчетомКонтекста(Опасная).data = 43, "approved command executed", Проверки);
		ПроверитьТестРежима(НЕ ВыполнитьКомандуСУчетомКонтекста(Опасная).success, "approval consumed once", Проверки);
		Другая = ТестоваяКомандаРежима("Результат = 44; // Записать", "client");
		Другая.params.Вставить("requires_approval", Истина);
		ПроверитьТестРежима(НЕ ВыполнитьКомандуСУчетомКонтекста(Другая).success, "next command needs decision", Проверки);
		ЗафиксироватьПоказаннуюКоманду(Другая);
		Другая.params.code = "Результат = 45; // Записать";
		ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Другая, Истина), "changed code not approved", Проверки);
		ЗафиксироватьПоказаннуюКоманду(Другая);
		Другая.params.execution_context = "server";
		ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Другая, Истина), "changed context not approved", Проверки);
		ВыполнитьТестыКнопкиРазрешенияСеанса(Проверки);
		РежимПодтвержденияОпасныхОпераций = "session_allow";
		РежимПодтвержденияПриИзменении(Неопределено);
		Для Индекс = 1 По 3 Цикл
			Команда = ТестоваяКомандаРежима("Тест = Новый Массив; Тест.Добавить(1); Тест.Удалить(0); Результат = 46;", "client");
			ПроверитьТестРежима(ВыполнитьКомандуСУчетомКонтекста(Команда).data = 46, "allow series " + Строка(Индекс), Проверки);
		КонецЦикла;
		ПроверитьТестРежима(РежимПодтвержденияОпасныхОпераций = "session_allow", "call completion keeps mode", Проверки);
		ПроверитьТестРежима(ТестовыйСохраненныйРежим() = "ask", "session allow stored only as ask", Проверки);
		Очередь = Новый Структура("Настройки,Состояние", СнимокНастроекПараллельности(), "queued");
		Выполняется = Новый Структура("Настройки,Состояние", СнимокНастроекПараллельности(), "running");
		РежимПодтвержденияОпасныхОпераций = "ask";
		РежимПодтвержденияПриИзменении(Неопределено);
		ПроверитьТестРежима(НЕ НастройкиПараллельнойОперацииАктуальны(Очередь), "queued grant invalidated", Проверки);
		ПроверитьТестРежима(НастройкиПараллельнойОперацииАктуальны(Выполняется), "running command not cancelled by mode", Проверки);
		ПроверитьТестРежима(НЕ ВыполнитьКомандуСУчетомКонтекста(Команда).success, "revoke requires approval", Проверки);
		ЗафиксироватьПоказаннуюКоманду(Команда);
		ЗавершитьСеансРазрешений();
		ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Команда, Истина), "old dialog after disconnect", Проверки);
		РежимПодтвержденияОпасныхОпераций = "session_allow";
		ЗавершитьСеансРазрешений();
		ПроверитьТестРежима(РежимПодтвержденияОпасныхОпераций = "ask", "allow reset on session end", Проверки);
		РежимПодтвержденияОпасныхОпераций = "session_allow";
		ИнициализироватьРежимПодтверждения();
		ПроверитьТестРежима(РежимПодтвержденияОпасныхОпераций = "ask", "new form never restores allow", Проверки);
		Команда = ТестоваяКомандаРежима("Результат = 48;", "client");
		Команда.params.Вставить("requires_approval", Истина);
		ЗафиксироватьПоказаннуюКоманду(Команда);
		ПринятьРешениеПоОпаснойКоманде(Команда, Истина);
		Команда.params.code = "Результат = 49;";
		ПроверитьТестРежима(НЕ ВыполнитьКомандуСУчетомКонтекста(Команда).success, "changed after approval denied", Проверки);
		ОжидающиеПодтверждения = Новый Соответствие;
		ОжидающиеПодтверждения.Вставить("same-id", Новый Структура("Команда", Команда));
		ОбработатьРезультатПодтвержденияВстроенный(Истина, Новый Структура("RequestId,ИдПодтверждения", "same-id", "old-dialog"));
		ОбработатьРезультатПодтвержденияВстроенный("session_allow", Новый Структура("RequestId,ИдПодтверждения", "same-id", "old-dialog"));
		ПроверитьТестРежима(ОжидающиеПодтверждения.Количество() = 1, "late dialog cannot consume reused request id", Проверки);
		ПроверитьТестРежима(РежимПодтвержденияОпасныхОпераций = "ask", "late HTTP dialog cannot switch mode", Проверки);
		ОповещениеТеста = Новый ОписаниеОповещения("ОбработатьРезультатПодтвержденияВстроенный", ЭтаФорма, Новый Структура);
		ОповещениеТеста.ДополнительныеПараметры.Вставить("ИдПодтверждения", Команда._toolkit_approval.id);
		ПроверитьТестРежима(ОповещениеТеста.ДополнительныеПараметры.ИдПодтверждения = Команда._toolkit_approval.id, "callback carries exact dialog identity", Проверки);
		СохранитьРежимПодтвержденияНаСервере("session_allow");
		ПроверитьТестРежима(ТестовыйСохраненныйРежим() = "ask", "reject persisted allow input", Проверки);
		СохранитьРежимПодтвержденияНаСервере("deny");
		ЗагрузитьНастройки();
		ПроверитьТестРежима(РежимПодтвержденияОпасныхОпераций = "deny", "reload deny", Проверки);
		СохранитьРежимПодтвержденияНаСервере("ask");
		ЗагрузитьНастройки();
		ПроверитьТестРежима(РежимПодтвержденияОпасныхОпераций = "ask", "reload ask", Проверки);
		// Real writes only to new files beside the report in the isolated test directory.
		Для Каждого Контекст Из СтрРазделить("client,server", ",") Цикл
			ПутьЗаписи = ПутьРезультатов + "." + Контекст + ".txt";
			КодЗаписи = "Текст = Новый ТекстовыйДокумент; Текст.УстановитьТекст(""fresh-test""); Текст.Записать("""
				+ ПутьЗаписи + """); Результат = 47;";
			КомандаЗаписи = ТестоваяКомандаРежима(КодЗаписи, Контекст);
			ПрименитьСтарыйФлагПодтверждения(Ложь);
			ПроверитьТестРежима(НЕ ВыполнитьКомандуСУчетомКонтекста(КомандаЗаписи).success, "deny real write " + Контекст, Проверки);
			ФайлЗаписи = Новый Файл(ПутьЗаписи);
			ПроверитьТестРежима(НЕ ФайлЗаписи.Существует(), "no effect in deny " + Контекст, Проверки);
			РежимПодтвержденияОпасныхОпераций = "session_allow";
			РежимПодтвержденияПриИзменении(Неопределено);
			РезультатЗаписи = ВыполнитьКомандуСУчетомКонтекста(КомандаЗаписи);
			ПроверитьТестРежима(РезультатЗаписи.success, "real write executed " + Контекст, Проверки);
			ПроверитьТестРежима(ФайлЗаписи.Существует(), "effect confirmed " + Контекст, Проверки);
		КонецЦикла;
		Результат = Новый Структура("success,checks", Истина, Проверки);
	Исключение
		Результат = Новый Структура("success,error,checks", Ложь, ОписаниеОшибки(), Проверки);
	КонецПопытки;
	ТекстОтчета = Новый ТекстовыйДокумент;
	ТекстОтчета.УстановитьТекст(ЗаписатьJSON2(Результат));
	ТекстОтчета.Записать(ПутьРезультатов, КодировкаТекста.UTF8);
КонецПроцедуры

&НаКлиенте
Функция ТестоваяКомандаРежима(Код, Контекст)
	Возврат Новый Структура("id,tool,params", Строка(Новый УникальныйИдентификатор), "execute_code",
		Новый Структура("code,execution_context", Код, Контекст));
КонецФункции

&НаКлиенте
Процедура ВыполнитьТестыКнопкиРазрешенияСеанса(Проверки)
	РежимПодтвержденияОпасныхОпераций = "ask";
	РежимПодтвержденияПриИзменении(Неопределено);
	Команда = ТестоваяКомандаРежима("Результат = 51;", "client");
	Команда.params.Вставить("requires_approval", Истина);
	ЗафиксироватьПоказаннуюКоманду(Команда);
	ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Команда, Ложь), "reject keeps command blocked", Проверки);
	ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Команда, Неопределено), "close keeps command blocked", Проверки);
	ПроверитьТестРежима(РежимПодтвержденияОпасныхОпераций = "ask", "reject and close keep ask", Проверки);
	ПроверитьТестРежима(ПринятьРешениеПоОпаснойКоманде(Команда, "session_allow"), "dialog grants session", Проверки);
	ПроверитьТестРежима(РежимПодтвержденияОпасныхОпераций = "session_allow", "dialog updates mode field", Проверки);
	ПроверитьТестРежима(ТестовыйСохраненныйРежим() = "ask", "dialog grant not persisted", Проверки);
	ПроверитьТестРежима(ВыполнитьКомандуСУчетомКонтекста(Команда).data = 51, "dialog current command executed", Проверки);
	Следующая = ТестоваяКомандаРежима("Результат = 52;", "client");
	Следующая.params.Вставить("requires_approval", Истина);
	ПроверитьТестРежима(ВыполнитьКомандуСУчетомКонтекста(Следующая).data = 52, "dialog next command needs no decision", Проверки);
	РежимПодтвержденияОпасныхОпераций = "ask";
	РежимПодтвержденияПриИзменении(Неопределено);
	ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Команда, "session_allow"), "dialog cannot regrant after revoke", Проверки);
	ЗафиксироватьПоказаннуюКоманду(Следующая);
	Следующая.params.code = "Результат = 53;";
	ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Следующая, "session_allow"), "changed code cannot grant session", Проверки);
	ЗафиксироватьПоказаннуюКоманду(Следующая);
	Следующая.params.execution_context = "server";
	ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Следующая, "session_allow"), "changed context cannot grant session", Проверки);
	ЗафиксироватьПоказаннуюКоманду(Следующая);
	ЗавершитьСеансРазрешений();
	ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Следующая, "session_allow"), "old session dialog cannot grant session", Проверки);
	ПроверитьТестРежима(РежимПодтвержденияОпасныхОпераций = "ask", "invalid dialogs keep ask", Проверки);
	ЗафиксироватьПоказаннуюКоманду(Следующая);
	РежимПодтвержденияОпасныхОпераций = "deny";
	ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Следующая, "session_allow"), "dialog cannot bypass deny", Проверки);
	РежимПодтвержденияОпасныхОпераций = "ask";
	РежимПодтвержденияПриИзменении(Неопределено);
	ВыполнитьТестыПараллельногоРазрешенияСеанса(Проверки);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТестыПараллельногоРазрешенияСеанса(Проверки)
	Для Каждого Маршрут Из СтрРазделить("mcp,rest,proxy", ",") Цикл
		Команда = ТестоваяКомандаРежима("Результат = 54;", "server");
		Команда.Вставить("_parallel_approval_id", "test-dialog-" + Маршрут);
		ЗафиксироватьПоказаннуюКоманду(Команда);
		Операция = Новый Структура("Состояние,ЗавершениеЗапрошено,Срок,Маршрут,Настройки",
			"approval", Ложь, ТекущиеМиллисекундыКлиента() + 60000,
			НовыйКонтекстВыполненияКоманды(Маршрут), СнимокНастроекПараллельности());
		ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Команда, "session_allow"), "missing operation cannot grant " + Маршрут, Проверки);
		ПланировщикФормы.Операции.Вставить(Команда._parallel_approval_id, Операция);
		Операция.ЗавершениеЗапрошено = Истина;
		ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Команда, "session_allow"), "cancelled operation cannot grant " + Маршрут, Проверки);
		Операция.ЗавершениеЗапрошено = Ложь;
		Операция.Срок = 0;
		ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Команда, "session_allow"), "expired operation cannot grant " + Маршрут, Проверки);
		Операция.Срок = ТекущиеМиллисекундыКлиента() + 60000;
		Операция.Настройки.anonymization = НЕ ИспользоватьТочнуюАнонимизацию;
		ПроверитьТестРежима(НЕ ПринятьРешениеПоОпаснойКоманде(Команда, "session_allow"), "changed settings cannot grant " + Маршрут, Проверки);
		Операция.Настройки = СнимокНастроекПараллельности();
		ПроверитьТестРежима(РежимПодтвержденияОпасныхОпераций = "ask", "invalid operation keeps ask " + Маршрут, Проверки);
		ПроверитьТестРежима(ПринятьРешениеПоОпаснойКоманде(Команда, "session_allow"), "pending operation grants session " + Маршрут, Проверки);
		Операция.Состояние = "queued";
		ПроверитьТестРежима(НастройкиПараллельнойОперацииАктуальны(Операция), "current queued operation remains valid " + Маршрут, Проверки);
		ПланировщикФормы.Операции.Удалить(Команда._parallel_approval_id);
		РежимПодтвержденияОпасныхОпераций = "ask";
		РежимПодтвержденияПриИзменении(Неопределено);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьТестРежима(Условие, Имя, Проверки)
	Если НЕ Условие Тогда ВызватьИсключение "FAILED: " + Имя; КонецЕсли;
	Проверки.Добавить(Имя);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТестовыйСохраненныйРежим()
	Возврат ХранилищеОбщихНастроек.Загрузить("MCPToolkit", "РежимПодтвержденияОпасныхОпераций");
КонецФункции
