{
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "parameters": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "string",
              "boolean",
              "integer"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "type": [
              "string",
              "boolean",
              "integer"
            ]
          }
        },
        "required": [
          "type",
          "required"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "required": {
                  "const": false
                }
              }
            },
            "then": {
              "required": [
                "default"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "default"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "string"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "boolean"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "integer"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "integer"
                }
              }
            }
          }
        ]
      }
    },
    "data_scope": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mutation": {
          "enum": [
            "read_only",
            "ui_write"
          ]
        }
      },
      "required": [
        "policy_id",
        "purpose",
        "mutation"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
          },
          "tool": {
            "enum": [
              "test_open",
              "test_inspect",
              "test_input",
              "test_action",
              "test_table",
              "test_expect"
            ]
          },
          "arguments": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "params": {
                "type": "object",
                "patternProperties": {
                  "^[^$].*$": {
                    "$ref": "#/$defs/value"
                  }
                },
                "additionalProperties": false
              },
              "window": {
                "$ref": "#/$defs/value"
              },
              "element": {
                "$ref": "#/$defs/value"
              }
            },
            "required": [
              "params"
            ],
            "additionalProperties": false
          },
          "on_error": {
            "enum": [
              "stop",
              "continue_observation"
            ]
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          },
          "finish_focus": {
            "type": "object",
            "properties": {
              "selector": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "type": {
                    "const": "field"
                  }
                },
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false
              },
              "same_form": {
                "const": true
              }
            },
            "required": [
              "selector",
              "same_form"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "step_id",
          "tool",
          "arguments",
          "on_error",
          "timeout_ms"
        ],
        "additionalProperties": false
      }
    },
    "recording_review": {
      "type": "object",
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compositions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "step_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "rule": {
                "enum": [
                  "activate_then_input",
                  "activate_input_finish_candidate"
                ]
              },
              "events": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "event": {
                      "enum": [
                        "activate",
                        "inputText"
                      ]
                    },
                    "source_path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "node_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "window": {
                      "type": "object",
                      "properties": {
                        "selector": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1024
                            }
                          },
                          "required": [
                            "title"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "selector"
                      ],
                      "additionalProperties": false
                    },
                    "element": {
                      "type": "object",
                      "properties": {
                        "selector": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1024
                            },
                            "title": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1024
                            },
                            "type": {
                              "const": "field"
                            }
                          },
                          "required": [
                            "type"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "selector"
                      ],
                      "additionalProperties": false
                    },
                    "step_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "required": [
                    "event",
                    "source_path",
                    "node_sha256",
                    "window",
                    "element"
                  ],
                  "additionalProperties": false
                }
              },
              "obligations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "confirm_live_target_and_input_activation",
                    "confirm_same_form_across_blocks",
                    "confirm_exact_finish_target"
                  ]
                }
              }
            },
            "required": [
              "step_id",
              "rule",
              "events",
              "obligations"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "source_sha256",
        "compositions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "scenario_id",
    "revision",
    "state",
    "parameters",
    "data_scope",
    "steps"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:toolkit:scenario:v1",
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": [
            "string",
            "boolean",
            "integer"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "properties": {
            "$param": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
            }
          },
          "required": [
            "$param"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "patternProperties": {
            "^[^$].*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "description": "Structural template contract only. Full semantic/context preflight is specified in scenario-contract.md.",
  "allOf": [
    {
      "if": {
        "required": [
          "recording_review"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "draft"
          }
        }
      }
    }
  ]
}
